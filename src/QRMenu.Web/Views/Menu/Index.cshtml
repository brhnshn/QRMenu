@model List<QRMenu.Core.Entities.Urun>
@{
    ViewData["Title"] = "Menü";
    Layout = null;
    var kategoriler = Model.Select(u => u.Kategori).DistinctBy(k => k.Id).OrderBy(k => k.SiraNo).ToList();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>QR Menü</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/menu.css" rel="stylesheet" />
</head>
<body class="bg-light">

    <!-- 1. HEADER -->
    <header class="menu-header">
        <div class="header-left">
            <div class="logo-area">
                <span class="logo-icon"></span>
                <span class="logo-text">Kafe Menu</span>
            </div>
            @if (Context.Items.ContainsKey("MasaId"))
            {
                <div class="table-badge">Masa @Context.Items["MasaId"]</div>
            }
        </div>
        <div class="header-right">
            <div class="lang-switch">TR</div>
        </div>
    </header>

    <!-- 2. KATEGORİ BUTONLARI (Yatay Kaydırma) -->
    <div class="category-tabs-area">
        <div class="category-tabs-scroll">
            @for (var i = 0; i < kategoriler.Count; i++)
            {
                var cat = kategoriler[i];
                <button class="category-tab @(i == 0 ? "active" : "")" data-cat-id="@cat.Id">
                    @cat.Ad
                </button>
            }
        </div>
    </div>

    <!-- 3. ÜRÜN LİSTESİ -->
    <div class="menu-content pb-5 mb-5">
        @foreach (var kategori in kategoriler)
        {
            var urunler = Model.Where(u => u.KategoriId == kategori.Id).ToList();
            if(!urunler.Any()) continue;

            <div class="category-section" id="cat-@kategori.Id">
                <h2 class="category-title">@kategori.Ad</h2>
                <div class="products-grid">
                    @foreach (var urun in urunler)
                    {
                        var isSoldOut = !urun.AktifMi;
                        <div class="product-card-horizontal @(isSoldOut ? "soldout" : "")">
                            <div class="product-img-wrapper">
                                @if (urun.PopulerMi)
                                {
                                    <span class="badge-populer"> Popüler</span>
                                }
                                @if (!string.IsNullOrEmpty(urun.GorselUrl))
                                {
                                    <img src="@urun.GorselUrl" alt="@urun.Ad" class="product-img" loading="lazy" />
                                }
                                else
                                {
                                    <div class="img-placeholder"></div>
                                }
                            </div>
                            <div class="product-details">
                                <h3 class="p-title">@urun.Ad</h3>
                                <p class="p-desc">@urun.Aciklama</p>
                                <div class="p-bottom">
                                    <span class="p-price">@urun.Fiyat.ToString("N2") TL</span>
                                    @if (!isSoldOut)
                                    {
                                        var opsiyonList = urun.UrunOpsiyonlar?.Select(uo => new { id = uo.Opsiyon.Id, ad = uo.Opsiyon.Ad, grup = uo.Opsiyon.Grup, ekFiyat = uo.Opsiyon.EkFiyat }).ToList() ?? new();
                                        var opsiyonJson = System.Text.Json.JsonSerializer.Serialize(opsiyonList);
                                        <button class="btn-add"
                                                data-urun-id="@urun.Id"
                                                data-urun-ad="@urun.Ad"
                                                data-fiyat="@urun.Fiyat.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-opsiyonlar='@Html.Raw(opsiyonJson)'>
                                            <span class="btn-add-icon">+</span>
                                            <span class="btn-add-text">Ekle</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-bold">Tükendi</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- 4. YAPIŞKAN ALT BAR -->
    <div class="sticky-bottom-bar" id="bottomBar" style="display: none;">
        <button class="btn-waiter" onclick="callWaiter()">
            <span class="fs-4 d-block lh-1"></span>
            <span class="small fw-semibold mt-1">Garson</span>
        </button>
        <button class="btn-view-cart" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas" onclick="fetchCartDetails()">
            <div class="d-flex align-items-center justify-content-center">
                <span class="fw-bold fs-5 me-2">Sepeti Gör</span>
                <span class="fw-bold fs-5 opacity-75">(<span id="bottomTotal">0.00</span> TL)</span>
            </div>
        </button>
    </div>

    <!-- SEPET OFFCANVAS (Sağdan kayan pencere) -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="cartOffcanvas">
        <div class="offcanvas-header bg-white shadow-sm z-1">
            <h5 class="offcanvas-title fw-bold">Sepetim</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body bg-light p-3" id="cartContent">
            <!-- JS ile doldurulacak -->
            <div class="text-center text-muted mt-5">Yükleniyor...</div>
        </div>
        <div class="offcanvas-footer bg-white border-top p-3 shadow-lg">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted fw-semibold">Genel Toplam</span>
                <span class="fs-4 fw-bold text-dark" id="cartOffcanvasTotal">0.00 TL</span>
            </div>
            <button class="btn btn-success w-100 py-3 rounded-4 fs-5 fw-bold" id="btnSiparisGonder" onclick="siparisGonder()">Siparişi Gönder</button>
        </div>
    </div>

    <!-- OPSIYON MODALI -->
    <div class="modal fade" id="optionsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold fs-4" id="optionsModalTitle">Ürün Seçenekleri</h5>
                    <button type="button" class="btn-close bg-light rounded-circle p-2" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-3" id="optionsModalBody">
                    <!-- Dinamik -->
                </div>
                <div class="modal-footer border-top-0 d-block px-3 pb-3">
                    <div id="optionWarning" class="text-danger small fw-semibold text-center mb-2" style="display:none;">Lütfen tüm zorunlu seçenekleri belirleyin.</div>
                    <button type="button" id="btnAddToCartModal" class="btn btn-dark w-100 py-3 rounded-4 fs-5 fw-bold d-flex justify-content-between align-items-center" onclick="submitOptionsForm()" disabled>
                        <span>Sepete Ekle</span>
                        <span id="modalTotalPrice" class="opacity-75">0.00 TL</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- SİPARİŞ ONAY MODALI -->
    <div class="modal fade" id="siparisOnayModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-body text-center p-4">
                    <div class="fs-1 mb-2">🍽️</div>
                    <h5 class="fw-bold mb-2">Siparişi Onayla</h5>
                    <p class="text-muted small mb-4">Siparişiniz mutfağa gönderilecek.</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-light flex-fill py-2 rounded-3 fw-semibold" data-bs-dismiss="modal">Vazgeç</button>
                        <button class="btn btn-success flex-fill py-2 rounded-3 fw-semibold" id="btnOnaylaGonder" onclick="siparisGonderConfirmed()">Gönder</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST BİLDİRİM -->
    <div class="position-fixed bottom-0 start-50 translate-middle-x mb-4" style="z-index:9999">
        <div id="toastBildirim" class="toast align-items-center border-0 rounded-4 shadow-lg" role="alert" data-bs-delay="3000">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="toastMesaj"></div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // Kategori butonları — tıklama ve scroll takibi
        let scrollObserver = null;

        function setupScrollObserver() {
            if (scrollObserver) scrollObserver.disconnect();
            const tabs = document.querySelectorAll('.category-tab');
            const sections = document.querySelectorAll('.category-section');

            scrollObserver = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        var catId = entry.target.id.replace('cat-', '');
                        tabs.forEach(function(t) { t.classList.remove('active'); });
                        var matchingTab = document.querySelector('.category-tab[data-cat-id="' + catId + '"]');
                        if (matchingTab) {
                            matchingTab.classList.add('active');
                            matchingTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                        }
                    }
                });
            }, { rootMargin: '-140px 0px -60% 0px', threshold: 0 });

            sections.forEach(function(s) { scrollObserver.observe(s); });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const tabs = document.querySelectorAll('.category-tab');

            // Tıklama: butona basınca o kategoriye kaydır
            tabs.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var catId = this.getAttribute('data-cat-id');
                    var section = document.getElementById('cat-' + catId);
                    if (!section) return;

                    tabs.forEach(function(t) { t.classList.remove('active'); });
                    this.classList.add('active');

                    var offset = 130;
                    var y = section.getBoundingClientRect().top + window.pageYOffset - offset;
                    window.scrollTo({ top: y, behavior: 'smooth' });
                });
            });

            setupScrollObserver();
        });

        function callWaiter() {
            alert(' Garson çağrısı yapıldı.');
        }

        let currentUrunId = 0;
        let baseFiyat = 0;
        let requiredGroups = [];

        // data-* attribute'larından opsiyonları okuyarak addToCartClick çağır
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-add');
            if (!btn) return;
            const urunId = parseInt(btn.dataset.urunId);
            const urunAd = btn.dataset.urunAd;
            const fiyat = parseFloat(btn.dataset.fiyat);
            let opsiyonlar = [];
            try { opsiyonlar = JSON.parse(btn.dataset.opsiyonlar || '[]'); } catch(_) {}
            addToCartClick(urunId, urunAd, fiyat, opsiyonlar);
        });

        function addToCartClick(urunId, urunAd, fiyat, opsiyonlar) {
            if (!opsiyonlar || opsiyonlar.length === 0) {
                postAddToCart(urunId, 1, []);
                return;
            }
            // Opsiyonlu akış
            currentUrunId = urunId;
            baseFiyat = parseFloat(fiyat);
            document.getElementById('optionsModalTitle').textContent = urunAd;
            const body = document.getElementById('optionsModalBody');
            body.innerHTML = '';

            const gruplar = {};
            opsiyonlar.forEach(o => {
                if (!gruplar[o.grup]) gruplar[o.grup] = [];
                gruplar[o.grup].push(o);
            });

            requiredGroups = []; // Zorunlu radio gruplarının isimleri (reset)

            for (const [grupAdi, opsList] of Object.entries(gruplar)) {
                const groupDiv = document.createElement('div');
                groupDiv.className = 'mb-4';
                const isMulti = grupAdi.toLowerCase().includes('ekstra') || grupAdi.toLowerCase().includes('çoklu');
                const requiredTag = !isMulti ? ' <span class="text-danger small">(Zorunlu)</span>' : '';
                groupDiv.innerHTML = `<h6 class="mb-3 fw-bold text-dark">${grupAdi}${requiredTag}</h6>`;

                const nameAttr = isMulti ? '' : 'grup_' + grupAdi.replace(/\s+/g, '');
                if (!isMulti) requiredGroups.push(nameAttr);

                opsList.forEach(ops => {
                    const id = 'ops_' + ops.id;
                    const inputType = isMulti ? 'checkbox' : 'radio';
                    const inputName = isMulti ? id : nameAttr;
                    const ekFiyatStr = ops.ekFiyat > 0 ? `<span class="text-muted small">+${ops.ekFiyat.toFixed(2)} TL</span>` : '';

                    groupDiv.innerHTML += `
                        <label class="form-check custom-option-check p-3 mb-2 rounded-3 border d-flex align-items-center position-relative w-100" style="cursor:pointer;" for="${id}">
                            <div class="flex-grow-1">
                                <span class="d-block fw-semibold">${ops.ad}</span>
                                ${ekFiyatStr}
                            </div>
                            <div class="form-check-radio-wrap ms-2">
                                <input class="form-check-input option-input m-0" type="${inputType}" name="${inputName}" id="${id}" value="${ops.id}" data-price="${ops.ekFiyat}" onchange="updateModalPrice()">
                            </div>
                        </label>
                    `;
                });
                body.appendChild(groupDiv);
            }
            updateModalPrice();
            new bootstrap.Modal(document.getElementById('optionsModal')).show();
        }

        function updateModalPrice() {
            let toplam = baseFiyat;
            document.querySelectorAll('.option-input:checked').forEach(input => {
                toplam += parseFloat(input.dataset.price);
            });
            document.getElementById('modalTotalPrice').textContent = toplam.toFixed(2) + ' TL';

            // Zorunlu grup kontrolü
            const btn = document.getElementById('btnAddToCartModal');
            const warning = document.getElementById('optionWarning');
            let allSelected = true;
            requiredGroups.forEach(function(grpName) {
                if (!document.querySelector('input[name="' + grpName + '"]:checked')) {
                    allSelected = false;
                }
            });
            btn.disabled = !allSelected;
            btn.style.opacity = allSelected ? '1' : '0.5';
            warning.style.display = allSelected ? 'none' : 'block';
        }

        function submitOptionsForm() {
            const selectedOps = [];
            document.querySelectorAll('.option-input:checked').forEach(input => {
                selectedOps.push(parseInt(input.value));
            });
            postAddToCart(currentUrunId, 1, selectedOps);
            var modal = bootstrap.Modal.getInstance(document.getElementById('optionsModal'));
            if(modal) modal.hide();
        }

        async function postAddToCart(urunId, adet, opsiyonIds) {
            try {
                const response = await fetch('/sepet/ekle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ UrunId: urunId, Adet: adet, OpsiyonIds: opsiyonIds })
                });
                const data = await response.json();
                if (data.success) {
                    updateBottomBar(data.urunSayisi, data.toplamTutar);
                    // Update offcanvas if it's open
                    var offcanvasElement = document.getElementById('cartOffcanvas');
                    if (offcanvasElement.classList.contains('show')) {
                        fetchCartDetails();
                    }
                } else {
                    alert('Hata: ' + data.message);
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function updateCartItem(detayId, adet) {
            try {
                const response = await fetch('/sepet/guncelle/' + detayId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Adet: adet })
                });
                const data = await response.json();
                if (data.success) {
                    updateBottomBar(data.urunSayisi, data.toplamTutar);
                    fetchCartDetails();
                }
            } catch (err) { console.error(err); }
        }

        async function removeCartItem(detayId) {
            try {
                const response = await fetch('/sepet/cikar/' + detayId, { method: 'POST' });
                const data = await response.json();
                if (data.success) {
                    updateBottomBar(data.urunSayisi, data.toplamTutar);
                    fetchCartDetails();
                }
            } catch (err) { console.error(err); }
        }

        function updateBottomBar(count, total) {
            const bottomBar = document.getElementById('bottomBar');
            if (count > 0) {
                bottomBar.style.display = 'flex';
                document.getElementById('bottomTotal').textContent = parseFloat(total).toFixed(2);
            } else {
                bottomBar.style.display = 'none';
                
                // Eğer sepet açıksa kapatalım
                var bsOffcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('cartOffcanvas'));
                if(bsOffcanvas) bsOffcanvas.hide();
            }
        }

        async function fetchCartDetails() {
            try {
                const response = await fetch('/sepet/detay-json');
                const data = await response.json();
                const container = document.getElementById('cartContent');
                document.getElementById('cartOffcanvasTotal').textContent = parseFloat(data.toplamTutar).toFixed(2) + ' TL';

                if (!data.items || data.items.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted mt-5"><div class="fs-1 mb-3"></div><h5>Sepetiniz Boş</h5></div>';
                    return;
                }

                container.innerHTML = '';
                data.items.forEach(item => {
                    let opsHtml = '';
                    if(item.opsiyonlar) {
                        try {
                            const parsed = JSON.parse(item.opsiyonlar);
                            if(parsed.length > 0) {
                                opsHtml = '<div class="small text-muted mt-1">' + parsed.map(p => p.Ad).join(', ') + '</div>';
                            }
                        } catch(e) {}
                    }
                    
                    container.innerHTML += `
                        <div class="cart-item bg-white p-3 rounded-4 mb-3 shadow-sm border-0 position-relative">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">${item.urunAd}</h6>
                                    ${opsHtml}
                                    <div class="fw-bold text-success mt-1">${parseFloat(item.birimFiyat).toFixed(2)} TL <span class="text-muted small fw-normal">/ adet</span></div>
                                </div>
                                <button class="btn btn-sm text-danger p-0" onclick="removeCartItem(${item.detayId})">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <div class="quantity-control bg-light rounded-pill px-2 py-1 border">
                                    <button class="btn btn-sm btn-link text-decoration-none text-dark fw-bold" onclick="updateCartItem(${item.detayId}, ${item.adet - 1})">-</button>
                                    <span class="mx-3 fw-bold">${item.adet}</span>
                                    <button class="btn btn-sm btn-link text-decoration-none text-dark fw-bold" onclick="updateCartItem(${item.detayId}, ${item.adet + 1})">+</button>
                                </div>
                                <div class="fw-bold fs-6">${(item.adet * item.birimFiyat).toFixed(2)} TL</div>
                            </div>
                        </div>
                    `;
                });
            } catch (err) {
                console.error("Sepet detayı alınamadı", err);
            }
        }

        // Sayfa açıldığında sepet tutarını getirip bottom bar'ı göster/gizle
        async function fetchInitialBadge() {
            try {
                const response = await fetch('/sepet/bilgi');
                const data = await response.json();
                updateBottomBar(data.urunSayisi, data.toplamTutar);
            } catch (err) { console.error(err); }
        }
        document.addEventListener('DOMContentLoaded', fetchInitialBadge);

        // ============================================================
        // SIGNALR — Gerçek zamanlı menü güncellemesi
        // ============================================================
        const menuConnection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/menu')
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .build();

        menuConnection.on('MenuGuncellendi', async function() {
            try {
                const res = await fetch('/menu/json');
                const kategoriler = await res.json();
                yenidenCiz(kategoriler);
            } catch (e) {
                console.error('Menü güncellenirken hata:', e);
            }
        });

        function yenidenCiz(kategoriler) {
            // Kategori tablarını güncelle
            const tabScroll = document.querySelector('.category-tabs-scroll');
            tabScroll.innerHTML = '';
            kategoriler.forEach(function(kat, i) {
                const btn = document.createElement('button');
                btn.className = 'category-tab' + (i === 0 ? ' active' : '');
                btn.setAttribute('data-cat-id', kat.id);
                btn.textContent = kat.ad;
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));
                    btn.classList.add('active');
                    const section = document.getElementById('cat-' + kat.id);
                    if (section) {
                        const y = section.getBoundingClientRect().top + window.pageYOffset - 130;
                        window.scrollTo({ top: y, behavior: 'smooth' });
                    }
                });
                tabScroll.appendChild(btn);
            });

            // Ürün kartlarını güncelle
            const menuContent = document.querySelector('.menu-content');
            menuContent.innerHTML = '';
            kategoriler.forEach(function(kat) {
                if (!kat.urunler || kat.urunler.length === 0) return;

                const section = document.createElement('div');
                section.className = 'category-section';
                section.id = 'cat-' + kat.id;

                let html = '<h2 class="category-title">' + escapeHtml(kat.ad) + '</h2><div class="products-grid">';
                kat.urunler.forEach(function(urun) {
                    const isSoldOut = !urun.aktifMi;

                    const fiyatStr = urun.fiyat.toFixed(2);

                    html += '<div class="product-card-horizontal ' + (isSoldOut ? 'soldout' : '') + '">';
                    html += '<div class="product-img-wrapper">';
                    if (urun.populerMi) {
                        html += '<span class="badge-populer"> Popüler</span>';
                    }
                    if (urun.gorselUrl) {
                        html += '<img src="' + escapeHtml(urun.gorselUrl) + '" alt="' + escapeHtml(urun.ad) + '" class="product-img" loading="lazy" />';
                    } else {
                        html += '<div class="img-placeholder"></div>';
                    }
                    html += '</div>';
                    html += '<div class="product-details">';
                    html += '<h3 class="p-title">' + escapeHtml(urun.ad) + '</h3>';
                    html += '<p class="p-desc">' + escapeHtml(urun.aciklama || '') + '</p>';
                    html += '<div class="p-bottom">';
                    html += '<span class="p-price">' + fiyatStr + ' TL</span>';
                    if (!isSoldOut) {
                        const opsAttr = JSON.stringify(urun.opsiyonlar || []);
                        html += '<button class="btn-add" data-urun-id="' + urun.id + '" data-urun-ad="' + escapeHtml(urun.ad) + '" data-fiyat="' + fiyatStr + '" data-opsiyonlar=\'' + opsAttr.replace(/'/g, '&#39;') + '\'>';
                        html += '<span class="btn-add-icon">+</span><span class="btn-add-text">Ekle</span></button>';
                    } else {
                        html += '<span class="text-danger small fw-bold">Tükendi</span>';
                    }
                    html += '</div></div></div>';
                });
                html += '</div>';
                section.innerHTML = html;
                menuContent.appendChild(section);
            });

            // IntersectionObserver'ı yeniden bağla
            setupScrollObserver();
        }

        function escapeHtml(str) {
            if (!str) return '';
            const d = document.createElement('div');
            d.textContent = str;
            return d.innerHTML;
        }

        // SignalR bağlantısını başlat
        menuConnection.start().catch(function(err) {
            console.error('SignalR bağlantı hatası:', err);
        });

        function siparisGonder() {
            new bootstrap.Modal(document.getElementById('siparisOnayModal')).show();
        }

        function showToast(msg, isError) {
            const el = document.getElementById('toastBildirim');
            el.className = 'toast align-items-center border-0 rounded-4 shadow-lg text-white ' + (isError ? 'bg-danger' : 'bg-success');
            document.getElementById('toastMesaj').textContent = msg;
            bootstrap.Toast.getOrCreateInstance(el).show();
        }

        async function siparisGonderConfirmed() {
            bootstrap.Modal.getInstance(document.getElementById('siparisOnayModal')).hide();

            const btn = document.getElementById('btnSiparisGonder');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Gönderiliyor...';

            try {
                const res = await fetch('/siparis/olustur', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });
                if (!res.ok && res.status === 401) {
                    showToast('Oturum süresi dolmuş. QR kodu tekrar okutun.', true);
                    btn.disabled = false;
                    btn.textContent = 'Siparişi Gönder';
                    return;
                }
                const data = await res.json();
                if(data.success) {
                    document.getElementById('cartContent').innerHTML = `
                        <div class="text-center mt-5">
                            <div style="width:64px;height:64px;background:#d4edda;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#155724" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                            <h5 class="fw-bold">Siparişiniz Alındı!</h5>
                            <p class="text-muted mb-1">Sipariş #${data.siparisId}</p>
                            <p class="fs-5 fw-bold text-success">${data.toplamTutar.toFixed(2)} TL</p>
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">${data.durum}</span>
                        </div>`;
                    document.getElementById('cartOffcanvasTotal').textContent = '0.00 TL';
                    btn.textContent = 'Sipariş Gönderildi ✓';
                    btn.classList.replace('btn-success', 'btn-secondary');
                    updateBottomBar(0, 0);
                    showToast('Siparişiniz mutfağa iletildi!', false);
                } else {
                    showToast(data.message, true);
                    btn.disabled = false;
                    btn.textContent = 'Siparişi Gönder';
                }
            } catch(e) {
                console.error(e);
                showToast('Bağlantı hatası, tekrar deneyin.', true);
                btn.disabled = false;
                btn.textContent = 'Siparişi Gönder';
            }
        }
    </script>
</body>
</html>
