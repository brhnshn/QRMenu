@model List<QRMenu.Core.Entities.Urun>
@using QRMenu.Web.Helpers
@{
    ViewData["Title"] = "Menü";
    Layout = null;
    var kategoriler = Model.Select(u => u.Kategori).DistinctBy(k => k.Id).OrderBy(k => k.SiraNo).ToList();
    (decimal IndirimOrani, List<int> UrunIds)? hhTuple = ViewBag.HappyHour as (decimal IndirimOrani, List<int> UrunIds)?;
    bool isHappyHour = false;
    decimal hhOran = 0;
    var hhUrunIds = new HashSet<int>();
    if (hhTuple is { } hhValue && hhValue.IndirimOrani > 0)
    {
        isHappyHour = true;
        hhOran = hhValue.IndirimOrani;
        hhUrunIds = hhValue.UrunIds?.ToHashSet() ?? new HashSet<int>();
    }

    var currentLang = Context.Request.Cookies["lang"] ?? "tr";
    bool isEn = currentLang == "en";
    string L(string? tr, string? en) => (isEn && !string.IsNullOrEmpty(en)) ? en : (tr ?? "");
    var masaId = Context.Items.TryGetValue("MasaId", out var masaIdCtxObj)
        && int.TryParse(masaIdCtxObj?.ToString(), out var parsedMasaId)
        ? parsedMasaId
        : 0;
    var masaNo = Context.Items.TryGetValue("MasaNo", out var masaNoObj)
        ? masaNoObj?.ToString()
        : (Context.Items.TryGetValue("MasaId", out var masaIdObj) ? masaIdObj?.ToString() : null);
    if (string.IsNullOrWhiteSpace(masaNo))
    {
        masaNo = Context.Request.Cookies["masa_no"];
    }
}

<!DOCTYPE html>
<html class="light" lang="@(isEn ? "en" : "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>QR Menü</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="~/js/tailwind-config.js" asp-append-version="true"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        body { min-height: 100dvh; }
        /* Stitch modal styles (no Bootstrap needed) */
        .stitch-modal-overlay {
            position: fixed; inset: 0; z-index: 9999;
            background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
            display: flex; align-items: center; justify-content: center;
            padding: 24px; opacity: 0; pointer-events: none; transition: opacity 0.25s;
        }
        .stitch-modal-overlay.active { opacity: 1; pointer-events: auto; }
        .stitch-modal-card {
            background: white; border-radius: 1.5rem; max-width: 480px; width: 100%;
            max-height: 85vh; overflow-y: auto; box-shadow: 0 24px 48px rgba(0,0,0,0.15);
            transform: translateY(20px); transition: transform 0.25s;
        }
        .stitch-modal-overlay.active .stitch-modal-card { transform: translateY(0); }
        .stitch-modal-card::-webkit-scrollbar { display: none; }

        /* Mobile category drawer */
        .category-drawer-overlay {
            position: fixed;
            inset: 0;
            z-index: 80;
            background: rgba(0, 0, 0, 0.35);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }
        .category-drawer-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }
        .category-drawer {
            position: fixed;
            top: 0;
            left: 0;
            z-index: 81;
            width: min(85vw, 340px);
            height: 100dvh;
            background: linear-gradient(180deg, #ffffff 0%, #f8f6f5 100%);
            box-shadow: 8px 0 30px rgba(0, 0, 0, 0.12);
            transform: translateX(-105%);
            transition: transform 0.28s ease;
            overflow-y: auto;
        }
        .category-drawer.active {
            transform: translateX(0);
        }
    </style>
</head>
<body class="bg-background font-body text-on-background selection:bg-primary/20">
    @Html.AntiForgeryToken()
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ═══ TOP APP BAR (Stitch — z-[60]) ═══ -->
    <header class="fixed top-0 w-full z-[60] bg-white/80 backdrop-blur-md">
        <div class="flex justify-between items-center px-4 py-3 w-full max-w-screen-xl mx-auto">
            <div class="flex items-center gap-3">
                <button class="md:hidden p-2 bg-surface-container-low hover:bg-surface-container-high transition-colors rounded-full"
                        onclick="toggleCategoryDrawer()"
                        aria-label="Kategoriler menüsü">
                    <span class="material-symbols-outlined text-orange-800">menu</span>
                </button>
                <span class="material-symbols-outlined text-orange-800 text-2xl" style="font-variation-settings: 'FILL' 1;">restaurant</span>
                <div class="flex flex-col">
                    <h1 class="font-headline font-bold text-base md:text-lg uppercase tracking-tight text-neutral-800 leading-tight">@(L("Kafe Menü", "Cafe Menu"))</h1>
                    @if (!string.IsNullOrWhiteSpace(masaNo))
                    {
                        <span class="font-label text-[11px] md:text-xs font-semibold text-primary">@(L("Masa", "Table")) @masaNo</span>
                    }
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="toggleLang()" class="font-label font-bold text-[11px] md:text-xs bg-surface-container-highest text-on-surface px-3 py-1.5 rounded-full shadow-sm border border-neutral-200 hover:bg-neutral-200 transition-colors">
                    @(isEn ? "TR" : "EN")
                </button>
                <button class="p-2 bg-orange-50 hover:bg-orange-100 transition-colors rounded-full" onclick="callWaiter()">
                    <span class="material-symbols-outlined text-orange-800">notifications_active</span>
                </button>
            </div>
        </div>
    </header>

    <!-- ═══ MOBILE CATEGORY DRAWER ═══ -->
    <div id="categoryDrawerOverlay" class="category-drawer-overlay md:hidden" onclick="closeCategoryDrawer()"></div>
    <aside id="categoryDrawer" class="category-drawer md:hidden" aria-hidden="true">
        <div class="px-5 pt-5 pb-4 flex items-center justify-between border-b border-neutral-200">
            <h3 class="font-headline font-extrabold text-lg text-on-surface">@(L("Kategoriler", "Categories"))</h3>
            <button class="w-10 h-10 rounded-full bg-surface-container-low hover:bg-surface-container-high transition-colors"
                    onclick="closeCategoryDrawer()"
                    aria-label="Kapat">
                <span class="material-symbols-outlined text-on-surface">close</span>
            </button>
        </div>
        <div class="p-4 space-y-2" id="categoryDrawerList">
            @foreach (var cat in kategoriler)
            {
                <button class="category-drawer-item w-full text-left px-4 py-3 rounded-2xl font-headline font-bold text-sm bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high transition-colors"
                        data-cat-id="@cat.Id">
                    @L(cat.Ad, cat.AdEN)
                </button>
            }
        </div>
    </aside>

    <main class="pt-[72px] pb-40 px-6 max-w-screen-xl mx-auto">



        <!-- ═══ HERO SECTION ═══ -->
        <section class="mb-6 mt-4">
            <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface leading-tight mb-4">
                @(L("Kafe Menü", "Cafe Menu"))<br/><span class="text-primary">@(L("Lezzetler", "Flavors"))</span>
            </h2>
            <p class="text-on-surface-variant max-w-md font-medium">@(L("Taze malzemeler, özenle hazırlanmış tarifler.", "Fresh ingredients, carefully crafted recipes."))</p>
            
            @if (isHappyHour)
            {
                <div class="mt-4 inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-red-500 text-white px-4 py-2 rounded-2xl shadow-lg shadow-orange-500/30">
                    <span class="material-symbols-outlined emoji animate-pulse" style="font-variation-settings:'FILL' 1;">celebration</span>
                    <span class="font-headline font-bold">@(isEn ? $"Happy Hour Active! -{hhOran}% Off" : $"Happy Hour Aktif! -%{hhOran} İndirim")</span>
                </div>
            }
        </section>

        <!-- ═══ CATEGORY TABS (Stitch — z-[55] so it stays ABOVE content but BELOW header z-[60]) ═══ -->
        <nav class="hidden md:flex gap-3 overflow-x-auto no-scrollbar pb-6 -mx-6 px-6 sticky top-[72px] z-[55] bg-background/95 backdrop-blur-sm pt-2">
            @for (var i = 0; i < kategoriler.Count; i++)
            {
                var cat = kategoriler[i];
                <button class="category-tab px-6 py-2.5 rounded-full font-headline font-bold text-sm whitespace-nowrap transition-all active:scale-95 @(i == 0 ? "bg-primary text-on-primary shadow-lg shadow-primary/20" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high")"
                        data-cat-id="@cat.Id">
                    @L(cat.Ad, cat.AdEN)
                </button>
            }
        </nav>

        <!-- ═══ MENU GRID (Stitch) ═══ -->
        @foreach (var kategori in kategoriler)
        {
            var urunler = Model.Where(u => u.KategoriId == kategori.Id).ToList();
            if (!urunler.Any()) continue;

            <div class="category-section mb-12" id="cat-@kategori.Id">
                <h2 class="font-headline text-2xl font-extrabold text-on-surface mb-6">@L(kategori.Ad, kategori.AdEN)</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var urun in urunler)
                    {
                        var isSoldOut = !urun.AktifMi;
                        var opsiyonList = urun.UrunOpsiyonlar?.OrderBy(uo => uo.Opsiyon.EkFiyat).Select(uo => new { id = uo.Opsiyon.Id, ad = OptionLocalization.LocalizeOptionText(uo.Opsiyon.Ad, uo.Opsiyon.AdEN, isEn), grup = OptionLocalization.LocalizeOptionText(uo.Opsiyon.Grup, uo.Opsiyon.GrupEN, isEn), ekFiyat = uo.Opsiyon.EkFiyat, zorunlu = uo.Opsiyon.Zorunlu }).ToList() ?? new();
                        var opsiyonJson = System.Text.Json.JsonSerializer.Serialize(opsiyonList);

                        <div class="group relative bg-surface-container-lowest rounded-3xl overflow-hidden transition-all duration-300 hover:shadow-2xl @(isSoldOut ? "opacity-50 pointer-events-none" : "") cursor-pointer"
                             @if(!isSoldOut){ <text>data-href="/Menu/Detay/@urun.Id"</text> }>
                            <div class="aspect-[4/3] w-full overflow-hidden">
                                @if (!string.IsNullOrEmpty(urun.GorselUrl))
                                {
                                    <img alt="@urun.Ad" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="@urun.GorselUrl" />
                                }
                                else
                                {
                                    <div class="w-full h-full bg-gradient-to-br from-surface-container-low to-surface-container flex items-center justify-center text-6xl">
                                        @{
                                            var emoji = "☕";
                                            var katAd = urun.Kategori?.Ad ?? "";
                                            if (katAd.Contains("Soğuk")) emoji = "🧊";
                                            else if (katAd.Contains("Kahvaltı")) emoji = "🍳";
                                            else if (katAd.Contains("Tost")) emoji = "🥪";
                                            else if (katAd.Contains("Burger")) emoji = "🍔";
                                            else if (katAd.Contains("Pizza")) emoji = "🍕";
                                            else if (katAd.Contains("Makarna")) emoji = "🍝";
                                            else if (katAd.Contains("Salata")) emoji = "🥗";
                                            else if (katAd.Contains("Tatlı")) emoji = "🍰";
                                        }
                                        @emoji
                                    </div>
                                }
                            </div>
                            <div class="p-6">
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="font-headline font-bold text-xl text-on-surface leading-tight">@L(urun.Ad, urun.AdEN)</h3>
                                    @{
                                        bool hhGecerli = isHappyHour && (!hhUrunIds.Any() || hhUrunIds.Contains(urun.Id));
                                        decimal gorunenFiyat = hhGecerli ? Math.Round(urun.Fiyat * (1 - hhOran / 100m), 2) : urun.Fiyat;
                                    }
                                    <div class="flex flex-col items-end">
                                        <span class="font-headline font-bold text-primary text-lg whitespace-nowrap ml-3">@gorunenFiyat.ToString("N2") ₺</span>
                                        @if (hhGecerli)
                                        {
                                            <span class="text-xs text-error font-bold line-through">@urun.Fiyat.ToString("N2") ₺</span>
                                        }
                                    </div>
                                </div>
                                <p class="text-on-surface-variant text-sm line-clamp-2 mb-6">@L(urun.Aciklama, urun.AciklamaEN)</p>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-1">
                                        @if (urun.PopulerMi)
                                        {
                                            <span class="material-symbols-outlined text-secondary text-sm" style="font-variation-settings:'FILL' 1;">local_fire_department</span>
                                            <span class="text-xs font-bold text-on-surface">Popüler</span>
                                        }
                                        @if (urun.Kalori.HasValue)
                                        {
                                            <span class="text-xs font-semibold text-on-surface-variant bg-surface-container-low px-2 py-0.5 rounded-full">🔥 @urun.Kalori kcal</span>
                                        }
                                        @if (isSoldOut)
                                        {
                                            <span class="text-xs font-bold text-error">@L("Tükendi", "Sold Out")</span>
                                        }
                                    </div>
                                    @if (!isSoldOut)
                                    {
                                        <button class="btn-add flex items-center justify-center w-10 h-10 rounded-2xl bg-primary text-on-primary hover:bg-primary-dim active:scale-90 transition-all shadow-md shadow-primary/20"
                                                data-urun-id="@urun.Id"
                                                data-urun-ad="@L(urun.Ad, urun.AdEN)"
                                                data-fiyat="@gorunenFiyat.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-orig-fiyat="@urun.Fiyat.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-opsiyonlar="@opsiyonJson">
                                            <span class="material-symbols-outlined">add</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </main>

    <!-- ═══ BOTTOM NAVIGATION BAR (Stitch — 3 tabs) ═══ -->
    <nav class="fixed bottom-0 left-0 w-full flex justify-around items-center px-4 pb-6 pt-3 bg-white shadow-[0_-4px_20px_rgba(0,0,0,0.05)] rounded-t-3xl z-[60]">
        <a class="flex flex-col items-center justify-center bg-orange-100 text-orange-900 rounded-xl px-3 py-1.5 transition-transform active:scale-90" href="/Menu/Index" style="text-decoration:none;">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">restaurant_menu</span>
            <span class="font-body text-[11px] font-semibold mt-1">@(L("Menü", "Menu"))</span>
        </a>
        <a class="flex flex-col items-center justify-center text-neutral-400 px-3 py-1.5 transition-transform active:scale-90" href="/Sepet" style="text-decoration:none;">
            <span class="material-symbols-outlined">shopping_cart</span>
            <span class="font-body text-[11px] font-semibold mt-1">@(L("Sepet", "Cart"))</span>
        </a>
        <a class="flex flex-col items-center justify-center text-neutral-400 px-3 py-1.5 transition-transform active:scale-90" href="/siparislerim" style="text-decoration:none;">
            <span class="material-symbols-outlined">receipt_long</span>
            <span class="font-body text-[11px] font-semibold mt-1">@(L("Siparişlerim", "My Orders"))</span>
        </a>
    </nav>

    <!-- ═══ OPSIYON MODALI (Custom, no Bootstrap) ═══ -->
    <div class="stitch-modal-overlay" id="optionsModal">
        <div class="stitch-modal-card">
            <div class="px-6 pt-6 pb-2 flex justify-between items-center">
                <h5 class="font-headline font-extrabold text-2xl text-on-surface" id="optionsModalTitle">@L("Seçenekler", "Options")</h5>
                <button onclick="closeOptionsModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-neutral-100 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="px-6 pt-2 pb-4" id="optionsModalBody"></div>
            <div class="px-6 pb-6">
                <div id="optionWarning" class="text-error text-sm font-semibold text-center mb-3" style="display:none;">@L("Lütfen tüm zorunlu seçenekleri belirleyin.", "Please select all required options.")</div>
                <button type="button" id="btnAddToCartModal"
                        class="w-full bg-gradient-to-r from-primary to-primary-container text-white h-14 rounded-2xl font-headline font-bold uppercase tracking-widest shadow-lg shadow-primary/20 transition-transform active:scale-[0.98] flex items-center justify-between px-6"
                        onclick="submitOptionsForm()" disabled style="opacity:0.5; border:none; cursor:pointer;">
                    <span>@L("Sepete Ekle", "Add to Cart")</span>
                    <span id="modalTotalPrice" class="opacity-80">0.00 ₺</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ═══ TOAST (Custom) ═══ -->
    <div class="fixed bottom-24 left-1/2 -translate-x-1/2 z-[9999] pointer-events-none" id="toastContainer">
        <div id="toastBildirim" class="bg-primary text-white px-6 py-3 rounded-full shadow-xl font-headline font-semibold text-sm flex items-center gap-2 opacity-0 transition-all duration-300 translate-y-4" style="pointer-events:auto;">
            <span id="toastMesaj"></span>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script type="application/json" id="menu-page-config">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            soldOutLabel = L("Tükendi", "Sold Out"),
            txtNoActiveOrder = L("Henüz aktif bir siparişiniz yok.", "You don't have an active order yet."),
            txtWaiterCalled = L("✅ Garson çağrıldı!", "✅ Waiter has been called!"),
            txtGenericError = L("Hata.", "Error."),
            txtTryAgain = L("⚠️ Tekrar deneyin.", "⚠️ Please try again."),
            txtDiscountedBadge = L("İNDİRİMLİ", "DISCOUNTED"),
            txtRequired = L("Zorunlu", "Required"),
            txtOptional = L("Opsiyonel", "Optional"),
            txtIncluded = L("Dahil", "Included"),
            txtAddedToCart = L("✅ Sepete eklendi!", "✅ Added to cart!"),
            txtConnectionError = L("❌ Bağlantı hatası.", "❌ Connection error."),
            txtUnknownError = L("Hata oluştu.", "An error occurred."),
            txtHappyHourUpdated = L("🎉 Mükemmel! İndirimler güncellendi!", "🎉 Great! Discounts have been updated!"),
            currentTableId = masaId
        }))
    </script>
    <script src="~/js/pages/menu-index.js" asp-append-version="true"></script>
</body>
</html>


