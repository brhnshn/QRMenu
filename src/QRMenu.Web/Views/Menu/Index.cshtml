@model List<QRMenu.Core.Entities.Urun>
@{
    ViewData["Title"] = "Menü";
    Layout = null;
    var kategoriler = Model.Select(u => u.Kategori).DistinctBy(k => k.Id).OrderBy(k => k.SiraNo).ToList();
    (decimal IndirimOrani, int? UrunId)? hhTuple = ViewBag.HappyHour as (decimal IndirimOrani, int? UrunId)?;
    bool isHappyHour = hhTuple.HasValue && hhTuple.Value.IndirimOrani > 0;
    decimal hhOran = isHappyHour ? hhTuple.Value.IndirimOrani : 0;
    int? hhUrunId = isHappyHour ? hhTuple.Value.UrunId : null;
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>QR Menü</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-primary-fixed-variant":"#581200","on-primary":"#ffefec","surface":"#f8f6f5",
                        "on-tertiary-fixed-variant":"#6e6d6d","error-container":"#fb5151","primary":"#a23718",
                        "secondary":"#765600","surface-container-lowest":"#ffffff","on-tertiary-container":"#636262",
                        "on-secondary-container":"#5d4300","surface-tint":"#a23718","surface-variant":"#dedcdc",
                        "surface-container-low":"#f2f0f0","primary-fixed-dim":"#ec6d49","surface-container":"#eae8e7",
                        "outline":"#777776","secondary-container":"#ffca57","on-error":"#ffefee",
                        "surface-bright":"#f8f6f5","on-secondary":"#fff1dc","primary-fixed":"#fd7954",
                        "outline-variant":"#aeadac","on-tertiary":"#f5f2f1","on-surface":"#2e2f2f",
                        "on-primary-container":"#480d00","on-primary-fixed":"#000000","error":"#b31b25",
                        "surface-container-highest":"#dedcdc","inverse-surface":"#0e0e0e","primary-dim":"#922c0c",
                        "on-background":"#2e2f2f","primary-container":"#fd7954","on-surface-variant":"#5c5b5b",
                        "secondary-dim":"#674b00","secondary-fixed-dim":"#f6ba2d",
                        "surface-container-high":"#e4e2e2","surface-dim":"#d5d4d4","background":"#f8f6f5",
                        "tertiary":"#5c5b5b","tertiary-container":"#ffffff","inverse-primary":"#fd7954"
                    },
                    fontFamily: { "headline":["Plus Jakarta Sans"],"body":["Be Vietnam Pro"],"label":["Plus Jakarta Sans"] },
                    borderRadius: {"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","2xl":"1rem","3xl":"1.5rem","full":"9999px"},
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        body { min-height: 100dvh; }
        /* Stitch modal styles (no Bootstrap needed) */
        .stitch-modal-overlay {
            position: fixed; inset: 0; z-index: 9999;
            background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
            display: flex; align-items: center; justify-content: center;
            padding: 24px; opacity: 0; pointer-events: none; transition: opacity 0.25s;
        }
        .stitch-modal-overlay.active { opacity: 1; pointer-events: auto; }
        .stitch-modal-card {
            background: white; border-radius: 1.5rem; max-width: 480px; width: 100%;
            max-height: 85vh; overflow-y: auto; box-shadow: 0 24px 48px rgba(0,0,0,0.15);
            transform: translateY(20px); transition: transform 0.25s;
        }
        .stitch-modal-overlay.active .stitch-modal-card { transform: translateY(0); }
        .stitch-modal-card::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-background font-body text-on-background selection:bg-primary/20">

    <!-- ═══ TOP APP BAR (Stitch — z-[60]) ═══ -->
    <header class="fixed top-0 w-full z-[60] bg-white/80 backdrop-blur-md">
        <div class="flex justify-between items-center px-6 py-4 w-full max-w-screen-xl mx-auto">
            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-orange-800" style="font-variation-settings: 'FILL' 1;">restaurant</span>
                <h1 class="font-headline font-bold text-lg uppercase tracking-tight text-neutral-800">Kafe Menü</h1>
                @if (Context.Items.ContainsKey("MasaId"))
                {
                    <span class="font-label text-sm font-semibold text-on-surface-variant bg-surface-container-low px-3 py-1.5 rounded-full">Masa @Context.Items["MasaId"]</span>
                }
            </div>
            <div class="flex items-center gap-2">
                <button class="p-2 hover:bg-neutral-100 transition-colors rounded-full" onclick="callWaiter()">
                    <span class="material-symbols-outlined text-orange-800">notifications_active</span>
                </button>
            </div>
        </div>
    </header>

    <main class="pt-[72px] pb-40 px-6 max-w-screen-xl mx-auto">



        <!-- ═══ HERO SECTION ═══ -->
        <section class="mb-6 mt-4">
            <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface leading-tight mb-4">
                Kafe Menü<br/><span class="text-primary">Lezzetler</span>
            </h2>
            <p class="text-on-surface-variant max-w-md font-medium">Taze malzemeler, özenle hazırlanmış tarifler.</p>
            
            @if (isHappyHour)
            {
                <div class="mt-4 inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-red-500 text-white px-4 py-2 rounded-2xl shadow-lg shadow-orange-500/30">
                    <span class="material-symbols-outlined emoji animate-pulse" style="font-variation-settings:'FILL' 1;">celebration</span>
                    <span class="font-headline font-bold">Happy Hour Aktif! -%@hhOran İndirim</span>
                </div>
            }
        </section>

        <!-- ═══ CATEGORY TABS (Stitch — z-[55] so it stays ABOVE content but BELOW header z-[60]) ═══ -->
        <nav class="flex gap-3 overflow-x-auto no-scrollbar pb-6 -mx-6 px-6 sticky top-[72px] z-[55] bg-background/95 backdrop-blur-sm pt-2">
            @for (var i = 0; i < kategoriler.Count; i++)
            {
                var cat = kategoriler[i];
                <button class="category-tab px-6 py-2.5 rounded-full font-headline font-bold text-sm whitespace-nowrap transition-all active:scale-95 @(i == 0 ? "bg-primary text-on-primary shadow-lg shadow-primary/20" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high")"
                        data-cat-id="@cat.Id">
                    @cat.Ad
                </button>
            }
        </nav>

        <!-- ═══ MENU GRID (Stitch) ═══ -->
        @foreach (var kategori in kategoriler)
        {
            var urunler = Model.Where(u => u.KategoriId == kategori.Id).ToList();
            if (!urunler.Any()) continue;

            <div class="category-section mb-12" id="cat-@kategori.Id">
                <h2 class="font-headline text-2xl font-extrabold text-on-surface mb-6">@kategori.Ad</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var urun in urunler)
                    {
                        var isSoldOut = !urun.AktifMi;
                        var opsiyonList = urun.UrunOpsiyonlar?.OrderBy(uo => uo.Opsiyon.EkFiyat).Select(uo => new { id = uo.Opsiyon.Id, ad = uo.Opsiyon.Ad, grup = uo.Opsiyon.Grup, ekFiyat = uo.Opsiyon.EkFiyat, zorunlu = uo.Opsiyon.Zorunlu }).ToList() ?? new();
                        var opsiyonJson = System.Text.Json.JsonSerializer.Serialize(opsiyonList);

                        <div class="group relative bg-surface-container-lowest rounded-3xl overflow-hidden transition-all duration-300 hover:shadow-2xl @(isSoldOut ? "opacity-50 pointer-events-none" : "") cursor-pointer"
                             @if(!isSoldOut){ <text>data-href="/Menu/Detay/@urun.Id"</text> }>
                            <div class="aspect-[4/3] w-full overflow-hidden">
                                @if (!string.IsNullOrEmpty(urun.GorselUrl))
                                {
                                    <img alt="@urun.Ad" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="@urun.GorselUrl" />
                                }
                                else
                                {
                                    <div class="w-full h-full bg-gradient-to-br from-surface-container-low to-surface-container flex items-center justify-center text-6xl">
                                        @{
                                            var emoji = "☕";
                                            var katAd = urun.Kategori?.Ad ?? "";
                                            if (katAd.Contains("Soğuk")) emoji = "🧊";
                                            else if (katAd.Contains("Kahvaltı")) emoji = "🍳";
                                            else if (katAd.Contains("Tost")) emoji = "🥪";
                                            else if (katAd.Contains("Burger")) emoji = "🍔";
                                            else if (katAd.Contains("Pizza")) emoji = "🍕";
                                            else if (katAd.Contains("Makarna")) emoji = "🍝";
                                            else if (katAd.Contains("Salata")) emoji = "🥗";
                                            else if (katAd.Contains("Tatlı")) emoji = "🍰";
                                        }
                                        @emoji
                                    </div>
                                }
                            </div>
                            <div class="p-6">
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="font-headline font-bold text-xl text-on-surface leading-tight">@urun.Ad</h3>
                                    @{
                                        bool hhGecerli = isHappyHour && (!hhUrunId.HasValue || hhUrunId.Value == urun.Id);
                                        decimal gorunenFiyat = hhGecerli ? Math.Round(urun.Fiyat * (1 - hhOran / 100m), 2) : urun.Fiyat;
                                    }
                                    <div class="flex flex-col items-end">
                                        <span class="font-headline font-bold text-primary text-lg whitespace-nowrap ml-3">@gorunenFiyat.ToString("N2") ₺</span>
                                        @if (hhGecerli)
                                        {
                                            <span class="text-xs text-error font-bold line-through">@urun.Fiyat.ToString("N2") ₺</span>
                                        }
                                    </div>
                                </div>
                                <p class="text-on-surface-variant text-sm line-clamp-2 mb-6">@urun.Aciklama</p>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-1">
                                        @if (urun.PopulerMi)
                                        {
                                            <span class="material-symbols-outlined text-secondary text-sm" style="font-variation-settings:'FILL' 1;">local_fire_department</span>
                                            <span class="text-xs font-bold text-on-surface">Popüler</span>
                                        }
                                        @if (urun.Kalori.HasValue)
                                        {
                                            <span class="text-xs font-semibold text-on-surface-variant bg-surface-container-low px-2 py-0.5 rounded-full">🔥 @urun.Kalori kcal</span>
                                        }
                                        @if (isSoldOut)
                                        {
                                            <span class="text-xs font-bold text-error">Tükendi</span>
                                        }
                                    </div>
                                    @if (!isSoldOut)
                                    {
                                        <button class="btn-add flex items-center justify-center w-10 h-10 rounded-2xl bg-primary text-on-primary hover:bg-primary-dim active:scale-90 transition-all shadow-md shadow-primary/20"
                                                data-urun-id="@urun.Id"
                                                data-urun-ad="@urun.Ad"
                                                data-fiyat="@gorunenFiyat.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-orig-fiyat="@urun.Fiyat.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-opsiyonlar='@Html.Raw(opsiyonJson)'>
                                            <span class="material-symbols-outlined">add</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </main>

    <!-- ═══ BOTTOM NAVIGATION BAR (Stitch — 3 tabs) ═══ -->
    <nav class="fixed bottom-0 left-0 w-full flex justify-around items-center px-4 pb-6 pt-3 bg-white shadow-[0_-4px_20px_rgba(0,0,0,0.05)] rounded-t-3xl z-[60]">
        <a class="flex flex-col items-center justify-center bg-orange-100 text-orange-900 rounded-xl px-3 py-1.5 transition-transform active:scale-90" href="/Menu/Index" style="text-decoration:none;">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">restaurant_menu</span>
            <span class="font-body text-[11px] font-semibold mt-1">Menü</span>
        </a>
        <a class="flex flex-col items-center justify-center text-neutral-400 px-3 py-1.5 transition-transform active:scale-90" href="/Sepet" style="text-decoration:none;">
            <span class="material-symbols-outlined">shopping_cart</span>
            <span class="font-body text-[11px] font-semibold mt-1">Sepet</span>
        </a>
        <a class="flex flex-col items-center justify-center text-neutral-400 px-3 py-1.5 transition-transform active:scale-90" href="/siparislerim" style="text-decoration:none;">
            <span class="material-symbols-outlined">receipt_long</span>
            <span class="font-body text-[11px] font-semibold mt-1">Siparişlerim</span>
        </a>
    </nav>

    <!-- ═══ OPSIYON MODALI (Custom, no Bootstrap) ═══ -->
    <div class="stitch-modal-overlay" id="optionsModal">
        <div class="stitch-modal-card">
            <div class="px-6 pt-6 pb-2 flex justify-between items-center">
                <h5 class="font-headline font-extrabold text-2xl text-on-surface" id="optionsModalTitle">Seçenekler</h5>
                <button onclick="closeOptionsModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-neutral-100 transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="px-6 pt-2 pb-4" id="optionsModalBody"></div>
            <div class="px-6 pb-6">
                <div id="optionWarning" class="text-error text-sm font-semibold text-center mb-3" style="display:none;">Lütfen tüm zorunlu seçenekleri belirleyin.</div>
                <button type="button" id="btnAddToCartModal"
                        class="w-full bg-gradient-to-r from-primary to-primary-container text-white h-14 rounded-2xl font-headline font-bold uppercase tracking-widest shadow-lg shadow-primary/20 transition-transform active:scale-[0.98] flex items-center justify-between px-6"
                        onclick="submitOptionsForm()" disabled style="opacity:0.5; border:none; cursor:pointer;">
                    <span>Sepete Ekle</span>
                    <span id="modalTotalPrice" class="opacity-80">0.00 ₺</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ═══ TOAST (Custom) ═══ -->
    <div class="fixed bottom-24 left-1/2 -translate-x-1/2 z-[9999] pointer-events-none" id="toastContainer">
        <div id="toastBildirim" class="bg-primary text-white px-6 py-3 rounded-2xl shadow-xl font-headline font-semibold text-sm flex items-center gap-2 opacity-0 transition-all duration-300 translate-y-4" style="pointer-events:auto;">
            <span id="toastMesaj"></span>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // ===== UTILITY =====
        function scrollToTracker() {
            const el = document.getElementById('orderTracker');
            if (el && el.style.display !== 'none') {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
                alert('Henüz aktif bir siparişiniz yok.');
            }
        }

        // ===== TOAST (Custom, no Bootstrap) =====
        function showToast(msg, isError) {
            const el = document.getElementById('toastBildirim');
            el.className = 'px-6 py-3 rounded-2xl shadow-xl font-headline font-semibold text-sm flex items-center gap-2 transition-all duration-300 text-white ' + (isError ? 'bg-error' : 'bg-primary');
            document.getElementById('toastMesaj').textContent = msg;
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
            setTimeout(() => { el.style.opacity = '0'; el.style.transform = 'translateY(16px)'; }, 3000);
        }

        // ===== CATEGORY SCROLL =====
        let scrollObserver = null;

        function setupScrollObserver() {
            if (scrollObserver) scrollObserver.disconnect();
            const tabs = document.querySelectorAll('.category-tab');
            const sections = document.querySelectorAll('.category-section');

            scrollObserver = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        var catId = entry.target.id.replace('cat-', '');
                        tabs.forEach(function(t) {
                            t.classList.remove('bg-primary', 'text-on-primary', 'shadow-lg', 'shadow-primary/20');
                            t.classList.add('bg-surface-container-low', 'text-on-surface-variant');
                        });
                        var matchingTab = document.querySelector('.category-tab[data-cat-id="' + catId + '"]');
                        if (matchingTab) {
                            matchingTab.classList.remove('bg-surface-container-low', 'text-on-surface-variant');
                            matchingTab.classList.add('bg-primary', 'text-on-primary', 'shadow-lg', 'shadow-primary/20');
                            matchingTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                        }
                    }
                });
            }, { rootMargin: '-140px 0px -60% 0px', threshold: 0 });

            sections.forEach(function(s) { scrollObserver.observe(s); });
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.category-tab').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var catId = this.getAttribute('data-cat-id');
                    var section = document.getElementById('cat-' + catId);
                    if (!section) return;
                    document.querySelectorAll('.category-tab').forEach(function(t) {
                        t.classList.remove('bg-primary', 'text-on-primary', 'shadow-lg', 'shadow-primary/20');
                        t.classList.add('bg-surface-container-low', 'text-on-surface-variant');
                    });
                    this.classList.remove('bg-surface-container-low', 'text-on-surface-variant');
                    this.classList.add('bg-primary', 'text-on-primary', 'shadow-lg', 'shadow-primary/20');
                    var y = section.getBoundingClientRect().top + window.pageYOffset - 140;
                    window.scrollTo({ top: y, behavior: 'smooth' });
                });
            });
            setupScrollObserver();
        });

        // ===== GARSON =====
        async function callWaiter() {
            try {
                const res = await fetch('/siparis/garson-cagir', { method: 'POST' });
                const data = await res.json();
                if (data.success) showToast('✅ Garson çağrıldı!');
                else showToast('⚠️ ' + (data.message || 'Hata.'), true);
            } catch(e) { showToast('⚠️ Tekrar deneyin.', true); }
        }

        // ===== SEPETE EKLEME =====
        let currentUrunId = 0, baseFiyat = 0, requiredGroups = [];

        // Attach click handlers directly to each .btn-add button
        function setupAddButtons() {
            document.querySelectorAll('.btn-add').forEach(function(btn) {
                btn.onclick = function(e) {
                    e.stopPropagation();
                    e.preventDefault();
                    handleAddClick(btn);
                };
            });
        }

        let lastClickedBtn = null;

        function handleAddClick(btn) {
            lastClickedBtn = btn;
            const urunId = parseInt(btn.dataset.urunId);
            const urunAd = btn.dataset.urunAd;
            const fiyat = parseFloat(btn.dataset.fiyat);
            let opsiyonlar = [];
            try { opsiyonlar = JSON.parse(btn.dataset.opsiyonlar || '[]'); } catch(_) {}

            if (!opsiyonlar || opsiyonlar.length === 0) {
                postAddToCart(urunId, 1, []);
                return;
            }

            // Happy Hour check
            const origFiyat = parseFloat(btn.getAttribute('data-orig-fiyat') || fiyat);
            const isHH = fiyat < origFiyat;

            // Show options modal
            currentUrunId = urunId;
            baseFiyat = fiyat;
            document.getElementById('optionsModalTitle').innerHTML = urunAd + (isHH ? ' <span class="text-xs bg-primary text-white px-2 py-0.5 rounded-full ml-2">İNDİRİMLİ</span>' : '');
            const body = document.getElementById('optionsModalBody');
            body.innerHTML = '';

            const gruplar = {};
            opsiyonlar.forEach(o => { if (!gruplar[o.grup]) gruplar[o.grup] = []; gruplar[o.grup].push(o); });
            requiredGroups = [];

            for (const [grupAdi, opsList] of Object.entries(gruplar)) {
                const isZorunlu = opsList[0].zorunlu === true;
                const isMulti = !isZorunlu;
                const barColor = isZorunlu ? 'bg-secondary' : 'bg-outline-variant';
                const tag = isZorunlu ? '<span class="text-error text-xs font-bold">(Zorunlu)</span>' : '<span class="text-on-surface-variant text-xs">(Opsiyonel)</span>';
                const nameAttr = isMulti ? '' : 'grup_' + grupAdi.replace(/\s+/g, '');
                if (!isMulti) requiredGroups.push(nameAttr);

                let html = `<div class="mb-6"><div class="flex items-center gap-3 mb-4"><span class="w-1 h-6 ${barColor} rounded-full"></span><h3 class="font-headline font-bold text-xl uppercase tracking-tighter">${grupAdi} ${tag}</h3></div><div class="grid gap-3">`;

                opsList.forEach(ops => {
                    const id = 'ops_' + ops.id;
                    const inputType = isMulti ? 'checkbox' : 'radio';
                    const inputName = isMulti ? id : nameAttr;
                    const priceStr = ops.ekFiyat > 0
                        ? `<span class="font-headline font-bold text-secondary">+${ops.ekFiyat.toFixed(2)} ₺</span>`
                        : `<span class="font-label text-xs uppercase text-on-surface-variant font-bold">Dahil</span>`;

                    html += `<label class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container-high transition-colors" for="${id}">
                        <div class="flex items-center gap-4">
                            <div class="relative flex items-center">
                                <input class="option-input peer h-6 w-6 rounded border-outline-variant text-primary focus:ring-primary/20 cursor-pointer appearance-none border-2 checked:bg-primary checked:border-primary" type="${inputType}" name="${inputName}" id="${id}" value="${ops.id}" data-price="${ops.ekFiyat}" onchange="updateModalPrice()">
                                <span class="material-symbols-outlined absolute text-white opacity-0 peer-checked:opacity-100 pointer-events-none text-sm left-1" style="font-variation-settings:'wght' 700;">check</span>
                            </div>
                            <span class="font-semibold text-on-surface">${ops.ad}</span>
                        </div>
                        ${priceStr}
                    </label>`;
                });

                html += '</div></div>';
                body.innerHTML += html;
            }
            updateModalPrice();
            document.getElementById('optionsModal').classList.add('active');
        }

        document.addEventListener('DOMContentLoaded', function() {
            setupAddButtons();
            // Card click → navigate to detail page
            document.querySelectorAll('[data-href]').forEach(function(card) {
                card.addEventListener('click', function() {
                    window.location.href = card.dataset.href;
                });
            });
        });

        function closeOptionsModal() {
            document.getElementById('optionsModal').classList.remove('active');
        }

        function updateModalPrice() {
            let toplam = baseFiyat; // baseFiyat zaten indirimli ürün fiyatı
            document.querySelectorAll('.option-input:checked').forEach(input => { 
                toplam += parseFloat(input.dataset.price); // Opsiyonları indirimsiz (tam fiyat) ekle
            });
            document.getElementById('modalTotalPrice').textContent = toplam.toFixed(2) + ' ₺';
            const btn = document.getElementById('btnAddToCartModal');
            const warning = document.getElementById('optionWarning');
            let allSelected = true;
            requiredGroups.forEach(grpName => { if (!document.querySelector('input[name="' + grpName + '"]:checked')) allSelected = false; });
            btn.disabled = !allSelected;
            btn.style.opacity = allSelected ? '1' : '0.5';
            warning.style.display = allSelected ? 'none' : 'block';
        }

        function submitOptionsForm() {
            const selectedOps = [];
            document.querySelectorAll('.option-input:checked').forEach(input => { selectedOps.push(parseInt(input.value)); });
            postAddToCart(currentUrunId, 1, selectedOps);
            closeOptionsModal();
        }

        async function postAddToCart(urunId, adet, opsiyonIds) {
            // Show spinner on the + button
            const btn = lastClickedBtn;
            let origHTML = '';
            if (btn) {
                origHTML = btn.innerHTML;
                btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-lg">progress_activity</span>';
                btn.disabled = true;
                btn.style.pointerEvents = 'none';
            }
            try {
                const response = await fetch('/sepet/ekle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ UrunId: urunId, Adet: adet, OpsiyonIds: opsiyonIds })
                });
                const data = await response.json();
                if (data.success) {
                    // Checkmark animation
                    if (btn) {
                        btn.innerHTML = '<span class="material-symbols-outlined text-lg" style="font-variation-settings:\'FILL\' 1;">check</span>';
                        btn.classList.remove('bg-primary'); btn.classList.add('bg-green-600');
                        setTimeout(() => { btn.innerHTML = origHTML; btn.disabled = false; btn.style.pointerEvents = ''; btn.classList.remove('bg-green-600'); btn.classList.add('bg-primary'); }, 1200);
                    }
                    showToast('✅ Sepete eklendi!');
                } else {
                    if (btn) { btn.innerHTML = origHTML; btn.disabled = false; btn.style.pointerEvents = ''; }
                    showToast('❌ ' + (data.message || 'Hata oluştu.'), true);
                }
            } catch (err) {
                console.error(err);
                if (btn) { btn.innerHTML = origHTML; btn.disabled = false; btn.style.pointerEvents = ''; }
                showToast('❌ Bağlantı hatası.', true);
            }
            lastClickedBtn = null;
        }

        // ===== SIGNALR =====
        const menuConnection = new signalR.HubConnectionBuilder().withUrl('/hubs/menu').withAutomaticReconnect([0,2000,5000,10000,30000]).build();

        menuConnection.on('HappyHourGuncellendi', async function() {
            try { const res = await fetch('/menu/json'); triggerYenidenCiz(await res.json()); showToast("🎉 Mükemmel! İndirimler güncellendi!"); } catch(e) { console.error(e); }
        });

        menuConnection.on('MenuGuncellendi', async function() {
            try { const res = await fetch('/menu/json'); triggerYenidenCiz(await res.json()); } catch(e) { console.error(e); }
        });

        function triggerYenidenCiz(data) {
            yenidenCiz(data.kategoriler, data.happyHour);
        }

        function yenidenCiz(kategoriler, happyHour) {
            const tabScroll = document.querySelector('nav.sticky');
            if (!tabScroll) return;
            tabScroll.innerHTML = '';
            kategoriler.forEach(function(kat, i) {
                const btn = document.createElement('button');
                btn.className = 'category-tab px-6 py-2.5 rounded-full font-headline font-bold text-sm whitespace-nowrap transition-all active:scale-95 ' + (i === 0 ? 'bg-primary text-on-primary shadow-lg shadow-primary/20' : 'bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high');
                btn.setAttribute('data-cat-id', kat.id);
                btn.textContent = kat.ad;
                btn.addEventListener('click', function() {
                    tabScroll.querySelectorAll('.category-tab').forEach(t => { t.classList.remove('bg-primary','text-on-primary','shadow-lg','shadow-primary/20'); t.classList.add('bg-surface-container-low','text-on-surface-variant'); });
                    btn.classList.remove('bg-surface-container-low','text-on-surface-variant'); btn.classList.add('bg-primary','text-on-primary','shadow-lg','shadow-primary/20');
                    const sec = document.getElementById('cat-' + kat.id);
                    if (sec) window.scrollTo({ top: sec.getBoundingClientRect().top + window.pageYOffset - 140, behavior: 'smooth' });
                });
                tabScroll.appendChild(btn);
            });

            document.querySelectorAll('.category-section').forEach(el => el.remove());
            const main = document.querySelector('main');
            kategoriler.forEach(function(kat) {
                if (!kat.urunler || kat.urunler.length === 0) return;
                const section = document.createElement('div');
                section.className = 'category-section mb-12';
                section.id = 'cat-' + kat.id;
                let html = '<h2 class="font-headline text-2xl font-extrabold text-on-surface mb-6">' + escapeHtml(kat.ad) + '</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">';
                kat.urunler.forEach(function(urun) {
                    const isSoldOut = !urun.aktifMi;
                    let bFiyat = urun.fiyat;
                    let hhGecerli = happyHour != null && (!happyHour.urunId || happyHour.urunId == urun.id);
                    if (hhGecerli) {
                        bFiyat = Math.round(bFiyat * (1 - happyHour.indirimOrani / 100) * 100) / 100;
                    }
                    const fiyatStr = urun.fiyat.toFixed(2);
                    const gorunenFiyatStr = bFiyat.toFixed(2);
                    const cardClick = isSoldOut ? '' : ` onclick="window.location.href='/Menu/Detay/${urun.id}'"`;
                    html += `<div class="group relative bg-surface-container-lowest rounded-3xl overflow-hidden transition-all duration-300 hover:shadow-2xl ${isSoldOut ? 'opacity-50 pointer-events-none' : ''} cursor-pointer"${cardClick}>`;
                    html += '<div class="aspect-[4/3] w-full overflow-hidden">';
                    if (urun.gorselUrl) html += `<img alt="${escapeHtml(urun.ad)}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="${escapeHtml(urun.gorselUrl)}" />`;
                    else html += '<div class="w-full h-full bg-gradient-to-br from-surface-container-low to-surface-container flex items-center justify-center text-6xl">☕</div>';
                    html += '</div><div class="p-6">';
                    html += `<div class="flex justify-between items-start mb-2"><h3 class="font-headline font-bold text-xl text-on-surface leading-tight">${escapeHtml(urun.ad)}</h3>`;
                    
                    html += `<div class="flex flex-col items-end"><span class="font-headline font-bold text-primary text-lg whitespace-nowrap ml-3">${gorunenFiyatStr} ₺</span>`;
                    if(hhGecerli) { html += `<span class="text-xs text-error font-bold line-through">${fiyatStr} ₺</span>`; }
                    html += `</div></div>`;
                    
                    html += `<p class="text-on-surface-variant text-sm line-clamp-2 mb-6">${escapeHtml(urun.aciklama || '')}</p>`;
                    html += '<div class="flex items-center justify-between"><div class="flex items-center gap-1">';
                    if (urun.populerMi) html += '<span class="material-symbols-outlined text-secondary text-sm" style="font-variation-settings:\'FILL\' 1;">local_fire_department</span><span class="text-xs font-bold text-on-surface">Popüler</span>';
                    if (urun.kalori) html += `<span class="text-xs font-semibold text-on-surface-variant bg-surface-container-low px-2 py-0.5 rounded-full">🔥 ${urun.kalori} kcal</span>`;
                    if (isSoldOut) html += '<span class="text-xs font-bold text-error">Tükendi</span>';
                    html += '</div>';
                    if (!isSoldOut) {
                        const opsAttr = JSON.stringify(urun.opsiyonlar || []).replace(/'/g, '&#39;');
                        html += `<button class="btn-add flex items-center justify-center w-10 h-10 rounded-2xl bg-primary text-on-primary hover:bg-primary-dim active:scale-90 transition-all shadow-md shadow-primary/20" 
                                    data-urun-id="${urun.id}" 
                                    data-urun-ad="${escapeHtml(urun.ad)}" 
                                    data-fiyat="${gorunenFiyatStr}" 
                                    data-orig-fiyat="${fiyatStr}"
                                    data-opsiyonlar='${opsAttr}'>
                                    <span class="material-symbols-outlined">add</span>
                                 </button>`;
                    }
                    html += '</div></div></div>';
                });
                html += '</div>';
                section.innerHTML = html;
                main.appendChild(section);
            });
            setupScrollObserver();
            setupAddButtons();
        }

        function escapeHtml(str) { if (!str) return ''; const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }
        menuConnection.start().catch(err => console.error('SignalR:', err));


    </script>
</body>
</html>
