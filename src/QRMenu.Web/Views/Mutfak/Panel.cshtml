@model List<QRMenu.Core.Entities.Siparis>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Mutfak KDS";
    ViewData["ActivePage"] = "MutfakPaneli";
    ViewData["PageTitle"] = "Mutfak Ekranı (KDS)";

    string? MusteriNotunuAyikla(string? notlar)
    {
        if (string.IsNullOrWhiteSpace(notlar)) return null;

        var trimmed = notlar.Trim();
        var parts = trimmed.Split('|', 2, StringSplitOptions.TrimEntries);
        if (parts.Length == 2 && !string.IsNullOrWhiteSpace(parts[1]))
            return parts[1];

        if (trimmed.StartsWith("🎉 Happy Hour", StringComparison.OrdinalIgnoreCase))
            return null;

        return trimmed;
    }
}

@section Styles {
    <style>
        .admin-content {
            min-height: 100vh;
            margin-top: 56px !important;
            background:
                radial-gradient(circle at 10% 12%, rgba(245, 158, 11, 0.16), transparent 26%),
                radial-gradient(circle at 84% 88%, rgba(248, 113, 113, 0.18), transparent 30%),
                linear-gradient(150deg, #0b1220, #111b2e 55%, #13203a);
        }

        .ticket-grid {
            padding: 20px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
            align-items: start;
            animation: kdsFadeIn 0.45s ease;
        }

        @@keyframes kdsFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .ticket-card {
            background: #ffffff;
            color: #0f172a;
            border-radius: 16px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 14px 28px rgba(0, 0, 0, 0.32);
            border: 2px solid #dbe4f1;
            transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
        }
        .ticket-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 36px rgba(0, 0, 0, 0.36);
        }
        .ticket-header {
            border-bottom: 2px dashed #cbd5e1;
            padding-bottom: 12px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        .masa-badge {
            background: linear-gradient(180deg, #1e293b, #0f172a);
            color: #f8fafc;
            font-size: 1.45rem;
            font-weight: 900;
            padding: 6px 12px;
            border-radius: 10px;
            letter-spacing: 0.02em;
        }
        .timer-badge {
            font-size: 1.15rem;
            font-weight: 900;
            padding: 4px 10px;
            border-radius: 8px;
            background: #f1f5f9;
            color: #334155;
        }
        
        .urun-list { flex: 1; margin-bottom: 15px; }
        .urun-row { font-size: 1.3rem; font-weight: 800; padding-bottom: 8px; margin-bottom: 8px; border-bottom: 1px solid #f1f5f9; }
        .urun-row:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
        .opsiyon-text { font-size: 0.95rem; font-weight: 600; color: #ef4444; margin-left: 24px; display: block; }

        .musteri-notu {
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 12px;
        }
        .musteri-notu-title {
            display: block;
            font-size: 0.72rem;
            font-weight: 900;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 2px;
        }
        .musteri-notu-text {
            font-size: 0.95rem;
            font-weight: 700;
            white-space: pre-line;
        }
        
        .action-btns { display: flex; gap: 8px; margin-top: auto; }
        .action-btns button { flex: 1; font-weight: 800; padding: 12px; font-size: 1.1rem; }

        /* Zaman Sınırları ve Animasyonlar */
        .ticket-danger {
            border-color: #ef4444;
            background: linear-gradient(180deg, #ffffff, #fff7f7);
            animation: pulseRed 2s infinite;
        }
        .ticket-danger .timer-badge { background: #fee2e2; color: #b91c1c; }

        @@keyframes pulseRed {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        #clock { font-family: monospace; }

        @@media (max-width: 768px) {
            .ticket-grid {
                grid-template-columns: 1fr;
                padding: 12px;
                gap: 14px;
            }

            .masa-badge {
                font-size: 1.2rem;
            }

            .urun-row {
                font-size: 1.1rem;
            }
        }
    </style>
}

<!-- Alarm sesi (gizli) -->
<audio id="bellSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

<div class="ticket-grid" id="kdsGrid">
    @if(Model != null && Model.Any())
    {
        foreach (var siparis in Model)
        {
            var musteriNotu = MusteriNotunuAyikla(siparis.Notlar);

            <div class="ticket-card shadow-sm" data-id="@siparis.Id" data-tarih="@siparis.OlusturmaTarihi.ToString("o")">
                <div class="ticket-header">
                    <div class="masa-badge">Masa @siparis.Masa.MasaNo</div>
                    <div class="timer-badge timer-text">00:00</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(musteriNotu))
                {
                    <div class="musteri-notu">
                        <span class="musteri-notu-title">Müşteri Notu</span>
                        <span class="musteri-notu-text">@musteriNotu</span>
                    </div>
                }
                <div class="urun-list">
                    @foreach(var detay in siparis.SiparisDetaylar.Where(d => d.Durum == QRMenu.Core.Enums.SiparisDurum.Onaylandi || d.Durum == QRMenu.Core.Enums.SiparisDurum.Hazirlaniyor))
                    {
                        <div class="urun-row">
                            <span class="text-primary">@detay.Adet x</span> @detay.Urun.Ad
                            @if(!string.IsNullOrEmpty(detay.SeciliOpsiyonlar) && detay.SeciliOpsiyonlar != "[]")
                            {
                                var optStr = "";
                                try {
                                    var opsJson = System.Text.Json.JsonDocument.Parse(detay.SeciliOpsiyonlar);
                                    var opsList = new System.Collections.Generic.List<string>();
                                    foreach(var ops in opsJson.RootElement.EnumerateArray()) {
                                        opsList.Add(ops.GetProperty("Ad").GetString() ?? "");
                                    }
                                    optStr = string.Join(", ", opsList);
                                } catch {}
                                <span class="opsiyon-text">@optStr</span>
                            }
                        </div>
                    }
                </div>
                <div class="action-btns">
                    @if (siparis.Durum == QRMenu.Core.Enums.SiparisDurum.Onaylandi)
                    {
                        <button class="btn btn-warning" onclick="durumGuncelle(@siparis.Id, 'Hazirlaniyor')">
                            <i class="bi bi-fire"></i> Hazırlanıyor
                        </button>
                    }
                    else if (siparis.Durum == QRMenu.Core.Enums.SiparisDurum.Hazirlaniyor)
                    {
                        <button class="btn btn-success" onclick="durumGuncelle(@siparis.Id, 'Hazir')">
                            <i class="bi bi-check-circle-fill"></i> Hazır
                        </button>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-muted py-5" style="grid-column: 1 / -1;">
            <i class="bi bi-cup-hot" style="font-size: 5rem; color: #334155;"></i>
            <h3 class="mt-3 text-white">Şu an bekleyen sipariş yok. Elinize sağlık!</h3>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Timer Hesaplamaları (5 dakikayı geçenler kırmızı)
        function updateTimers() {
            const cards = document.querySelectorAll('.ticket-card');
            const now = new Date();

            cards.forEach(card => {
                const tarihStr = card.getAttribute('data-tarih');
                const pDate = new Date(tarihStr);
                
                // .NET 'o' formatı (ISO 8601) gönderdiği için JS Date() bunu doğru anlar.
                // Timezone farkını manuel eklemeye gerek yok, (now - pDate) ms cinsinden mutlak farktır.
                const diffMs = now - pDate;
                if(diffMs < 0) return;

                const diffSec = Math.floor(diffMs / 1000);
                const mins = Math.floor(diffSec / 60);
                const secs = diffSec % 60;
                
                card.querySelector('.timer-text').innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                card.classList.remove('ticket-danger');

                if (diffMs > (5 * 60 * 1000)) {
                    card.classList.add('ticket-danger');
                }
            });
        }
        
        setInterval(updateTimers, 1000);
        updateTimers();

        let refreshTimer = null;
        let lastRefreshAt = 0;
        let refreshInFlight = false;

        async function softRefreshKdsGrid() {
            if (refreshInFlight) return;
            refreshInFlight = true;

            try {
                const res = await fetch(window.location.pathname, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('KDS verisi alınamadı.');

                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const yeniGrid = doc.getElementById('kdsGrid');
                const mevcutGrid = document.getElementById('kdsGrid');

                if (yeniGrid && mevcutGrid) {
                    mevcutGrid.innerHTML = yeniGrid.innerHTML;
                    updateTimers();
                }
            } catch (err) {
                console.error(err);
                location.reload();
            } finally {
                refreshInFlight = false;
            }
        }

        function scheduleSoftRefresh(delayMs = 500) {
            const minIntervalMs = 2000;
            const elapsed = Date.now() - lastRefreshAt;
            const waitMs = Math.max(delayMs, minIntervalMs - elapsed);

            if (refreshTimer) return;

            refreshTimer = setTimeout(async () => {
                refreshTimer = null;
                lastRefreshAt = Date.now();
                await softRefreshKdsGrid();
            }, Math.max(0, waitMs));
        }

        async function durumGuncelle(siparisId, durum) {
            const payload = { yeniDurum: durum };
            const res = await fetch(`/Mutfak/DurumGuncelle/${siparisId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if(data.success) {
                // SignalR zaten tetiklendiği için reload yeterli veya otomatik yenilenir
                scheduleSoftRefresh(100);
            } else {
                alert("Durum güncellenirken hata: " + data.message);
            }
        }

        // SignalR Entegrasyonu
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/order")
            .withAutomaticReconnect()
            .build();

        connection.on("SiparisGeldi", function () {
            document.getElementById('bellSound').play().catch(e => console.log('Ses çalma hatası:', e));
            scheduleSoftRefresh(900);
        });

        connection.on("SiparisEklendi", function () {
            document.getElementById('bellSound').play().catch(e => console.log('Ses çalma hatası:', e));
            scheduleSoftRefresh(900);
        });

        connection.on("SiparisGuncellendi", function () {
            scheduleSoftRefresh(500);
        });

        connection.start().then(() => {
            console.log("KDS Bağlantısı başarılı.");
        }).catch(err => console.error("SignalR KDS Hatası:", err));
    </script>
}
