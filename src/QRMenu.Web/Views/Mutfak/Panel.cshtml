@using System.Text.Json
@using QRMenu.Core.Enums
@model List<QRMenu.Core.Entities.Siparis>
@{
    Layout = "~/Views/Shared/_MutfakLayout.cshtml";
    ViewData["Title"] = "Mutfak KDS";
    ViewData["ActivePage"] = "MutfakPaneli";
    ViewData["PageTitle"] = "Mutfak Ekranı (KDS)";
    ViewData["MutfakPageTitle"] = "Mutfak KDS";
    ViewData["MutfakActivePage"] = "CanliSiparisler";
    ViewData["MutfakContentClass"] = "p-3 sm:p-5 lg:p-8 pb-24 md:pb-8 flex-1 overflow-y-auto";

    var aktifSiparisler = (Model ?? new List<QRMenu.Core.Entities.Siparis>())
        .Where(s => s.SiparisDetaylar.Any(d => d.Durum == SiparisDurum.Onaylandi || d.Durum == SiparisDurum.Hazirlaniyor))
        .OrderBy(s => s.OlusturmaTarihi)
        .ToList();

    var now = DateTime.UtcNow;
    var aktifBiletSayisi = aktifSiparisler.Count;
    var ortalamaSaniye = aktifBiletSayisi > 0
        ? (int)Math.Round(aktifSiparisler.Average(s => (now - s.OlusturmaTarihi).TotalSeconds))
        : 0;
    var hazardakiSiparisSayisi = aktifSiparisler.Count(s => s.Durum == SiparisDurum.Hazirlaniyor);

    string? MusteriNotunuAyikla(string? notlar)
    {
        if (string.IsNullOrWhiteSpace(notlar)) return null;

        var trimmed = notlar.Trim();
        var parts = trimmed.Split('|', 2, StringSplitOptions.TrimEntries);
        if (parts.Length == 2 && !string.IsNullOrWhiteSpace(parts[1]))
            return parts[1];

        if (trimmed.StartsWith("Happy Hour", StringComparison.OrdinalIgnoreCase))
            return null;

        return trimmed;
    }

    string SureyiYaz(int saniye)
    {
        if (saniye < 0) saniye = 0;
        var dakika = saniye / 60;
        var sn = saniye % 60;
        return $"{dakika:D2}:{sn:D2}";
    }

    List<string> OpsiyonlariCoz(string? opsiyonJson)
    {
        var sonuc = new List<string>();
        if (string.IsNullOrWhiteSpace(opsiyonJson) || opsiyonJson == "[]")
            return sonuc;

        try
        {
            using var doc = JsonDocument.Parse(opsiyonJson);
            foreach (var item in doc.RootElement.EnumerateArray())
            {
                if (item.TryGetProperty("Ad", out var adProp))
                {
                    var ad = adProp.GetString();
                    if (!string.IsNullOrWhiteSpace(ad))
                    {
                        sonuc.Add(ad);
                    }
                }
            }
        }
        catch
        {
            // Geçersiz opsiyon JSON'u ekran akışını bozmasın.
        }

        return sonuc;
    }
}

@section PageStyles {
    <style>
        .kds-panel-root {
            min-height: 100%;
            touch-action: pan-y;
        }

        .kds-order-grid {
            display: grid;
            grid-template-columns: repeat(1, minmax(0, 1fr));
            gap: 1rem;
        }

        @@media (min-width: 640px) {
            .kds-order-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (min-width: 768px) {
            .kds-order-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (min-width: 1024px) {
            .kds-order-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1.5rem;
            }
        }

        @@media (min-width: 1280px) {
            .kds-order-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 1.5rem;
            }
        }

        .kds-ticket-card {
            max-height: calc(100dvh - 13rem);
        }

        .kds-ticket-card .ticket-body {
            min-height: 0;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        .kds-receipt-modal {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: clamp(.5rem, 2vw, 1rem);
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            overflow: hidden;
        }

        .kds-receipt-modal.is-open {
            display: flex;
        }

        .kds-receipt-shell {
            display: flex;
            flex-direction: column;
            width: min(96vw, 960px);
            max-width: 960px;
            height: min(94dvh, 820px);
            max-height: calc(100dvh - 1rem);
            background: #ffffff;
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            animation: modalPopIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        .kds-receipt-header {
            padding: 1.25rem 1.5rem;
            background: #fafafa;
            border-bottom: 1px solid #f0f0f0;
            flex-shrink: 0;
        }

        .kds-receipt-body {
            padding: 1rem 1.5rem;
            overflow-y: auto;
            flex-grow: 1;
            flex-basis: auto;
            min-height: 0;
            overscroll-behavior: contain;
        }

        body.kds-modal-open #kitchenTopbar,
        body.kds-modal-open #kitchenSidebar {
            opacity: 0;
            pointer-events: none;
        }
        
        .kds-receipt-footer {
            padding: 1rem 1.5rem;
            background: #fafafa;
            border-top: 1px solid #f0f0f0;
            flex-shrink: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .kds-receipt-footer > button {
            min-height: 2.9rem;
            flex: 1 1 10.5rem;
        }

        .kds-receipt-items {
            display: grid;
            gap: .55rem;
        }

        .kds-receipt-actions {
            margin-top: .75rem;
            display: flex;
            flex-wrap: wrap;
            gap: .6rem;
            align-items: center;
            justify-content: space-between;
        }

        .kds-select-mode-group {
            display: none;
        }

        .kds-select-mode-btn {
            border: 0;
            background: transparent;
            padding: .35rem .7rem;
            border-radius: .65rem;
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .04em;
            color: #6a6969;
            text-transform: uppercase;
        }

        .kds-select-mode-btn.is-active {
            background: #2e2f2f;
            color: #fff;
        }

        .kds-cancel-btn {
            border: 0;
            background: #c62828;
            color: #fff;
            padding: .45rem .95rem;
            border-radius: .9rem;
            font-size: .7rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .kds-cancel-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .kds-receipt-item {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: .75rem;
            padding: .85rem .75rem;
            border-bottom: 1px solid rgb(239 236 234);
            cursor: pointer;
            transition: all 0.2s ease;
            border-radius: .85rem;
            margin-bottom: 2px;
        }

        .kds-receipt-item:hover {
            background: #fdfdfd;
        }

        .kds-receipt-item.is-selected {
            background: #fff6f3;
            border-radius: .85rem;
            padding-left: .65rem;
            padding-right: .65rem;
            outline: 1px solid rgba(198, 40, 40, 0.18);
        }

        .kds-receipt-lead {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .35rem;
        }

        .kds-cancel-check {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1.75rem;
            height: 1.75rem;
            border-radius: .6rem;
            border: 2px solid #d9d3cf;
            background: #fff;
            transition: all 0.2s ease;
        }

        .kds-cancel-input {
            width: 100%;
            height: 100%;
            margin: 0;
            accent-color: #c62828;
        }

        .kds-cancel-btn.is-busy {
            opacity: .92;
        }

        .kds-btn-spinner {
            width: .95rem;
            height: .95rem;
            border-radius: 999px;
            border: 2px solid rgba(255,255,255,0.42);
            border-top-color: #fff;
            animation: kdsSpin .75s linear infinite;
        }

        .kds-qty-chip-group {
            display: inline-flex;
            flex-wrap: wrap;
            gap: .35rem;
            align-items: center;
        }

        .kds-qty-chip {
            border: 1px solid #ddd7d3;
            background: #fff;
            color: #5f5e5d;
            border-radius: .6rem;
            min-width: 2.05rem;
            min-height: 1.9rem;
            padding: .1rem .45rem;
            font-size: .72rem;
            font-weight: 800;
            line-height: 1;
        }

        .kds-qty-chip.is-active {
            background: #c62828;
            border-color: #c62828;
            color: #fff;
        }

        .kds-cancel-qty {
            display: none;
        }

        .kds-receipt-item:last-child {
            border-bottom: 0;
        }

        .kds-receipt-item.is-prepared .kds-receipt-item-name,
        .kds-receipt-item.is-prepared .kds-receipt-option {
            color: #7a7d7d;
            text-decoration: line-through;
            text-decoration-thickness: 2px;
        }

        .kds-prepared-toggle {
            min-width: 8.25rem;
            min-height: 2.5rem;
            border-radius: .85rem;
            border: 1px solid #d8d4d2;
            background: #ffffff;
            color: #2e2f2f;
            font-weight: 800;
            font-size: .82rem;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            transition: background-color .15s ease, border-color .15s ease, color .15s ease;
            white-space: nowrap;
        }

        .kds-prepared-toggle:hover {
            border-color: #a23718;
        }

        .kds-prepared-toggle.is-prepared {
            background: #e9f5ec;
            border-color: #8fc79b;
            color: #1f6f3a;
        }

        .kds-prepared-status {
            display: none;
            grid-column: 2 / 4;
            margin-top: -.35rem;
            color: #1f6f3a;
            font-size: .75rem;
            font-weight: 800;
        }

        .kds-receipt-item.is-prepared .kds-prepared-status {
            display: block;
        }

        .kds-spinner, .kds-btn-spinner {
            width: 1.1rem;
            height: 1.1rem;
            border-radius: 999px;
            border: 2px solid rgba(255,255,255,0.35);
            border-top-color: #fff;
            animation: kdsSpin .7s linear infinite;
            display: inline-block;
        }

        @@keyframes kdsSpin {
            to { transform: rotate(360deg); }
        }

        @@keyframes modalPopIn {
            0% { opacity: 0; transform: scale(0.95) translateY(10px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        .kds-receipt-title {
            font-weight: 800;
            letter-spacing: 0.08em;
        }

        .kds-danger {
            animation: kdsPulse 2s infinite;
        }

        .kds-compact-mode .ticket-head {
            padding: .75rem 1rem;
        }

        .kds-compact-mode .ticket-body {
            padding: .7rem .95rem;
            gap: .65rem;
        }

        .kds-compact-mode .ticket-actions {
            padding: .65rem .85rem;
        }

        .kds-compact-mode .ticket-body .space-y-4 {
            row-gap: .55rem;
        }

        @@keyframes kdsPulse {
            0% { box-shadow: 0 0 0 0 rgba(251, 81, 81, 0.32); }
            70% { box-shadow: 0 0 0 12px rgba(251, 81, 81, 0); }
            100% { box-shadow: 0 0 0 0 rgba(251, 81, 81, 0); }
        }

        @@media (max-width: 767px) {
            .kds-ticket-card {
                max-height: none;
            }

            .kds-ticket-card .ticket-head {
                padding: 1rem;
            }

            .kds-ticket-card .ticket-body {
                padding: 1rem;
            }

            .kds-ticket-card .ticket-actions {
                padding: .85rem;
            }

            .kds-receipt-shell {
                width: calc(100vw - 1rem);
                height: calc(100dvh - 1rem);
                border-radius: 1rem;
            }

            .kds-receipt-header,
            .kds-receipt-body,
            .kds-receipt-footer {
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .kds-receipt-item {
                grid-template-columns: auto minmax(0, 1fr);
                gap: .6rem;
            }

            .kds-prepared-toggle {
                grid-column: 2;
                justify-self: start;
                min-width: 7.75rem;
                min-height: 2.35rem;
            }

            .kds-prepared-status {
                grid-column: 2;
            }
        }
    </style>
}

<audio id="bellSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

<div id="kdsPanelRoot" class="kds-panel-root bg-surface font-body text-on-surface">
    <div class="flex flex-wrap items-center justify-between gap-3 sm:gap-4 mb-5 sm:mb-8">
        <div class="flex gap-4 flex-wrap">
            <div class="bg-surface-container-low px-4 sm:px-6 py-3 rounded-2xl flex flex-col">
                <span class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Aktif Bilet</span>
                <span class="text-2xl sm:text-3xl font-headline font-extrabold text-primary">@aktifBiletSayisi</span>
            </div>
            <div class="bg-surface-container-low px-4 sm:px-6 py-3 rounded-2xl flex flex-col">
                <span class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Ort. Hazırlık</span>
                <span class="text-2xl sm:text-3xl font-headline font-extrabold text-secondary">@SureyiYaz(ortalamaSaniye)</span>
            </div>
            <div class="bg-surface-container-low px-4 sm:px-6 py-3 rounded-2xl flex flex-col">
                <span class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Hazırlanıyor</span>
                <span class="text-2xl sm:text-3xl font-headline font-extrabold text-on-surface">@hazardakiSiparisSayisi</span>
            </div>
        </div>
    </div>

    @if (aktifSiparisler.Any())
    {
        <div id="kdsGrid" class="kds-order-grid">
            @foreach (var siparis in aktifSiparisler)
            {
                var detaylar = siparis.SiparisDetaylar
                    .Where(d => d.Durum == SiparisDurum.Onaylandi || d.Durum == SiparisDurum.Hazirlaniyor)
                    .ToList();

                var detaylarGorunen = detaylar.Take(4).ToList();
                var kalanDetaySayisi = Math.Max(0, detaylar.Count - detaylarGorunen.Count);

                        if (!detaylar.Any())
                        {
                            continue;
                        }

                        var musteriNotu = MusteriNotunuAyikla(siparis.Notlar);
                        var elapsed = now - siparis.OlusturmaTarihi;
                        var danger = elapsed.TotalMinutes >= 5;
                        var yeniBilet = siparis.Durum == SiparisDurum.Onaylandi && !danger;
                        var detayIptalAktif = siparis.Durum == SiparisDurum.Onaylandi || siparis.Durum == SiparisDurum.Hazirlaniyor;

                        var kartSinifi = danger
                            ? "ring-2 ring-error/15 border border-error-container/20 kds-ticket-card kds-danger"
                            : yeniBilet
                                ? "border-2 border-secondary kds-ticket-card"
                                : "border border-outline/20 kds-ticket-card";

                        var baslikSinifi = danger
                            ? "bg-error-container/10"
                            : yeniBilet
                                ? "bg-secondary text-white"
                                : "bg-surface-container-high";

                        var sureRozetiSinifi = danger
                            ? "bg-error-container text-on-error-container"
                            : yeniBilet
                                ? "bg-white/20 text-white"
                                : "bg-surface-container-highest text-on-surface";

                    <article class="bg-surface-container-lowest rounded-2xl flex flex-col overflow-hidden @kartSinifi" data-id="@siparis.Id" data-tarih="@siparis.OlusturmaTarihi.ToString("o")">
                            <div class="@baslikSinifi p-4 sm:p-5 flex justify-between items-center ticket-head">
                                <div class="@(yeniBilet ? "text-white" : "")">
                                    <div class="text-xs font-bold uppercase tracking-tighter @(yeniBilet ? "opacity-80" : "text-on-surface-variant")">Masa @siparis.Masa.MasaNo</div>
                                    <div class="text-xl sm:text-2xl font-headline font-black @(yeniBilet ? "" : "text-on-surface")">Ticket #@siparis.GunlukSiparisNo</div>
                                </div>
                                <div class="@sureRozetiSinifi px-3 py-1.5 rounded-lg flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm">timer</span>
                                    <span class="font-headline font-bold text-base sm:text-lg timer-text">@SureyiYaz((int)Math.Max(0, elapsed.TotalSeconds))</span>
                                </div>
                            </div>

                            <div class="p-4 sm:p-5 flex-grow flex flex-col gap-4 ticket-body">
                                @if (!string.IsNullOrWhiteSpace(musteriNotu))
                                {
                                    <div class="kds-customer-note bg-secondary-container/20 p-3 rounded-xl border-l-4 border-secondary">
                                        <div class="text-[10px] font-black uppercase text-secondary-dim tracking-widest">Müşteri Notu</div>
                                        <p class="text-sm font-medium text-on-secondary-container">@musteriNotu</p>
                                    </div>
                                }

                                <div class="space-y-4">
                                    @foreach (var detay in detaylarGorunen)
                                    {
                                        var opsiyonlar = OpsiyonlariCoz(detay.SeciliOpsiyonlar);
                                        <div class="flex items-start gap-3">
                                            <div class="bg-surface-container-highest px-2.5 py-1 rounded-lg font-black text-on-surface">@detay.Adet</div>
                                            <div class="flex-grow">
                                                <div class="font-headline font-bold text-on-surface text-base sm:text-lg">@detay.Urun.Ad</div>
                                                @if (opsiyonlar.Any())
                                                {
                                                    foreach (var opsiyon in opsiyonlar)
                                                    {
                                                        <div class="text-xs sm:text-sm text-on-surface-variant font-medium">• @opsiyon</div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if (kalanDetaySayisi > 0)
                                {
                                    <div class="text-xs font-semibold text-outline">+ @kalanDetaySayisi ürün daha (fişten görüntüle)</div>
                                }
                            </div>

                            <div class="p-3 sm:p-4 bg-surface-container-low ticket-actions">
                                <div class="flex gap-3">
                                    <button type="button" class="kds-receipt-btn flex-1 bg-white text-on-surface py-3 sm:py-4 rounded-xl font-headline font-extrabold text-base sm:text-lg transition-all border border-surface-container-high hover:border-primary" data-receipt-id="@siparis.Id">
                                        Fiş
                                    </button>
                                    @if (siparis.Durum == SiparisDurum.Onaylandi)
                                    {
                                        <button type="button" onclick="durumGuncelleClick(this, @siparis.Id, 'Hazirlaniyor')" class="flex-[2] bg-primary hover:bg-primary-dim text-white py-3 sm:py-4 rounded-xl font-headline font-extrabold text-base sm:text-lg transition-all flex justify-center items-center gap-2">
                                            <span>Hazırlanıyor</span>
                                            <span class="material-symbols-outlined">chevron_right</span>
                                        </button>
                                        <button type="button" onclick="durumGuncelleClick(this, @siparis.Id, 'Iptal')" class="bg-error hover:bg-error/90 text-white py-3 sm:py-4 px-4 rounded-xl font-headline font-extrabold text-base sm:text-lg transition-all flex justify-center items-center gap-2">
                                            <span class="material-symbols-outlined">cancel</span>
                                        </button>
                                    }
                                    else if (siparis.Durum == SiparisDurum.Hazirlaniyor)
                                    {
                                        <button type="button" onclick="durumGuncelleClick(this, @siparis.Id, 'Hazir')" class="flex-[2] bg-primary hover:bg-primary-dim text-white py-3 sm:py-4 rounded-xl font-headline font-extrabold text-base sm:text-lg transition-all flex justify-center items-center gap-2">
                                            <span>Hazır</span>
                                            <span class="material-symbols-outlined">check_circle</span>
                                        </button>
                                        <button type="button" onclick="durumGuncelleClick(this, @siparis.Id, 'Iptal')" class="bg-error hover:bg-error/90 text-white py-3 sm:py-4 px-4 rounded-xl font-headline font-extrabold text-base sm:text-lg transition-all flex justify-center items-center gap-2">
                                            <span class="material-symbols-outlined">cancel</span>
                                        </button>
                                    }
                                </div>
                            </div>
                </article>

                <template id="kdsReceipt-@siparis.Id">
                    <div class="kds-receipt-shell" data-receipt-order-id="@siparis.Id" data-receipt-status="@siparis.Durum">
                        <div class="kds-receipt-header">
                            <div class="flex items-start justify-between">
                                <div>
                                    <div class="text-[10px] font-bold uppercase tracking-widest text-outline">Masa @siparis.Masa.MasaNo</div>
                                    <div class="text-2xl font-headline font-black text-on-surface">Ticket #@siparis.GunlukSiparisNo</div>
                                    <div class="text-xs text-on-surface-variant mt-1">@siparis.OlusturmaTarihi.AddHours(3).ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                                <div class="text-[10px] font-bold px-2 py-1 rounded-full bg-surface-container text-on-surface">@siparis.Durum.ToString()</div>
                            </div>
                            <div class="kds-receipt-actions">
                                <button type="button" class="kds-cancel-btn flex items-center justify-center gap-2" data-cancel-selected data-cancel-enabled="@(detayIptalAktif ? "1" : "0")" @(detayIptalAktif ? "" : "disabled")>
                                    <span class="kds-btn-spinner hidden" id="cancelSpinner"></span>
                                    <span>Seçilenleri İptal Et</span>
                                </button>
                            </div>
                        </div>

                        <div class="kds-receipt-body">
                            @if (!string.IsNullOrWhiteSpace(musteriNotu))
                            {
                                <div class="bg-secondary-container/20 p-3 rounded-xl border-l-4 border-secondary mb-4">
                                    <div class="text-[10px] font-black uppercase text-secondary-dim tracking-widest">Müşteri Notu</div>
                                    <p class="text-sm font-medium text-on-secondary-container">@musteriNotu</p>
                                </div>
                            }

                            <div class="kds-receipt-items">
                                @foreach (var detay in detaylar)
                                {
                                    var opsiyonlar = OpsiyonlariCoz(detay.SeciliOpsiyonlar);
                                    @for (var i = 0; i < detay.Adet; i++)
                                    {
                                        <div class="kds-receipt-item" data-detail-id="@detay.Id">
                                            <div class="kds-receipt-lead">
                                                <label class="kds-cancel-check">
                                                    <input type="checkbox" class="kds-cancel-input" value="@detay.Id" @(detayIptalAktif ? "" : "disabled") />
                                                </label>
                                            </div>
                                            <div class="min-w-0 pt-0.5">
                                                <div class="kds-receipt-item-name font-headline font-bold text-on-surface break-words">
                                                    @detay.Urun.Ad 
                                                    <span class="text-xs bg-surface-container-highest px-1.5 py-0.5 rounded text-on-surface-variant ml-1">1 ADET</span>
                                                </div>
                                                @if (opsiyonlar.Any())
                                                {
                                                    <div class="mt-1 space-y-1 text-xs text-on-surface-variant font-medium">
                                                    @foreach (var opsiyon in opsiyonlar)
                                                    {
                                                        <div class="kds-receipt-option">• @opsiyon</div>
                                                    }
                                                    </div>
                                                }
                                            </div>
                                            <button type="button" class="kds-prepared-toggle" data-prepared-toggle="@detay.Id" aria-pressed="false">
                                                <span class="material-symbols-outlined text-[18px]">radio_button_unchecked</span>
                                                <span class="kds-prepared-label">Hazırlandı</span>
                                            </button>
                                            <div class="kds-prepared-status">Hazırlandı olarak işaretlendi</div>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="border-t border-surface-container mt-5 pt-4 flex items-center justify-between">
                                <span class="text-sm font-bold text-on-surface uppercase tracking-wider">Toplam</span>
                                <span class="text-xl font-black text-on-surface">₺@siparis.ToplamTutar</span>
                            </div>
                        </div>

                        <div class="kds-receipt-footer flex-col sm:flex-row">
                            @if (siparis.Durum == SiparisDurum.Onaylandi)
                            {
                                <button type="button" onclick="durumGuncelleClick(this, @siparis.Id, 'Hazirlaniyor', true)" class="flex-1 bg-primary hover:bg-primary-dim text-white py-3 rounded-xl font-headline font-extrabold text-base transition-all flex justify-center items-center gap-2">
                                    <span>Hazırlanıyor</span>
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </button>
                                <button type="button" onclick="durumGuncelleClick(this, @siparis.Id, 'Iptal', true)" class="flex-1 bg-error hover:bg-error/90 text-white py-3 rounded-xl font-headline font-extrabold text-base transition-all flex justify-center items-center gap-2">
                                    <span>Hepsini İptal Et</span>
                                    <span class="material-symbols-outlined">cancel</span>
                                </button>
                            }
                            else if (siparis.Durum == SiparisDurum.Hazirlaniyor)
                            {
                                <button type="button" onclick="durumGuncelleClick(this, @siparis.Id, 'Hazir', true)" class="flex-1 bg-primary hover:bg-primary-dim text-white py-3 rounded-xl font-headline font-extrabold text-base transition-all flex justify-center items-center gap-2">
                                    <span>Hazır</span>
                                    <span class="material-symbols-outlined">check_circle</span>
                                </button>
                                <button type="button" onclick="durumGuncelleClick(this, @siparis.Id, 'Iptal', true)" class="flex-1 bg-error hover:bg-error/90 text-white py-3 rounded-xl font-headline font-extrabold text-base transition-all flex justify-center items-center gap-2">
                                    <span>Hepsini İptal Et</span>
                                    <span class="material-symbols-outlined">cancel</span>
                                </button>
                            }
                            <button type="button" onclick="closeReceipt();" class="flex-1 border border-surface-container-high text-on-surface py-3 rounded-xl font-headline font-extrabold text-base transition-all hover:bg-surface-container-lowest">
                                Kapat
                            </button>
                        </div>
                    </div>
                </template>
            }
        </div>
    }
    else
    {
        <section id="kdsEmptyState" class="w-full min-h-[420px] rounded-3xl bg-surface-container-lowest border border-surface-container p-8 flex flex-col items-center justify-center text-center">
            <span class="material-symbols-outlined text-6xl text-primary mb-2">skillet</span>
            <h3 class="text-3xl font-headline font-black text-on-surface">Şu an bekleyen sipariş yok.</h3>
            <p class="text-on-surface-variant mt-2 font-medium">Mutfak hazır. Yeni sipariş geldiğinde ekran otomatik güncellenecek.</p>
        </section>
    }

    <nav class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-20 px-4 bg-white/90 backdrop-blur-md shadow-[0_-4px_20px_rgba(0,0,0,0.05)] border-t border-[#eae8e7]">
        <div class="flex flex-col items-center justify-center bg-primary text-white rounded-xl mx-2 py-2 px-4 scale-110 duration-300 ease-out">
            <span class="material-symbols-outlined">clock_loader_40</span>
            <span class="font-body text-xs uppercase tracking-widest mt-1">Hazırlanıyor</span>
        </div>
        <div class="flex flex-col items-center justify-center text-on-surface py-2 px-4">
            <span class="material-symbols-outlined">check_circle</span>
            <span class="font-body text-xs uppercase tracking-widest mt-1">Hazır</span>
        </div>
        <div class="flex flex-col items-center justify-center text-on-surface py-2 px-4">
            <span class="material-symbols-outlined">task</span>
            <span class="font-body text-xs uppercase tracking-widest mt-1">Tamamlandı</span>
        </div>
    </nav>

</div>

<div id="kdsReceiptModal" class="kds-receipt-modal" aria-hidden="true">
    <div id="kdsReceiptBody"></div>
</div>

@section PageScripts {
    <script>
        let dangerThresholdMs = 5 * 60 * 1000;
        let pinCriticalTop = true;
        let showCustomerNotes = true;
        let compactCards = false;
        let criticalPulse = true;
        let lastKdsSortSignature = '';

        function loadRuntimeSettings() {
            try {
                const criticalMinutes = parseInt(localStorage.getItem('kdsCriticalMinutes') || '', 10);
                if (Number.isFinite(criticalMinutes) && criticalMinutes >= 1 && criticalMinutes <= 60) {
                    dangerThresholdMs = criticalMinutes * 60 * 1000;
                } else {
                    dangerThresholdMs = 5 * 60 * 1000;
                }

                const pinTopRaw = localStorage.getItem('kdsPinCriticalTop');
                pinCriticalTop = pinTopRaw === null ? true : pinTopRaw === '1';

                const showNotesRaw = localStorage.getItem('kdsShowCustomerNotes');
                showCustomerNotes = showNotesRaw === null ? true : showNotesRaw === '1';

                const compactRaw = localStorage.getItem('kdsCompactCards');
                compactCards = compactRaw === null ? false : compactRaw === '1';

                const pulseRaw = localStorage.getItem('kdsCriticalPulse');
                criticalPulse = pulseRaw === null ? true : pulseRaw === '1';
                return;
            } catch (e) {
                // localStorage erişilemiyorsa varsayılan süre kullan
            }

            dangerThresholdMs = 5 * 60 * 1000;
            pinCriticalTop = true;
            showCustomerNotes = true;
            compactCards = false;
            criticalPulse = true;
        }

        function applyRuntimeUiSettings() {
            const root = document.getElementById('kdsPanelRoot');
            if (root) {
                root.classList.toggle('kds-compact-mode', compactCards);
            }

            document.querySelectorAll('.kds-customer-note').forEach(note => {
                note.style.display = showCustomerNotes ? '' : 'none';
            });
        }

        function getPreparedDetailIds() {
            try {
                const raw = localStorage.getItem('kdsPreparedDetails') || '[]';
                const parsed = JSON.parse(raw);
                return Array.isArray(parsed) ? new Set(parsed.map(String)) : new Set();
            } catch (e) {
                return new Set();
            }
        }

        function savePreparedDetailIds(ids) {
            try {
                localStorage.setItem('kdsPreparedDetails', JSON.stringify(Array.from(ids)));
            } catch (e) {
                // İşaretleme sadece mutfak ekranına yardımcı yerel bilgi; kaydedilemezse ekran yine çalışır.
            }
        }

        function setPreparedVisualState(row, isPrepared) {
            if (!row) {
                return;
            }

            row.classList.toggle('is-prepared', isPrepared);
            const button = row.querySelector('[data-prepared-toggle]');
            if (!button) {
                return;
            }

            button.classList.toggle('is-prepared', isPrepared);
            button.setAttribute('aria-pressed', isPrepared ? 'true' : 'false');

            const icon = button.querySelector('.material-symbols-outlined');
            if (icon) {
                icon.textContent = isPrepared ? 'check_circle' : 'radio_button_unchecked';
            }

            const label = button.querySelector('.kds-prepared-label');
            if (label) {
                label.textContent = isPrepared ? 'Hazırlandı' : 'Hazırlandı';
            }
        }

        function applyPreparedMarks(scope = document) {
            const preparedIds = getPreparedDetailIds();
            scope.querySelectorAll('[data-detail-id]').forEach(row => {
                const detailId = row.getAttribute('data-detail-id');
                setPreparedVisualState(row, preparedIds.has(String(detailId)));
            });
        }

        async function submitAutoReadyIfAllPrepared(scope) {
            const receiptShell = scope?.closest?.('.kds-receipt-shell') || document.querySelector('#kdsReceiptBody .kds-receipt-shell');
            if (!receiptShell || receiptShell.dataset.autoReadySubmitted === '1') {
                return;
            }

            const itemRows = Array.from(receiptShell.querySelectorAll('[data-detail-id]'));
            if (!itemRows.length || itemRows.some(row => !row.classList.contains('is-prepared'))) {
                return;
            }

            const siparisId = parseInt(receiptShell.getAttribute('data-receipt-order-id') || '', 10);
            if (!Number.isFinite(siparisId)) {
                return;
            }

            receiptShell.dataset.autoReadySubmitted = '1';
            const status = receiptShell.getAttribute('data-receipt-status');

            if (status === 'Onaylandi') {
                const hazirlaniyorOk = await durumGuncelle(siparisId, 'Hazirlaniyor', false);
                if (!hazirlaniyorOk) {
                    receiptShell.dataset.autoReadySubmitted = '0';
                    return;
                }
            }

            const hazirOk = await durumGuncelle(siparisId, 'Hazir');
            if (hazirOk) {
                closeReceipt();
            } else {
                receiptShell.dataset.autoReadySubmitted = '0';
            }
        }

        function openReceipt(receiptId) {
            const modal = document.getElementById('kdsReceiptModal');
            const body = document.getElementById('kdsReceiptBody');
            const template = document.getElementById(`kdsReceipt-${receiptId}`);

            if (!modal || !body || !template) {
                return;
            }

            body.innerHTML = '';
            body.appendChild(template.content.cloneNode(true));
            applyPreparedMarks(body);
            const receipt = body.querySelector('.kds-receipt-shell');
            if (receipt) {
                setKdsCancelMode(getKdsCancelMode(), receipt);
                updateKdsReceiptSelection(receipt);
            }
            modal.classList.add('is-open');
            document.body.classList.add('kds-modal-open');
            document.body.style.overflow = 'hidden';
        }

        function closeReceipt() {
            const modal = document.getElementById('kdsReceiptModal');
            const body = document.getElementById('kdsReceiptBody');

            if (modal) {
                modal.classList.remove('is-open');
            }

            if (body) {
                body.innerHTML = '';
            }

            document.body.classList.remove('kds-modal-open');
            document.body.style.overflow = '';
        }

        function updateTimers() {
            const cards = document.querySelectorAll('.kds-ticket-card');
            const now = new Date();

            cards.forEach(card => {
                const tarihStr = card.getAttribute('data-tarih');
                const pDate = new Date(tarihStr);
                const diffMs = now - pDate;
                if (diffMs < 0) {
                    return;
                }

                const diffSec = Math.floor(diffMs / 1000);
                const mins = Math.floor(diffSec / 60);
                const secs = diffSec % 60;

                const timerText = card.querySelector('.timer-text');
                if (timerText) {
                    timerText.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                }

                const isCritical = diffMs > dangerThresholdMs;
                card.dataset.critical = isCritical ? '1' : '0';
                card.classList.toggle('kds-danger', criticalPulse && isCritical);
            });

            const sortSignature = Array.from(cards)
                .map(card => `${card.getAttribute('data-id') || ''}:${card.dataset.critical || '0'}`)
                .join('|');
            const shouldSort = sortSignature !== lastKdsSortSignature
                && pinCriticalTop
                && window.scrollY < 20
                && !document.body.classList.contains('kds-modal-open');
            if (shouldSort) {
                lastKdsSortSignature = sortSignature;
                sortKdsCardsByPriority();
            }
        }

        function sortKdsCardsByPriority() {
            const grid = document.getElementById('kdsGrid');
            if (!grid) {
                return;
            }

            const cards = Array.from(grid.querySelectorAll('.kds-ticket-card'));
            if (!cards.length) {
                return;
            }

            cards.sort((a, b) => {
                const aCritical = a.dataset.critical === '1' ? 1 : 0;
                const bCritical = b.dataset.critical === '1' ? 1 : 0;

                if (pinCriticalTop && aCritical !== bCritical) {
                    // Kritik biletler üstte kalır.
                    return bCritical - aCritical;
                }

                const aTime = Date.parse(a.dataset.tarih || '');
                const bTime = Date.parse(b.dataset.tarih || '');
                const safeATime = Number.isFinite(aTime) ? aTime : 0;
                const safeBTime = Number.isFinite(bTime) ? bTime : 0;

                // Aynı öncelikte eski siparişler üstte kalır.
                return safeATime - safeBTime;
            });

            cards.forEach((card) => {
                grid.appendChild(card);
            });
        }

        setInterval(updateTimers, 1000);
        loadRuntimeSettings();
        applyRuntimeUiSettings();
        updateTimers();

        document.addEventListener('click', function (event) {

            const cancelButton = event.target.closest('[data-cancel-selected]');
            if (cancelButton) {
                event.preventDefault();
                if (!cancelButton.disabled) {
                    iptalSeciliDetaylar();
                }
                return;
            }

            const preparedButton = event.target.closest('[data-prepared-toggle]');
            if (preparedButton) {
                event.preventDefault();
                const detailId = preparedButton.getAttribute('data-prepared-toggle');
                const row = preparedButton.closest('[data-detail-id]');
                const preparedIds = getPreparedDetailIds();
                const prepared = preparedIds.has(String(detailId));

                if (prepared) {
                    preparedIds.delete(String(detailId));
                } else {
                    preparedIds.add(String(detailId));
                }

                savePreparedDetailIds(preparedIds);
                setPreparedVisualState(row, !prepared);
                submitAutoReadyIfAllPrepared(row);
                return;
            }

            // Eğer fiş içindeki herhangi bir yere tıklanmışsa, küçük kutucukla uğraşılmasın; kartın herhangi bir yeri seçimi değiştirsin
            const receiptItem = event.target.closest('.kds-receipt-item');
            if (receiptItem) {
                // Eğer tıklama interaktif bir öğe üzerindeyse (input, select, button, a, label) geri dön
                if (event.target.closest('input,select,button,a,label')) {
                    return;
                }

                const checkbox = receiptItem.querySelector('.kds-cancel-input');
                if (checkbox && !checkbox.disabled) {
                    checkbox.checked = !checkbox.checked;
                    checkbox.dispatchEvent(new Event('change', { bubbles: true }));
                }

                return;
            }

            const receiptButton = event.target.closest('[data-receipt-id]');
            if (receiptButton) {
                event.preventDefault();
                openReceipt(receiptButton.dataset.receiptId);
                return;
            }

            const modal = document.getElementById('kdsReceiptModal');
            if (modal && event.target === modal) {
                closeReceipt();
            }
        });

        document.addEventListener('change', function (event) {
            const cancelInput = event.target.closest('.kds-cancel-input');
            if (!cancelInput) {
                return;
            }

            const receipt = cancelInput.closest('.kds-receipt-shell');
            if (receipt) {
                updateKdsReceiptSelection(receipt);
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeReceipt();
            }
        });

        let refreshTimer = null;
        let lastRefreshAt = 0;
        let refreshInFlight = false;

        async function softRefreshKdsPanel() {
            if (refreshInFlight) {
                return;
            }

            refreshInFlight = true;
            try {
                const res = await fetch(window.location.pathname, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!res.ok) {
                    throw new Error('KDS verisi alınamadı.');
                }

                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const yeniPanel = doc.getElementById('kdsPanelRoot');
                const mevcutPanel = document.getElementById('kdsPanelRoot');

                if (yeniPanel && mevcutPanel) {
                    mevcutPanel.innerHTML = yeniPanel.innerHTML;
                    closeReceipt();
                    loadRuntimeSettings();
                    applyRuntimeUiSettings();
                    updateTimers();
                }
            } catch (err) {
                console.error(err);
                console.warn('Mutfak paneli güncellenemedi, mevcut içerik korunuyor.');
            } finally {
                refreshInFlight = false;
            }
        }

        function scheduleSoftRefresh(delayMs = 500) {
            const minIntervalMs = 2000;
            const elapsed = Date.now() - lastRefreshAt;
            const waitMs = Math.max(delayMs, minIntervalMs - elapsed);

            if (refreshTimer) {
                return;
            }

            refreshTimer = setTimeout(async () => {
                refreshTimer = null;
                lastRefreshAt = Date.now();
                await softRefreshKdsPanel();
            }, Math.max(0, waitMs));
        }

        const inFlightDurumGuncellemeleri = new Set();

        async function durumGuncelleClick(button, siparisId, durum, closeAfter = false) {
            if (inFlightDurumGuncellemeleri.has(siparisId)) {
                return;
            }

            const originalHtml = button ? button.innerHTML : null;
            if (button) {
                button.disabled = true;
                button.classList.add('opacity-80', 'cursor-not-allowed');
                button.innerHTML = '<span class="kds-spinner" aria-hidden="true"></span><span>İşleniyor</span>';
            }

            const ok = await durumGuncelle(siparisId, durum, true);

            if (button && !ok) {
                button.disabled = false;
                button.classList.remove('opacity-80', 'cursor-not-allowed');
                if (originalHtml !== null) {
                    button.innerHTML = originalHtml;
                }
            }

            if (ok && closeAfter) {
                closeReceipt();
            }
        }

        const kdsCancelModeKey = 'kdsCancelMode';

        function getKdsCancelMode() {
            return 'multi';
        }

        function setKdsCancelMode(mode, receipt) {
            // Artık sadece çoklu seçim var
            if (!receipt) return;
            receipt.dataset.cancelMode = 'multi';
            updateKdsReceiptSelection(receipt);
        }

        function updateKdsReceiptSelection(receipt) {
            if (!receipt) {
                return;
            }

            let selectedCount = 0;
            receipt.querySelectorAll('.kds-receipt-item').forEach(row => {
                const checked = row.querySelector('.kds-cancel-input')?.checked;
                row.classList.toggle('is-selected', Boolean(checked));
                if (checked) {
                    selectedCount += 1;
                }
            });

            const cancelBtn = receipt.querySelector('[data-cancel-selected]');
            const enabled = cancelBtn?.getAttribute('data-cancel-enabled') !== '0';
            if (cancelBtn) {
                cancelBtn.disabled = !enabled || selectedCount === 0;
            }
        }

        function collectKdsCancelDetails(receipt) {
            if (!receipt) {
                return [];
            }

            const selectionMap = new Map();
            receipt.querySelectorAll('.kds-cancel-input:checked').forEach(input => {
                const detailId = Number.parseInt(input.value, 10);
                if (Number.isFinite(detailId)) {
                    selectionMap.set(detailId, (selectionMap.get(detailId) || 0) + 1);
                }
            });

            const result = [];
            selectionMap.forEach((adet, siparisDetayId) => {
                result.push({ siparisDetayId, adet });
            });
            return result;
        }

        async function iptalSeciliDetaylar() {
            const receipt = document.querySelector('#kdsReceiptBody .kds-receipt-shell');
            if (!receipt) {
                return;
            }

            const detaylar = collectKdsCancelDetails(receipt);
            if (!detaylar.length) {
                return;
            }

            const onay = confirm('Seçilen kalemler iptal edilsin mi?');
            if (!onay) {
                return;
            }

            const cancelBtn = receipt.querySelector('[data-cancel-selected]');
            const spinner = receipt.querySelector('#cancelSpinner');
            const originalHtml = cancelBtn ? cancelBtn.querySelector('span:not(.kds-btn-spinner)')?.innerText : 'Seçilenleri İptal Et';

            if (cancelBtn) {
                cancelBtn.disabled = true;
                cancelBtn.classList.add('is-busy');
                if (spinner) spinner.classList.remove('hidden');
                const label = cancelBtn.querySelector('span:not(.kds-btn-spinner)');
                if (label) label.innerText = 'İşleniyor...';
            }

            try {
                const res = await fetch('/Mutfak/SiparisDetayIptal', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ detaylar })
                });

                const data = await res.json();
                if (data.success) {
                    closeReceipt();
                    scheduleSoftRefresh(120);
                    return;
                }

                alert('İptal sırasında hata: ' + (data.message || 'Bilinmeyen hata'));
            } catch (err) {
                console.error(err);
                alert('İptal sırasında bağlantı hatası oluştu.');
            } finally {
                if (cancelBtn) {
                    cancelBtn.disabled = false;
                    cancelBtn.classList.remove('is-busy');
                    if (spinner) spinner.classList.add('hidden');
                    const label = cancelBtn.querySelector('span:not(.kds-btn-spinner)');
                    if (label) label.innerText = originalHtml;
                }
                updateKdsReceiptSelection(receipt);
            }
        }

        async function durumGuncelle(siparisId, durum, refresh = true) {
            if (inFlightDurumGuncellemeleri.has(siparisId)) {
                return false;
            }

            inFlightDurumGuncellemeleri.add(siparisId);
            try {
                const payload = { yeniDurum: durum };
                const res = await fetch(`/Mutfak/DurumGuncelle/${siparisId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.success) {
                    if (refresh) {
                        scheduleSoftRefresh(100);
                    }
                    return true;
                } else {
                    alert('Durum güncellenirken hata: ' + data.message);
                    return false;
                }
            } catch (err) {
                console.error(err);
                alert('Durum güncellenirken beklenmeyen bir hata oluştu.');
                return false;
            } finally {
                inFlightDurumGuncellemeleri.delete(siparisId);
            }
        }

        function playBell() {
            try {
                if (localStorage.getItem('kdsEnableSound') === '0') {
                    return;
                }
            } catch (e) {
                // localStorage erişilemiyorsa ses varsayılan açık kalır
            }

            const bell = document.getElementById('bellSound');
            if (bell) {
                bell.play().catch(e => console.log('Ses çalma hatası:', e));
            }
        }

        function buildConnection(useFallbackTransports) {
            const options = useFallbackTransports
                ? { transport: signalR.HttpTransportType.ServerSentEvents | signalR.HttpTransportType.LongPolling }
                : undefined;

            return new signalR.HubConnectionBuilder()
                .withUrl('/hubs/order', options)
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Error)
                .build();
        }

        function registerConnectionHandlers(conn) {
            conn.on('SiparisGeldi', function () {
                playBell();
                scheduleSoftRefresh(900);
            });

            conn.on('SiparisEklendi', function () {
                playBell();
                scheduleSoftRefresh(900);
            });

            conn.on('SiparisGuncellendi', function () {
                scheduleSoftRefresh(500);
            });
        }

        let connection = buildConnection(false);
        registerConnectionHandlers(connection);

        async function startConnection(conn, allowFallback) {
            try {
                await conn.start();
                console.log('KDS bağlantısı başarılı.');
            } catch (err) {
                console.error('SignalR KDS hatası:', err);
                if (!allowFallback) return;

                try {
                    await conn.stop();
                } catch (stopErr) {
                    console.warn('SignalR kapatılırken hata:', stopErr);
                }

                connection = buildConnection(true);
                registerConnectionHandlers(connection);
                await startConnection(connection, false);
            }
        }

        startConnection(connection, true);
    </script>
}
