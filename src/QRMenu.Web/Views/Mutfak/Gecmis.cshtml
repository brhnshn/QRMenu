@using QRMenu.Core.Enums
@model List<QRMenu.Core.Entities.Siparis>
@{
    Layout = "~/Views/Shared/_MutfakLayout.cshtml";
    ViewData["Title"] = "Sipariş Geçmişi";
    ViewData["MutfakPageTitle"] = "Sipariş Geçmişi";
    ViewData["MutfakActivePage"] = "SiparisGecmisi";
    ViewData["MutfakContentClass"] = "p-3 sm:p-5 lg:p-8 pb-8 h-full overflow-y-auto";

    string DurumEtiketi(SiparisDurum durum) => durum switch
    {
        SiparisDurum.Hazir => "Hazır",
        SiparisDurum.TeslimEdildi => "Teslim Edildi",
        SiparisDurum.KismiOdendi => "Kısmi Ödendi",
        SiparisDurum.TamOdendi => "Tam Ödendi",
        SiparisDurum.Iptal => "İptal",
        SiparisDurum.Iade => "İade",
        _ => durum.ToString()
    };

    string DurumSinifi(SiparisDurum durum) => durum switch
    {
        SiparisDurum.Hazir => "bg-emerald-100 text-emerald-700",
        SiparisDurum.TeslimEdildi => "bg-blue-100 text-blue-700",
        SiparisDurum.TamOdendi => "bg-slate-200 text-slate-700",
        SiparisDurum.KismiOdendi => "bg-amber-100 text-amber-700",
        SiparisDurum.Iptal => "bg-red-100 text-red-700",
        SiparisDurum.Iade => "bg-rose-100 text-rose-700",
        _ => "bg-surface-container text-on-surface"
    };
}

@section PageStyles {
    <style>
        .kds-history-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 1rem;
        }

        @@media (max-width: 767px) {
            .kds-history-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<section class="mb-6">
    <h2 class="text-2xl sm:text-3xl font-headline font-black text-on-surface">Son 7 Gün Sipariş Geçmişi</h2>
    <p class="text-sm sm:text-base text-on-surface-variant mt-1">Hazırlık süreci tamamlanan siparişler burada listelenir.</p>
</section>

@if (Model.Any())
{
    <div class="kds-history-grid">
        @foreach (var siparis in Model)
        {
            <article class="bg-surface-container-lowest rounded-2xl border border-surface-container p-5 flex flex-col gap-4">
                <header class="flex items-start justify-between gap-3">
                    <div>
                        <div class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Masa @siparis.Masa.MasaNo</div>
                        <div class="text-xl font-headline font-black text-on-surface">Ticket #@siparis.GunlukSiparisNo</div>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold @DurumSinifi(siparis.Durum)">@DurumEtiketi(siparis.Durum)</span>
                </header>

                <div class="text-sm text-on-surface-variant font-medium">
                    Tarih: @siparis.OlusturmaTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </div>

                <div class="space-y-2">
                    @foreach (var detay in siparis.SiparisDetaylar)
                    {
                        <div class="flex items-start gap-2 text-sm">
                            <span class="font-bold text-primary">@detay.Adet x</span>
                            <span class="text-on-surface">@detay.Urun.Ad</span>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}
else
{
    <section class="w-full min-h-[320px] rounded-3xl bg-surface-container-lowest border border-surface-container p-8 flex flex-col items-center justify-center text-center">
        <span class="material-symbols-outlined text-6xl text-primary mb-2">history</span>
        <h3 class="text-2xl font-headline font-black text-on-surface">Gösterilecek sipariş geçmişi yok.</h3>
        <p class="text-on-surface-variant mt-2 font-medium">Geçmiş siparişler oluştukça bu ekran otomatik olarak dolacaktır.</p>
    </section>
}