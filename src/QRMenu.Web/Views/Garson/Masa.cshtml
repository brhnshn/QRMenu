@model QRMenu.Web.ViewModels.GarsonMasaPageViewModel

@{
    Layout = "~/Views/Shared/_GarsonLayout.cshtml";
    ViewData["GarsonPageTitle"] = $"Masa {Model.MasaNo}";
    ViewData["GarsonActivePage"] = "Masa";
    ViewData["GarsonContentClass"] = "px-3 py-3 sm:px-5 sm:py-3 flex-1 min-h-0 overflow-y-auto lg:overflow-hidden";
    ViewData["GarsonMasaLink"] = $"/Garson/Masa/{Model.MasaId}";
}

@section GarsonHeaderLeft {
    <a href="/Garson/Masalar" class="flex items-center gap-2 group hover:bg-stone-200/50 transition-colors p-2 rounded-xl active:scale-95 transition-transform duration-150">
        <span class="material-symbols-outlined text-stone-500">arrow_back</span>
        <span class="text-stone-500 font-medium font-label">Geri</span>
    </a>
    <div class="hidden sm:block h-6 w-px bg-stone-200/50 mx-1"></div>
    <h2 class="text-[#2e2f2f] font-['Plus_Jakarta_Sans'] text-base sm:text-lg font-bold">Masa @Model.MasaNo</h2>
}

@section GarsonHeaderRight {
    <a href="/Garson/Masa/@Model.MasaId/YeniSiparis" class="bg-primary text-on-primary px-4 sm:px-5 py-2.5 rounded-2xl flex items-center justify-center gap-2 font-label font-bold tracking-tight active:scale-95 transition-all shadow-lg shadow-primary/20 w-full sm:w-auto">
        <span class="material-symbols-outlined text-[20px]">add</span>
        <span>Yeni Sipariş Al</span>
    </a>
}

@section PageStyles {
    <style>
        .durum-chip {
            border-radius: 9999px;
            padding: 4px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1.1;
        }

        .urun-ozet {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .fis-item-row {
            display: flex;
            gap: .85rem;
            align-items: center;
            padding: .85rem .75rem;
            border-bottom: 1px dashed #e5e3e1;
            cursor: pointer;
            transition: all 0.2s ease;
            border-radius: .85rem;
            margin-bottom: 2px;
        }

        .fis-item-row.is-selected {
            background: #fff6f3;
            outline: 1px solid rgba(162, 55, 24, 0.18);
        }

        .fis-cancel-btn {
            border: 0;
            background: #c62828;
            color: #fff;
            padding: .5rem 1rem;
            border-radius: .9rem;
            font-size: .74rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
        }

        .fis-cancel-btn:disabled { opacity: .45; cursor: not-allowed; }
        .fis-btn-spinner { width: 0.9rem; height: 0.9rem; border-radius: 999px; border: 2px solid rgba(255,255,255,0.42); border-top-color: #fff; animation: fisSpin .75s linear infinite; }
        .fis-cancel-input { width: 1rem; height: 1rem; accent-color: #c62828; }
        .durum-Onaylandi { background: #e0f2fe; color: #0369a1; }
        .durum-Hazirlaniyor { background: #dbeafe; color: #1d4ed8; }
        .durum-Hazir { background: #fff7ed; color: #c2410c; }
        .durum-TeslimEdildi { background: #dcfce7; color: #166534; }
        .durum-KismiOdendi { background: #fef3c7; color: #92400e; }
        .durum-TamOdendi { background: #e5e7eb; color: #374151; }
        .durum-Iptal { background: #fee2e2; color: #991b1b; }
        .durum-Iade { background: #ede9fe; color: #5b21b6; }

        @@keyframes fisSpin { to { transform: rotate(360deg); } }
        @@keyframes garsonNoticePulse { from { transform: scale(1); } to { transform: scale(1.05); } }

        .masa-fit-layout {
            height: 100%;
            min-height: 0;
            display: grid;
            grid-template-rows: auto minmax(0, 1fr);
            gap: 0.55rem;
        }

        .masa-main-grid {
            min-height: 0;
            display: grid;
            grid-template-columns: minmax(0, 4.15fr) minmax(220px, 0.85fr);
            gap: 0.6rem;
            align-items: stretch;
        }

        @@media (max-width: 1200px) { .masa-main-grid { grid-template-columns: minmax(0, 1fr); } #masaYanPanel { display: none; } }
    </style>
}

@await Html.PartialAsync("_GarsonMasaPanel", Model.Panel)

@section PageScripts {
    <script>
        let acikSiparisId = null;
        let refreshTimer = null;
        let lastRefreshAt = 0;
        let refreshInFlight = false;
        let garsonToastTimer = null;
        let garsonConfirmResolver = null;

        function durumLabel(durum) {
            const labels = {
                Onaylandi: 'Onaylandı',
                Hazirlaniyor: 'Hazırlanıyor',
                Hazir: 'Hazır',
                TeslimEdildi: 'Teslim Edildi',
                KismiOdendi: 'Kısmi Ödendi',
                TamOdendi: 'Tam Ödendi',
                Iptal: 'İptal',
                Iade: 'İade'
            };
            return labels[durum] || durum;
        }

        function escapeHtml(text) {
            return String(text || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        async function siparisDetayAc(id) {
            acikSiparisId = id;
            const overlay = document.getElementById('fisOverlay');
            const content = document.getElementById('fisContent');
            if (!overlay || !content) return;

            overlay.style.display = 'flex';
            content.innerHTML = '<div class="text-center text-stone-400 py-8">Yükleniyor...</div>';

            try {
                const res = await fetch(`/Garson/SiparisDetay/${id}`);
                const data = await res.json();
                if (!data.success) throw new Error(data.message || 'Sipariş bulunamadı.');

                let urunlerHtml = '';
                for (const d of data.detaylar || []) {
                    const checkboxEnabled = d.durum === 'Onaylandi' || d.durum === 'Hazir' || d.durum === 'TeslimEdildi';
                    let opsText = '';
                    if (d.opsiyonlar) {
                        try {
                            const parsed = JSON.parse(d.opsiyonlar);
                            if (Array.isArray(parsed) && parsed.length > 0) {
                                opsText = parsed.map(o => o.Ad + (o.EkFiyat > 0 ? ` (+${o.EkFiyat} TL)` : '')).join(', ');
                            } else {
                                opsText = d.opsiyonlar;
                            }
                        } catch (e) {
                            opsText = d.opsiyonlar;
                        }
                    }

                    urunlerHtml += `
                        <div class="fis-item-row" data-detail-id="${d.detayId}">
                            <input type="checkbox" class="fis-cancel-input" value="${d.detayId}" ${checkboxEnabled ? '' : 'disabled'}>
                            <div class="flex-1 min-w-0">
                                <div class="font-bold text-sm">${escapeHtml(d.urunAd)} x ${d.adet}</div>
                                ${opsText ? `<div class="text-xs text-stone-500 mt-0.5">${escapeHtml(opsText)}</div>` : ''}
                            </div>
                            <span class="durum-chip durum-${escapeHtml(d.durum)}">${escapeHtml(durumLabel(d.durum))}</span>
                        </div>`;
                }

                const teslimButonuAktif = data.durum === 'Hazir';
                const iptalButonuAktif = data.durum === 'Hazir' || data.durum === 'TeslimEdildi';

                content.innerHTML = `
                    <div data-fis-order-id="${data.id}">
                        <div class="mb-5">
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <h4 class="font-headline font-black text-xl text-on-surface">#${data.gunlukSiparisNo} - Masa ${data.masaNo ?? '-'}</h4>
                                    <p class="text-sm text-on-surface-variant">${data.olusturmaTarihi || ''}</p>
                                </div>
                                <span class="durum-chip durum-${escapeHtml(data.durum)}">${escapeHtml(durumLabel(data.durum))}</span>
                            </div>
                            <div class="mt-3 text-sm font-semibold">${Number(data.toplamTutar || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} TL</div>
                        </div>
                        <div class="rounded-2xl border p-4">${urunlerHtml || '<div class="text-sm text-stone-500">Detay bulunamadı.</div>'}</div>
                        <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
                            <button type="button" class="px-4 py-2 rounded-xl bg-sky-600 text-white text-sm font-bold disabled:opacity-40" ${teslimButonuAktif ? '' : 'disabled'} onclick="durumGuncelle(${data.id}, 'TeslimEdildi')">Teslim Et</button>
                            <button type="button" class="px-4 py-2 rounded-xl border border-red-300 bg-red-50 text-red-700 text-sm font-bold disabled:opacity-40" ${iptalButonuAktif ? '' : 'disabled'} onclick="siparisIptalEt(${data.id})">Siparişi İptal Et</button>
                            <button type="button" id="garsonFisCancelBtn" class="fis-cancel-btn" data-cancel-selected disabled>
                                <span class="fis-btn-spinner hidden" id="garsonFisCancelSpinner"></span>
                                <span>Seçilenleri İptal Et</span>
                            </button>
                        </div>
                    </div>`;

                bindFisSelection();
                updateGarsonFisSelection();
            } catch (err) {
                console.error(err);
                content.innerHTML = '<div class="text-center text-red-500 py-8">Detay yüklenemedi.</div>';
            }
        }

        function bindFisSelection() {
            document.querySelectorAll('#fisContent .fis-item-row').forEach(row => {
                row.addEventListener('click', (e) => {
                    if (e.target.closest('input,button,a,label')) return;
                    const cb = row.querySelector('.fis-cancel-input');
                    if (cb && !cb.disabled) {
                        cb.checked = !cb.checked;
                        updateGarsonFisSelection();
                    }
                });
            });
        }

        function updateGarsonFisSelection() {
            const root = document.querySelector('#fisContent [data-fis-order-id]');
            if (!root) return;

            let selectedCount = 0;
            root.querySelectorAll('.fis-item-row').forEach(row => {
                const checked = row.querySelector('.fis-cancel-input')?.checked;
                row.classList.toggle('is-selected', Boolean(checked));
                if (checked) selectedCount += 1;
            });

            const cancelBtn = root.querySelector('[data-cancel-selected]');
            if (cancelBtn) {
                cancelBtn.disabled = selectedCount === 0;
            }
        }

        function collectGarsonCancelDetails() {
            const selectionMap = new Map();
            document.querySelectorAll('#fisContent .fis-cancel-input:checked').forEach(input => {
                const detailId = Number.parseInt(input.value, 10);
                if (Number.isFinite(detailId)) {
                    selectionMap.set(detailId, (selectionMap.get(detailId) || 0) + 1);
                }
            });

            const result = [];
            selectionMap.forEach((adet, siparisDetayId) => result.push({ siparisDetayId, adet }));
            return result;
        }

        async function garsonIptalSeciliDetaylar() {
            const detaylar = collectGarsonCancelDetails();
            if (!detaylar.length) return;

            const onay = await showGarsonConfirm({
                title: 'Seçili İptal Onayı',
                message: `Seçilen ${detaylar.length} kalem iptal edilsin mi?`,
                okText: 'Seçilenleri İptal Et',
                cancelText: 'Vazgeç',
                tone: 'danger'
            });
            if (!onay) return;

            const cancelBtn = document.getElementById('garsonFisCancelBtn');
            const spinner = document.getElementById('garsonFisCancelSpinner');
            const labelEl = cancelBtn?.querySelector('span:not(.fis-btn-spinner)');
            const originalText = labelEl ? labelEl.innerText : 'Seçilenleri İptal Et';

            if (cancelBtn) {
                cancelBtn.disabled = true;
                if (spinner) spinner.classList.remove('hidden');
                if (labelEl) labelEl.innerText = 'İşleniyor...';
            }

            try {
                const res = await fetch('/Garson/SiparisDetayIptal', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ masaId: @Model.MasaId, detaylar })
                });

                const result = await res.json();
                if (!result.success) {
                    showGarsonToast('Hata: ' + (result.message || 'Bilinmeyen hata'), 'error');
                    return;
                }

                showGarsonToast('Seçilen kalemler iptal edildi.', 'success');
                fisKapat();
                scheduleSoftRefresh(40);
            } catch (err) {
                console.error(err);
                showGarsonToast('İptal işlemi sırasında bağlantı hatası oluştu.', 'error');
            } finally {
                if (cancelBtn) {
                    cancelBtn.disabled = false;
                    if (spinner) spinner.classList.add('hidden');
                    if (labelEl) labelEl.innerText = originalText;
                }
                updateGarsonFisSelection();
            }
        }

        function fisKapat() {
            const overlay = document.getElementById('fisOverlay');
            if (overlay) overlay.style.display = 'none';
            acikSiparisId = null;
        }

        function showGarsonToast(message, type = 'error') {
            const toast = document.getElementById('garsonToast');
            const card = document.getElementById('garsonToastCard');
            const icon = document.getElementById('garsonToastIcon');
            const msg = document.getElementById('garsonToastMessage');
            if (!toast || !card || !icon || !msg) return;

            const themes = {
                success: { cardClass: 'max-w-[360px] flex items-start gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-700 shadow-xl', icon: 'check_circle' },
                info: { cardClass: 'max-w-[360px] flex items-start gap-2 rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sky-700 shadow-xl', icon: 'info' },
                error: { cardClass: 'max-w-[360px] flex items-start gap-2 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-700 shadow-xl', icon: 'error' }
            };

            const theme = themes[type] || themes.error;
            card.className = theme.cardClass;
            icon.textContent = theme.icon;
            msg.textContent = message;
            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');

            if (garsonToastTimer) clearTimeout(garsonToastTimer);
            garsonToastTimer = setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
            }, 3200);
        }

        function showGarsonConfirm({ title, message, okText = 'Onayla', cancelText = 'Vazgeç', tone = 'primary' }) {
            const modal = document.getElementById('garsonConfirmModal');
            const titleEl = document.getElementById('garsonConfirmTitle');
            const messageEl = document.getElementById('garsonConfirmMessage');
            const okBtn = document.getElementById('garsonConfirmOkBtn');
            const cancelBtn = document.getElementById('garsonConfirmCancelBtn');
            if (!modal || !titleEl || !messageEl || !okBtn || !cancelBtn) return Promise.resolve(false);

            titleEl.textContent = title;
            messageEl.textContent = message;
            okBtn.textContent = okText;
            cancelBtn.textContent = cancelText;
            okBtn.className = tone === 'danger'
                ? 'px-4 py-2 rounded-xl bg-red-600 text-white text-sm font-bold hover:bg-red-700 transition-colors'
                : 'px-4 py-2 rounded-xl bg-sky-600 text-white text-sm font-bold hover:bg-sky-700 transition-colors';

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            return new Promise(resolve => { garsonConfirmResolver = resolve; });
        }

        function closeGarsonConfirm(accepted) {
            const modal = document.getElementById('garsonConfirmModal');
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            if (garsonConfirmResolver) {
                const resolve = garsonConfirmResolver;
                garsonConfirmResolver = null;
                resolve(Boolean(accepted));
            }
        }

        async function durumGuncelle(id, durum) {
            try {
                const res = await fetch(`/Garson/DurumGuncelle/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ yeniDurum: durum })
                });
                const result = await res.json();
                if (!result.success) {
                    showGarsonToast('Hata: ' + result.message, 'error');
                    return;
                }

                if (durum === 'TeslimEdildi') {
                    showGarsonToast('Sipariş teslim edildi.', 'success');
                }

                fisKapat();
                scheduleSoftRefresh(40);
            } catch (e) {
                console.error(e);
                showGarsonToast('Bağlantı hatası. Lütfen tekrar deneyin.', 'error');
            }
        }

        async function topluTeslimEt(masaId) {
            const onay = await showGarsonConfirm({
                title: 'Toplu Teslim Onayı',
                message: 'Hazır durumdaki tüm siparişler teslim edildi olarak işaretlenecek. Devam edilsin mi?',
                okText: 'Toplu Teslim Et',
                cancelText: 'Vazgeç'
            });
            if (!onay) return;

            try {
                const res = await fetch(`/Garson/Masa/${masaId}/TopluTeslimEt`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await res.json();
                if (!result.success) {
                    showGarsonToast('Hata: ' + result.message, 'error');
                    return;
                }

                showGarsonToast(`${Number(result.affectedCount || 0)} sipariş teslim edildi.`, 'success');
                scheduleSoftRefresh(40);
            } catch (e) {
                console.error(e);
                showGarsonToast('Toplu teslim işlemi sırasında bağlantı hatası oluştu.', 'error');
            }
        }

        async function siparisIptalEt(id) {
            const onay = await showGarsonConfirm({
                title: 'Sipariş İptal Onayı',
                message: 'Bu siparişi iptal etmek istediğinize emin misiniz?',
                okText: 'Siparişi İptal Et',
                cancelText: 'Vazgeç',
                tone: 'danger'
            });
            if (!onay) return;
            durumGuncelle(id, 'Iptal');
        }

        function toggleGecmisPanel() {
            const panel = document.getElementById('gecmisSiparisPanel');
            if (panel) panel.classList.toggle('hidden');
        }

        function closeGecmisPanel() {
            const panel = document.getElementById('gecmisSiparisPanel');
            if (panel) panel.classList.add('hidden');
        }

        async function softRefreshMasaSiparisleri() {
            if (refreshInFlight) return;
            refreshInFlight = true;
            try {
                // Mevcut uyarı durumu kaybolmasın diye cache'le
                const noticeOverlay = document.getElementById('garsonNoticeOverlay');
                const isNoticeVisible = noticeOverlay && noticeOverlay.style.display !== 'none';
                const noticeText = isNoticeVisible ? document.getElementById('garsonNoticeText').textContent : '';

                const res = await fetch(window.location.pathname, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Masa sipariş verisi alınamadı.');

                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const incoming = doc.getElementById('garsonMasaPanelRoot');
                const current = document.getElementById('garsonMasaPanelRoot');
                if (incoming && current) {
                    current.outerHTML = incoming.outerHTML;

                    // Eğer uyarı aktiftiyse DOM yenilendikten sonra geri getir
                    if (isNoticeVisible) {
                        const newOverlay = document.getElementById('garsonNoticeOverlay');
                        const newText = document.getElementById('garsonNoticeText');
                        if (newOverlay && newText) {
                            newText.textContent = noticeText;
                            newOverlay.style.display = 'flex';
                        }
                    }
                }

                if (acikSiparisId) {
                    await siparisDetayAc(acikSiparisId);
                }
            } catch (err) {
                console.error(err);
            } finally {
                refreshInFlight = false;
            }
        }

        function scheduleSoftRefresh(delayMs = 70) {
            const minIntervalMs = 150;
            const elapsed = Date.now() - lastRefreshAt;
            const waitMs = Math.max(delayMs, minIntervalMs - elapsed);
            if (refreshTimer) return;
            refreshTimer = setTimeout(async () => {
                refreshTimer = null;
                lastRefreshAt = Date.now();
                await softRefreshMasaSiparisleri();
            }, Math.max(0, waitMs));
        }

        function buildConnection(useFallbackTransports) {
            const options = useFallbackTransports
                ? { transport: signalR.HttpTransportType.ServerSentEvents | signalR.HttpTransportType.LongPolling }
                : undefined;

            return new signalR.HubConnectionBuilder()
                .withUrl('/hubs/order', options)
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Error)
                .build();
        }

        function registerConnectionHandlers(conn) {
            conn.on('SiparisGeldi', () => {
                scheduleSoftRefresh(100);
            });
            conn.on('SiparisEklendi', () => scheduleSoftRefresh(100));
            conn.on('GarsonCagrisi', (masaNo) => {
                showGarsonNotice('Masa ' + (masaNo || '?') + ' garson çağırıyor!');
                playNoticeSound();
                scheduleSoftRefresh(80);
            });
            conn.on('SiparisGuncellendi', () => {
                const overlay = document.getElementById('garsonNoticeOverlay');
                if (overlay && overlay.style.display === 'flex') return;
                scheduleSoftRefresh(70);
            });
            conn.on('SiparisHazir', (masaNo) => {
                showGarsonNotice(`Masa ${masaNo} Siparişi Hazır!`);
                playNoticeSound();
                scheduleSoftRefresh(50);
            });
            conn.on('SiparisIptal', () => scheduleSoftRefresh(60));
            conn.on('OdemeYapildi', () => scheduleSoftRefresh(50));
        }

        let connection = buildConnection(false);
        registerConnectionHandlers(connection);

        async function startConnection(conn, allowFallback) {
            try {
                await conn.start();
            } catch (err) {
                console.error('SignalR Hatası:', err);
                if (!allowFallback) return;
                try { await conn.stop(); } catch {}
                connection = buildConnection(true);
                registerConnectionHandlers(connection);
                await startConnection(connection, false);
            }
        }

        startConnection(connection, true);

        function showGarsonNotice(text) {
            const textNode = document.getElementById('garsonNoticeText');
            const overlay = document.getElementById('garsonNoticeOverlay');
            if (!textNode || !overlay) return;
            textNode.textContent = text;
            overlay.style.display = 'flex';
        }

        function closeGarsonNotice() {
            const overlay = document.getElementById('garsonNoticeOverlay');
            if (overlay) overlay.style.display = 'none';
            scheduleSoftRefresh(40);
        }

        function playNoticeSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.type = 'sine';
                const now = ctx.currentTime;
                osc.frequency.setValueAtTime(880, now);
                osc.frequency.exponentialRampToValueAtTime(440, now + 0.45);
                gain.gain.setValueAtTime(0.45, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);
                osc.start(now);
                osc.stop(now + 0.45);
            } catch {}
        }

        document.addEventListener('click', (event) => {
            const widget = document.getElementById('gecmisSiparisWidget');
            if (widget && !widget.contains(event.target)) {
                closeGecmisPanel();
            }

            const cancelBtn = event.target.closest('[data-cancel-selected]');
            if (cancelBtn) {
                event.preventDefault();
                if (!cancelBtn.disabled) garsonIptalSeciliDetaylar();
            }
        });

        document.addEventListener('change', (event) => {
            if (event.target.closest('.fis-cancel-input')) {
                updateGarsonFisSelection();
            }
        });

        document.addEventListener('click', (event) => {
            const modal = document.getElementById('garsonConfirmModal');
            if (modal && !modal.classList.contains('hidden') && event.target === modal) {
                closeGarsonConfirm(false);
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                const confirmModal = document.getElementById('garsonConfirmModal');
                if (confirmModal && !confirmModal.classList.contains('hidden')) {
                    closeGarsonConfirm(false);
                } else {
                    fisKapat();
                }
            }
        });
    </script>
}

