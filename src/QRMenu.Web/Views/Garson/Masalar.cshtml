@model QRMenu.Web.ViewModels.GarsonMasalarPageViewModel

@{
    Layout = "~/Views/Shared/_GarsonLayout.cshtml";
    ViewData["GarsonPageTitle"] = "Masa Yönetimi";
    ViewData["GarsonActivePage"] = "Masalar";
    ViewData["GarsonContentClass"] = "p-4 sm:p-6 lg:p-8 flex-1 overflow-y-auto";
}

@section PageStyles {
    <style>
        .table-card {
            transition: all 0.3s ease;
            box-shadow: 0 8px 24px rgba(46, 47, 47, 0.06);
        }

        .table-card:hover {
            transform: translateY(-4px) scale(1.015);
            box-shadow: 0 16px 30px rgba(46, 47, 47, 0.11);
        }

        .table-card-hazir {
            border-left: 5px solid #f59e0b;
            animation: hazirPulse 1.4s ease-in-out infinite alternate;
        }

        .table-card-dolu {
            border-left: 5px solid #a23718;
        }

        .table-card-hesap {
            border-left: 5px solid #765600;
        }

        .table-card-bos {
            border-left: 5px solid #16a34a;
        }

        @@keyframes hazirPulse {
            from { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.22); }
            to { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0.03); }
        }

        @@keyframes garsonNoticePulse {
            from { transform: scale(1); }
            to { transform: scale(1.05); }
        }
    </style>
}

@await Html.PartialAsync("_GarsonMasalarContent", Model)

@section PageScripts {
    <script>
        function garsonSettingEnabled(key, fallback) {
            try {
                const raw = localStorage.getItem(key);
                return raw === null ? fallback : raw === '1';
            } catch {
                return fallback;
            }
        }

        let refreshTimer = null;
        let lastRefreshAt = 0;
        let refreshInFlight = false;

        async function softRefreshMasalarGrid() {
            if (refreshInFlight) return;
            refreshInFlight = true;

            try {
                // Mevcut uyarı durumunu sakla (Masa * siparişi hazır vb.)
                const noticeOverlay = document.getElementById('garsonNoticeOverlay');
                const isNoticeVisible = noticeOverlay && noticeOverlay.style.display !== 'none';
                const noticeText = isNoticeVisible ? document.getElementById('garsonNoticeText').textContent : '';

                const res = await fetch(window.location.pathname, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Masalar verisi alınamadı.');

                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const incoming = doc.getElementById('garsonMasalarContentRoot');
                const current = document.getElementById('garsonMasalarContentRoot');

                if (incoming && current) {
                    current.outerHTML = incoming.outerHTML;

                    // Eğer uyarı varsa yeni değiştirilen DOM üzerinde tekrar aç
                    if (isNoticeVisible) {
                        const newOverlay = document.getElementById('garsonNoticeOverlay');
                        const newText = document.getElementById('garsonNoticeText');
                        if (newOverlay && newText) {
                            newText.textContent = noticeText;
                            newOverlay.style.display = 'flex';
                        }
                    }
                }
            } catch (err) {
                console.error(err);
                console.warn('Garson masalar içeriği güncellenemedi, mevcut görünüm korunuyor.');
            } finally {
                refreshInFlight = false;
            }
        }

        function scheduleSoftRefresh(delayMs = 90) {
            const minIntervalMs = 150;
            const elapsed = Date.now() - lastRefreshAt;
            const waitMs = Math.max(delayMs, minIntervalMs - elapsed);

            if (refreshTimer) return;

            refreshTimer = setTimeout(async () => {
                refreshTimer = null;
                lastRefreshAt = Date.now();
                await softRefreshMasalarGrid();
            }, Math.max(0, waitMs));
        }

        function buildConnection(useFallbackTransports) {
            const options = useFallbackTransports
                ? { transport: signalR.HttpTransportType.ServerSentEvents | signalR.HttpTransportType.LongPolling }
                : undefined;

            return new signalR.HubConnectionBuilder()
                .withUrl('/hubs/order', options)
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Error)
                .build();
        }

        function registerConnectionHandlers(conn) {
            conn.on('SiparisGeldi', () => {
                scheduleSoftRefresh(100);
            });
            conn.on('SiparisEklendi', () => scheduleSoftRefresh(100));
            conn.on('SiparisGuncellendi', () => {
                const overlay = document.getElementById('garsonNoticeOverlay');
                if (overlay && overlay.style.display === 'flex') return;
                scheduleSoftRefresh(80);
            });
            conn.on('GarsonCagrisi', (masaNo) => {
                if (garsonSettingEnabled('garsonNoticeOverlay', true)) {
                    showGarsonNotice('Masa ' + (masaNo || '?') + ' garson çağırıyor!');
                }
                if (garsonSettingEnabled('garsonNoticeSound', true)) {
                    playNoticeSound();
                }
                scheduleSoftRefresh(80);
            });
            conn.on('SiparisHazir', (masaNo) => {
                if (garsonSettingEnabled('garsonNoticeOverlay', true)) {
                    showGarsonNotice('Masa ' + masaNo + ' siparişi hazır!');
                }
                if (garsonSettingEnabled('garsonNoticeSound', true)) {
                    playNoticeSound();
                }
                scheduleSoftRefresh(60);
            });
            conn.on('SiparisIptal', () => scheduleSoftRefresh(70));
            conn.on('OdemeYapildi', () => scheduleSoftRefresh(60));
        }

        let connection = buildConnection(false);
        registerConnectionHandlers(connection);

        async function startConnection(conn, allowFallback) {
            try {
                await conn.start();
            } catch (err) {
                console.error('SignalR hatası:', err);
                if (!allowFallback) return;

                try { await conn.stop(); } catch {}

                connection = buildConnection(true);
                registerConnectionHandlers(connection);
                await startConnection(connection, false);
            }
        }

        startConnection(connection, true);

        function showGarsonNotice(text) {
            const textNode = document.getElementById('garsonNoticeText');
            const overlay = document.getElementById('garsonNoticeOverlay');
            if (!textNode || !overlay) return;

            textNode.textContent = text;
            overlay.style.display = 'flex';
        }

        function closeGarsonNotice() {
            const overlay = document.getElementById('garsonNoticeOverlay');
            if (!overlay) return;

            overlay.style.display = 'none';
            scheduleSoftRefresh(50);
        }

        function playNoticeSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.type = 'sine';
                const now = ctx.currentTime;
                osc.frequency.setValueAtTime(880, now);
                osc.frequency.exponentialRampToValueAtTime(440, now + 0.45);
                gain.gain.setValueAtTime(0.45, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);
                osc.start(now);
                osc.stop(now + 0.45);
            } catch {
                console.log('Bildirim sesi çalınamadı.');
            }
        }
    </script>
}

