@model List<QRMenu.Core.Entities.Masa>
@using System.Globalization
@{
    Layout = "~/Views/Shared/_GarsonLayout.cshtml";
    ViewData["GarsonPageTitle"] = "Masa Yönetimi";
    ViewData["GarsonActivePage"] = "Masalar";
    ViewData["GarsonContentClass"] = "p-4 sm:p-6 lg:p-8 flex-1 overflow-y-auto";

    var trCulture = CultureInfo.GetCultureInfo("tr-TR");

    var musaitMasaSayisi = 0;
    var doluMasaSayisi = 0;
    var hesapBekleyenMasaSayisi = 0;
    var toplamMasaSayisi = Model.Count;

    foreach (var masa in Model)
    {
        var aktifSiparisler = masa.Siparisler
            .Where(s => s.Durum != QRMenu.Core.Enums.SiparisDurum.TamOdendi
                        && s.Durum != QRMenu.Core.Enums.SiparisDurum.Iptal
                        && s.Durum != QRMenu.Core.Enums.SiparisDurum.Iade)
            .ToList();

        var siparisVarMi = aktifSiparisler.Any();
        var hesapBekliyorMu = aktifSiparisler.Any(s =>
            s.Durum == QRMenu.Core.Enums.SiparisDurum.TeslimEdildi ||
            s.Durum == QRMenu.Core.Enums.SiparisDurum.KismiOdendi);

        if (siparisVarMi)
            doluMasaSayisi++;
        else
            musaitMasaSayisi++;

        if (hesapBekliyorMu)
            hesapBekleyenMasaSayisi++;
    }
}

@section PageStyles {
    <style>
        .table-card {
            transition: all 0.3s ease;
            box-shadow: 0 8px 24px rgba(46, 47, 47, 0.06);
        }

        .table-card:hover {
            transform: translateY(-4px) scale(1.015);
            box-shadow: 0 16px 30px rgba(46, 47, 47, 0.11);
        }

        .table-card-hazir {
            border-left: 5px solid #f59e0b;
            animation: hazirPulse 1.4s ease-in-out infinite alternate;
        }

        .table-card-dolu {
            border-left: 5px solid #a23718;
        }

        .table-card-hesap {
            border-left: 5px solid #765600;
        }

        .table-card-bos {
            border-left: 5px solid #16a34a;
        }

        @@keyframes hazirPulse {
            from {
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.22);
            }
            to {
                box-shadow: 0 0 0 10px rgba(245, 158, 11, 0.03);
            }
        }

        @@keyframes garsonNoticePulse {
            from {
                transform: scale(1);
            }
            to {
                transform: scale(1.05);
            }
        }

        @@media (max-width: 640px) {
            .table-card {
                border-left-width: 4px;
            }

            #garsonNoticeOverlay h1 {
                font-size: 1.65rem !important;
            }

            #garsonNoticeOverlay p {
                font-size: 0.9rem !important;
            }
        }
    </style>
}

<div id="garsonSummaryStats" class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6 mb-6 sm:mb-10">
    <div class="bg-surface-container-lowest p-4 sm:p-6 rounded-xl border-b-4 border-green-500/30">
        <p class="text-xs sm:text-sm font-label text-on-surface-variant mb-1">Müsait</p>
        <p class="text-2xl sm:text-3xl font-headline font-bold text-on-surface">@musaitMasaSayisi</p>
    </div>
    <div class="bg-surface-container-lowest p-4 sm:p-6 rounded-xl border-b-4 border-primary/30">
        <p class="text-xs sm:text-sm font-label text-on-surface-variant mb-1">Dolu</p>
        <p class="text-2xl sm:text-3xl font-headline font-bold text-on-surface">@doluMasaSayisi</p>
    </div>
    <div class="bg-surface-container-lowest p-4 sm:p-6 rounded-xl border-b-4 border-secondary/30">
        <p class="text-xs sm:text-sm font-label text-on-surface-variant mb-1">Hesap Bekleyen</p>
        <p class="text-2xl sm:text-3xl font-headline font-bold text-on-surface">@hesapBekleyenMasaSayisi</p>
    </div>
    <div class="bg-surface-container-lowest p-4 sm:p-6 rounded-xl border-b-4 border-tertiary/30">
        <p class="text-xs sm:text-sm font-label text-on-surface-variant mb-1">Toplam Masa</p>
        <p class="text-2xl sm:text-3xl font-headline font-bold text-on-surface">@toplamMasaSayisi</p>
    </div>
</div>

<div id="garsonMasalarGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4 sm:gap-6 lg:gap-8">
    @foreach (var masa in Model.OrderBy(m => m.MasaNo))
    {
        var aktifSiparisler = masa.Siparisler
            .Where(s => s.Durum != QRMenu.Core.Enums.SiparisDurum.TamOdendi
                        && s.Durum != QRMenu.Core.Enums.SiparisDurum.Iptal
                        && s.Durum != QRMenu.Core.Enums.SiparisDurum.Iade)
            .ToList();

        var siparisVarMi = aktifSiparisler.Any();
        var hesapBekliyorMu = aktifSiparisler.Any(s =>
            s.Durum == QRMenu.Core.Enums.SiparisDurum.TeslimEdildi ||
            s.Durum == QRMenu.Core.Enums.SiparisDurum.KismiOdendi);
        var hazirBekliyorMu = aktifSiparisler.Any(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.Hazir);

        var kartSinif = "table-card-bos";
        var badgeSinif = "bg-green-100 text-green-700";
        var badgeYazi = "BOŞ";

        if (hesapBekliyorMu)
        {
            kartSinif = "table-card-hesap";
            badgeSinif = "bg-secondary/10 text-secondary";
            badgeYazi = "HESAP";
        }
        else if (siparisVarMi)
        {
            kartSinif = hazirBekliyorMu ? "table-card-hazir" : "table-card-dolu";
            badgeSinif = "bg-primary/10 text-primary";
            badgeYazi = "DOLU";
        }

        var toplamTutar = aktifSiparisler.Sum(s => s.ToplamTutar);
        var ilkSiparis = aktifSiparisler.OrderBy(s => s.OlusturmaTarihi).FirstOrDefault();
        var gecenDakika = ilkSiparis == null ? 0 : Math.Max(1, (int)(DateTime.UtcNow - ilkSiparis.OlusturmaTarihi).TotalMinutes);

        <a href="/Garson/Masa/@masa.Id" class="group relative bg-surface-container-lowest rounded-xl p-5 sm:p-6 table-card @kartSinif cursor-pointer text-decoration-none text-on-surface">
            <div class="flex justify-between items-start mb-8 sm:mb-12">
                <div class="w-12 h-12 rounded-lg @(siparisVarMi ? "bg-primary-container/20 text-primary" : "bg-surface-container") flex items-center justify-center font-headline font-extrabold text-xl">
                    @masa.MasaNo.ToString("00")
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest @badgeSinif">@badgeYazi</span>
            </div>
            <div class="space-y-1">
                @if (!siparisVarMi)
                {
                    <p class="text-on-surface-variant text-sm font-medium">Bekleyen sipariş yok</p>
                }
                else if (hesapBekliyorMu)
                {
                    <p class="text-on-surface font-semibold text-sm">@toplamTutar.ToString("C2", trCulture)</p>
                    <div class="flex items-center gap-1.5 text-secondary text-xs font-bold">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">payments</span>
                        <span>Ödeme bekleniyor</span>
                    </div>
                }
                else
                {
                    <p class="text-on-surface font-semibold text-sm">@toplamTutar.ToString("C2", trCulture)</p>
                    <div class="flex items-center gap-1.5 text-on-surface-variant text-xs">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">schedule</span>
                        <span>@gecenDakika dk.</span>
                    </div>
                    @if (hazirBekliyorMu)
                    {
                        <div class="flex items-center gap-1.5 text-error text-xs font-bold">
                            <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">warning</span>
                            <span>Servis bekliyor</span>
                        </div>
                    }
                }
            </div>
        </a>
    }
</div>

<div id="garsonNoticeOverlay" style="display:none; position:fixed; inset:0; z-index:99999; background:rgba(0,0,0,0.85); justify-content:center; align-items:center; flex-direction:column; cursor:pointer;" onclick="closeGarsonNotice()">
    <div style="text-align:center; animation: garsonNoticePulse 0.6s ease-in-out infinite alternate;">
        <div style="font-size:4.5rem; color:#fcd34d;">🔔</div>
        <h1 style="color:#fff; font-size:2.4rem; margin:1rem 0; font-weight:800;" id="garsonNoticeText">Masa</h1>
        <p style="color:rgba(255,255,255,0.72); font-size:1.05rem;">Kapatmak için tıklayın</p>
    </div>
</div>

@section PageScripts {
    <script>
        function garsonSettingEnabled(key, fallback) {
            try {
                const raw = localStorage.getItem(key);
                if (raw === null) {
                    return fallback;
                }

                return raw === '1';
            } catch (e) {
                return fallback;
            }
        }

        let refreshTimer = null;
        let lastRefreshAt = 0;
        let refreshInFlight = false;

        async function softRefreshMasalarGrid() {
            if (refreshInFlight) return;
            refreshInFlight = true;

            try {
                const res = await fetch(window.location.pathname, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Masalar verisi alınamadı.');

                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const yeniGrid = doc.getElementById('garsonMasalarGrid');
                const mevcutGrid = document.getElementById('garsonMasalarGrid');
                const yeniOzet = doc.getElementById('garsonSummaryStats');
                const mevcutOzet = document.getElementById('garsonSummaryStats');

                if (yeniGrid && mevcutGrid) {
                    mevcutGrid.innerHTML = yeniGrid.innerHTML;
                }

                if (yeniOzet && mevcutOzet) {
                    mevcutOzet.innerHTML = yeniOzet.innerHTML;
                }
            } catch (err) {
                console.error(err);
                console.warn('Garson masalar içeriği güncellenemedi, mevcut görünüm korunuyor.');
            } finally {
                refreshInFlight = false;
            }
        }

        function scheduleSoftRefresh(delayMs = 500) {
            const minIntervalMs = 2500;
            const elapsed = Date.now() - lastRefreshAt;
            const waitMs = Math.max(delayMs, minIntervalMs - elapsed);

            if (refreshTimer) return;

            refreshTimer = setTimeout(async () => {
                refreshTimer = null;
                lastRefreshAt = Date.now();
                await softRefreshMasalarGrid();
            }, Math.max(0, waitMs));
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/order')
            .withAutomaticReconnect()
            .build();

        connection.on('SiparisGeldi', function () {
            scheduleSoftRefresh(900);
        });

        connection.on('SiparisEklendi', function () {
            scheduleSoftRefresh(900);
        });

        connection.on('SiparisGuncellendi', function () {
            const overlay = document.getElementById('garsonNoticeOverlay');
            if (overlay && overlay.style.display === 'flex') {
                return;
            }
            scheduleSoftRefresh(500);
        });

        connection.on('GarsonCagrisi', function () {
            scheduleSoftRefresh(400);
        });

        connection.on('SiparisHazir', function (masaNo) {
            if (garsonSettingEnabled('garsonNoticeOverlay', true)) {
                showGarsonNotice('Masa ' + masaNo + ' siparişi hazır!');
            }

            if (garsonSettingEnabled('garsonNoticeSound', true)) {
                playNoticeSound();
            }

            scheduleSoftRefresh(350);
        });

        connection.on('SiparisIptal', function () {
            scheduleSoftRefresh(400);
        });

        connection.on('OdemeYapildi', function () {
            scheduleSoftRefresh(300);
        });

        connection.start().catch(err => console.error('SignalR hatası:', err));

        function showGarsonNotice(text) {
            const textNode = document.getElementById('garsonNoticeText');
            const overlay = document.getElementById('garsonNoticeOverlay');
            if (!textNode || !overlay) return;

            textNode.textContent = text;
            overlay.style.display = 'flex';
        }

        function closeGarsonNotice() {
            const overlay = document.getElementById('garsonNoticeOverlay');
            if (!overlay) return;

            overlay.style.display = 'none';
            scheduleSoftRefresh(100);
        }

        function playNoticeSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.type = 'sine';
                const now = ctx.currentTime;
                osc.frequency.setValueAtTime(880, now);
                osc.frequency.exponentialRampToValueAtTime(440, now + 0.45);
                gain.gain.setValueAtTime(0.45, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);
                osc.start(now);
                osc.stop(now + 0.45);
            } catch (e) {
                console.log('Bildirim sesi çalınamadı.');
            }
        }
    </script>
}