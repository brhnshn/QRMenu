@model List<QRMenu.Web.ViewModels.QrKodViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Masalar";
    ViewData["ActivePage"] = "Masalar";
    ViewData["PageTitle"] = "Masalar & Bölgeler Yönetimi";
    var bolgeler = ViewBag.Bolgeler as List<QRMenu.Core.Entities.Bolge> ?? new();
}

@section Styles {
    <link href="~/css/admin-masalar.css" rel="stylesheet" />
    <style>
        .kategori-section { background: white; padding: 1.5rem; border-radius: 1rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); margin-bottom: 2rem; }
        .kategori-list { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
        .kategori-chip { background: #f8f9fa; border: 1px solid #e9ecef; padding: 0.5rem 1rem; border-radius: 50rem; display: flex; align-items: center; gap: 0.5rem; font-weight: 500; font-size: 0.9rem; color: #495057; }
        .kategori-chip .chip-count { background: #0d6efd; color: white; border-radius: 50rem; padding: 0.1rem 0.5rem; font-size: 0.75rem; }
        .kategori-chip .chip-actions button { background: none; border: none; padding: 0; color: #adb5bd; transition: 0.2s; cursor: pointer; }
        .kategori-chip .chip-actions button:hover { color: #0d6efd; }
        .kategori-chip .chip-actions .btn-chip-delete:hover { color: #dc3545; }
        .btn-kategori-ekle { background: #e0f8e9; color: #198754; border: none; padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.85rem; transition: 0.2s; }
        .btn-kategori-ekle:hover { background: #198754; color: white; }
    </style>
}

<!-- ===== BÖLGE YÖNETİMİ ===== -->
<div class="kategori-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-geo-alt-fill text-primary"></i> Bölge Yönetimi</h6>
        <button class="btn-kategori-ekle" onclick="bolgeModal()">
            <i class="bi bi-plus-lg"></i> Bölge Ekle
        </button>
    </div>
    <div class="kategori-list" id="bolgeList">
        @foreach (var b in bolgeler)
        {
            var masaSayisi = Model.Count(m => m.BolgeId == b.Id);
            <div class="kategori-chip">
                <span>@b.Ad</span>
                <span class="chip-count">@masaSayisi Masa</span>
                <div class="chip-actions ms-2">
                    <button title="Düzenle" onclick="bolgeModal(@b.Id, '@b.Ad.Replace("'","\\'")', @b.SiraNo)"><i class="bi bi-pencil"></i></button>
                    <button class="btn-chip-delete" title="Sil" onclick="bolgeSil(@b.Id, '@b.Ad.Replace("'","\\'")')"><i class="bi bi-trash"></i></button>
                </div>
            </div>
        }
        @if (!bolgeler.Any())
        {
            <span class="text-muted small">Henüz bölge eklenmemiş. Önce masa bölgelerini oluşturun.</span>
        }
    </div>
</div>

<!-- Başlık + Yeni Masa Butonu -->
<div class="content-header d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i> Masa Listesi</h5>
    <button class="btn btn-primary px-4 rounded-pill shadow-sm" onclick="masaModal()">
        <i class="bi bi-plus-lg"></i> Yeni Masa Ekle
    </button>
</div>

<div id="mesaj"></div>

<!-- Masa Kartları -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3" id="masaGrid">
    @foreach (var item in Model)
    {
        <div class="col" id="col-@item.MasaNo">
            <div class="masa-card">
                <div class="masa-card-body">
                    <div class="masa-no">Masa @item.MasaNo</div>
                    <div class="masa-bolge text-muted small mb-2"><i class="bi bi-geo-alt"></i> Bölge: @(item.BolgeAd ?? "Belirtilmedi")</div>
                    <span class="masa-durum @(item.DoluMu ? "durum-dolu" : "durum-bos")">
                        <i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> @(item.DoluMu ? "Dolu" : "Boş")
                    </span>

                    <div class="qr-area">
                        <div class="qr-placeholder-sm" id="placeholder-@item.MasaNo"
                             style="@(string.IsNullOrEmpty(item.QrUrl) ? "" : "display:none")">
                            <span>QR Yok</span>
                        </div>
                        <img class="qr-img-sm" id="qr-img-@item.MasaNo" alt="QR"
                             style="@(string.IsNullOrEmpty(item.QrUrl) ? "display:none" : "")" />
                    </div>

                    @if (!string.IsNullOrEmpty(item.QrUrl))
                    {
                        <span class="badge bg-success" style="font-size:0.65rem;" id="qrbadge-@item.MasaNo">QR Aktif</span>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-primary" onclick="olustur(@item.MasaNo)" id="qrolustur-@item.MasaNo" style="font-size:0.75rem;">
                            <i class="bi bi-qr-code"></i> QR Oluştur
                        </button>
                    }
                </div>
                <div class="masa-card-footer">
                    <button class="footer-btn btn-qr @(string.IsNullOrEmpty(item.QrUrl) ? "d-none" : "")"
                            id="indir-@item.MasaNo" onclick="indir(@item.MasaNo)">
                        <i class="bi bi-download"></i> QR İndir
                    </button>
                    <button class="footer-btn btn-edit" onclick="masaModal(@item.Id, @item.MasaNo, @(item.BolgeId ?? 0))">
                        <i class="bi bi-pencil"></i> Düzenle
                    </button>
                    <button class="footer-btn btn-delete" onclick="masaSil(@item.MasaNo)">
                        <i class="bi bi-trash"></i> Sil
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- BÖLGE MODAL -->
<div class="modal fade" id="bolgeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
            <div class="modal-header border-0 bg-light pb-2 pt-4 px-4">
                <h5 class="modal-title fw-bold flex-grow-1" id="bolgeModalTitle">
                    <i class="bi bi-geo-alt-fill me-2 text-primary"></i> Bölge Ekle
                </h5>
                <button type="button" class="btn-close bg-white rounded-circle shadow-sm" data-bs-dismiss="modal" style="width: 2.5rem; height: 2.5rem; background-image: none; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-x-lg text-dark"></i>
                </button>
            </div>
            <div class="modal-body px-4 pt-3 pb-4 bg-light">
                <input type="hidden" id="bolgeEditId" value="0" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-bold text-muted mb-1">Bölge Adı *</label>
                        <input type="text" class="form-control bg-white shadow-sm border-0" id="bolgeAd" maxlength="100" style="border-radius: 0.5rem;" placeholder="Ör: Bahçe" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted mb-1">Sıra No</label>
                        <input type="number" class="form-control bg-white shadow-sm border-0" id="bolgeSiraNo" value="0" min="0" style="border-radius: 0.5rem;" />
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light px-4 pb-4 pt-0">
                <button type="button" class="btn btn-light shadow-sm" data-bs-dismiss="modal" style="border-radius: 0.5rem;">İptal</button>
                <button type="button" class="btn btn-success shadow-sm px-4" onclick="bolgeKaydet()" style="border-radius: 0.5rem;"><i class="bi bi-check-lg me-2"></i> Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- YENİ / DÜZENLE MASA MODAL -->
<div class="modal fade" id="masaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
            <div class="modal-header border-0 bg-light pb-2 pt-4 px-4">
                <h5 class="modal-title fw-bold flex-grow-1" id="masaModalTitle">
                    <i class="bi bi-grid-fill me-2 text-primary"></i> Yeni Masa Ekle
                </h5>
                <button type="button" class="btn-close bg-white rounded-circle shadow-sm" data-bs-dismiss="modal" style="width: 2.5rem; height: 2.5rem; background-image: none; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-x-lg text-dark"></i>
                </button>
            </div>
            <div class="modal-body px-4 pt-3 pb-4 bg-light">
                <input type="hidden" id="masaEditId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted mb-1">Bölge Seçin *</label>
                        <select class="form-select bg-white shadow-sm border-0" id="masaBolge" required style="border-radius: 0.5rem;">
                            <option value="">Seçiniz</option>
                            @foreach (var b in bolgeler)
                            {
                                <option value="@b.Id">@b.Ad</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted mb-1">Masa Numarası *</label>
                        <input type="number" id="masaNo" class="form-control bg-white shadow-sm border-0" placeholder="Ör: 7" min="1" style="border-radius: 0.5rem;" />
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light px-4 pb-4 pt-0">
                <button type="button" class="btn btn-light shadow-sm" data-bs-dismiss="modal" style="border-radius: 0.5rem;">İptal</button>
                <button type="button" class="btn btn-success shadow-sm px-4" onclick="masaKaydet()" style="border-radius: 0.5rem;">
                    <i class="bi bi-check-lg me-2"></i> Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var qrData = {};

    function mesaj(text, tip) {
        document.getElementById('mesaj').innerHTML = '<div class="alert alert-' + tip + ' py-2 mb-3 shadow position-fixed bottom-0 end-0 m-3" style="font-size:0.85rem; z-index:9999; max-width:350px;">' + text + '</div>';
        setTimeout(function() { document.getElementById('mesaj').innerHTML = ''; }, 3000);
    }

    // --- BÖLGE AJAX İŞLEMLERİ ---
    function bolgeModal(id, ad, sira) {
        document.getElementById('bolgeEditId').value = id || 0;
        document.getElementById('bolgeAd').value = ad || '';
        document.getElementById('bolgeSiraNo').value = sira || 0;
        document.getElementById('bolgeModalTitle').innerHTML = id ? '<i class="bi bi-geo-alt-fill me-2 text-primary"></i> Bölge Düzenle' : '<i class="bi bi-geo-alt-fill me-2 text-primary"></i> Bölge Ekle';
        new bootstrap.Modal(document.getElementById('bolgeModal')).show();
    }

    async function bolgeKaydet() {
        var id = document.getElementById('bolgeEditId').value;
        var ad = document.getElementById('bolgeAd').value;
        var sira = document.getElementById('bolgeSiraNo').value || 0;
        
        if (!ad) { mesaj('Bölge adı zorunlu', 'danger'); return; }

        var response = await fetch(id > 0 ? '/admin/bolge-guncelle/' + id : '/admin/bolge-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ Ad: ad, SiraNo: parseInt(sira) })
        });
        
        var responseData = await response.json();
        if (responseData.success) {
            mesaj('Bölge kaydedildi', 'success');
            setTimeout(() => location.reload(), 500);
        } else {
            mesaj(responseData.message || 'Hata oluştu', 'danger');
        }
    }

    async function bolgeSil(id, ad) {
        if (!confirm('"' + ad + '" bölgesi silinecek. Emin misiniz?')) return;
        var response = await fetch('/admin/bolge-sil/' + id, { method: 'POST' });
        var responseData = await response.json();
        if (responseData.success) {
            mesaj('Bölge silindi', 'success');
            setTimeout(() => location.reload(), 500);
        } else {
            mesaj(responseData.message || 'Hata oluştu, bu bölgede aktif masalar olabilir.', 'danger');
        }
    }

    // --- MASA AJAX İŞLEMLERİ ---
    function masaModal(id, no, bolgeId) {
        document.getElementById('masaEditId').value = id || 0;
        document.getElementById('masaNo').value = no || '';
        document.getElementById('masaBolge').value = bolgeId || '';
        document.getElementById('masaModalTitle').innerHTML = id ? '<i class="bi bi-grid-fill me-2 text-primary"></i> Masa Düzenle' : '<i class="bi bi-grid-fill me-2 text-primary"></i> Yeni Masa Ekle';
        new bootstrap.Modal(document.getElementById('masaModal')).show();
    }

    async function masaKaydet() {
        var id = document.getElementById('masaEditId').value;
        var no = document.getElementById('masaNo').value;
        var bolgeId = document.getElementById('masaBolge').value;

        if (!no || no < 1) { mesaj('Geçerli bir masa numarası girin', 'danger'); return; }
        if (!bolgeId) { mesaj('Bölge seçmek zorunludur', 'danger'); return; }

        var response = await fetch(id > 0 ? '/admin/masa-guncelle/' + id : '/admin/masa-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ MasaNo: parseInt(no), BolgeId: parseInt(bolgeId) })
        });
        
        var responseData = await response.json();
        if (responseData.success) {
            mesaj('Masa başarıyla kaydedildi', 'success');
            setTimeout(() => location.reload(), 500);
        } else {
            mesaj(responseData.message || 'Hata oluştu', 'danger');
        }
    }

    function masaSil(masaNo) {
        if (!confirm('Masa ' + masaNo + ' silinsin mi?')) return;
        fetch('/admin/masa-sil/' + masaNo).then(r => r.json()).then(data => {
            if (data.success) {
                var col = document.getElementById('col-' + masaNo);
                if (col) { col.style.transition = 'opacity 0.3s'; col.style.opacity = '0'; setTimeout(() => col.remove(), 300); }
                mesaj(data.message || 'Masa ' + masaNo + ' silindi', 'success');
            } else { mesaj(data.message, 'danger'); }
        });
    }

    function olustur(masaNo) {
        fetch('/admin/qr-olustur/' + masaNo).then(r => r.json()).then(data => {
            if (data.success) {
                qrData[masaNo] = data.qrBase64;
                var img = document.getElementById('qr-img-' + masaNo);
                img.src = 'data:image/png;base64,' + data.qrBase64;
                img.style.display = 'block';
                document.getElementById('placeholder-' + masaNo).style.display = 'none';

                var btn = document.getElementById('qrolustur-' + masaNo);
                if (btn) { btn.outerHTML = '<span class="badge bg-success" style="font-size:0.65rem;" id="qrbadge-' + masaNo + '">QR Aktif</span>'; }

                document.getElementById('indir-' + masaNo).classList.remove('d-none');
            }
        });
    }

    function indir(masaNo) {
        var b = qrData[masaNo];
        if (!b) { alert('Önce QR oluşturun'); return; }
        var a = document.createElement('a');
        a.href = 'data:image/png;base64,' + b;
        a.download = 'Masa_' + masaNo + '_QR.png';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
    }

    document.addEventListener('DOMContentLoaded', function() {
        @foreach (var item in Model)
        {
            if (!string.IsNullOrEmpty(item.QrUrl))
            {
                <text>olustur(@item.MasaNo);</text>
            }
        }
    });
</script>
}
