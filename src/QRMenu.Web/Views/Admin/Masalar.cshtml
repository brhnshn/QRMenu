@model List<QRMenu.Web.ViewModels.QrKodViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Masalar";
    ViewData["ActivePage"] = "Masalar";
    ViewData["PageTitle"] = "Masalar & Bölgeler Yönetimi";
    var bolgeler = ViewBag.Bolgeler as List<QRMenu.Core.Entities.Bolge> ?? new();
}

@section Styles {
    <style>
        .font-headline { font-family: 'Plus Jakarta Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .admin-content { padding: 0 !important; background: transparent; }
        .bg-surface { background-color: transparent !important; }
    </style>
}

<div class="p-6 md:p-8 w-full space-y-8">
    <div id="mesaj"></div>

    <!-- Bölge Yönetimi Section -->
    <section>
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-2xl font-bold text-on-surface font-headline">Bölge Yönetimi</h2>
                <p class="text-sm text-tertiary">Mekanınızdaki aktif servis alanlarını düzenleyin</p>
            </div>
            <button class="flex items-center gap-2 bg-primary text-on-primary px-6 py-2.5 rounded-full font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] transition-transform" onclick="bolgeModal()">
                <span class="material-symbols-outlined">add</span> Bölge Ekle
            </button>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4" id="bolgeList">
            @foreach (var b in bolgeler)
            {
                var masaSayisi = Model.Count(m => m.BolgeId == b.Id);
                <div class="bg-surface-container-lowest p-5 rounded-xl border-b-4 border-stone-300 hover:border-primary shadow-sm hover:shadow-md transition-all cursor-pointer group">
                    <div class="flex justify-between items-start mb-4">
                        <span class="material-symbols-outlined text-stone-600 bg-stone-100 group-hover:text-primary group-hover:bg-primary/10 p-2 rounded-lg transition-colors">deck</span>
                        <div class="flex gap-1">
                            <button class="p-1.5 text-stone-400 hover:text-primary transition-colors" title="Düzenle" onclick="bolgeModal(@b.Id, '@b.Ad.Replace("'", "\\'")', @b.SiraNo)"><span class="material-symbols-outlined text-sm">edit</span></button>
                            <button class="p-1.5 text-stone-400 hover:text-error transition-colors" title="Sil" onclick="bolgeSil(@b.Id, '@b.Ad.Replace("'", "\\'")')"><span class="material-symbols-outlined text-sm">delete</span></button>
                        </div>
                    </div>
                    <h3 class="font-bold text-lg text-on-surface">@b.Ad</h3>
                    <div class="flex items-center justify-between mt-2">
                        <span class="text-xs font-medium text-tertiary">@masaSayisi Masa Aktif</span>
                    </div>
                </div>
            }
            @if (!bolgeler.Any())
            {
                <div class="col-span-full"><span class="text-muted small">Henüz bölge eklenmemiş. Önce masa bölgelerini oluşturun.</span></div>
            }
        </div>
    </section>

    <!-- Masa Listesi Section -->
    <section>
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-2xl font-bold text-on-surface font-headline">Masa Listesi</h2>
                <div class="flex gap-4 mt-2">
                    <span class="flex items-center gap-1.5 text-xs font-semibold text-tertiary">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> @Model.Count(m => !m.DoluMu) Boş
                    </span>
                    <span class="flex items-center gap-1.5 text-xs font-semibold text-tertiary">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span> @Model.Count(m => m.DoluMu) Dolu
                    </span>
                </div>
            </div>
            <div class="flex gap-3">
                <button class="flex items-center gap-2 bg-surface-container hover:bg-stone-200 text-on-surface px-6 py-2.5 rounded-full font-bold transition-colors shadow-sm" onclick="updateQrBaseUrl()" title="QR kodların gideceği linki ayarla">
                    <span class="material-symbols-outlined">link</span> QR Link Ayarı
                </button>
                <button class="flex items-center gap-2 bg-primary text-on-primary px-6 py-2.5 rounded-full font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] transition-transform" onclick="masaModal()">
                    <span class="material-symbols-outlined">add</span> Masa Ekle
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-6" id="masaGrid">
            @foreach (var item in Model)
            {
                <div class="group bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all border border-transparent @(item.DoluMu ? "hover:border-primary/10" : "hover:border-emerald-100")" id="col-@item.MasaNo">
                    <div class="p-5 flex flex-col items-center">
                        <div class="w-36 h-36 bg-white rounded-2xl mb-4 flex items-center justify-center relative border border-stone-100 p-1.5 shadow-sm">
                            @if (string.IsNullOrEmpty(item.QrUrl))
                            {
                                <div class="w-full h-full flex flex-col items-center justify-center text-stone-400 text-xs font-semibold bg-stone-50 rounded-xl" id="placeholder-@item.MasaNo">
                                    <span class="material-symbols-outlined text-3xl mb-1 opacity-50">qr_code</span>
                                    <span>QR Yok</span>
                                </div>
                                <img class="w-full h-full object-contain rounded-xl hidden" id="qr-img-@item.MasaNo" alt="QR" />
                            }
                            else
                            {
                                <div class="w-full h-full flex flex-col items-center justify-center text-stone-400 text-xs font-semibold bg-stone-50 rounded-xl hidden" id="placeholder-@item.MasaNo">
                                    <span class="material-symbols-outlined text-3xl mb-1 opacity-50">qr_code</span>
                                    <span>QR Yok</span>
                                </div>
                                <img class="w-full h-full object-contain rounded-xl" id="qr-img-@item.MasaNo" alt="QR" src="data:image/png;base64,@item.QrBase64" />
                            }
                            <div class="absolute -top-3 -right-3 @(item.DoluMu ? "bg-primary" : "bg-emerald-500") text-white text-[11px] font-bold px-3 py-1 rounded-full z-10 shadow-md border-2 border-white">@(item.DoluMu ? "DOLU" : "BOŞ")</div>
                        </div>
                        <h4 class="font-bold text-lg text-on-surface">Masa @item.MasaNo</h4>
                        <p class="text-xs text-tertiary mb-6"><i class="bi bi-geo-alt"></i> Bölge: @(item.BolgeAd ?? "Belirtilmedi")</p>
                        
                        <div class="flex flex-col gap-2 w-full">
                            <div class="flex gap-2 w-full">
                                <button class="flex-1 text-xs font-bold py-2 rounded-lg bg-surface-container hover:bg-stone-200 transition-colors" onclick="masaModal(@item.Id, @item.MasaNo, @(item.BolgeId ?? 0))">Düzenle</button>
                                <button class="flex-1 text-xs font-bold py-2 rounded-lg bg-red-100 text-red-600 hover:bg-red-200 transition-colors" onclick="masaSil(@item.MasaNo)">Sil</button>
                            </div>
                            <div class="flex gap-2 w-full" id="qr-actions-@item.MasaNo">
                                @if (string.IsNullOrEmpty(item.QrUrl))
                                {
                                    <button class="w-full text-xs font-bold py-2 rounded-lg bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors" id="qrolustur-@item.MasaNo" onclick="olustur(@item.MasaNo)">
                                        <i class="bi bi-qr-code"></i> QR Oluştur
                                    </button>
                                    <button class="hidden flex-1 text-xs font-bold py-2 rounded-lg bg-emerald-100 text-emerald-700 hover:bg-emerald-200 transition-colors" id="indir-@item.MasaNo" onclick="indir(@item.MasaNo)">
                                        <i class="bi bi-download"></i> İndir
                                    </button>
                                    <button class="hidden w-10 text-xs font-bold py-2 rounded-lg bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors flex items-center justify-center" id="qryenile-@item.MasaNo" onclick="olustur(@item.MasaNo)" title="Yeniden Oluştur">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="hidden w-full text-xs font-bold py-2 rounded-lg bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors" id="qrolustur-@item.MasaNo" onclick="olustur(@item.MasaNo)">
                                        <i class="bi bi-qr-code"></i> QR Oluştur
                                    </button>
                                    <button class="flex-1 text-xs font-bold py-2 rounded-lg bg-emerald-100 text-emerald-700 hover:bg-emerald-200 transition-colors" id="indir-@item.MasaNo" onclick="indir(@item.MasaNo)">
                                        <i class="bi bi-download"></i> İndir
                                    </button>
                                    <button class="w-10 text-xs font-bold py-2 rounded-lg bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors flex items-center justify-center" id="qryenile-@item.MasaNo" onclick="olustur(@item.MasaNo)" title="Yeniden Oluştur">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="group rounded-2xl border-2 border-dashed border-stone-300 flex flex-col items-center justify-center p-5 cursor-pointer hover:border-primary hover:bg-primary/5 transition-all" onclick="masaModal()">
                <div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center text-stone-400 group-hover:bg-primary/10 group-hover:text-primary transition-colors mb-3">
                    <span class="material-symbols-outlined text-2xl">add</span>
                </div>
                <span class="font-bold text-stone-500 group-hover:text-primary transition-colors">Yeni Masa</span>
            </div>
        </div>
    </section>
</div>

<!-- BÖLGE MODAL (Bootstrap kullanıldı ama Tailwind sınıfları eklendi) -->
<div class="modal fade" id="bolgeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl rounded-3xl overflow-hidden bg-white">
            <div class="p-6 border-b border-stone-200 flex justify-between items-center">
                <h3 class="text-xl font-bold font-headline" id="bolgeModalTitle">Yeni Bölge Ekle</h3>
                <button type="button" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 transition-colors border-0 bg-transparent" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <input type="hidden" id="bolgeEditId" value="0" />
                <div>
                    <label class="block text-xs font-bold text-tertiary uppercase mb-1 font-label">Bölge Adı *</label>
                    <input type="text" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="bolgeAd" maxlength="100" placeholder="Ör: Bahçe" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-tertiary uppercase mb-1 font-label">Öncelik (Sıralama)</label>
                    <input type="number" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="bolgeSiraNo" value="0" min="0" />
                </div>
            </div>
            <div class="p-6 bg-stone-50 flex gap-3">
                <button type="button" class="flex-1 bg-surface-container-highest text-on-surface font-bold py-3 rounded-xl hover:bg-stone-300 transition-colors border-0" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="flex-1 bg-primary text-on-primary font-bold py-3 rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.02] transition-transform border-0" onclick="bolgeKaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- MASA MODAL (Bootstrap kullanıldı ama Tailwind sınıfları eklendi) -->
<div class="modal fade" id="masaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl rounded-3xl overflow-hidden bg-white">
            <div class="p-6 border-b border-stone-200 flex justify-between items-center">
                <h3 class="text-xl font-bold font-headline" id="masaModalTitle">Yeni Masa Ekle</h3>
                <button type="button" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 transition-colors border-0 bg-transparent" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <input type="hidden" id="masaEditId" value="0" />
                <div>
                    <label class="block text-xs font-bold text-tertiary uppercase mb-1 font-label">Bölge Seçin *</label>
                    <select class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="masaBolge" required>
                        <option value="">Seçiniz</option>
                        @foreach (var b in bolgeler)
                        {
                            <option value="@b.Id">@b.Ad</option>
                        }
                    </select>
                </div>
                <div class="hidden">
                    <label class="block text-xs font-bold text-tertiary uppercase mb-1 font-label">Masa Numarası *</label>
                    <input type="number" id="masaNo" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" placeholder="Ör: 7" min="1" />
                </div>
            </div>
            <div class="p-6 bg-stone-50 flex gap-3">
                <button type="button" class="flex-1 bg-surface-container-highest text-on-surface font-bold py-3 rounded-xl hover:bg-stone-300 transition-colors border-0" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="flex-1 bg-primary text-on-primary font-bold py-3 rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.02] transition-transform border-0" onclick="masaKaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var qrData = {};
    var existingMasaNos = [@string.Join(",", Model.Select(m => m.MasaNo))];

    function mesaj(text, tip) {
        var bgColor = tip === 'success' ? 'bg-emerald-500' : (tip === 'danger' ? 'bg-red-500' : 'bg-primary');
        document.getElementById('mesaj').innerHTML = '<div class="fixed bottom-5 right-5 ' + bgColor + ' text-white px-6 py-3 rounded-xl shadow-xl font-bold z-[9999]">' + text + '</div>';
        setTimeout(function() { document.getElementById('mesaj').innerHTML = ''; }, 3000);
    }

    // --- BÖLGE AJAX İŞLEMLERİ ---
    function bolgeModal(id, ad, sira) {
        document.getElementById('bolgeEditId').value = id || 0;
        document.getElementById('bolgeAd').value = ad || '';
        document.getElementById('bolgeSiraNo').value = sira || 0;
        document.getElementById('bolgeModalTitle').innerHTML = id ? 'Bölge Düzenle' : 'Yeni Bölge Ekle';
        new bootstrap.Modal(document.getElementById('bolgeModal')).show();
    }

    async function bolgeKaydet() {
        var id = document.getElementById('bolgeEditId').value;
        var ad = document.getElementById('bolgeAd').value;
        var sira = document.getElementById('bolgeSiraNo').value || 0;
        
        if (!ad) { mesaj('Bölge adı zorunlu', 'danger'); return; }

        var response = await fetch(id > 0 ? '/admin/bolge-guncelle/' + id : '/admin/bolge-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ Ad: ad, SiraNo: parseInt(sira) })
        });
        
        var responseData = await response.json();
        if (responseData.success) {
            mesaj('Bölge kaydedildi', 'success');
            setTimeout(() => location.reload(), 500);
        } else {
            mesaj(responseData.message || 'Hata oluştu', 'danger');
        }
    }

    async function bolgeSil(id, ad) {
        const result = await window.SavorAlert.fire({
            title: 'Emin misiniz?',
            text: '"' + ad + '" bölgesi silinecek.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        });
        if (!result.isConfirmed) return;
        var response = await fetch('/admin/bolge-sil/' + id, { method: 'POST' });
        var responseData = await response.json();
        if (responseData.success) {
            mesaj('Bölge silindi', 'success');
            setTimeout(() => location.reload(), 500);
        } else {
            mesaj(responseData.message || 'Hata oluştu, bu bölgede aktif masalar olabilir.', 'danger');
        }
    }

    // --- MASA AJAX İŞLEMLERİ ---
    function masaModal(id, no, bolgeId) {
        document.getElementById('masaEditId').value = id || 0;
        
        if (!id) {
            var nextNo = 1;
            while (existingMasaNos.includes(nextNo)) {
                nextNo++;
            }
            document.getElementById('masaNo').value = nextNo;
        } else {
            document.getElementById('masaNo').value = no || '';
        }
        
        document.getElementById('masaBolge').value = bolgeId || '';
        document.getElementById('masaModalTitle').innerHTML = id ? 'Masa Düzenle' : 'Yeni Masa Ekle';
        new bootstrap.Modal(document.getElementById('masaModal')).show();
    }

    async function masaKaydet() {
        var id = document.getElementById('masaEditId').value;
        var no = document.getElementById('masaNo').value;
        var bolgeId = document.getElementById('masaBolge').value;

        if (!no || no < 1) { mesaj('Geçerli bir masa numarası girin', 'danger'); return; }
        if (!bolgeId) { mesaj('Bölge seçmek zorunludur', 'danger'); return; }

        var response = await fetch(id > 0 ? '/admin/masa-guncelle/' + id : '/admin/masa-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ MasaNo: parseInt(no), BolgeId: parseInt(bolgeId) })
        });
        
        var responseData = await response.json();
        if (responseData.success) {
            mesaj('Masa başarıyla kaydedildi', 'success');
            setTimeout(() => location.reload(), 500);
        } else {
            mesaj(responseData.message || 'Hata oluştu', 'danger');
        }
    }

    async function masaSil(masaNo) {
        const result = await window.SavorAlert.fire({
            title: 'Emin misiniz?',
            text: 'Masa ' + masaNo + ' silinsin mi?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        });
        if (!result.isConfirmed) return;
        var r = await fetch('/admin/masa-sil/' + masaNo);
        var data = await r.json();
        
        if (data.success) {
            if (data.hasRecords) {
                removeMasaCol(masaNo);
                Swal.fire({
                    toast: true,
                    position: 'bottom-end',
                    icon: 'info',
                    title: 'Masa gizliye alındı',
                    text: 'Geçmiş siparişleri korumak için masa gizlendi.',
                    showConfirmButton: true,
                    confirmButtonText: 'Eski Kayıtları Göster',
                    confirmButtonColor: '#a23718',
                    showCancelButton: true,
                    cancelButtonText: 'Kapat',
                    timer: 8000,
                    timerProgressBar: true,
                    background: '#f8f6f5', color: '#2e2f2f'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.open('/admin/siparisler?masaId=' + data.masaId, '_blank');
                    }
                });
            } else {
                removeMasaCol(masaNo);
                mesaj('Masa ' + masaNo + ' başarıyla silindi', 'success');
            }
        } else {
            mesaj(data.message, 'danger');
        }
    }

    function removeMasaCol(masaNo) {
        var col = document.getElementById('col-' + masaNo);
        if (col) { 
            col.style.transition = 'opacity 0.3s'; 
            col.style.opacity = '0'; 
            setTimeout(() => col.remove(), 300); 
        }
    }

    document.addEventListener("DOMContentLoaded", async function() {
        if (!localStorage.getItem('qrBaseUrl')) {
            await updateQrBaseUrl();
        }
    });

    async function getQrUrlBase() {
        var savedUrl = localStorage.getItem('qrBaseUrl');
        if (savedUrl) return savedUrl;
        return await updateQrBaseUrl();
    }

    async function updateQrBaseUrl() {
        var currentUrl = localStorage.getItem('qrBaseUrl') || window.location.origin;
        const { value: urlBase } = await window.SavorAlert.fire({
            title: 'QR Bağlantı Adresi',
            input: 'text',
            inputLabel: 'Müşteriler bu QR kodu okuttuğunda hangi domaine yönlensin?',
            inputValue: currentUrl,
            showCancelButton: true,
            confirmButtonText: 'Kaydet',
            cancelButtonText: 'İptal'
        });

        if (urlBase) {
            localStorage.setItem('qrBaseUrl', urlBase);
            mesaj('QR bağlantı adresi güncellendi', 'success');
            return urlBase;
        }
        return null;
    }

    async function olustur(masaNo) {
        var urlBase = await getQrUrlBase();
        if (!urlBase) return;

        var response = await fetch('/admin/qr-olustur/' + masaNo, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ BaseUrl: urlBase })
        });
        var data = await response.json();

        if (data.success) {
            qrData[masaNo] = data.qrBase64;
            var img = document.getElementById('qr-img-' + masaNo);
            img.src = 'data:image/png;base64,' + data.qrBase64;
            img.classList.remove('hidden');
            
            var placeholder = document.getElementById('placeholder-' + masaNo);
            if(placeholder) {
                placeholder.classList.add('hidden');
            }

            var olusturBtn = document.getElementById('qrolustur-' + masaNo);
            var indirBtn = document.getElementById('indir-' + masaNo);
            var yenileBtn = document.getElementById('qryenile-' + masaNo);

            if (olusturBtn) {
                olusturBtn.classList.add('hidden');
                olusturBtn.classList.remove('w-full');
            }
            if (indirBtn) {
                indirBtn.classList.remove('hidden');
                indirBtn.classList.add('flex-1');
            }
            if (yenileBtn) {
                yenileBtn.classList.remove('hidden');
            }
            
            mesaj('QR başarıyla oluşturuldu!', 'success');
        } else {
            mesaj(data.message, 'danger');
        }
    }

    function indir(masaNo) {
        var b = qrData[masaNo];
        if (!b) { 
            Swal.fire({
                title:'Uyarı', 
                text:'Önce QR oluşturun', 
                icon:'warning', 
                confirmButtonColor:'#a23718',
                background:'#f8f6f5',
                color:'#2e2f2f'
            }); 
            return; 
        }
        var a = document.createElement('a');
        a.href = 'data:image/png;base64,' + b;
        a.download = 'Masa_' + masaNo + '_QR.png';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
    }

</script>
}
