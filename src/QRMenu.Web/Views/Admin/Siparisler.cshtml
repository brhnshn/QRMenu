@model List<QRMenu.Core.Entities.Siparis>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sipariş Arşivi ve Raporlama";
    ViewData["ActivePage"] = "Siparisler";
    ViewData["PageTitle"] = "Sipariş Arşivi";
    
    var turkeyTz = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "Turkey Standard Time" : "Europe/Istanbul");
    Func<DateTime, string> toTR = dt =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(dt, DateTimeKind.Utc), turkeyTz).ToString("dd.MM.yyyy HH:mm");
    
    var bugun = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, turkeyTz).Date;
    
    // İstatistikler (Bugüne özel)
    var bugunSiparis = Model.Where(s => TimeZoneInfo.ConvertTimeFromUtc(s.OlusturmaTarihi, turkeyTz).Date == bugun).ToList();
    var bugunToplamSayi = ViewBag.BugunToplamSayi != null
        ? Convert.ToInt32(ViewBag.BugunToplamSayi)
        : bugunSiparis.Count;
    var bugunCiro = ViewBag.BugunCiro != null
        ? Convert.ToDecimal(ViewBag.BugunCiro)
        : bugunSiparis.Where(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.TamOdendi).Sum(s => s.ToplamTutar);
    
    var iptalIadeSiparis = Model.Where(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.Iptal || s.Durum == QRMenu.Core.Enums.SiparisDurum.Iade).ToList();
    var iptalIadeCiro = ViewBag.IptalIadeCiro != null
        ? Convert.ToDecimal(ViewBag.IptalIadeCiro)
        : iptalIadeSiparis.Sum(s => s.ToplamTutar);
    var iptalIadeSayi = ViewBag.IptalIadeSayi != null
        ? Convert.ToInt32(ViewBag.IptalIadeSayi)
        : iptalIadeSiparis.Count;
    
    var masalar = Model.Select(s => s.Masa).Where(m => m != null).DistinctBy(m => m.Id).OrderBy(m => m.MasaNo).ToList();
    var currentPage = ViewBag.CurrentPage != null ? Convert.ToInt32(ViewBag.CurrentPage) : 1;
    var totalPages = ViewBag.TotalPages != null ? Convert.ToInt32(ViewBag.TotalPages) : 1;
    var pageSize = ViewBag.PageSize != null ? Convert.ToInt32(ViewBag.PageSize) : 100;
    var totalCount = ViewBag.TotalCount != null ? Convert.ToInt32(ViewBag.TotalCount) : Model.Count;
}

<style>
    .editorial-shadow { box-shadow: 0 12px 32px rgba(46, 47, 47, 0.04); }
    .scale-98-active-transition:active { transform: scale(0.98); }

    @@media print {
        aside, header, nav, .flex-wrap, button, .material-symbols-outlined, .pagination, #filterArama, .bg-surface-container-low, .grid {
            display: none !important;
        }
        body, html, main, .flex-1 {
            height: auto !important;
            overflow: visible !important;
            display: block !important;
            background: white !important;
        }
        .p-4.md:p-8 {
            padding: 0 !important;
            margin: 0 !important;
        }
        .hidden.md:block {
            display: block !important;
        }
        .bg-surface-container-lowest {
            background: white !important;
            border: none !important;
            box-shadow: none !important;
        }
        table {
            width: 100% !important;
            border: 1px solid #eee !important;
        }
        th, td {
            border-bottom: 1px solid #eee !important;
        }
        .siparis-row {
            display: table-row !important;
        }
        /* İstatistikleri gizlemek istemiyorsanız .grid'i yukarıdan kaldırabilirsiniz, 
           ancak çıktı genellikle sadece liste için istenir. */
    }
</style>

<div class="p-4 md:p-8 space-y-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h2 class="text-3xl font-extrabold font-headline text-on-surface tracking-tight">Sipariş Arşivi</h2>
            <p class="text-on-surface-variant mt-1">Geçmiş siparişleri inceleyin ve raporları görüntüleyin.</p>
        </div>
        <div class="flex items-center space-x-3">
            <button onclick="window.print()" class="flex items-center space-x-2 bg-surface-container-lowest text-on-surface px-4 py-2.5 rounded-xl border border-outline-variant/20 font-semibold text-sm editorial-shadow hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-lg">download</span>
                <span>Dışa Aktar</span>
            </button>
        </div>
    </div>

    <!-- Stats Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Bugünün Siparişleri -->
        <div class="bg-surface-container-lowest p-6 rounded-xl editorial-shadow relative overflow-hidden group border border-surface-container">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Bugünün Siparişleri</p>
                    <h3 class="text-4xl font-extrabold text-on-surface mt-2 font-headline">@bugunToplamSayi <span class="text-lg font-semibold text-on-surface-variant">Adet</span></h3>
                </div>
                <div class="p-3 bg-primary/10 rounded-xl text-primary">
                    <span class="material-symbols-outlined text-2xl">receipt_long</span>
                </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-on-surface-variant font-medium">
                <span class="material-symbols-outlined text-sm mr-1">history</span>
                <span>Sadece bugünkü veriler</span>
            </div>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-primary/5 rounded-full opacity-50 group-hover:scale-110 transition-transform"></div>
        </div>

        <!-- Günlük Net Gelir -->
        <div class="bg-surface-container-lowest p-6 rounded-xl editorial-shadow relative overflow-hidden group border border-surface-container">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Günlük Net Gelir</p>
                    <h3 class="text-4xl font-extrabold text-on-surface mt-2 font-headline">₺@bugunCiro.ToString("N0")<span class="text-lg font-semibold text-on-surface-variant">,@((bugunCiro % 1).ToString("00"))</span></h3>
                </div>
                <div class="p-3 bg-secondary/10 rounded-xl text-secondary">
                    <span class="material-symbols-outlined text-2xl">payments</span>
                </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-green-600 font-bold">
                <span class="material-symbols-outlined text-sm mr-1">trending_up</span>
                <span>Tamamlanmış ödemeler</span>
            </div>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-secondary/5 rounded-full opacity-50 group-hover:scale-110 transition-transform"></div>
        </div>

        <!-- Tüm Zamanlar İptal/İade -->
        <div class="bg-surface-container-lowest p-6 rounded-xl editorial-shadow relative overflow-hidden group border border-surface-container">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tüm Zamanlar İptal/İade</p>
                    <div class="mt-2">
                        <h3 class="text-2xl font-extrabold text-on-surface font-headline">@iptalIadeSayi <span class="text-base font-semibold text-on-surface-variant">İşlem</span></h3>
                        <p class="text-xl font-bold text-error mt-1">₺@iptalIadeCiro.ToString("N0")</p>
                    </div>
                </div>
                <div class="p-3 bg-error/10 rounded-xl text-error">
                    <span class="material-symbols-outlined text-2xl">cancel</span>
                </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-on-surface-variant font-medium">
                <span class="material-symbols-outlined text-sm mr-1">history</span>
                <span>Tüm zamanların verisi</span>
            </div>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-error/5 rounded-full opacity-50 group-hover:scale-110 transition-transform"></div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-surface-container-low p-4 rounded-2xl flex flex-wrap items-center gap-4 border border-surface-container">
        <div class="flex-1 min-w-[200px]">
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 text-lg">search</span>
                <input id="filterArama" onkeyup="filtreleTablo()" class="w-full pl-10 pr-4 py-2.5 bg-surface-container-lowest border-none rounded-xl focus:ring-2 focus:ring-primary/20 text-sm font-medium" placeholder="Sipariş No Ara..." type="text"/>
            </div>
        </div>
        <div class="flex items-center flex-wrap gap-3">
            <!-- Tarih Filtresi -->
            <div class="flex items-center space-x-2 bg-surface-container-lowest px-3 py-1.5 rounded-xl border border-surface-container-high">
                <span class="material-symbols-outlined text-on-surface-variant/50 text-lg">calendar_today</span>
                <select id="filterTarih" onchange="filtreleTablo()" class="bg-transparent border-none focus:ring-0 text-xs font-bold text-on-surface cursor-pointer py-1 pl-0 pr-8 uppercase tracking-wider">
                    <option value="all" selected>Tüm Zamanlar</option>
                    <option value="today">Bugün</option>
                    <option value="yesterday">Dün</option>
                </select>
            </div>
            <!-- Durum Filtresi -->
            <div class="flex items-center space-x-2 bg-surface-container-lowest px-3 py-1.5 rounded-xl border border-surface-container-high">
                <span class="material-symbols-outlined text-on-surface-variant/50 text-lg">filter_alt</span>
                <select id="filterDurum" onchange="filtreleTablo()" class="bg-transparent border-none focus:ring-0 text-xs font-bold text-on-surface cursor-pointer py-1 pl-0 pr-8 uppercase tracking-wider">
                    <option value="all">Tüm Durumlar</option>
                    <option value="bekleyen">Aktif / Bekleyen</option>
                    <option value="TamOdendi">Tamamlananlar</option>
                    <option value="Iptal">İptal Edilenler</option>
                </select>
            </div>
            <!-- Masa Filtresi -->
            <div class="flex items-center space-x-2 bg-surface-container-lowest px-3 py-1.5 rounded-xl border border-surface-container-high">
                <span class="material-symbols-outlined text-on-surface-variant/50 text-lg">table_restaurant</span>
                <select id="filterMasa" onchange="filtreleTablo()" class="bg-transparent border-none focus:ring-0 text-xs font-bold text-on-surface cursor-pointer py-1 pl-0 pr-8 uppercase tracking-wider">
                    <option value="all">Tüm Masalar</option>
                    @foreach (var m in masalar)
                    {
                        <option value="@m.Id">Masa @m.MasaNo</option>
                    }
                </select>
            </div>
            <button onclick="window.location.reload()" class="p-2.5 bg-surface-container-lowest text-on-surface-variant rounded-xl border border-surface-container-high hover:text-primary transition-colors editorial-shadow">
                <span class="material-symbols-outlined text-lg">restart_alt</span>
            </button>
        </div>
    </div>

    <!-- Order Table (Desktop) -->
    <div class="hidden md:block bg-surface-container-lowest rounded-2xl overflow-hidden editorial-shadow border border-surface-container">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low/50 border-b border-surface-container">
                    <th class="px-6 py-4 text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em]">Sipariş No</th>
                    <th class="px-6 py-4 text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em]">Tarih & Saat</th>
                    <th class="px-6 py-4 text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em]">Masa Bilgisi</th>
                    <th class="px-6 py-4 text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em]">Tutar</th>
                    <th class="px-6 py-4 text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em]">Ödeme</th>
                    <th class="px-6 py-4 text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em]">Durum</th>
                    <th class="px-6 py-4 text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em] text-right">İşlem</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-surface-container" id="siparisTbody">
                @foreach (var siparis in Model)
                {
                    string durumClass = "bg-stone-100 text-stone-600";
                    string durumText = siparis.Durum.ToString();
                    bool isBekleyen = false;

                    switch (siparis.Durum)
                    {
                        case QRMenu.Core.Enums.SiparisDurum.Onaylandi: durumClass = "bg-primary/10 text-primary"; durumText = "Yeni Alındı"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.Hazirlaniyor: durumClass = "bg-secondary/10 text-secondary"; durumText = "Hazırlanıyor"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.Hazir: durumClass = "bg-blue-100 text-blue-900"; durumText = "Servise Hazır"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.TeslimEdildi: durumClass = "bg-green-100 text-green-900"; durumText = "Bırakıldı"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.KismiOdendi: durumClass = "bg-secondary/10 text-secondary"; durumText = "Kısmi"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.TamOdendi: durumClass = "bg-green-100 text-green-900"; durumText = "Tamamlandı"; break;
                        case QRMenu.Core.Enums.SiparisDurum.Iptal: durumClass = "bg-red-100 text-red-900"; durumText = "İptal"; break;
                        case QRMenu.Core.Enums.SiparisDurum.Iade: durumClass = "bg-stone-100 text-stone-600"; durumText = "İade"; break;
                    }

                    var siparisTarihLocal = TimeZoneInfo.ConvertTimeFromUtc(siparis.OlusturmaTarihi, turkeyTz);
                    var isToday = siparisTarihLocal.Date == bugun;
                    var isYesterday = siparisTarihLocal.Date == bugun.AddDays(-1);
                    var dateCat = isToday ? "today" : (isYesterday ? "yesterday" : "old");
                    var durumCat = siparis.Durum.ToString();
                    var searchData = siparis.Id.ToString();
                    var masaId = siparis.MasaId.ToString();
                    var masaNo = siparis.Masa?.MasaNo ?? 0;

                    <tr class="siparis-row hover:bg-surface transition-colors" data-date="@dateCat" data-durum="@durumCat" data-isbekleyen="@(isBekleyen?"true":"false")" data-masa="@masaId" data-search="@searchData">
                        <td class="px-6 py-4 font-bold text-primary">#@siparis.Id</td>
                        <td class="px-6 py-4">
                            <div class="text-sm font-semibold text-on-surface">@siparisTarihLocal.ToString("dd MMM yyyy")</div>
                            <div class="text-[11px] font-bold text-on-surface-variant opacity-60">@siparisTarihLocal.ToString("HH:mm")</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center space-x-2">
                                <span class="w-2 h-2 rounded-full bg-secondary"></span>
                                <span class="text-sm font-bold text-on-surface">Masa @masaNo</span>
                                <span class="text-[10px] text-on-surface-variant font-medium">(@(siparis.Masa?.Bolge?.Ad ?? "Standart"))</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm font-black text-on-surface">₺@siparis.ToplamTutar.ToString("N2")</td>
                        <td class="px-6 py-4">
                            @if(siparis.Durum == QRMenu.Core.Enums.SiparisDurum.TamOdendi) {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-green-50 text-green-700 uppercase tracking-wider">Ödendi</span>
                            } else if (siparis.Durum == QRMenu.Core.Enums.SiparisDurum.Iptal) {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-stone-100 text-stone-600 uppercase tracking-wider">-</span>
                            } else {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-secondary/10 text-secondary uppercase tracking-wider">Açık</span>
                            }
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest @durumClass">
                                @durumText
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <button onclick="detayGoster(@siparis.Id)" class="text-primary hover:text-primary-dim font-bold text-xs uppercase tracking-widest scale-98-active-transition transition-all">Detay Gör</button>
                        </td>
                    </tr>
                }
                <tr id="emptyRow" style="display:none;">
                    <td colspan="7" class="text-center py-12">
                        <div class="flex flex-col items-center">
                            <span class="material-symbols-outlined text-5xl text-on-surface-variant/20 mb-2">search_off</span>
                            <h5 class="text-on-surface font-bold">Sonuç Bulunamadı</h5>
                            <p class="text-on-surface-variant text-sm">Filtre kriterlerinize uygun sipariş kaydı yok.</p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Order Cards (Mobile) -->
    <div class="md:hidden space-y-4" id="siparisMobileCards">
        @foreach (var siparis in Model)
        {
            string durumClass = "bg-stone-100 text-stone-600";
            string durumText = siparis.Durum.ToString();
            bool isBekleyen = false;

            switch (siparis.Durum)
            {
                case QRMenu.Core.Enums.SiparisDurum.Onaylandi: durumClass = "bg-primary/10 text-primary"; durumText = "Yeni Alındı"; isBekleyen = true; break;
                case QRMenu.Core.Enums.SiparisDurum.Hazirlaniyor: durumClass = "bg-secondary/10 text-secondary"; durumText = "Hazırlanıyor"; isBekleyen = true; break;
                case QRMenu.Core.Enums.SiparisDurum.Hazir: durumClass = "bg-blue-100 text-blue-900"; durumText = "Servise Hazır"; isBekleyen = true; break;
                case QRMenu.Core.Enums.SiparisDurum.TeslimEdildi: durumClass = "bg-green-100 text-green-900"; durumText = "Bırakıldı"; isBekleyen = true; break;
                case QRMenu.Core.Enums.SiparisDurum.KismiOdendi: durumClass = "bg-secondary/10 text-secondary"; durumText = "Kısmi"; isBekleyen = true; break;
                case QRMenu.Core.Enums.SiparisDurum.TamOdendi: durumClass = "bg-green-100 text-green-900"; durumText = "Tamamlandı"; break;
                case QRMenu.Core.Enums.SiparisDurum.Iptal: durumClass = "bg-red-100 text-red-900"; durumText = "İptal"; break;
            }

            var siparisTarihLocal = TimeZoneInfo.ConvertTimeFromUtc(siparis.OlusturmaTarihi, turkeyTz);
            var isToday = siparisTarihLocal.Date == bugun;
            var isYesterday = siparisTarihLocal.Date == bugun.AddDays(-1);
            var dateCat = isToday ? "today" : (isYesterday ? "yesterday" : "old");
            var durumCat = siparis.Durum.ToString();
            var searchData = siparis.Id.ToString();
            var masaId = siparis.MasaId.ToString();
            var masaNo = siparis.Masa?.MasaNo ?? 0;

            <div class="bg-surface-container-lowest p-4 rounded-2xl border border-surface-container editorial-shadow siparis-row-mobile" data-date="@dateCat" data-durum="@durumCat" data-isbekleyen="@(isBekleyen?"true":"false")" data-masa="@masaId" data-search="@searchData">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <span class="text-xs font-black text-primary uppercase tracking-widest">#@siparis.Id</span>
                        <div class="text-[11px] font-bold text-on-surface-variant opacity-60">@siparisTarihLocal.ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                    <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest @durumClass">@durumText</span>
                </div>
                <div class="flex justify-between items-center bg-surface-container-low/50 p-3 rounded-xl mb-4">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-secondary">table_restaurant</span>
                        <span class="text-xs font-bold text-on-surface">Masa @masaNo</span>
                    </div>
                    <span class="text-sm font-black text-on-surface">₺@siparis.ToplamTutar.ToString("N2")</span>
                </div>
                <button onclick="detayGoster(@siparis.Id)" class="w-full bg-surface-container-low text-on-surface py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest hover:bg-surface-container transition-colors">Detayları Gör</button>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="flex flex-col md:flex-row items-center justify-between gap-4 pb-12">
            <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest opacity-60">Toplam @totalCount kayıttan @Model.Count tanesi gösteriliyor</p>
            <div class="flex items-center space-x-2">
                <a href="/admin/siparisler?page=@(currentPage - 1)&pageSize=@pageSize" class="flex items-center space-x-2 px-4 py-2 rounded-xl bg-surface-container-low text-on-surface font-bold text-xs uppercase tracking-widest hover:bg-surface-container transition-colors @(currentPage <= 1 ? "pointer-events-none opacity-40" : "")">
                    <span class="material-symbols-outlined text-lg">chevron_left</span>
                    <span>Önceki</span>
                </a>
                <div class="flex space-x-1">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                        {
                            <a href="/admin/siparisler?page=@i&pageSize=@pageSize" class="w-9 h-9 flex items-center justify-center rounded-lg font-bold text-xs @(i == currentPage ? "bg-primary text-on-primary" : "bg-surface-container-lowest text-on-surface hover:bg-surface-container transition-colors border border-surface-container")">@i</a>
                        }
                        else if (i == 2 || i == totalPages - 1)
                        {
                            <span class="px-1 self-center text-on-surface-variant">...</span>
                        }
                    }
                </div>
                <a href="/admin/siparisler?page=@(currentPage + 1)&pageSize=@pageSize" class="flex items-center space-x-2 px-4 py-2 rounded-xl bg-surface-container-low text-on-surface font-bold text-xs uppercase tracking-widest hover:bg-surface-container transition-colors @(currentPage >= totalPages ? "pointer-events-none opacity-40" : "")">
                    <span>Sonraki</span>
                    <span class="material-symbols-outlined text-lg">chevron_right</span>
                </a>
            </div>
        </div>
    }
</div>

<!-- SİPARİŞ DETAY MODALI -->
<div class="modal fade" id="siparisDetayModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl rounded-[2rem] overflow-hidden">
            <div class="modal-header border-0 bg-surface-container-low px-8 py-6">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">receipt_long</span>
                    </div>
                    <div>
                        <h5 class="modal-title font-black font-headline text-on-surface uppercase tracking-tight" id="mdlTitle">Sipariş Fişi</h5>
                        <p class="text-[10px] font-bold text-on-surface-variant opacity-60 uppercase tracking-widest" id="mdlSiparisId"></p>
                    </div>
                </div>
                <button type="button" class="p-2 hover:bg-surface-container rounded-full transition-colors" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body p-8 bg-surface">
                <div id="modalLoading" class="hidden flex-col items-center py-8">
                    <div class="w-8 h-8 border-4 border-primary/20 border-t-primary rounded-full animate-spin mb-4"></div>
                    <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest">Veriler Yükleniyor...</p>
                </div>
                
                <div id="modalIcerik" class="hidden space-y-6">
                    <div class="flex justify-between items-center pb-4 border-b border-surface-container-high">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary text-sm">table_restaurant</span>
                            <span class="text-xs font-black text-on-surface uppercase tracking-widest" id="mdlMasaNo"></span>
                        </div>
                        <span class="px-3 py-1 rounded-full bg-green-100 text-green-900 text-[9px] font-black uppercase tracking-widest">Aktif Sipariş</span>
                    </div>

                    <div id="mdlUrunList" class="space-y-3">
                        <!-- JS İle Dolacak -->
                    </div>
                    
                    <div class="bg-surface-container-low p-5 rounded-2xl border-2 border-dashed border-surface-container-high">
                        <div class="flex justify-between items-center">
                            <span class="text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em]">Genel Toplam</span>
                            <span class="text-2xl font-black text-on-surface font-headline" id="mdlToplamTutar"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-6 bg-surface-container-low">
                <button type="button" class="w-full bg-on-surface text-surface py-3 rounded-xl font-bold text-xs uppercase tracking-widest hover:opacity-90 transition-opacity" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const urlParams = new URLSearchParams(window.location.search);
            const masaId = urlParams.get('masaId');
            
            if (masaId) {
                const filterTarih = document.getElementById('filterTarih');
                if (filterTarih) filterTarih.value = 'all';
                
                const filterMasa = document.getElementById('filterMasa');
                if (filterMasa) filterMasa.value = masaId;
                
                const filterDurum = document.getElementById('filterDurum');
                if (filterDurum) filterDurum.value = 'all';
            }
            filtreleTablo();
        });

        function filtreleTablo() {
            var tarih = document.getElementById('filterTarih').value;
            var durum = document.getElementById('filterDurum').value;
            var masa = document.getElementById('filterMasa').value;
            var arama = document.getElementById('filterArama').value.trim();

            var rows = document.querySelectorAll('.siparis-row');
            var mobileCards = document.querySelectorAll('.siparis-row-mobile');
            var emptyRow = document.getElementById('emptyRow');
            var gorunanRow = 0;
            
            rows.forEach(row => {
                var rDate = row.getAttribute('data-date');
                var rDurum = row.getAttribute('data-durum');
                var rMasa = row.getAttribute('data-masa');
                var rSearch = row.getAttribute('data-search');
                var rBekleyen = row.getAttribute('data-isbekleyen') === 'true';
                
                var matchTarih = (tarih === 'all' || rDate === tarih);
                var matchDurum = (durum === 'all' || (durum === 'bekleyen' ? rBekleyen : rDurum === durum));
                var matchMasa = (masa === 'all' || rMasa === masa);
                var matchArama = !arama || rSearch.includes(arama);

                if (matchTarih && matchDurum && matchMasa && matchArama) {
                    row.style.display = '';
                    gorunanRow++;
                } else {
                    row.style.display = 'none';
                }
            });

            mobileCards.forEach(card => {
                var rDate = card.getAttribute('data-date');
                var rDurum = card.getAttribute('data-durum');
                var rMasa = card.getAttribute('data-masa');
                var rSearch = card.getAttribute('data-search');
                var rBekleyen = card.getAttribute('data-isbekleyen') === 'true';
                
                var matchTarih = (tarih === 'all' || rDate === tarih);
                var matchDurum = (durum === 'all' || (durum === 'bekleyen' ? rBekleyen : rDurum === durum));
                var matchMasa = (masa === 'all' || rMasa === masa);
                var matchArama = !arama || rSearch.includes(arama);

                if (matchTarih && matchDurum && matchMasa && matchArama) {
                    card.style.display = 'block';
                    if (window.innerWidth <= 768) gorunanRow++;
                } else {
                    card.style.display = 'none';
                }
            });

            if(emptyRow) {
                emptyRow.style.display = gorunanRow === 0 ? '' : 'none';
            }
        }

        async function detayGoster(id) {
            var m = new bootstrap.Modal(document.getElementById('siparisDetayModal'));
            m.show();
            
            const loadingEl = document.getElementById('modalLoading');
            const contentEl = document.getElementById('modalIcerik');

            loadingEl.classList.remove('hidden');
            loadingEl.classList.add('flex');
            contentEl.classList.add('hidden');

            try {
                const res = await fetch(`/admin/siparis-detay/${id}`);
                const data = await res.json();
                
                if(data.success || data.id) {
                    var sData = data.success ? data : data;
                    
                    document.getElementById('mdlSiparisId').innerText = "#" + id;
                    document.getElementById('mdlTitle').innerText = "Sipariş Fişi #" + id;
                    document.getElementById('mdlMasaNo').innerText = sData.masaNo ? "Masa " + sData.masaNo : "Belirtilmemiş";
                    document.getElementById('mdlToplamTutar').innerText = "₺" + parseFloat(sData.toplamTutar).toLocaleString('tr-TR', { minimumFractionDigits: 2 });

                    var htmlUrun = "";
                    if(sData.detaylar && sData.detaylar.length > 0) {
                        sData.detaylar.forEach(d => {
                            let opsText = "";
                            if(d.opsiyonlar) {
                                try {
                                    var ops = JSON.parse(d.opsiyonlar);
                                    if(ops.length > 0) {
                                        opsText = `<div class="text-[10px] font-bold text-on-surface-variant opacity-60 mt-1 uppercase tracking-widest"><span class="material-symbols-outlined text-[10px] mr-1">sell</span> ${ops.map(x => x.Ad).join(", ")}</div>`;
                                    }
                                } catch(e) {}
                            }

                            htmlUrun += `
                            <div class="flex justify-between items-center p-4 bg-surface-container-low rounded-2xl border border-surface-container">
                                <div>
                                    <div class="text-xs font-black text-on-surface uppercase tracking-widest"><span class="text-primary mr-2">${d.adet}x</span> ${d.urunAd || 'Ürün'}</div>
                                    ${opsText}
                                </div>
                                <div class="text-xs font-black text-on-surface">₺${(d.adet * d.birimFiyat).toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</div>
                            </div>`;
                        });
                    } else {
                        htmlUrun = `<div class="text-center text-on-surface-variant p-4 text-xs font-bold uppercase tracking-widest">İçerik bulunamadı.</div>`;
                    }
                    document.getElementById('mdlUrunList').innerHTML = htmlUrun;

                    loadingEl.classList.add('hidden');
                    loadingEl.classList.remove('flex');
                    contentEl.classList.remove('hidden');
                } else {
                    alert("Detaylar alınamadı: " + (data.message || "Bilinmeyen hata"));
                    m.hide();
                }
            } catch (err) {
                console.error(err);
                alert("İşlem sırasında bir hata oluştu.");
                m.hide();
            }
        }
    </script>
}

