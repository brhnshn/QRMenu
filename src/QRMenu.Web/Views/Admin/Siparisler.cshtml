@model List<QRMenu.Core.Entities.Siparis>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Siparişler";
    
    var turkeyTz = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "Turkey Standard Time" : "Europe/Istanbul");
    Func<DateTime, string> toTR = dt =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(dt, DateTimeKind.Utc), turkeyTz).ToString("dd.MM HH:mm");
    
    var bekleyen = Model.Count(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.Onaylandi);
    var hazirlaniyor = Model.Count(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.Hazirlaniyor);
    var hazir = Model.Count(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.Hazir);
    var teslim = Model.Count(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.TeslimEdildi);
    var masalar = Model.Select(s => s.Masa).Where(m => m != null).DistinctBy(m => m.Id).OrderBy(m => m.MasaNo).ToList();
}

@section Styles {
    <link href="~/css/admin-siparisler.css" rel="stylesheet" />
}

<!-- PROGRESS STEPPER BAR -->
<div class="stepper-wrapper" id="stepperBar">
    <div class="stepper-item" data-step="1">
        <div class="step-counter">1</div>
        <div class="step-name">Onaylandı</div>
    </div>
    <div class="stepper-item" data-step="2">
        <div class="step-counter">2</div>
        <div class="step-name">Hazırlanıyor</div>
    </div>
    <div class="stepper-item" data-step="3">
        <div class="step-counter">3</div>
        <div class="step-name">Hazır</div>
    </div>
    <div class="stepper-item" data-step="4">
        <div class="step-counter">4</div>
        <div class="step-name">Teslim Edildi</div>
    </div>
    <div class="stepper-item" data-step="5">
        <div class="step-counter">5</div>
        <div class="step-name">Ödendi</div>
    </div>
</div>

<!-- ÖZET SAYAÇLAR -->
<div class="stats-mini">
    <span class="stat-pill pill-bekleyen"><i class="bi bi-hourglass-split"></i> Bekleyen: <strong id="statBekleyen">@bekleyen</strong></span>
    <span class="stat-pill pill-hazirlaniyor"><i class="bi bi-fire"></i> Hazırlanıyor: <strong id="statHazirlaniyor">@hazirlaniyor</strong></span>
    <span class="stat-pill pill-hazir"><i class="bi bi-check-circle"></i> Hazır: <strong id="statHazir">@hazir</strong></span>
    <span class="stat-pill pill-teslim"><i class="bi bi-bag-check"></i> Teslim: <strong id="statTeslim">@teslim</strong></span>
    <span class="stat-pill pill-toplam"><i class="bi bi-list-ol"></i> Toplam: <strong id="statToplam">@Model.Count</strong></span>
</div>

<!-- FİLTRE BAR -->
<div class="siparis-filter-bar">
    <select id="filterDurum">
        <option value="">Tüm Durumlar</option>
        <option value="Onaylandi">Onaylandı</option>
        <option value="Hazirlaniyor">Hazırlanıyor</option>
        <option value="Hazir">Hazır</option>
        <option value="TeslimEdildi">Teslim Edildi</option>
        <option value="KismiOdendi">Kısmi Ödendi</option>
        <option value="TamOdendi">Tam Ödendi</option>
        <option value="Iptal">İptal</option>
        <option value="Iade">İade</option>
    </select>
    <select id="filterMasa">
        <option value="">Tüm Masalar</option>
        @foreach(var m in masalar)
        {
            <option value="@m.Id">Masa @m.MasaNo</option>
        }
    </select>
    <button class="filter-btn" onclick="filtrele()">
        <i class="bi bi-funnel"></i> Filtrele
    </button>
    <button class="filter-btn" style="background:#6c757d" onclick="filtreTemizle()">
        <i class="bi bi-x-circle"></i> Temizle
    </button>
</div>

<!-- SİPARİŞ TABLOSU -->
<div class="siparis-table-wrap">
<table class="siparis-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Masa</th>
            <th>Ürünler</th>
            <th>Tutar</th>
            <th>Durum</th>
            <th>Tarih</th>
        </tr>
    </thead>
    <tbody id="siparisBody">
        @if(!Model.Any())
        {
            <tr>
                <td colspan="6">
                    <div class="siparis-empty">
                        <div class="icon">📋</div>
                        <h5>Henüz sipariş yok</h5>
                        <p>Müşteriler sipariş verdikçe burada görünecek.</p>
                    </div>
                </td>
            </tr>
        }
        else
        {
            @foreach(var s in Model)
            {
                var detayOzet = string.Join(", ", s.SiparisDetaylar.Select(sd => $"{sd.Adet}x {sd.Urun.Ad}"));
                <tr id="row-@s.Id" data-durum="@s.Durum" data-id="@s.Id" onclick="siparisDetayAc(@s.Id); highlightProgress(this);" style="cursor:pointer;">
                    <td><strong>#@s.Id</strong></td>
                    <td><span class="badge bg-dark rounded-pill">Masa @s.Masa?.MasaNo</span></td>
                    <td class="text-truncate" style="max-width:260px;" title="@detayOzet">@detayOzet</td>
                    <td><strong>@s.ToplamTutar.ToString("N2") TL</strong></td>
                    <td><span class="durum-badge durum-@s.Durum">@DurumText(s.Durum)</span></td>
                    <td>@toTR(s.OlusturmaTarihi)</td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

<!-- SİPARİŞ DETAY OVERLAY (Fiş + Büyük Aksiyon Butonları) -->
<div id="fisOverlay" style="display:none; position:fixed; inset:0; z-index:99998; background:rgba(0,0,0,0.8); justify-content:center; align-items:center; cursor:pointer;" onclick="if(event.target===this)fisKapat()">
    <div class="detay-panel" onclick="event.stopPropagation()">
        <button class="detay-kapat" onclick="fisKapat()">&times;</button>
        <div id="fisContent" style="width:100%; display:flex; flex-direction:inherit;">
            <div style="text-align:center; color:#aaa; padding:3rem 2rem; width:100%;">Yükleniyor...</div>
        </div>
    </div>
</div>

<!-- BİLDİRİM SESLERİ -->
<audio id="notifSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

@functions {
    string DurumText(QRMenu.Core.Enums.SiparisDurum d) => d switch
    {
        QRMenu.Core.Enums.SiparisDurum.Sepette => "Sepette",
        QRMenu.Core.Enums.SiparisDurum.Onaylandi => "Onaylandı",
        QRMenu.Core.Enums.SiparisDurum.Hazirlaniyor => "Hazırlanıyor",
        QRMenu.Core.Enums.SiparisDurum.Hazir => "Hazır",
        QRMenu.Core.Enums.SiparisDurum.TeslimEdildi => "Teslim Edildi",
        QRMenu.Core.Enums.SiparisDurum.KismiOdendi => "Kısmi Ödendi",
        QRMenu.Core.Enums.SiparisDurum.TamOdendi => "Tam Ödendi",
        QRMenu.Core.Enums.SiparisDurum.Iptal => "İptal",
        QRMenu.Core.Enums.SiparisDurum.Iade => "İade",
        _ => d.ToString()
    };
}

@section Scripts {
<script>
    let acikSiparisId = null;

    async function siparisDetayAc(id) {
        acikSiparisId = id;
        document.getElementById('fisContent').innerHTML = '<div style="text-align:center; color:#aaa; padding:3rem 2rem;">Yükleniyor...</div>';
        document.getElementById('fisOverlay').style.display = 'flex';

        try {
            const res = await fetch(`/admin/siparis-detay/${id}`);
            const data = await res.json();
            if (!data.success) {
                document.getElementById('fisContent').innerHTML = `<div style="text-align:center; color:#e74c3c; padding:3rem 2rem;">${data.message}</div>`;
                return;
            }
            renderFis(data);
        } catch (e) {
            console.error(e);
            document.getElementById('fisContent').innerHTML = '<div style="text-align:center; color:#e74c3c; padding:3rem 2rem;">Detay yüklenemedi.</div>';
        }
    }

    function renderFis(data) {
        let urunlerHtml = '';
        data.detaylar.forEach(d => {
            let opsHtml = '';
            if (d.opsiyonlar) {
                try {
                    const parsed = JSON.parse(d.opsiyonlar);
                    if (parsed.length > 0) {
                        opsHtml = `<div style="font-size:0.85rem; color:#888; padding-left:1.5rem;">${parsed.map(p => p.Ad).join(', ')}</div>`;
                    }
                } catch(e) {}
            }
            urunlerHtml += `
                <div style="display:flex; justify-content:space-between; align-items:flex-start; padding:12px 0; border-bottom:1px dashed #ddd;">
                    <div>
                        <span style="font-weight:700; font-size:1.1rem;">${d.adet}x ${escapeHtml(d.urunAd)}</span>
                        ${opsHtml}
                    </div>
                    <span style="font-weight:800; font-size:1.1rem; white-space:nowrap;">${(d.adet * d.birimFiyat).toFixed(2)} TL</span>
                </div>`;
        });

        const transitions = getTransitions(data.durum);
        let actionsHtml = '';
        if (transitions.length > 0) {
            transitions.forEach(t => {
                actionsHtml += `<button class="detay-action-btn ${t.cls}" onclick="event.stopPropagation(); overlayDurumGuncelle(${data.id}, '${t.durum}')">
                    <i class="bi ${t.icon}"></i> ${t.text}
                </button>`;
            });
        } else {
            actionsHtml = '<div style="color:#aaa; text-align:center; font-size:0.9rem; padding:20px 0;">İşlem yok</div>';
        }

        document.getElementById('fisContent').innerHTML = `
            <div class="real-receipt">
                <div style="display:flex; justify-content:space-between; align-items:center; padding:24px 28px 16px; border-bottom:1px solid #f0f0f0;">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <span style="font-size:1.5rem; font-weight:800; color:#2c3e50;">#${data.id}</span>
                        <span class="durum-badge durum-${data.durum}" style="font-size:0.85rem; padding:5px 14px;">${durumLabel(data.durum)}</span>
                    </div>
                    <span style="background:#2c3e50; color:#fff; padding:6px 16px; border-radius:20px; font-size:0.9rem; font-weight:700;">Masa ${data.masaNo || '-'}</span>
                </div>

                <div style="display:flex; gap:20px; padding:12px 28px; font-size:0.85rem; color:#888; border-bottom:1px solid #f0f0f0;">
                    <span><i class="bi bi-clock"></i> ${data.olusturmaTarihi}</span>
                    ${data.guncellemeTarihi ? `<span><i class="bi bi-arrow-repeat"></i> ${data.guncellemeTarihi}</span>` : ''}
                </div>

                <div style="padding:8px 28px;">
                    ${urunlerHtml}
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; padding:18px 28px; background:#f8f9fa; border-top:2px solid #2c3e50; font-size:1.3rem; font-weight:900; color:#2c3e50;">
                    <span>TOPLAM</span>
                    <span style="display:flex; flex-direction:column; align-items:flex-end;">
                        ${data.toplamTutar.toFixed(2)} TL
                    </span>
                </div>
                
                ${(data.notlar && data.notlar.includes('🎉 Happy Hour')) ? `<div style="padding:10px 28px; font-size:1rem; color:#856404; background:#fff3cd; font-weight:800; text-align:center; display:flex; justify-content:center; align-items:center; gap:8px;"><i class="bi bi-gift-fill"></i> ${escapeHtml(data.notlar.split('|')[0].trim())}</div>` : ''}

                ${data.notlar && !data.notlar.startsWith('🎉 Happy Hour') ? `<div style="padding:14px 28px; font-size:0.9rem; color:#666; background:#fffbf0; border-top:1px solid #f0f0f0;"><i class="bi bi-chat-left-text" style="color:#e67e22; margin-right:6px;"></i> ${escapeHtml(data.notlar)}</div>` : ''}
                ${data.notlar && data.notlar.includes('|') ? `<div style="padding:14px 28px; font-size:0.9rem; color:#666; background:#fffbf0; border-top:1px solid #f0f0f0;"><i class="bi bi-chat-left-text" style="color:#e67e22; margin-right:6px;"></i> ${escapeHtml(data.notlar.split('|')[1].trim())}</div>` : ''}
                <div class="receipt-zigzag"></div>
            </div>

            <div class="action-sidebar">
                <h6>İşlemler</h6>
                ${actionsHtml}
            </div>
        `;
    }

    function fisKapat() {
        document.getElementById('fisOverlay').style.display = 'none';
        acikSiparisId = null;
    }

    async function overlayDurumGuncelle(siparisId, yeniDurum) {
        document.querySelectorAll('.detay-action-btn').forEach(b => b.disabled = true);

        try {
            const res = await fetch(`/admin/siparis-durum/${siparisId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ YeniDurum: yeniDurum })
            });
            const data = await res.json();
            if (data.success) {
                await siparisDetayAc(siparisId);
            } else {
                alert('Hata: ' + data.message);
                document.querySelectorAll('.detay-action-btn').forEach(b => b.disabled = false);
            }
        } catch (e) {
            console.error(e);
            alert('Bir hata oluştu.');
            document.querySelectorAll('.detay-action-btn').forEach(b => b.disabled = false);
        }
    }

    function durumLabel(d) {
        const map = {
            'Sepette': 'Sepette', 'Onaylandi': 'Onaylandı', 'Hazirlaniyor': 'Hazırlanıyor',
            'Hazir': 'Hazır', 'TeslimEdildi': 'Teslim Edildi', 'KismiOdendi': 'Kısmi Ödendi',
            'TamOdendi': 'Tam Ödendi', 'Iptal': 'İptal', 'Iade': 'İade'
        };
        return map[d] || d;
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function getTransitions(durum) {
        const map = {
            'Onaylandi': [
                { durum: 'Hazirlaniyor', text: 'Hazırlamaya Başla', cls: 'action-primary', icon: 'bi-fire' },
                { durum: 'Iptal', text: 'İptal Et', cls: 'action-danger', icon: 'bi-x-lg' }
            ],
            'Hazirlaniyor': [
                { durum: 'Hazir', text: 'Hazır', cls: 'action-success', icon: 'bi-check-lg' },
                { durum: 'Iptal', text: 'İptal Et', cls: 'action-danger', icon: 'bi-x-lg' }
            ],
            'Hazir': [
                { durum: 'TeslimEdildi', text: 'Teslim Et', cls: 'action-info', icon: 'bi-bag-check' }
            ],
            'TeslimEdildi': [
                { durum: 'KismiOdendi', text: 'Kısmi Ödeme', cls: 'action-warning', icon: 'bi-cash' },
                { durum: 'TamOdendi', text: 'Tamamı Ödendi', cls: 'action-success', icon: 'bi-check-circle' },
                { durum: 'Iade', text: 'İade', cls: 'action-danger-outline', icon: 'bi-arrow-return-left' }
            ],
            'KismiOdendi': [
                { durum: 'TamOdendi', text: 'Tamamı Ödendi', cls: 'action-success', icon: 'bi-check-circle' }
            ],
            'TamOdendi': [
                { durum: 'Iade', text: 'İade', cls: 'action-danger-outline', icon: 'bi-arrow-return-left' }
            ]
        };
        return map[durum] || [];
    }

    // ===== FILTRELEME =====
    async function filtrele() {
        const durum = document.getElementById('filterDurum').value;
        const masaId = document.getElementById('filterMasa').value;

        let url = '/admin/siparisler-json?';
        if (durum) url += `durum=${durum}&`;
        if (masaId) url += `masaId=${masaId}&`;

        try {
            const res = await fetch(url);
            const list = await res.json();
            renderTable(list);
        } catch(e) {
            console.error(e);
        }
    }

    function filtreTemizle() {
        document.getElementById('filterDurum').value = '';
        document.getElementById('filterMasa').value = '';
        location.reload();
    }

    function renderTable(list) {
        const body = document.getElementById('siparisBody');
        if (!list.length) {
            body.innerHTML = `<tr><td colspan="6"><div class="siparis-empty"><div class="icon">📋</div><h5>Sonuç bulunamadı</h5></div></td></tr>`;
            return;
        }

        body.innerHTML = list.map(s => {
            return `<tr id="row-${s.id}" data-durum="${s.durum}" data-id="${s.id}" onclick="siparisDetayAc(${s.id}); highlightProgress(this);" style="cursor:pointer;">
                <td><strong>#${s.id}</strong></td>
                <td><span class="badge bg-dark rounded-pill">Masa ${s.masaNo || '-'}</span></td>
                <td class="text-truncate" style="max-width:260px;" title="${escapeHtml(s.detayOzet)}">${escapeHtml(s.detayOzet)}</td>
                <td><strong>${s.toplamTutar.toFixed(2)} TL</strong></td>
                <td><span class="durum-badge durum-${s.durum}">${durumLabel(s.durum)}</span></td>
                <td>${s.olusturmaTarihi}</td>
            </tr>`;
        }).join('');
    }

    // ===== PROGRESS STEPPER =====
    function highlightProgress(row) {
        document.querySelectorAll('#siparisBody tr').forEach(r => r.classList.remove('row-selected'));
        row.classList.add('row-selected');

        const durum = row.getAttribute('data-durum');
        const stepMap = { 'Onaylandi': 1, 'Hazirlaniyor': 2, 'Hazir': 3, 'TeslimEdildi': 4, 'KismiOdendi': 5, 'TamOdendi': 5 };
        const activeStep = stepMap[durum] || 0;
        const isCancel = (durum === 'Iptal' || durum === 'Iade');

        document.querySelectorAll('#stepperBar .stepper-item').forEach(item => {
            const step = parseInt(item.getAttribute('data-step'));
            item.classList.remove('completed', 'active', 'cancelled');

            if (isCancel) {
                item.classList.add('cancelled');
            } else if (step < activeStep) {
                item.classList.add('completed');
            } else if (step === activeStep) {
                item.classList.add('active');
            }
        });
    }

    // ===== STATS GÜNCELLEME =====
    function updateStats(list) {
        const counts = { Onaylandi: 0, Hazirlaniyor: 0, Hazir: 0, TeslimEdildi: 0 };
        list.forEach(s => { if (counts[s.durum] !== undefined) counts[s.durum]++; });
        document.getElementById('statBekleyen').textContent = counts.Onaylandi;
        document.getElementById('statHazirlaniyor').textContent = counts.Hazirlaniyor;
        document.getElementById('statHazir').textContent = counts.Hazir;
        document.getElementById('statTeslim').textContent = counts.TeslimEdildi;
        document.getElementById('statToplam').textContent = list.length;
    }

    function bildirimSesiCal() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.type = 'sine';
            osc.frequency.setValueAtTime(830, ctx.currentTime);
            osc.frequency.setValueAtTime(1100, ctx.currentTime + 0.1);
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 0.5);
        } catch(e) {}
    }

    const siparisConnection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/menu')
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .build();

    siparisConnection.on('SiparisEklendi', async function() {
        try {
            const res = await fetch('/admin/siparisler-json');
            const list = await res.json();
            renderTable(list);
            updateStats(list);
            bildirimSesiCal();
        } catch(e) {
            console.error('Yeni sipariş çekme hatası:', e);
        }
    });

    siparisConnection.on('SiparisGuncellendi', async function() {
        try {
            const res = await fetch('/admin/siparisler-json');
            const list = await res.json();
            renderTable(list);
            updateStats(list);
            bildirimSesiCal();
            if (acikSiparisId) {
                const detayRes = await fetch(`/admin/siparis-detay/${acikSiparisId}`);
                const detayData = await detayRes.json();
                if (detayData.success) renderFis(detayData);
            }
        } catch(e) {
            console.error('Sipariş güncelleme hatası:', e);
        }
    });

    siparisConnection.on('SiparisGuncellendi', async function() {
        try {
            const res = await fetch('/admin/siparisler-json');
            const list = await res.json();
            renderTable(list);
            updateStats(list);
            bildirimSesiCal();
            if (acikSiparisId) {
                const detayRes = await fetch(`/admin/siparis-detay/${acikSiparisId}`);
                const detayData = await detayRes.json();
                if (detayData.success) renderFis(detayData);
            }
        } catch(e) {
            console.error('Sipariş güncelleme hatası:', e);
        }
    });

    siparisConnection.start().catch(function(err) {
        console.error('SignalR bağlantı hatası:', err);
    });
</script>
}
