@model List<QRMenu.Core.Entities.Siparis>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sipariş Arşivi ve Raporlama";
    
    var turkeyTz = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "Turkey Standard Time" : "Europe/Istanbul");
    Func<DateTime, string> toTR = dt =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(dt, DateTimeKind.Utc), turkeyTz).ToString("dd.MM.yyyy HH:mm");
    
    var bugun = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, turkeyTz).Date;
    
    // İstatistikler (Bugüne özel)
    var bugunSiparis = Model.Where(s => TimeZoneInfo.ConvertTimeFromUtc(s.OlusturmaTarihi, turkeyTz).Date == bugun).ToList();
    var bugunToplamSayi = ViewBag.BugunToplamSayi != null
        ? Convert.ToInt32(ViewBag.BugunToplamSayi)
        : bugunSiparis.Count;
    var bugunCiro = ViewBag.BugunCiro != null
        ? Convert.ToDecimal(ViewBag.BugunCiro)
        : bugunSiparis.Where(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.TamOdendi).Sum(s => s.ToplamTutar);
    
    var iptalIadeSiparis = Model.Where(s => s.Durum == QRMenu.Core.Enums.SiparisDurum.Iptal || s.Durum == QRMenu.Core.Enums.SiparisDurum.Iade).ToList();
    var iptalIadeCiro = ViewBag.IptalIadeCiro != null
        ? Convert.ToDecimal(ViewBag.IptalIadeCiro)
        : iptalIadeSiparis.Sum(s => s.ToplamTutar);
    var iptalIadeSayi = ViewBag.IptalIadeSayi != null
        ? Convert.ToInt32(ViewBag.IptalIadeSayi)
        : iptalIadeSiparis.Count;
    
    var masalar = Model.Select(s => s.Masa).Where(m => m != null).DistinctBy(m => m.Id).OrderBy(m => m.MasaNo).ToList();
    var currentPage = ViewBag.CurrentPage != null ? Convert.ToInt32(ViewBag.CurrentPage) : 1;
    var totalPages = ViewBag.TotalPages != null ? Convert.ToInt32(ViewBag.TotalPages) : 1;
    var pageSize = ViewBag.PageSize != null ? Convert.ToInt32(ViewBag.PageSize) : 100;
    var totalCount = ViewBag.TotalCount != null ? Convert.ToInt32(ViewBag.TotalCount) : Model.Count;
}

<style>
    /* Raporlama Kartları */
    .report-card { background: white; border-radius: 1rem; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s; height: 100%; display: flex; align-items: center; padding: 1.5rem; }
    .report-card:hover { transform: translateY(-3px); }
    .report-icon { width: 3.5rem; height: 3.5rem; border-radius: 1rem; display: flex; justify-content: center; align-items: center; font-size: 1.5rem; margin-right: 1.25rem; }
    .report-info h6 { font-size: 0.85rem; color: #6c757d; font-weight: 600; text-transform: uppercase; margin-bottom: 0.3rem; letter-spacing: 0.5px; }
    .report-info h3 { font-size: 1.5rem; font-weight: 800; color: #212529; margin: 0; }

    /* İkon Renkleri */
    .icon-primary { background: #e7f1ff; color: #0d6efd; }
    .icon-success { background: #e0f8e9; color: #198754; }
    .icon-danger { background: #fee2e2; color: #dc3545; }

    /* Filtre Barı Modern */
    .filter-section { background: white; border-radius: 1rem; padding: 1.25rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); margin-bottom: 1.5rem; }
    .filter-input { border: 1px solid #e9ecef; border-radius: 0.5rem; padding: 0.5rem 1rem; font-size: 0.9rem; color: #495057; outline: none; background: #fafafa; }
    .filter-input:focus { border-color: #0d6efd; background: white; }
    
    /* Modern Tablo */
    .table-card { background: white; border-radius: 1rem; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    .modern-table { width: 100%; border-collapse: separate; border-spacing: 0 0.5rem; }
    .modern-table th { font-size: 0.85rem; color: #6c757d; text-transform: uppercase; font-weight: 600; padding: 0.75rem 1rem; border-bottom: 2px solid #f8f9fa; }
    .modern-table td { padding: 1rem; background: #fff; vertical-align: middle; border-top: 1px solid rgba(0,0,0,0.02); border-bottom: 1px solid rgba(0,0,0,0.02); font-size: 0.95rem; }
    .modern-table tr { box-shadow: 0 2px 5px rgba(0,0,0,0.01); transition: all 0.2s; }
    .modern-table tr:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.04); background-color: #fafbfc; position: relative; z-index: 10; }
    .modern-table td:first-child { border-left: 1px solid rgba(0,0,0,0.02); border-top-left-radius: 0.5rem; border-bottom-left-radius: 0.5rem; }
    .modern-table td:last-child { border-right: 1px solid rgba(0,0,0,0.02); border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem; }

    /* Durum Badge'leri */
    .badge-durum { padding: 0.4rem 0.8rem; border-radius: 50rem; font-weight: 600; font-size: 0.75rem; letter-spacing: 0.3px; display: inline-block; text-align: center; min-width: 90px; }
    .bg-soft-primary { background-color: #e7f1ff; color: #0d6efd; border: 1px solid #cce5ff; }
    .bg-soft-warning { background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
    .bg-soft-info { background-color: #cff4fc; color: #055160; border: 1px solid #b6effb; }
    .bg-soft-success { background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; }
    .bg-soft-danger { background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; }
    .bg-soft-secondary { background-color: #e2e3e5; color: #41464b; border: 1px solid #d3d6d8; }

    .btn-detay { background: transparent; color: #0d6efd; border: 1px solid #0d6efd; border-radius: 50rem; padding: 0.3rem 1rem; font-size: 0.8rem; font-weight: 600; transition: 0.2s; cursor: pointer; }
    .btn-detay:hover { background: #0d6efd; color: white; }
</style>

<!-- İSTATİSTİK KARTLARI -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="report-card">
            <div class="report-icon icon-primary"><i class="bi bi-basket"></i></div>
            <div class="report-info">
                <h6>BUGÜN GELEN SİPARİŞ</h6>
                <h3>@bugunToplamSayi <span style="font-size:1rem;color:#adb5bd;font-weight:500;">Adet</span></h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="report-card">
            <div class="report-icon icon-success"><i class="bi bi-wallet2"></i></div>
            <div class="report-info">
                <h6>GÜNLÜK NET CİRO (ÖDENMİŞ)</h6>
                <h3>@bugunCiro.ToString("N2") ₺</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="report-card">
            <div class="report-icon icon-danger"><i class="bi bi-x-octagon"></i></div>
            <div class="report-info">
                <h6>TÜM ZAMANLAR İPTAL/İADE</h6>
                <h3>@iptalIadeSayi <span style="font-size:1rem;color:#adb5bd;font-weight:500;">İşlem (@iptalIadeCiro.ToString("N0") ₺)</span></h3>
            </div>
        </div>
    </div>
</div>

<!-- FİLTRE BARI -->
<div class="filter-section d-flex flex-wrap gap-3 align-items-center justify-content-between">
    <div class="d-flex flex-wrap gap-3 align-items-center">
        <div>
            <label class="form-label small fw-bold text-muted mb-1 d-block"><i class="bi bi-calendar"></i> Tarih Filtresi</label>
            <select class="filter-input" id="filterTarih" onchange="filtreleTablo()">
                <option value="all">Tüm Zamanlar</option>
                <option value="today" selected>Sadece Bugün</option>
                <option value="yesterday">Dün</option>
            </select>
        </div>
        <div>
            <label class="form-label small fw-bold text-muted mb-1 d-block"><i class="bi bi-tag"></i> Durum Filtresi</label>
            <select class="filter-input" id="filterDurum" onchange="filtreleTablo()">
                <option value="all">Tüm Durumlar</option>
                <option value="bekleyen">Aktif / Tamamlanmamış</option>
                <option value="TamOdendi">Tam Ödenenler</option>
                <option value="Iptal">İptal Edilenler</option>
            </select>
        </div>
        <div>
            <label class="form-label small fw-bold text-muted mb-1 d-block"><i class="bi bi-grid"></i> Masa Filtresi</label>
            <select class="filter-input" id="filterMasa" onchange="filtreleTablo()">
                <option value="all">Tüm Masalar</option>
                @foreach (var m in masalar)
                {
                    <option value="@m.Id">Masa @m.MasaNo</option>
                }
            </select>
        </div>
    </div>
    <div class="ms-auto mt-3 mt-md-0">
        <button class="btn btn-outline-secondary me-2" onclick="window.location.reload()"><i class="bi bi-arrow-clockwise"></i> Yenile</button>
        <div class="input-group d-inline-flex" style="width: 250px;">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" id="filterArama" onkeyup="filtreleTablo()" class="form-control border-start-0 ps-0" placeholder="Sipariş No (Örn: 123)" style="background:#fafafa;">
        </div>
    </div>
</div>

<!-- VERİ TABLOSU -->
<div class="table-card">
    <h5 class="fw-bold mb-3"><i class="bi bi-list-columns-reverse text-primary me-2"></i> Sipariş Arşivi</h5>
    <div class="table-responsive" style="min-height: 300px;">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Sipariş No</th>
                    <th>Tarih & Saat</th>
                    <th>Masa Bilgisi</th>
                    <th>Tutar</th>
                    <th>Ödeme</th>
                    <th>Durum</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody id="siparisTbody">
                @foreach (var siparis in Model)
                {
                    string durumClass = "bg-soft-secondary";
                    string durumText = siparis.Durum.ToString();
                    bool isBekleyen = false;

                    switch (siparis.Durum)
                    {
                        case QRMenu.Core.Enums.SiparisDurum.Onaylandi: durumClass = "bg-soft-primary"; durumText = "Yeni Alındı"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.Hazirlaniyor: durumClass = "bg-soft-warning"; durumText = "Hazırlanıyor"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.Hazir: durumClass = "bg-soft-info"; durumText = "Servise Hazır"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.TeslimEdildi: durumClass = "bg-soft-success"; durumText = "Masaya Bırakıldı"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.KismiOdendi: durumClass = "bg-soft-warning"; durumText = "Kısmi Ödendi"; isBekleyen = true; break;
                        case QRMenu.Core.Enums.SiparisDurum.TamOdendi: durumClass = "bg-soft-success"; durumText = "Tamamlandı"; break;
                        case QRMenu.Core.Enums.SiparisDurum.Iptal: durumClass = "bg-soft-danger"; durumText = "İptal Edildi"; break;
                        case QRMenu.Core.Enums.SiparisDurum.Iade: durumClass = "bg-soft-secondary"; durumText = "İade Edildi"; break;
                        case QRMenu.Core.Enums.SiparisDurum.Sepette: durumClass = "bg-soft-secondary"; durumText = "Sepette"; break;
                    }

                    var siparisTarihLocal = TimeZoneInfo.ConvertTimeFromUtc(siparis.OlusturmaTarihi, turkeyTz);
                    var isToday = siparisTarihLocal.Date == bugun;
                    var isYesterday = siparisTarihLocal.Date == bugun.AddDays(-1);
                    var dateCat = isToday ? "today" : (isYesterday ? "yesterday" : "old");
                    var durumCat = siparis.Durum.ToString();
                    var searchData = siparis.Id.ToString();
                    var masaId = siparis.MasaId.ToString();
                    var masaNo = siparis.Masa?.MasaNo ?? 0;

                    <tr class="siparis-row" data-date="@dateCat" data-durum="@durumCat" data-isbekleyen="@(isBekleyen?"true":"false")" data-masa="@masaId" data-search="@searchData">
                        <td><strong class="text-dark">#@siparis.Id</strong></td>
                        <td>
                            <div class="fw-bold text-dark">@toTR(siparis.OlusturmaTarihi)</div>
                            <small class="text-muted">@(isToday ? "Bugün" : (isYesterday ? "Dün" : "Geçmiş"))</small>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px; height:32px;">
                                    <i class="bi bi-geo-alt-fill text-muted" style="font-size:0.85rem;"></i>
                                </div>
                                <div>
                                    <strong class="d-block text-dark">Masa @masaNo</strong>
                                    <small class="text-muted">@(siparis.Masa?.Bolge?.Ad ?? "Standart Alan")</small>
                                </div>
                            </div>
                        </td>
                        <td><strong class="text-dark" style="font-size:1.05rem;">@siparis.ToplamTutar.ToString("N2") ₺</strong></td>
                        <td>
                            @if(siparis.Durum == QRMenu.Core.Enums.SiparisDurum.TamOdendi) {
                                <span class="text-success small fw-bold"><i class="bi bi-check-circle-fill"></i> Ödendi</span>
                            } else if (siparis.Durum == QRMenu.Core.Enums.SiparisDurum.Iptal) {
                                <span class="text-danger small fw-bold"><i class="bi bi-x-circle-fill"></i> Ödenmedi</span>
                            } else {
                                <span class="text-warning small fw-bold"><i class="bi bi-clock-history"></i> Açık</span>
                            }
                        </td>
                        <td><span class="badge-durum @durumClass">@durumText</span></td>
                        <td class="text-end">
                            <button class="btn-detay" onclick="detayGoster(@siparis.Id)"><i class="bi bi-eye"></i> Detay Gör</button>
                        </td>
                    </tr>
                }
                <tr id="emptyRow" style="display:none;">
                    <td colspan="7" class="text-center py-5">
                        <div class="text-muted">
                            <i class="bi bi-search fs-1 d-block mb-3 text-secondary"></i> 
                            <h5>Sonuç Bulunamadı</h5>
                            <p class="mb-0 small">Filtre kriterlerinize uygun sipariş kaydı yok.</p>
                        </div>
                    </td>
                </tr>
                @if (!Model.Any())
                {
                    <script>
                        document.addEventListener("DOMContentLoaded", function() {
                            document.getElementById('emptyRow').style.display = '';
                            document.getElementById('emptyRow').querySelector('h5').innerText = "Kayıt Yok";
                            document.getElementById('emptyRow').querySelector('p').innerText = "Sisteme henüz hiç sipariş düşmedi.";
                        });
                    </script>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mt-3 px-1">
        <small class="text-muted">Toplam @totalCount kayıt, Sayfa @currentPage / @totalPages</small>
        <div class="btn-group" role="group" aria-label="Sayfalama">
            <a class="btn btn-sm btn-outline-secondary @(currentPage <= 1 ? "disabled" : "")"
               href="/admin/siparisler?page=@(currentPage - 1)&pageSize=@pageSize">Önceki</a>
            <a class="btn btn-sm btn-outline-secondary @(currentPage >= totalPages ? "disabled" : "")"
               href="/admin/siparisler?page=@(currentPage + 1)&pageSize=@pageSize">Sonraki</a>
        </div>
    </div>
}

<!-- SİPARİŞ DETAY MODALI (YENİ TASARIM) -->
<div class="modal fade" id="siparisDetayModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem;">
            <div class="modal-header border-0 bg-light pb-2 pt-4 px-4 rounded-top" style="border-radius: 1.25rem;">
                <h5 class="modal-title fw-bold flex-grow-1 text-dark">
                    <i class="bi bi-receipt-cutoff me-2 text-primary"></i> <span id="mdlTitle">Sipariş Fişi</span>
                </h5>
                <button type="button" class="btn-close bg-white rounded-circle shadow-sm" data-bs-dismiss="modal" style="width: 2.5rem; height: 2.5rem;"></button>
            </div>
            <div class="modal-body px-0 py-0 pb-3" style="background-color: #f8f9fa;">
                <div id="modalLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-2 text-muted fw-bold">Veriler Getiriliyor...</div>
                </div>
                
                <div id="modalIcerik" style="display:none;">
                    <div class="bg-white p-4 mx-3 mt-3 shadow-sm" style="border-radius: 1rem; border: 1px solid #eee; position: relative;">
                        <!-- Cırt Cırt Efekti Top -->
                        <div style="position:absolute; top:-6px; left:0; right:0; height:12px; background: radial-gradient(circle, transparent 4px, #fff 5px, #fff 6px, transparent 6px); background-size: 16px 12px; z-index:1;"></div>
                        
                        <div class="row mb-3 pb-3 border-bottom border-dashed border-2 px-1">
                            <div class="col-6">
                                <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Sipariş Numarası</div>
                                <h4 class="fw-bold mb-0 text-dark" id="mdlSiparisId"></h4>
                            </div>
                            <div class="col-6 text-end">
                                <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Masa / Konum</div>
                                <h4 class="fw-bold mb-0 text-dark" id="mdlMasaNo"></h4>
                            </div>
                        </div>
                        
                        <!-- Sipariş Kalemleri -->
                        <div class="small text-muted fw-bold text-uppercase mb-3 ps-1"><i class="bi bi-list-ul"></i> Sipariş İçeriği</div>
                        <div id="mdlUrunList" class="mb-4">
                            <!-- JS İle Dolacak -->
                        </div>
                        
                        <!-- Toplam Tutar Alanı -->
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 mt-4" style="border-radius: 0.75rem; border: 2px dashed #dee2e6;">
                            <span class="text-secondary fw-bold text-uppercase fs-5">GENEL TOPLAM</span>
                            <h3 class="fw-bold text-dark mb-0" id="mdlToplamTutar"></h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center bg-light rounded-bottom py-3" style="border-radius: 1.25rem;">
                <button type="button" class="btn btn-secondary px-4 fw-bold rounded-pill shadow-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // İlk girişte Filtre çalışsın (Sadece bugün seçili geldiği için)
            filtreleTablo();
        });

        // Tablo içi Filtreleme
        function filtreleTablo() {
            var tarih = document.getElementById('filterTarih').value;
            var durum = document.getElementById('filterDurum').value;
            var masa = document.getElementById('filterMasa').value;
            var arama = document.getElementById('filterArama').value.trim();

            var rows = document.querySelectorAll('.siparis-row');
            var emptyRow = document.getElementById('emptyRow');
            var gorunanRow = 0;
            
            rows.forEach(row => {
                var rDate = row.getAttribute('data-date');
                var rDurum = row.getAttribute('data-durum');
                var rMasa = row.getAttribute('data-masa');
                var rSearch = row.getAttribute('data-search');
                var rBekleyen = row.getAttribute('data-isbekleyen') === 'true';
                
                var matchTarih = (tarih === 'all' || rDate === tarih);
                
                var matchDurum = true;
                if (durum === 'bekleyen') matchDurum = rBekleyen;
                else if (durum !== 'all') matchDurum = (rDurum === durum);
                
                var matchMasa = (masa === 'all' || rMasa === masa);
                
                var matchArama = true;
                if(arama !== '') {
                    // Sadece tam eşleşme veya içeriyorsa
                    matchArama = rSearch.includes(arama) || (rSearch === arama);
                }

                if (matchTarih && matchDurum && matchMasa && matchArama) {
                    row.style.display = '';
                    gorunanRow++;
                } else {
                    row.style.display = 'none';
                }
            });

            if(emptyRow) {
                if(gorunanRow === 0) {
                    emptyRow.style.display = '';
                } else {
                    emptyRow.style.display = 'none';
                }
            }
        }

        // Sipariş Detayını Admin/SiparislerDetay API'sinden Veya Var Olan Bir Yerden Çekmek
        async function detayGoster(id) {
            var m = new bootstrap.Modal(document.getElementById('siparisDetayModal'));
            m.show();
            
            document.getElementById('modalLoading').style.display = 'block';
            document.getElementById('modalIcerik').style.display = 'none';

            try {
                // Halihazırda var olan "/admin/siparis-detay/id" JSON dönen Controller kullanılıyor (Eski kodunuzdaki endpoint)
                const res = await fetch(`/admin/siparis-detay/${id}`);
                const data = await res.json();
                
                if(data.success || data.id) {
                    // Mevcut data objesini parse edelim
                    var sData = data.success ? data : data; // Fallback
                    
                    document.getElementById('mdlSiparisId').innerText = "#" + id;
                    document.getElementById('mdlTitle').innerText = "Sipariş Fişi #" + id;
                    document.getElementById('mdlMasaNo').innerText = sData.masaNo ? "Masa " + sData.masaNo : "Belirtilmemiş";
                    document.getElementById('mdlToplamTutar').innerText = parseFloat(sData.toplamTutar).toFixed(2) + " ₺";

                    var htmlUrun = "";
                    if(sData.detaylar && sData.detaylar.length > 0) {
                        sData.detaylar.forEach(d => {
                            // JSON içindeki opsiyonları vs parse edip güzelce yazdır
                            let opsText = "";
                            if(d.opsiyonlar) {
                                try {
                                    var ops = JSON.parse(d.opsiyonlar);
                                    if(ops.length > 0) {
                                        opsText = `<div class="small text-secondary mt-1"><i class="bi bi-tag-fill me-1"></i> ${ops.map(x => x.Ad).join(", ")}</div>`;
                                    }
                                } catch(e) {}
                            }

                            htmlUrun += `
                            <div class="d-flex justify-content-between align-items-center bg-light bg-opacity-50 p-3 mb-2 rounded" style="border: 1px solid #f1f2f4;">
                                <div>
                                    <div class="fw-bold text-dark fs-6"><span class="badge bg-secondary me-2 rounded-pill">${d.adet}x</span> ${d.urunAd || 'Ürün'}</div>
                                    ${opsText}
                                </div>
                                <div class="fw-bold text-dark fs-6">${(d.adet * d.birimFiyat).toFixed(2)} ₺</div>
                            </div>`;
                        });
                    } else {
                        htmlUrun = `<div class="text-center text-muted p-3"><i class="bi bi-exclamation-circle me-1"></i> İçerik bulunamadı.</div>`;
                    }
                    document.getElementById('mdlUrunList').innerHTML = htmlUrun;

                    document.getElementById('modalLoading').style.display = 'none';
                    document.getElementById('modalIcerik').style.display = 'block';
                } else {
                    alert("Detaylar alınamadı: " + (data.message || "Bilinmeyen hata"));
                    m.hide();
                }
            } catch (err) {
                console.error(err);
                alert("İşlem sırasında bir hata oluştu.");
                m.hide();
            }
        }
    </script>
}
