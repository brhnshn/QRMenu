@model List<QRMenu.Core.Entities.Urun>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Ürünler";
    ViewData["ActivePage"] = "Urunler";
    ViewData["PageTitle"] = "Ürün & Kategori Yönetimi";
    var kategoriler = ViewBag.Kategoriler as List<QRMenu.Core.Entities.Kategori> ?? new();
}

@section Styles {
    <style>
        body { font-family: 'Be Vietnam Pro', sans-serif; }
        .font-headline { font-family: 'Plus Jakarta Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .admin-content { padding: 0 !important; background: transparent; }
        .bg-surface { background-color: transparent !important; }
        /* Hide scrollbar for category chips */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
        
        @@media (max-width: 768px) {
            .table-responsive-none { display: none; }
        }
    </style>
}

<div class="p-6 md:p-8 w-full space-y-8">
    <!-- Breadcrumbs & Header Actions -->
    <!-- Breadcrumbs & Header Actions -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest mb-1">
                <span>Yönetim</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary">Ürünler & Kategoriler</span>
            </div>
            <h2 class="text-2xl md:text-3xl font-extrabold text-stone-900 font-headline">Kategori Yönetimi</h2>
        </div>
        <div class="flex gap-2 w-full md:w-auto">
            <button class="flex-1 md:flex-none bg-white border-2 border-surface-container-high text-on-surface px-4 md:px-6 py-2.5 rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-surface-container transition-colors shadow-sm text-sm md:text-base" onclick="urunTasiModalAc()">
                <span class="material-symbols-outlined">move_item</span> Ürün Taşı
            </button>
            <button class="flex-1 md:flex-none bg-primary text-on-primary px-4 md:px-6 py-2.5 rounded-xl font-bold flex items-center justify-center gap-2 hover:opacity-90 transition-all shadow-md text-sm md:text-base" onclick="urunModal()">
                <span class="material-symbols-outlined">add</span> Yeni Ürün
            </button>
        </div>
    </div>

    <!-- Category Filter Chips -->
    <!-- Category Filter Chips -->
    <div class="flex overflow-x-auto scrollbar-hide gap-3 mb-10 pb-4 -mx-6 px-6 md:mx-0 md:px-0 md:flex-wrap items-center" id="kategoriList">
        <button class="bg-secondary-container text-on-secondary-container px-6 py-2.5 rounded-full font-bold text-sm flex items-center gap-2 shadow-sm whitespace-nowrap" onclick="document.getElementById('filterKategori').value=''; filterTable();">
            Tüm Kategoriler
        </button>
        @foreach (var kat in kategoriler)
        {
            <div class="group relative flex items-center flex-shrink-0">
                <button class="bg-white text-stone-600 border border-transparent hover:border-outline-variant px-6 py-2.5 rounded-full font-semibold text-sm whitespace-nowrap transition-all flex items-center gap-2" onclick="document.getElementById('filterKategori').value='@kat.Id'; filterTable();">
                    @kat.Ad
                    <span class="bg-surface-container text-xs rounded-full px-2 py-0.5 ml-1">@Model.Count(u => u.KategoriId == kat.Id)</span>
                </button>
                <div class="hidden group-hover:flex absolute -top-10 left-1/2 -translate-x-1/2 bg-white shadow-lg rounded-xl p-1 gap-1 border border-stone-100 z-10">
                    <button class="p-2 text-stone-400 hover:text-primary transition-colors" onclick="kategoriModal(@kat.Id, '@kat.Ad.Replace("'", "\\'")', '@(kat.AdEN?.Replace("'", "\\'") ?? "")', @kat.SiraNo)"><span class="material-symbols-outlined text-sm">edit</span></button>
                    <button class="p-2 text-stone-400 hover:text-error transition-colors" onclick="kategoriSil(@kat.Id, '@kat.Ad.Replace("'", "\\'")')"><span class="material-symbols-outlined text-sm">delete</span></button>
                </div>
            </div>
        }
        <button class="bg-surface-container-high text-stone-400 p-2.5 rounded-full hover:bg-stone-300 transition-colors flex-shrink-0" onclick="kategoriModal()">
            <span class="material-symbols-outlined">add</span>
        </button>
    </div>

    <!-- Product Management Container -->
    <div class="bg-white rounded-[2rem] border border-stone-200/50 overflow-hidden shadow-sm">
        <!-- Filter Bar -->
        <div class="p-6 bg-surface-container-low flex flex-col md:flex-row gap-4 border-b border-stone-100">
            <div class="flex-1 flex gap-4">
                <div class="flex-1 relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-stone-400">search</span>
                    <input class="w-full bg-white border-none rounded-xl pl-12 pr-4 py-3 focus:ring-2 focus:ring-primary/20 text-sm" id="filterSearch" placeholder="Ürün ara..." type="text" oninput="filterTable()"/>
                </div>
                <!-- Hidden select for compatibility with filterTable() logic -->
                <select id="filterKategori" class="hidden" onchange="filterTable()">
                    <option value="">Tümü</option>
                    @foreach (var k in kategoriler) { <option value="@k.Id">@k.Ad</option> }
                </select>
                <select class="bg-white border-none rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary/20 text-sm font-semibold min-w-[200px]" id="filterDurum" onchange="filterTable()">
                    <option value="">Tüm Durumlar</option>
                    <option value="aktif">Aktif</option>
                    <option value="pasif">Pasif</option>
                </select>
            </div>
        </div>

        <!-- Product Table / Mobile Cards -->
        <div class="w-full">
            @if (Model.Any())
            {
                <table class="w-full text-left border-collapse table-responsive-none">
                    <thead>
                        <tr class="bg-white border-b border-stone-100">
                            <th class="px-8 py-5 text-[11px] font-extrabold text-stone-400 uppercase tracking-widest">Ürün Detayı</th>
                            <th class="px-6 py-5 text-[11px] font-extrabold text-stone-400 uppercase tracking-widest">Kategori</th>
                            <th class="px-6 py-5 text-[11px] font-extrabold text-stone-400 uppercase tracking-widest">Fiyat</th>
                            <th class="px-6 py-5 text-[11px] font-extrabold text-stone-400 uppercase tracking-widest">Durum</th>
                            <th class="px-8 py-5 text-[11px] font-extrabold text-stone-400 uppercase tracking-widest text-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-50" id="urunTbody">
                        @foreach (var urun in Model)
                        {
                            <tr class="hover:bg-surface-container-lowest transition-colors group urun-row" data-id="@urun.Id" data-kategori="@urun.KategoriId" data-ad="@urun.Ad.ToLower()" data-durum="@(urun.AktifMi ? "aktif" : "pasif")">
                                <td class="px-8 py-4">
                                    <div class="flex items-center gap-4">
                                        <div class="w-14 h-14 rounded-2xl overflow-hidden bg-stone-100 flex-shrink-0 flex items-center justify-center">
                                            @if (!string.IsNullOrEmpty(urun.GorselUrl))
                                            {
                                                <img alt="@urun.Ad" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="@urun.GorselUrl"/>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined text-stone-300">image</span>
                                            }
                                        </div>
                                        <div>
                                            <p class="font-bold text-stone-900 mb-0.5">
                                                @urun.Ad
                                                @if (urun.PopulerMi) { <span class="ml-2 text-[10px] bg-secondary-container text-on-secondary-container px-2 py-0.5 rounded uppercase font-bold tracking-wider">Popüler</span> }
                                            </p>
                                            <p class="text-xs text-stone-500 line-clamp-1" style="max-width:300px;">@(urun.Aciklama ?? "-")</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 bg-surface-container-high text-on-surface-variant rounded-full text-[11px] font-bold">@urun.Kategori.Ad</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-stone-900 font-extrabold">₺@urun.Fiyat.ToString("N2")</span>
                                </td>
                                <td class="px-6 py-4">
                                    <button class="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-transparent hover:border-stone-200 transition-colors" onclick="toggleUrun(@urun.Id)">
                                        @if (urun.AktifMi)
                                        {
                                            <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                                            <span class="text-xs font-bold text-emerald-600">Aktif</span>
                                        }
                                        else
                                        {
                                            <div class="w-2 h-2 rounded-full bg-stone-300"></div>
                                            <span class="text-xs font-bold text-stone-400">Pasif</span>
                                        }
                                    </button>
                                </td>
                                <td class="px-8 py-4 text-right">
                                    <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button class="p-2 text-stone-400 hover:text-primary transition-colors" title="Düzenle" onclick="urunDuzenle(@urun.Id)">
                                            <span class="material-symbols-outlined">edit</span>
                                        </button>
                                        <button class="p-2 text-stone-400 hover:text-secondary transition-colors" title="Opsiyonlar" onclick="opsiyonModal(@urun.Id, '@urun.Ad.Replace("'", "\\'")')">
                                            <span class="material-symbols-outlined">settings_suggest</span>
                                        </button>
                                        <button class="p-2 text-stone-400 hover:text-error transition-colors" title="Sil" onclick="urunSil(@urun.Id, '@urun.Ad.Replace("'", "\\'")')">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Mobile Card View -->
                <div class="md:hidden divide-y divide-stone-100" id="urunMobileCards">
                    @foreach (var urun in Model)
                    {
                        <div class="p-5 flex flex-col gap-4 urun-row-mobile" data-id="@urun.Id" data-kategori="@urun.KategoriId" data-ad="@urun.Ad.ToLower()" data-durum="@(urun.AktifMi ? "aktif" : "pasif")">
                            <div class="flex items-center gap-4">
                                <div class="w-16 h-16 rounded-2xl overflow-hidden bg-stone-100 flex-shrink-0 flex items-center justify-center">
                                    @if (!string.IsNullOrEmpty(urun.GorselUrl))
                                    {
                                        <img alt="@urun.Ad" class="w-full h-full object-cover" src="@urun.GorselUrl"/>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-stone-300">image</span>
                                    }
                                </div>
                                <div class="flex-1">
                                    <div class="flex justify-between items-start">
                                        <p class="font-bold text-stone-900 mb-0.5">@urun.Ad</p>
                                        <span class="text-stone-900 font-extrabold">₺@urun.Fiyat.ToString("N2")</span>
                                    </div>
                                    <p class="text-[11px] text-stone-500 mb-2">@urun.Kategori.Ad</p>
                                    <div class="flex gap-2">
                                        @if (urun.PopulerMi) { <span class="text-[9px] bg-secondary-container text-on-secondary-container px-2 py-0.5 rounded uppercase font-bold tracking-wider">Popüler</span> }
                                        <button onclick="toggleUrun(@urun.Id)" class="border-0 bg-transparent p-0">
                                            @if (urun.AktifMi) { <span class="text-[9px] bg-emerald-100 text-emerald-600 px-2 py-0.5 rounded uppercase font-bold">Aktif</span> }
                                            else { <span class="text-[9px] bg-stone-100 text-stone-400 px-2 py-0.5 rounded uppercase font-bold">Pasif</span> }
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="flex gap-2 border-t border-stone-50 pt-4">
                                <button class="flex-1 bg-stone-100 text-stone-600 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 border-0" onclick="urunDuzenle(@urun.Id)">
                                    <span class="material-symbols-outlined text-sm">edit</span> Düzenle
                                </button>
                                <button class="flex-1 bg-stone-100 text-stone-600 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 border-0" onclick="opsiyonModal(@urun.Id, '@urun.Ad.Replace("'", "\\'")')">
                                    <span class="material-symbols-outlined text-sm">settings_suggest</span> Opsiyonlar
                                </button>
                                <button class="bg-red-50 text-red-500 p-2.5 rounded-xl border-0 flex items-center justify-center" onclick="urunSil(@urun.Id, '@urun.Ad.Replace("'", "\\'")')">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center text-stone-500">
                    <span class="material-symbols-outlined text-4xl mb-3 opacity-50">restaurant_menu</span>
                    <h5 class="font-bold font-headline">Henüz Ürün Yok</h5>
                    <p class="text-sm">İlk ürününüzü ekleyerek başlayın.</p>
                </div>
            }
        </div>
    </div>
</div>

<div id="mesaj"></div>

<!-- KATEGORİ MODAL -->
<div class="modal fade" id="kategoriModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl rounded-3xl overflow-hidden bg-white">
            <div class="p-6 border-b border-stone-200 flex justify-between items-center">
                <h3 class="text-xl font-bold font-headline flex items-center gap-2" id="kategoriModalTitle">Kategori Ekle</h3>
                <button type="button" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 transition-colors border-0 bg-transparent" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <input type="hidden" id="kategoriEditId" value="0" />
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-tertiary uppercase mb-1 font-label">Kategori Adı [TR] *</label>
                        <input type="text" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="kategoriAd" maxlength="100" placeholder="Ör: Tatlılar" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-tertiary uppercase mb-1 font-label">Kategori Adı [EN]</label>
                        <input type="text" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="kategoriAdEN" maxlength="100" placeholder="Ör: Desserts" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-tertiary uppercase mb-1 font-label">Sıra No</label>
                    <input type="number" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="kategoriSiraNo" value="0" min="0" />
                </div>
            </div>
            <div class="p-6 bg-stone-50 flex gap-3">
                <button type="button" class="flex-1 bg-surface-container-highest text-on-surface font-bold py-3 rounded-xl hover:bg-stone-300 transition-colors border-0" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="flex-1 bg-primary text-on-primary font-bold py-3 rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.02] transition-transform border-0" onclick="kategoriKaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- ÜRÜN EKLE/DÜZENLE MODAL -->
<div class="modal fade" id="urunModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-2xl rounded-3xl overflow-hidden bg-white">
            <div class="p-6 border-b border-stone-200 flex justify-between items-center">
                <h3 class="text-xl font-bold font-headline flex items-center gap-2" id="urunModalTitle">Yeni Ürün Ekle</h3>
                <button type="button" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 transition-colors border-0 bg-transparent" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>
            <div class="p-6">
                <form id="urunForm" enctype="multipart/form-data">
                    <input type="hidden" id="urunEditId" value="0" />
                    <div class="text-center mb-6">
                        <img id="gorselPreview" class="rounded-2xl shadow-sm mx-auto object-cover" style="max-width: 120px; max-height:120px; display: none;" />
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Ürün Adı [TR] *</label>
                            <input type="text" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="urunAd" name="Ad" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Ürün Adı [EN]</label>
                            <input type="text" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="urunAdEN" name="AdEN" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Açıklama [TR]</label>
                            <textarea class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20 resize-none h-20" id="urunAciklama" name="Aciklama"></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Açıklama [EN]</label>
                            <textarea class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20 resize-none h-20" id="urunAciklamaEN" name="AciklamaEN"></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Fiyat (₺) *</label>
                            <input type="number" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="urunFiyat" name="Fiyat" step="0.01" min="0.01" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Kategori *</label>
                            <select class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="urunKategori" name="KategoriId" required>
                                <option value="">Seçiniz</option>
                                @foreach (var kat in kategoriler) { <option value="@kat.Id">@kat.Ad</option> }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Görsel (max 2MB)</label>
                            <input type="file" class="w-full bg-surface-container-low border-none rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 text-sm mb-1" id="urunGorsel" name="Gorsel" accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this)" />
                            <div id="currentGorselPath" class="text-[10px] text-stone-400 truncate px-1"></div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Kalori (kcal)</label>
                            <input type="number" class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="urunKalori" name="Kalori" min="0" />
                        </div>
                        <div class="md:col-span-2 flex items-center gap-6 mt-2">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" id="urunPopuler" name="PopulerMi" value="true" class="w-5 h-5 rounded text-primary focus:ring-primary border-stone-300" />
                                <span class="font-bold text-stone-700">Popüler Ürün</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" id="urunAktif" name="AktifMi" value="true" checked class="w-5 h-5 rounded text-emerald-500 focus:ring-emerald-500 border-stone-300" />
                                <span class="font-bold text-stone-700">Aktif Satışta</span>
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="p-6 bg-stone-50 flex gap-3">
                <button type="button" class="flex-1 bg-surface-container-highest text-on-surface font-bold py-3 rounded-xl hover:bg-stone-300 transition-colors border-0" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="flex-1 bg-primary text-on-primary font-bold py-3 rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.02] transition-transform border-0" onclick="urunKaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- ÜRÜN TAŞIMA MODAL -->
<div class="modal fade" id="urunTasiModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-2xl rounded-3xl overflow-hidden bg-white">
            <div class="p-6 border-b border-stone-200 flex justify-between items-center">
                <h3 class="text-xl font-bold font-headline flex items-center gap-2" id="urunTasiModalTitle">Ürün Taşı</h3>
                <button type="button" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 transition-colors border-0 bg-transparent" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <form id="urunTasiForm">
                    <div>
                        <label class="block text-xs font-bold text-tertiary uppercase mb-1">Kaynak Kategori</label>
                        <select class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="kaynakKategoriId" onchange="urunTasiListeYenile()">
                            <option value="">Seçiniz...</option>
                            @foreach (var k in kategoriler) { <option value="@k.Id">@k.Ad</option> }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-tertiary uppercase mb-1 mt-4">Taşınacak Ürünler</label>
                        <div id="tasinacakUrunlerList" class="bg-surface-container-lowest border border-stone-200 rounded-xl p-3 max-h-[160px] overflow-y-auto">
                            <span class="text-sm text-stone-400">Önce kaynak kategori seçin.</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-tertiary uppercase mb-1 mt-4">Hedef Kategori</label>
                        <select class="w-full bg-surface-container-low border-none rounded-xl p-3 focus:ring-2 focus:ring-primary/20" id="hedefKategoriId">
                            <option value="">Seçiniz...</option>
                            @foreach (var k in kategoriler) { <option value="@k.Id">@k.Ad</option> }
                        </select>
                    </div>
                </form>
            </div>
            <div class="p-6 bg-stone-50 flex gap-3">
                <button type="button" class="flex-1 bg-surface-container-highest text-on-surface font-bold py-3 rounded-xl hover:bg-stone-300 transition-colors border-0" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="flex-1 bg-primary text-on-primary font-bold py-3 rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.02] transition-transform border-0" onclick="urunTasiKaydet()">Taşı</button>
            </div>
        </div>
    </div>
</div>

<!-- OPSİYON MODAL -->
<div class="modal fade" id="opsiyonModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-lg-down">
        <div class="modal-content border-0 shadow-2xl rounded-3xl overflow-hidden bg-white">
            <div class="p-6 border-b border-stone-200 flex justify-between items-center bg-surface-container-low">
                <div>
                    <h3 class="text-2xl font-black text-stone-900" id="opsiyonModalTitle">Opsiyon Yönetimi</h3>
                    <p class="text-sm text-stone-500 font-medium" id="opsiyonModalSubtitle">Ürün için ek seçenekler</p>
                </div>
                <button type="button" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-stone-200 transition-colors border-0 bg-transparent" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-6 bg-white overflow-y-auto" style="max-height: 75vh;">
                <input type="hidden" id="opsiyonUrunId" value="0" />
                
                <!-- YENİ SEÇENEK EKLE (ARTIK ÜSTTE) -->
                <div class="border-2 border-dashed border-stone-200 rounded-2xl p-6 bg-stone-50 mb-8">
                    <h4 class="font-bold text-stone-700 mb-4 flex items-center gap-2"><span class="material-symbols-outlined text-primary">add_circle</span> Yeni Seçenek Ekle</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Grup Seçin [TR]</label>
                            <div class="flex gap-2">
                                <select class="flex-1 bg-white border border-stone-200 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 text-sm" id="grupSecici" onchange="grupSecildi(this)">
                                    <option value="">Seçiniz...</option>
                                    <option value="NEW">+ Yeni Grup Ekle</option>
                                </select>
                                <button type="button" id="btnGrupReset" class="hidden px-3 bg-stone-100 rounded-xl hover:bg-stone-200" onclick="resetGrupSecim()" title="Sıfırla">
                                    <span class="material-symbols-outlined text-sm">refresh</span>
                                </button>
                            </div>
                            <div id="yeniGrupArea" class="hidden mt-2 animate-in fade-in slide-in-from-top-1">
                                <input type="text" class="w-full bg-white border border-stone-200 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 text-sm" id="yeniOpsiyonGrup" placeholder="Yeni Grup Adı Girin..." />
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Grup [EN]</label>
                            <input type="text" class="w-full bg-white border border-stone-200 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 text-sm" id="yeniOpsiyonGrupEN" placeholder="Ör: Size" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Seçenek Adı [TR]</label>
                            <input type="text" class="w-full bg-white border border-stone-200 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 text-sm" id="yeniOpsiyonAd" placeholder="Ör: Büyük" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Seçenek Adı [EN]</label>
                            <input type="text" class="w-full bg-white border border-stone-200 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 text-sm" id="yeniOpsiyonAdEN" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Fiyat Farkı (₺)</label>
                            <input type="number" class="w-full bg-white border border-stone-200 rounded-xl p-2.5 focus:ring-2 focus:ring-primary/20 text-sm" id="yeniOpsiyonFiyat" value="0" step="any" min="0" />
                        </div>
                        <div class="flex flex-col justify-end">
                            <label class="block text-xs font-bold text-tertiary uppercase mb-1">Zorunluluk</label>
                            <div class="flex bg-white rounded-xl border border-stone-200 overflow-hidden">
                                <input type="radio" class="peer/zorunlu hidden" name="btnZorunluRadio" id="zorunluToggleOn" checked>
                                <label class="flex-1 text-center py-2.5 text-sm font-bold cursor-pointer peer-checked/zorunlu:bg-primary/10 peer-checked/zorunlu:text-primary transition-colors" for="zorunluToggleOn">Zorunlu</label>
                                
                                <input type="radio" class="peer/opsiyonel hidden" name="btnZorunluRadio" id="zorunluToggleOff">
                                <label class="flex-1 text-center py-2.5 text-sm font-bold cursor-pointer peer-checked/opsiyonel:bg-emerald-50 peer-checked/opsiyonel:text-emerald-600 transition-colors border-l border-stone-200" for="zorunluToggleOff">Opsiyonel</label>
                            </div>
                        </div>
                        <div class="md:col-span-2 flex justify-end mt-2">
                            <button class="bg-primary text-on-primary px-6 py-2.5 rounded-xl font-bold hover:bg-primary-dim transition-colors" onclick="opsiyonEkle()">Ekle</button>
                        </div>
                    </div>
                </div>

                <div id="opsiyonList" class="space-y-4">
                    <!-- Dinamik liste gelecek -->
                </div>
            </div>
            <div class="p-6 bg-surface-container-low border-t border-stone-100 flex justify-end gap-3">
                <button type="button" class="px-8 py-3 rounded-xl font-bold bg-white border border-stone-200 text-stone-600 hover:bg-stone-50 transition-colors" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function mesaj(text, tip) {
        var bgColor = tip === 'success' ? 'bg-emerald-500' : (tip === 'danger' ? 'bg-red-500' : 'bg-primary');
        document.getElementById('mesaj').innerHTML = '<div class="fixed bottom-5 right-5 ' + bgColor + ' text-white px-6 py-3 rounded-xl shadow-xl font-bold z-[9999] animate-[bounce_1s_ease-in-out]">' + text + '</div>';
        setTimeout(function() { document.getElementById('mesaj').innerHTML = ''; }, 3000);
    }

    function filterTable() {
        var katId = document.getElementById('filterKategori').value;
        var search = document.getElementById('filterSearch').value.toLowerCase();
        var durum = document.getElementById('filterDurum').value;

        // Desktop rows
        document.querySelectorAll('.urun-row').forEach(function(tr) {
            var matchKat = !katId || tr.dataset.kategori === katId;
            var matchSearch = !search || tr.dataset.ad.includes(search);
            var matchDurum = !durum || tr.dataset.durum === durum;
            tr.style.display = (matchKat && matchSearch && matchDurum) ? '' : 'none';
        });

        // Mobile cards
        document.querySelectorAll('.urun-row-mobile').forEach(function(div) {
            var matchKat = !katId || div.dataset.kategori === katId;
            var matchSearch = !search || div.dataset.ad.includes(search);
            var matchDurum = !durum || div.dataset.durum === durum;
            div.style.display = (matchKat && matchSearch && matchDurum) ? 'flex' : 'none';
        });
    }

    // --- KATEGORİ ---
    function kategoriModal(id, ad, adEN, siraNo) {
        document.getElementById('kategoriEditId').value = id || 0;
        document.getElementById('kategoriAd').value = ad || '';
        document.getElementById('kategoriAdEN').value = adEN || '';
        document.getElementById('kategoriSiraNo').value = siraNo || 0;
        document.getElementById('kategoriModalTitle').innerHTML = id ? 'Kategori Düzenle' : 'Kategori Ekle';
        new bootstrap.Modal(document.getElementById('kategoriModal')).show();
    }

    async function kategoriKaydet() {
        var id = parseInt(document.getElementById('kategoriEditId').value);
        var ad = document.getElementById('kategoriAd').value.trim();
        if (!ad) { mesaj('Kategori adı boş olamaz.', 'danger'); return; }

        var payload = { ad: ad, adEN: document.getElementById('kategoriAdEN').value.trim() || null, siraNo: parseInt(document.getElementById('kategoriSiraNo').value) || 0 };
        var url = id > 0 ? '/admin/kategori-guncelle/' + id : '/admin/kategori-ekle';
        var res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        var data = await res.json();
        
        if (data.success) {
            mesaj(id > 0 ? 'Kategori güncellendi.' : 'Kategori eklendi.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else { mesaj(data.message, 'danger'); }
    }

    async function kategoriSil(id, ad) {
        const result = await window.SavorAlert.fire({
            title: 'Emin misiniz?',
            text: '"' + ad + '" kategorisi silinsin mi?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        });
        if (!result.isConfirmed) return;
        var res = await fetch('/admin/kategori-sil/' + id, { method: 'POST' });
        var data = await res.json();
        if (data.success) {
            mesaj('Kategori silindi.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else { mesaj(data.message, 'warning'); }
    }

    // --- ÜRÜN ---
    function urunModal() {
        document.getElementById('urunEditId').value = 0;
        document.getElementById('urunForm').reset();
        document.getElementById('urunAktif').checked = true;
        document.getElementById('gorselPreview').style.display = 'none';
        document.getElementById('currentGorselPath').innerText = '';
        document.getElementById('urunModalTitle').innerHTML = 'Yeni Ürün Ekle';
        new bootstrap.Modal(document.getElementById('urunModal')).show();
    }

    async function urunDuzenle(id) {
        var res = await fetch('/admin/urun-detay/' + id);
        var data = await res.json();
        if (!data.success) { mesaj(data.message, 'danger'); return; }
        var u = data.urun;

        document.getElementById('urunEditId').value = u.id;
        document.getElementById('urunAd').value = u.ad;
        document.getElementById('urunAdEN').value = u.adEN || '';
        document.getElementById('urunAciklama').value = u.aciklama || '';
        document.getElementById('urunAciklamaEN').value = u.aciklamaEN || '';
        document.getElementById('urunFiyat').value = u.fiyat;
        document.getElementById('urunKategori').value = u.kategoriId;
        document.getElementById('urunPopuler').checked = u.populerMi;
        document.getElementById('urunAktif').checked = u.aktifMi;
        document.getElementById('urunKalori').value = u.kalori || '';
        document.getElementById('urunGorsel').value = '';

        var preview = document.getElementById('gorselPreview');
        var pathDiv = document.getElementById('currentGorselPath');
        if (u.gorselUrl) { 
            preview.src = u.gorselUrl; 
            preview.style.display = 'block';
            pathDiv.innerText = 'Mevcut: ' + u.gorselUrl.split('/').pop();
        }
        else { 
            preview.style.display = 'none'; 
            pathDiv.innerText = '';
        }

        document.getElementById('urunModalTitle').innerHTML = 'Ürün Düzenle: ' + u.ad;
        new bootstrap.Modal(document.getElementById('urunModal')).show();
    }

    async function urunKaydet() {
        var id = parseInt(document.getElementById('urunEditId').value);
        var form = new FormData();
        form.append('Ad', document.getElementById('urunAd').value);
        form.append('AdEN', document.getElementById('urunAdEN').value);
        form.append('Aciklama', document.getElementById('urunAciklama').value);
        form.append('AciklamaEN', document.getElementById('urunAciklamaEN').value);
        form.append('Fiyat', document.getElementById('urunFiyat').value);
        form.append('KategoriId', document.getElementById('urunKategori').value);
        form.append('PopulerMi', document.getElementById('urunPopuler').checked);
        form.append('AktifMi', document.getElementById('urunAktif').checked);
        var kaloriVal = document.getElementById('urunKalori').value;
        if (kaloriVal) form.append('Kalori', kaloriVal);

        var gorselInput = document.getElementById('urunGorsel');
        if (gorselInput.files.length > 0) form.append('Gorsel', gorselInput.files[0]);

        var url = id > 0 ? '/admin/urun-guncelle/' + id : '/admin/urun-ekle';
        var res = await fetch(url, { method: 'POST', body: form });
        var data = await res.json();

        if (data.success) {
            mesaj(id > 0 ? 'Ürün güncellendi.' : 'Ürün eklendi.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else { mesaj(data.message, 'danger'); }
    }

    async function urunSil(id, ad) {
        const result = await window.SavorAlert.fire({
            title: 'Emin misiniz?',
            text: '"' + ad + '" ürünü silinsin mi?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        });
        if (!result.isConfirmed) return;
        var res = await fetch('/admin/urun-sil/' + id, { method: 'POST' });
        var data = await res.json();
        if (data.success) {
            mesaj(data.message || 'Ürün silindi.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else { mesaj(data.message, 'danger'); }
    }

    async function toggleUrun(id) {
        var res = await fetch('/admin/urun-toggle/' + id, { method: 'POST' });
        var data = await res.json();
        if (data.success) {
            mesaj('Durum güncellendi.', 'success');
            setTimeout(function() { location.reload(); }, 300);
        }
    }

    function previewImage(input) {
        var preview = document.getElementById('gorselPreview');
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) { preview.src = e.target.result; preview.style.display = 'block'; };
            reader.readAsDataURL(input.files[0]);
        } else { preview.style.display = 'none'; }
    }

    // --- TAŞIMA ---
    function urunTasiModalAc() {
        document.getElementById('urunTasiForm').reset();
        document.getElementById('tasinacakUrunlerList').innerHTML = '<span class="text-sm text-stone-400">Önce kaynak kategori seçin.</span>';
        new bootstrap.Modal(document.getElementById('urunTasiModal')).show();
    }

    function urunTasiListeYenile() {
        var kaynakKategoriId = document.getElementById('kaynakKategoriId').value;
        var list = document.getElementById('tasinacakUrunlerList');
        if (!kaynakKategoriId) { list.innerHTML = '<span class="text-sm text-stone-400">Önce kaynak kategori seçin.</span>'; return; }

        var urunler = Array.from(document.querySelectorAll('.urun-row'))
            .filter(function(tr) { return tr.dataset.kategori === kaynakKategoriId; })
            .map(function(tr) { return { id: tr.dataset.id, ad: tr.dataset.ad }; });

        if (!urunler.length) { list.innerHTML = '<span class="text-sm text-stone-400">Bu kategoride taşınacak ürün bulunamadı.</span>'; return; }

        list.innerHTML = urunler.map(function(u) {
            return '<div class="flex items-center gap-2 mb-2">' +
                '<input type="checkbox" class="w-4 h-4 rounded text-primary focus:ring-primary border-stone-300 tasinacak-urun-check" value="' + u.id + '" id="tasiUrun_' + u.id + '">' +
                '<label class="text-sm text-stone-700 cursor-pointer" for="tasiUrun_' + u.id + '">' + u.ad + '</label>' +
                '</div>';
        }).join('');
    }

    async function urunTasiKaydet() {
        var kaynakKategoriId = document.getElementById('kaynakKategoriId').value;
        var kategoriId = document.getElementById('hedefKategoriId').value;
        var secilenUrunIds = Array.from(document.querySelectorAll('.tasinacak-urun-check:checked')).map(function(cb) { return parseInt(cb.value); });

        if (!kaynakKategoriId || !kategoriId) { mesaj('Kategori seçimi zorunlu.', 'warning'); return; }
        if (parseInt(kaynakKategoriId) === parseInt(kategoriId)) { mesaj('Aynı kategoriye taşınamaz.', 'warning'); return; }
        if (!secilenUrunIds.length) { mesaj('Ürün seçin.', 'warning'); return; }

        var res = await fetch('/admin/urun-tasi', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ UrunIds: secilenUrunIds, YeniKategoriId: parseInt(kategoriId) }) });
        var data = await res.json();
        if (data.success) {
            mesaj(secilenUrunIds.length + ' ürün taşındı.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else { mesaj(data.message, 'danger'); }
    }

    // --- OPSİYON ---
    var currentProductGroups = [];
    async function opsiyonModal(urunId, urunAd) {
        document.getElementById('opsiyonUrunId').value = urunId;
        document.getElementById('opsiyonModalSubtitle').innerText = urunAd + ' için ek seçenekler';
        
        resetGrupSecim();
        document.getElementById('yeniOpsiyonAd').value = '';
        document.getElementById('yeniOpsiyonAdEN').value = '';
        document.getElementById('yeniOpsiyonFiyat').value = 0;
        document.getElementById('zorunluToggleOn').checked = true;

        await opsiyonListeYenile(urunId);
        new bootstrap.Modal(document.getElementById('opsiyonModal')).show();
    }

    function grupSecildi(el) {
        var val = el.value;
        var yeniArea = document.getElementById('yeniGrupArea');
        var grupInput = document.getElementById('yeniOpsiyonGrup');
        var grupENInput = document.getElementById('yeniOpsiyonGrupEN');
        var btnReset = document.getElementById('btnGrupReset');

        if (val === 'NEW') {
            yeniArea.classList.remove('hidden');
            grupInput.value = '';
            grupENInput.value = '';
            grupENInput.readOnly = false;
            btnReset.classList.remove('hidden');
        } else if (val !== '') {
            yeniArea.classList.add('hidden');
            var found = currentProductGroups.find(g => g.grup === val);
            grupInput.value = val;
            grupENInput.value = found ? (found.grupEN || '') : '';
            grupENInput.readOnly = true;
            btnReset.classList.remove('hidden');
        } else {
            resetGrupSecim();
        }
    }

    function resetGrupSecim() {
        document.getElementById('grupSecici').value = '';
        document.getElementById('yeniGrupArea').classList.add('hidden');
        document.getElementById('yeniOpsiyonGrup').value = '';
        document.getElementById('yeniOpsiyonGrupEN').value = '';
        document.getElementById('yeniOpsiyonGrupEN').readOnly = false;
        document.getElementById('btnGrupReset').classList.add('hidden');
    }

    async function opsiyonListeYenile(urunId) {
        var res = await fetch('/admin/urun-detay/' + urunId);
        var data = await res.json();
        var listDiv = document.getElementById('opsiyonList');

        if (!data.success || !data.urun.opsiyonlar || data.urun.opsiyonlar.length === 0) {
            listDiv.innerHTML = '<div class="text-center py-6 text-stone-400 text-sm">Bu ürüne henüz opsiyon eklenmemiş.</div>';
            return;
        }

        var gruplar = {};
        currentProductGroups = [];
        data.urun.opsiyonlar.forEach(function(o) {
            if (!gruplar[o.grup]) {
                gruplar[o.grup] = { adEN: o.grupEN, zorunlu: o.zorunlu, opsiyonlar: [] };
                currentProductGroups.push({ grup: o.grup, grupEN: o.grupEN });
            }
            gruplar[o.grup].opsiyonlar.push(o);
        });

        // Grup seçiciyi güncelle
        var sel = document.getElementById('grupSecici');
        sel.innerHTML = '<option value="">Seçiniz...</option>' + 
                       currentProductGroups.map(g => '<option value="' + g.grup + '">' + g.grup + '</option>').join('') +
                       '<option value="NEW">+ Yeni Grup Ekle</option>';

        var html = '';
        for(var g in gruplar) {
            var dt = gruplar[g];
            html += '<div class="bg-surface-container-lowest border border-stone-200 rounded-2xl p-6">' +
                '<div class="flex justify-between items-start mb-4">' +
                '<div><h4 class="font-bold text-stone-900">' + g + (dt.adEN ? ' <span class="text-xs text-stone-400">(' + dt.adEN + ')</span>' : '') + '</h4>' +
                '<p class="text-xs text-stone-400">' + (dt.zorunlu ? 'Zorunlu' : 'Opsiyonel') + '</p></div></div>' +
                '<div class="flex flex-col gap-2">';
            
            dt.opsiyonlar.forEach(function(o) {
                html += '<div class="flex justify-between items-center bg-white border border-stone-100 rounded-xl px-4 py-2">' +
                    '<div class="flex flex-col"><span class="text-sm font-bold text-stone-700">' + o.ad + '</span>' +
                    (o.adEN ? '<span class="text-[10px] text-stone-400">' + o.adEN + '</span>' : '') + '</div>' +
                    '<div class="flex items-center gap-4">' +
                    (o.ekFiyat > 0 ? '<span class="text-sm font-bold text-emerald-600">+₺' + o.ekFiyat.toFixed(2) + '</span>' : '<span class="text-xs text-stone-400">Ücretsiz</span>') +
                    '<button class="text-error hover:text-red-700 p-1" onclick="opsiyonSil(' + o.id + ')" title="Sil"><span class="material-symbols-outlined text-sm">delete</span></button>' +
                    '</div></div>';
            });
            html += '</div></div>';
        }
        listDiv.innerHTML = html;
    }

    async function opsiyonEkle() {
        var urunId = parseInt(document.getElementById('opsiyonUrunId').value);
        var grup = document.getElementById('yeniOpsiyonGrup').value.trim();
        var ad = document.getElementById('yeniOpsiyonAd').value.trim();
        if (!grup || !ad) { mesaj('TR Grup ve Ad zorunlu.', 'danger'); return; }

        var payload = {
            urunId: urunId, ad: ad, adEN: document.getElementById('yeniOpsiyonAdEN').value.trim() || null,
            grup: grup, grupEN: document.getElementById('yeniOpsiyonGrupEN').value.trim() || null,
            ekFiyat: parseFloat(document.getElementById('yeniOpsiyonFiyat').value) || 0,
            zorunlu: document.getElementById('zorunluToggleOn').checked
        };
        
        var res = await fetch('/admin/opsiyon-ekle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        var data = await res.json();
        if (data.success) {
            mesaj('Opsiyon eklendi.', 'success');
            document.getElementById('yeniOpsiyonAd').value = '';
            document.getElementById('yeniOpsiyonAdEN').value = '';
            document.getElementById('yeniOpsiyonFiyat').value = 0;
            await opsiyonListeYenile(urunId);
        } else { mesaj(data.message, 'warning'); }
    }

    async function opsiyonSil(id) {
        var urunId = parseInt(document.getElementById('opsiyonUrunId').value);
        var res = await fetch('/admin/opsiyon-sil/' + id, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ urunId: urunId }) });
        var data = await res.json();
        if (data.success) {
            mesaj('Opsiyon silindi.', 'success');
            await opsiyonListeYenile(urunId);
        } else { mesaj(data.message, 'danger'); }
    }

    // --- OTOMATİK ÇEVİRİ ---
    async function translateTrToEn(trText) {
        try {
            var url = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=tr&tl=en&dt=t&q=' + encodeURIComponent(trText);
            var res = await fetch(url);
            var data = await res.json();
            return data[0][0][0];
        } catch(e) {
            return null;
        }
    }

    document.getElementById('kategoriAd').addEventListener('blur', async function() {
        var trText = this.value.trim(); var enInput = document.getElementById('kategoriAdEN');
        if (trText && !enInput.value.trim()) {
            var ceviri = await translateTrToEn(trText);
            if(ceviri) enInput.value = ceviri;
        }
    });

    document.getElementById('urunAd').addEventListener('blur', async function() {
