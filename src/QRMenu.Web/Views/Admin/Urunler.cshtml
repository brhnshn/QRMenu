@model List<QRMenu.Core.Entities.Urun>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Ürünler";
    ViewData["ActivePage"] = "Urunler";
    ViewData["PageTitle"] = "Ürün & Kategori Yönetimi";
    var kategoriler = ViewBag.Kategoriler as List<QRMenu.Core.Entities.Kategori> ?? new();
}

@section Styles {
    <link href="~/css/admin-urunler.css" rel="stylesheet" />
}

<!-- ===== KATEGORİ YÖNETİMİ ===== -->
<div class="kategori-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0"><i class="bi bi-tags"></i> Kategori Yönetimi</h6>
        <button class="btn-kategori-ekle" onclick="kategoriModal()">
            <i class="bi bi-plus-lg"></i> Kategori Ekle
        </button>
    </div>
    <div class="kategori-list" id="kategoriList">
        @foreach (var kat in kategoriler)
        {
            var urunSayisi = Model.Count(u => u.KategoriId == kat.Id);
            <div class="kategori-chip" id="kat-@kat.Id">
                <span>@kat.Ad</span>
                <span class="chip-count">@urunSayisi</span>
                <div class="chip-actions">
                    <button title="Düzenle" onclick="kategoriModal(@kat.Id, '@kat.Ad.Replace("'","\\'")', '@(kat.AdEN?.Replace("'","\\'") ?? "")', @kat.SiraNo)"><i class="bi bi-pencil"></i></button>
                    <button class="btn-chip-delete" title="Sil" onclick="kategoriSil(@kat.Id, '@kat.Ad.Replace("'","\\'")')"><i class="bi bi-trash"></i></button>
                </div>
            </div>
        }
        @if (!kategoriler.Any())
        {
            <span class="text-muted small">Henüz kategori yok. İlk kategorinizi ekleyin.</span>
        }
    </div>
</div>

<!-- ===== FİLTRE BAR ===== -->
<div class="filter-bar">
    <select class="form-select" id="filterKategori" onchange="filterTable()">
        <option value="">Tüm Kategoriler</option>
        @foreach (var kat in kategoriler)
        {
            <option value="@kat.Id">@kat.Ad</option>
        }
    </select>
    <input type="text" class="form-control" id="filterSearch" placeholder="Ürün ara..." oninput="filterTable()" />
    <button class="btn btn-warning text-dark shadow-sm d-flex align-items-center" onclick="urunTasiModalAc()" style="border-radius: 0.75rem; gap:0.5rem; font-weight:600; padding: 0.5rem 1rem; margin-right: 0.5rem;">
        <i class="bi bi-arrows-move"></i> Ürün Taşı
    </button>
    <button class="btn-yeni-urun" onclick="urunModal()">
        <i class="bi bi-plus-lg"></i> Yeni Ürün Ekle
    </button>
</div>

<!-- ===== ÜRÜN TABLOSU ===== -->
<div class="urun-table-wrap">
    @if (Model.Any())
    {
        <table class="urun-table">
            <thead>
                <tr>
                    <th>Görsel</th>
                    <th>Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Açıklama</th>
                    <th>Fiyat</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody id="urunTbody">
                @foreach (var urun in Model)
                {
                    <tr data-id="@urun.Id" data-kategori="@urun.KategoriId" data-ad="@urun.Ad.ToLower()">
                        <td>
                            @if (!string.IsNullOrEmpty(urun.GorselUrl))
                            {
                                <img src="@urun.GorselUrl" alt="@urun.Ad" class="urun-img" />
                            }
                            else
                            {
                                <div class="urun-img-placeholder"><i class="bi bi-image"></i></div>
                            }
                        </td>
                        <td>
                            <strong>@urun.Ad</strong>
                            @if (urun.PopulerMi) { <span class="badge-populer">⭐ Popüler</span> }
                        </td>
                        <td>@urun.Kategori.Ad</td>
                        <td class="text-muted small">@(urun.Aciklama?.Length > 40 ? urun.Aciklama.Substring(0, 40) + "..." : urun.Aciklama)</td>
                        <td><strong>@urun.Fiyat.ToString("N2") TL</strong></td>
                        <td>
                            <span class="@(urun.AktifMi ? "badge-aktif" : "badge-pasif")" style="cursor:pointer;" onclick="toggleUrun(@urun.Id)" title="Tıkla: Aktif/Pasif">
                                @(urun.AktifMi ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td>
                            <button class="aksiyon-btn" onclick="urunDuzenle(@urun.Id)" title="Düzenle"><i class="bi bi-pencil"></i></button>
                            <button class="aksiyon-btn" onclick="opsiyonModal(@urun.Id, '@urun.Ad.Replace("'","\\'")')" title="Opsiyonlar"><i class="bi bi-list-check"></i></button>
                            <button class="aksiyon-btn btn-danger" onclick="urunSil(@urun.Id, '@urun.Ad.Replace("'","\\'")')" title="Sil"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-cup-hot"></i>
            <h5>Henüz Ürün Yok</h5>
            <p>İlk ürününüzü ekleyerek başlayın.</p>
        </div>
    }
</div>

<!-- ===== KATEGORİ MODAL ===== -->
<div class="modal fade" id="kategoriModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
            <div class="modal-header border-0 bg-light pb-2 pt-4 px-4">
                <h5 class="modal-title fw-bold flex-grow-1" id="kategoriModalTitle">
                    <i class="bi bi-tags-fill me-2 text-primary"></i> Kategori Ekle
                </h5>
                <button type="button" class="btn-close bg-white rounded-circle shadow-sm" data-bs-dismiss="modal" style="width: 2.5rem; height: 2.5rem; background-image: none; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-x-lg text-dark"></i>
                </button>
            </div>
            <div class="modal-body px-4 pt-3 pb-4 bg-light">
                <input type="hidden" id="kategoriEditId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted mb-1">Kategori Adı [TR] *</label>
                        <input type="text" class="form-control bg-white shadow-sm border-0" id="kategoriAd" maxlength="100" style="border-radius: 0.5rem;" placeholder="Ör: Tatlılar" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted mb-1">Kategori Adı [EN]</label>
                        <input type="text" class="form-control bg-white shadow-sm border-0" id="kategoriAdEN" maxlength="100" style="border-radius: 0.5rem;" placeholder="Ör: Desserts" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small fw-bold text-muted mb-1">Sıra No</label>
                        <input type="number" class="form-control bg-white shadow-sm border-0" id="kategoriSiraNo" value="0" min="0" style="border-radius: 0.5rem;" />
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light px-4 pb-4 pt-0">
                <button type="button" class="btn btn-light shadow-sm" data-bs-dismiss="modal" style="border-radius: 0.5rem;">İptal</button>
                <button type="button" class="btn btn-success shadow-sm px-4" onclick="kategoriKaydet()" style="border-radius: 0.5rem;"><i class="bi bi-check-lg me-2"></i> Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== ÜRÜN TAŞIMA MODAL ===== -->
<div class="modal fade" id="urunTasiModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
            <div class="modal-header border-0 bg-light pb-2 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="urunTasiModalTitle">
                    <i class="bi bi-arrows-move me-2 text-warning"></i> Ürün Taşı
                </h5>
                <button type="button" class="btn-close bg-white rounded-circle shadow-sm" data-bs-dismiss="modal" style="width: 2.5rem; height: 2.5rem; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-x-lg text-dark"></i>
                </button>
            </div>
            <div class="modal-body border-0 px-4 py-4">
                <form id="urunTasiForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Kaynak Kategori</label>
                        <select class="form-select form-select-lg shadow-sm" id="kaynakKategoriId" onchange="urunTasiListeYenile()" style="border-radius: 0.75rem;">
                            <option value="">Seçiniz...</option>
                            @foreach (var k in kategoriler)
                            {
                                <option value="@k.Id">@k.Ad</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Taşınacak Ürünler</label>
                        <div id="tasinacakUrunlerList" class="border rounded p-2 bg-white" style="min-height: 120px; max-height: 260px; overflow-y: auto;">
                            <small class="text-muted">Önce kaynak kategori seçin.</small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Hedef Kategori</label>
                        <select class="form-select form-select-lg shadow-sm" id="hedefKategoriId" style="border-radius: 0.75rem;">
                            <option value="">Seçiniz...</option>
                            @foreach (var k in kategoriler)
                            {
                                <option value="@k.Id">@k.Ad</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light px-4 pb-4 pt-0">
                <button type="button" class="btn btn-light shadow-sm" data-bs-dismiss="modal" style="border-radius: 0.5rem;">İptal</button>
                <button type="button" class="btn btn-warning shadow-sm px-4 text-dark" onclick="urunTasiKaydet()" style="border-radius: 0.5rem; font-weight:600;"><i class="bi bi-check-lg me-2"></i> Taşı</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== ÜRÜN EKLE/DÜZENLE MODAL ===== -->
<div class="modal fade" id="urunModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
            <div class="modal-header border-0 bg-light pb-2 pt-4 px-4">
                <h5 class="modal-title fw-bold flex-grow-1" id="urunModalTitle">
                    <i class="bi bi-box-seam-fill me-2 text-primary"></i> Yeni Ürün Ekle
                </h5>
                <button type="button" class="btn-close bg-white rounded-circle shadow-sm" data-bs-dismiss="modal" style="width: 2.5rem; height: 2.5rem; background-image: none; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-x-lg text-dark"></i>
                </button>
            </div>
            <div class="modal-body px-4 pt-3 pb-4 bg-light">
                <form id="urunForm" enctype="multipart/form-data">
                    <input type="hidden" id="urunEditId" value="0" />

                    <div class="text-center mb-4">
                        <img id="gorselPreview" class="gorsel-preview shadow-sm" alt="Önizleme" style="border-radius: 1rem; max-width: 150px; display: none; margin: 0 auto;" />
                        <style>.gorsel-preview.active { display: block !important; margin-bottom: 1rem; }</style>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted mb-1">Ürün Adı [TR] *</label>
                            <input type="text" class="form-control bg-white shadow-sm border-0" id="urunAd" name="Ad" maxlength="200" required style="border-radius: 0.5rem;" placeholder="Ör: Künefe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted mb-1">Ürün Adı [EN]</label>
                            <input type="text" class="form-control bg-white shadow-sm border-0" id="urunAdEN" name="AdEN" maxlength="200" style="border-radius: 0.5rem;" placeholder="Ör: Kunefe" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted mb-1">Açıklama [TR]</label>
                            <textarea class="form-control bg-white shadow-sm border-0" id="urunAciklama" name="Aciklama" rows="3" maxlength="500" style="border-radius: 0.5rem; resize: none;" placeholder="Ürün içeriği..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted mb-1">Açıklama [EN]</label>
                            <textarea class="form-control bg-white shadow-sm border-0" id="urunAciklamaEN" name="AciklamaEN" rows="3" maxlength="500" style="border-radius: 0.5rem; resize: none;" placeholder="Product ingredients..."></textarea>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted mb-1">Fiyat (₺) *</label>
                            <div class="input-group bg-white shadow-sm" style="border-radius: 0.5rem; overflow: hidden;">
                                <span class="input-group-text border-0 bg-transparent text-secondary">₺</span>
                                <input type="number" class="form-control border-0 bg-transparent ps-0" id="urunFiyat" name="Fiyat" step="0.01" min="0.01" required placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted mb-1">Kategori *</label>
                            <select class="form-select bg-white shadow-sm border-0" id="urunKategori" name="KategoriId" required style="border-radius: 0.5rem;">
                                <option value="">Seçiniz</option>
                                @foreach (var kat in kategoriler)
                                {
                                    <option value="@kat.Id">@kat.Ad</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted mb-1">Görsel (max 2MB)</label>
                            <input type="file" class="form-control bg-white shadow-sm border-0" id="urunGorsel" name="Gorsel" accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this)" style="border-radius: 0.5rem;" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted mb-1">Kalori (kcal)</label>
                            <input type="number" class="form-control bg-white shadow-sm border-0" id="urunKalori" name="Kalori" min="0" placeholder="Ör: 250" style="border-radius: 0.5rem;" />
                        </div>

                        <div class="col-md-8 d-flex align-items-center gap-4 mt-4">
                            <div class="form-check form-switch p-0 d-flex align-items-center">
                                <input class="form-check-input ms-0 me-2" type="checkbox" id="urunPopuler" name="PopulerMi" value="true" style="transform: scale(1.3); cursor: pointer;" />
                                <label class="form-check-label fw-bold text-warning" for="urunPopuler" style="cursor: pointer;"><i class="bi bi-star-fill text-warning me-1"></i> Popüler Ürün</label>
                            </div>
                            <div class="form-check form-switch p-0 d-flex align-items-center">
                                <input class="form-check-input ms-0 me-2" type="checkbox" id="urunAktif" name="AktifMi" value="true" checked style="transform: scale(1.3); cursor: pointer;" />
                                <label class="form-check-label fw-bold text-success" for="urunAktif" style="cursor: pointer;">Aktif Satışta</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light px-4 pb-4 pt-0">
                <button type="button" class="btn btn-light shadow-sm" data-bs-dismiss="modal" style="border-radius: 0.5rem;">İptal</button>
                <button type="button" class="btn btn-success shadow-sm px-4" onclick="urunKaydet()" style="border-radius: 0.5rem;"><i class="bi bi-check-lg me-2"></i> Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== OPSİYON YÖNETİM MODAL ===== -->
<div class="modal fade" id="opsiyonModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
            <!-- Modern Header -->
            <div class="modal-header border-0 bg-light pb-2 pt-4 px-4">
                <h5 class="modal-title fw-bold flex-grow-1" id="opsiyonModalTitle">
                    <i class="bi bi-ui-checks-grid me-2 text-primary"></i> Opsiyonlar
                </h5>
                <button type="button" class="btn-close bg-white rounded-circle shadow-sm" data-bs-dismiss="modal" style="width: 2.5rem; height: 2.5rem; background-image: none; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-x-lg text-dark"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body px-4 pt-2 pb-4 bg-light">
                <input type="hidden" id="opsiyonUrunId" value="0" />

                <!-- Mevcut opsiyonlar listesi -->
                <div id="opsiyonList" class="mb-4"></div>

                <!-- Yeni opsiyon ekle paneli -->
                <div class="card border-0 shadow-sm" style="border-radius: 1rem;">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 d-flex align-items-center text-secondary">
                            <i class="bi bi-plus-circle-fill me-2 text-success"></i> Yeni Seçenek Oluştur
                        </h6>
                        
                        <div class="row g-3 config-row">
                            <!-- Dropdown + Manuel Giriş (<datalist>) -->
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted mb-1">Grup (Kategori) [TR]</label>
                                <input type="text" class="form-control form-control-sm bg-light" id="yeniOpsiyonGrup" list="dlGrup" placeholder="Seç veya yazın (ör: Boyut)" maxlength="50" style="border-radius: 0.5rem;" />
                                <datalist id="dlGrup">
                                    <option value="BOYUT"></option>
                                    <option value="SEÇENEK"></option>
                                    <option value="SOSLAR"></option>
                                    <option value="EKSTRALAR"></option>
                                    <option value="TÜRÜ"></option>
                                    <option value="PİŞME DERECESİ"></option>
                                    <option value="İÇECEKLER"></option>
                                </datalist>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted mb-1">Grup (Kategori) [EN]</label>
                                <input type="text" class="form-control form-control-sm bg-light" id="yeniOpsiyonGrupEN" placeholder="Opsiyonel (ör: Size)" maxlength="50" style="border-radius: 0.5rem;" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted mb-1">Seçenek Adı [TR]</label>
                                <input type="text" class="form-control form-control-sm bg-light" id="yeniOpsiyonAd" list="dlAd" placeholder="Seç veya yazın (ör: Büyük)" maxlength="100" style="border-radius: 0.5rem;" />
                                <datalist id="dlAd">
                                    <option value="Küçük"></option>
                                    <option value="Orta"></option>
                                    <option value="Büyük"></option>
                                    <option value="Buzlu"></option>
                                    <option value="Az Buzlu"></option>
                                    <option value="Ketçap"></option>
                                    <option value="Mayonez"></option>
                                    <option value="Az Pişmiş"></option>
                                    <option value="İyi Pişmiş"></option>
                                    <option value="Ranch Sos"></option>
                                </datalist>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted mb-1">Seçenek Adı [EN]</label>
                                <input type="text" class="form-control form-control-sm bg-light" id="yeniOpsiyonAdEN" placeholder="Opsiyonel (ör: Large)" maxlength="100" style="border-radius: 0.5rem;" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted mb-1">Fiyat Farkı (₺)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0" style="border-radius: 0.5rem 0 0 0.5rem;">₺</span>
                                    <input type="number" class="form-control bg-light border-start-0" id="yeniOpsiyonFiyat" placeholder="0.00" step="any" min="0" value="0" style="border-radius: 0 0.5rem 0.5rem 0;" />
                                </div>
                            </div>

                            <!-- Modern Toggle (Zorunlu / Opsiyonel) -->
                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-muted mb-1">Zorunluluk</label>
                                <div class="d-flex bg-light p-1" style="border-radius: 0.5rem; border: 1px solid #dee2e6;">
                                    <input type="radio" class="btn-check" name="btnZorunluRadio" id="zorunluToggleOn" autocomplete="off" checked>
                                    <label class="btn w-50 border-0 transition-all text-dark py-1" for="zorunluToggleOn" style="font-size:0.8rem; font-weight:600; border-radius: 0.4rem;">Zorunlu</label>

                                    <input type="radio" class="btn-check" name="btnZorunluRadio" id="zorunluToggleOff" autocomplete="off">
                                    <label class="btn w-50 border-0 transition-all text-dark py-1" for="zorunluToggleOff" style="font-size:0.8rem; font-weight:600; border-radius: 0.4rem;">Opsiyonel</label>
                                </div>
                            </div>

                            <!-- Ekle Butonu -->
                            <div class="col-md-3 d-flex align-items-end">
                                <button class="btn btn-primary btn-sm w-100 d-flex align-items-center justify-content-center gap-2 shadow-sm" onclick="opsiyonEkle()" style="border-radius: 0.5rem; height: 31px;">
                                    <i class="bi bi-plus-lg"></i> <span class="d-none d-md-inline" style="font-size:0.85rem;">Ekle</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    /* btn-check için özelleştirme */
    .btn-check:checked + .btn[for="zorunluToggleOn"] { background: #fee2e2; color: #dc3545 !important; border:1px solid #f8d7da; }
    .btn-check:checked + .btn[for="zorunluToggleOff"] { background: #e0f8e9; color: #198754 !important; border:1px solid #d1e7dd; }
    
    /* Opsiyon listesi özelleştirme Update */
    #opsiyonList .opsiyon-list-item {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }
</style>

<div id="mesaj"></div>

@section Scripts {
<script>
    // ===== YARDIMCI =====
    function mesaj(text, tip) {
        document.getElementById('mesaj').innerHTML = '<div class="alert alert-' + tip + ' py-2 mb-3 position-fixed bottom-0 end-0 m-3 shadow" style="font-size:0.85rem;z-index:9999;max-width:350px;">' + text + '</div>';
        setTimeout(function() { document.getElementById('mesaj').innerHTML = ''; }, 3000);
    }

    // ===== FİLTRE =====
    function filterTable() {
        var katId = document.getElementById('filterKategori').value;
        var search = document.getElementById('filterSearch').value.toLowerCase();
        document.querySelectorAll('#urunTbody tr').forEach(function(tr) {
            var matchKat = !katId || tr.dataset.kategori === katId;
            var matchSearch = !search || tr.dataset.ad.includes(search);
            tr.style.display = (matchKat && matchSearch) ? '' : 'none';
        });
    }

    // ===== KATEGORİ =====
    function kategoriModal(id, ad, adEN, siraNo) {
        document.getElementById('kategoriEditId').value = id || 0;
        document.getElementById('kategoriAd').value = ad || '';
        document.getElementById('kategoriAdEN').value = adEN || '';
        document.getElementById('kategoriSiraNo').value = siraNo || 0;
        document.getElementById('kategoriModalTitle').textContent = id ? 'Kategori Düzenle' : 'Kategori Ekle';
        new bootstrap.Modal(document.getElementById('kategoriModal')).show();
    }

    async function kategoriKaydet() {
        var id = parseInt(document.getElementById('kategoriEditId').value);
        var ad = document.getElementById('kategoriAd').value.trim();
        if (!ad) { mesaj('Kategori adı boş olamaz.', 'danger'); return; }

        var payload = {
            ad: ad,
            adEN: document.getElementById('kategoriAdEN').value.trim() || null,
            siraNo: parseInt(document.getElementById('kategoriSiraNo').value) || 0
        };

        var url = id > 0 ? '/admin/kategori-guncelle/' + id : '/admin/kategori-ekle';
        var res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('kategoriModal')).hide();
            mesaj(id > 0 ? 'Kategori güncellendi.' : 'Kategori eklendi.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else {
            mesaj(data.message, 'danger');
        }
    }

    async function kategoriSil(id, ad) {
        if (!confirm('"' + ad + '" kategorisi silinsin mi?')) return;
        var res = await fetch('/admin/kategori-sil/' + id, { method: 'POST' });
        var data = await res.json();
        if (data.success) {
            mesaj('Kategori silindi.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else {
            mesaj(data.message, 'warning');
        }
    }

    // ===== ÜRÜN =====
    function urunModal() {
        document.getElementById('urunEditId').value = 0;
        document.getElementById('urunForm').reset();
        document.getElementById('urunAktif').checked = true;
        document.getElementById('gorselPreview').classList.remove('active');
        document.getElementById('urunModalTitle').textContent = 'Yeni Ürün Ekle';
        new bootstrap.Modal(document.getElementById('urunModal')).show();
    }

    async function urunDuzenle(id) {
        var res = await fetch('/admin/urun-detay/' + id);
        var data = await res.json();
        if (!data.success) { mesaj(data.message, 'danger'); return; }
        var u = data.urun;

        document.getElementById('urunEditId').value = u.id;
        document.getElementById('urunAd').value = u.ad;
        document.getElementById('urunAdEN').value = u.adEN || '';
        document.getElementById('urunAciklama').value = u.aciklama || '';
        document.getElementById('urunAciklamaEN').value = u.aciklamaEN || '';
        document.getElementById('urunFiyat').value = u.fiyat;
        document.getElementById('urunKategori').value = u.kategoriId;
        document.getElementById('urunPopuler').checked = u.populerMi;
        document.getElementById('urunAktif').checked = u.aktifMi;
        document.getElementById('urunKalori').value = u.kalori || '';
        document.getElementById('urunGorsel').value = '';

        var preview = document.getElementById('gorselPreview');
        if (u.gorselUrl) {
            preview.src = u.gorselUrl;
            preview.classList.add('active');
        } else {
            preview.classList.remove('active');
        }

        document.getElementById('urunModalTitle').textContent = 'Ürün Düzenle: ' + u.ad;
        new bootstrap.Modal(document.getElementById('urunModal')).show();
    }

    function urunTasiModalAc() {
        document.getElementById('urunTasiForm').reset();
        document.getElementById('tasinacakUrunlerList').innerHTML = '<small class="text-muted">Önce kaynak kategori seçin.</small>';
        new bootstrap.Modal(document.getElementById('urunTasiModal')).show();
    }

    function urunTasiListeYenile() {
        var kaynakKategoriId = document.getElementById('kaynakKategoriId').value;
        var list = document.getElementById('tasinacakUrunlerList');

        if (!kaynakKategoriId) {
            list.innerHTML = '<small class="text-muted">Önce kaynak kategori seçin.</small>';
            return;
        }

        var urunler = Array.from(document.querySelectorAll('#urunTbody tr'))
            .filter(function(tr) { return tr.dataset.kategori === kaynakKategoriId; })
            .map(function(tr) {
                return {
                    id: tr.dataset.id,
                    ad: tr.querySelector('td:nth-child(2) strong')?.textContent?.trim() || ('Ürün #' + tr.dataset.id)
                };
            });

        if (!urunler.length) {
            list.innerHTML = '<small class="text-muted">Bu kategoride taşınacak ürün bulunamadı.</small>';
            return;
        }

        var html = urunler.map(function(u) {
            return '<div class="form-check mb-2">' +
                '<input class="form-check-input tasinacak-urun-check" type="checkbox" value="' + u.id + '" id="tasiUrun_' + u.id + '">' +
                '<label class="form-check-label" for="tasiUrun_' + u.id + '">' + u.ad + '</label>' +
                '</div>';
        }).join('');

        list.innerHTML = html;
    }

    async function urunTasiKaydet() {
        var kaynakKategoriId = document.getElementById('kaynakKategoriId').value;
        var kategoriId = document.getElementById('hedefKategoriId').value;
        var secilenUrunIds = Array.from(document.querySelectorAll('.tasinacak-urun-check:checked'))
            .map(function(cb) { return parseInt(cb.value); });

        if (!kaynakKategoriId) {
            mesaj('Lütfen kaynak kategori seçin.', 'warning');
            return;
        }

        if (!kategoriId) {
            mesaj('Lütfen hedef kategori seçin.', 'warning');
            return;
        }

        if (parseInt(kaynakKategoriId) === parseInt(kategoriId)) {
            mesaj('Kaynak ve hedef kategori aynı olamaz.', 'warning');
            return;
        }

        if (!secilenUrunIds.length) {
            mesaj('Lütfen en az bir ürün seçin.', 'warning');
            return;
        }

        var res = await fetch('/admin/urun-tasi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ UrunIds: secilenUrunIds, YeniKategoriId: parseInt(kategoriId) })
        });
        
        var data = await res.json();
        if (data.success) {
            var adet = data.tasinanAdet || secilenUrunIds.length;
            mesaj(adet + ' ürün başarıyla taşındı.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else {
            mesaj(data.message || 'Bir hata oluştu.', 'danger');
        }
    }

    async function urunKaydet() {
        var id = parseInt(document.getElementById('urunEditId').value);
        var form = new FormData();
        form.append('Ad', document.getElementById('urunAd').value);
        form.append('AdEN', document.getElementById('urunAdEN').value);
        form.append('Aciklama', document.getElementById('urunAciklama').value);
        form.append('AciklamaEN', document.getElementById('urunAciklamaEN').value);
        form.append('Fiyat', document.getElementById('urunFiyat').value);
        form.append('KategoriId', document.getElementById('urunKategori').value);
        form.append('PopulerMi', document.getElementById('urunPopuler').checked);
        form.append('AktifMi', document.getElementById('urunAktif').checked);
        var kaloriVal = document.getElementById('urunKalori').value;
        if (kaloriVal) form.append('Kalori', kaloriVal);

        var gorselInput = document.getElementById('urunGorsel');
        if (gorselInput.files.length > 0) {
            form.append('Gorsel', gorselInput.files[0]);
        }

        var url = id > 0 ? '/admin/urun-guncelle/' + id : '/admin/urun-ekle';
        var res = await fetch(url, { method: 'POST', body: form });
        var data = await res.json();

        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('urunModal')).hide();
            mesaj(id > 0 ? 'Ürün güncellendi.' : 'Ürün eklendi.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else {
            mesaj(data.message, 'danger');
        }
    }

    async function urunSil(id, ad) {
        if (!confirm('"' + ad + '" ürünü silinsin mi?')) return;
        var res = await fetch('/admin/urun-sil/' + id, { method: 'POST' });
        var data = await res.json();
        if (data.success) {
            mesaj(data.message || 'Ürün silindi.', 'success');
            setTimeout(function() { location.reload(); }, 500);
        } else {
            mesaj(data.message, 'danger');
        }
    }

    async function toggleUrun(id) {
        var res = await fetch('/admin/urun-toggle/' + id, { method: 'POST' });
        var data = await res.json();
        if (data.success) {
            mesaj('Durum güncellendi.', 'success');
            setTimeout(function() { location.reload(); }, 300);
        }
    }

    function previewImage(input) {
        var preview = document.getElementById('gorselPreview');
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.classList.add('active');
            };
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.classList.remove('active');
        }
    }

    // ===== OPSİYON =====
    async function opsiyonModal(urunId, urunAd) {
        document.getElementById('opsiyonUrunId').value = urunId;
        
        // Update Title with icon
        document.getElementById('opsiyonModalTitle').innerHTML = '<i class="bi bi-ui-checks-grid me-2 text-primary"></i> Opsiyonlar — ' + urunAd;
        
        document.getElementById('yeniOpsiyonGrup').value = '';
        document.getElementById('yeniOpsiyonGrupEN').value = '';
        document.getElementById('yeniOpsiyonAd').value = '';
        document.getElementById('yeniOpsiyonAdEN').value = '';
        document.getElementById('yeniOpsiyonFiyat').value = 0;
        document.getElementById('zorunluToggleOn').checked = true;

        await opsiyonListeYenile(urunId);
        new bootstrap.Modal(document.getElementById('opsiyonModal')).show();
    }

    async function opsiyonListeYenile(urunId) {
        var res = await fetch('/admin/urun-detay/' + urunId);
        var data = await res.json();
        var listDiv = document.getElementById('opsiyonList');

        if (!data.success || !data.urun.opsiyonlar || data.urun.opsiyonlar.length === 0) {
            listDiv.innerHTML = '<p class="text-muted small">Bu ürüne henüz opsiyon eklenmemiş.</p>';
            return;
        }

        var html = '';
        data.urun.opsiyonlar.forEach(function(o) {
            html += '<div class="opsiyon-list-item d-flex align-items-center justify-content-between">' +
                '<div class="opsiyon-info flex-grow-1">' +
                    '<div class="mb-1"><span class="badge bg-secondary me-2">' + o.grup + (o.grupEN ? ' / ' + o.grupEN : '') + '</span>' +
                    '<strong class="fs-6">' + o.ad + (o.adEN ? ' / <span class="text-muted">' + o.adEN + '</span>' : '') + '</strong>' +
                    (o.ekFiyat > 0 ? '<span class="text-success ms-2 fw-bold">+' + o.ekFiyat.toFixed(2) + ' ₺</span>' : '') + '</div>' +
                    (o.zorunlu ? '<span class="badge bg-danger rounded-pill px-2">Zorunlu</span>' : '<span class="badge bg-success rounded-pill px-2">Opsiyonel</span>') +
                '</div>' +
                '<button class="btn btn-outline-danger btn-sm rounded-circle ms-3" title="Opsiyonu Sil" onclick="opsiyonSil(' + o.id + ')" style="width:30px; height:30px; display:flex; align-items:center; justify-content:center;"><i class="bi bi-x-lg"></i></button>' +
            '</div>';
        });
        listDiv.innerHTML = html;
    }

    async function opsiyonEkle() {
        var urunId = parseInt(document.getElementById('opsiyonUrunId').value);
        var grup = document.getElementById('yeniOpsiyonGrup').value.trim();
        var grupEN = document.getElementById('yeniOpsiyonGrupEN').value.trim();
        var ad = document.getElementById('yeniOpsiyonAd').value.trim();
        var adEN = document.getElementById('yeniOpsiyonAdEN').value.trim();
        var ekFiyat = parseFloat(document.getElementById('yeniOpsiyonFiyat').value) || 0;
        var zorunlu = document.getElementById('zorunluToggleOn').checked;

        if (!grup || !ad) { mesaj('Türkçe Grup ve Ad alanları zorunlu.', 'danger'); return; }

        var res = await fetch('/admin/opsiyon-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                urunId: urunId, 
                ad: ad, 
                adEN: adEN || null, 
                grup: grup, 
                grupEN: grupEN || null, 
                ekFiyat: ekFiyat, 
                zorunlu: zorunlu 
            })
        });
        var data = await res.json();
        if (data.success) {
            mesaj('Opsiyon eklendi.', 'success');
            document.getElementById('yeniOpsiyonAd').value = '';
            document.getElementById('yeniOpsiyonAdEN').value = '';
            document.getElementById('yeniOpsiyonFiyat').value = 0;
            // Grubun aynı kalması ard arda eklerken kolaylık sağlar, o yüzden silmiyoruz.
            await opsiyonListeYenile(urunId);
        } else {
            mesaj(data.message, 'warning');
        }
    }

    async function opsiyonSil(opsiyonId) {
        var urunId = parseInt(document.getElementById('opsiyonUrunId').value);
        var res = await fetch('/admin/opsiyon-sil/' + opsiyonId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ urunId: urunId })
        });
        var data = await res.json();
        if (data.success) {
            mesaj('Opsiyon kaldırıldı.', 'success');
            await opsiyonListeYenile(urunId);
        } else {
            mesaj(data.message, 'danger');
        }
    }

    // ===== OTOMATİK ÇEVİRİ YARDIMCISI =====
    async function otomatikCeviri(text) {
        if (!text) return '';
        try {
            // Ücretsiz Google Translate API
            var url = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=tr&tl=en&dt=t&q=' + encodeURIComponent(text);
            var response = await fetch(url);
            var data = await response.json();
            return data[0][0][0];
        } catch (e) {
            console.error("Çeviri hatası:", e);
            return text;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Grup (Kategori) [TR] alanından çıkıldığında çevir
        document.getElementById('yeniOpsiyonGrup').addEventListener('blur', async function() {
            var trText = this.value.trim();
            var enInput = document.getElementById('yeniOpsiyonGrupEN');
            if (trText && !enInput.value.trim()) {
                enInput.value = 'Çevriliyor...';
                var translated = await otomatikCeviri(trText);
                enInput.value = translated;
            }
        });

        // Seçenek Adı [TR] alanından çıkıldığında çevir
        document.getElementById('yeniOpsiyonAd').addEventListener('blur', async function() {
            var trText = this.value.trim();
            var enInput = document.getElementById('yeniOpsiyonAdEN');
            if (trText && !enInput.value.trim()) {
                enInput.value = 'Çevriliyor...';
                var translated = await otomatikCeviri(trText);
                enInput.value = translated;
            }
        });

        // Ürün Adı [TR] alanından çıkıldığında çevir
        document.getElementById('urunAd').addEventListener('blur', async function() {
            var trText = this.value.trim();
            var enInput = document.getElementById('urunAdEN');
            if (trText && !enInput.value.trim()) {
                enInput.value = 'Çevriliyor...';
                var translated = await otomatikCeviri(trText);
                enInput.value = translated;
            }
        });

        // Ürün Açıklama [TR] alanından çıkıldığında çevir
        document.getElementById('urunAciklama').addEventListener('blur', async function() {
            var trText = this.value.trim();
            var enInput = document.getElementById('urunAciklamaEN');
            if (trText && !enInput.value.trim()) {
                enInput.value = 'Çevriliyor...';
                var translated = await otomatikCeviri(trText);
                enInput.value = translated;
            }
        });

        // Kategori Adı [TR] alanından çıkıldığında çevir (Bonus)
        document.getElementById('kategoriAd').addEventListener('blur', async function() {
            var trText = this.value.trim();
            var enInput = document.getElementById('kategoriAdEN');
            if (trText && !enInput.value.trim()) {
                enInput.value = 'Çevriliyor...';
                var translated = await otomatikCeviri(trText);
                enInput.value = translated;
            }
        });
    });
</script>
