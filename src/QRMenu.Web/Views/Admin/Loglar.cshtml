@model IEnumerable<QRMenu.Core.Entities.SecurityLog>
@{
    Layout = "_AdminLayout";
}

<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center gap-3 mb-2">
        <div class="p-2 bg-indigo-50 text-indigo-600 rounded-xl">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Güvenlik Logları</h1>
            <p class="text-sm text-gray-500">Sistemde oluşan yetkisiz erişim, hata ve spam denemelerini izleyin.</p>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-8">
    <form method="get" class="flex flex-wrap items-end gap-4">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Olay Tipi</label>
            <select name="eventType" class="w-48 px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                <option value="">Tümü</option>
                <option value="Unauthorized" selected="@(ViewBag.CurrentFilter == "Unauthorized")">Yetkisiz Erişim (401)</option>
                <option value="Forbidden" selected="@(ViewBag.CurrentFilter == "Forbidden")">Rol Yetersiz (403)</option>
                <option value="RateLimit" selected="@(ViewBag.CurrentFilter == "RateLimit")">Spam / Rate Limit (429)</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Sıralama</label>
            <select name="sortOrder" class="w-48 px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                <option value="desc" selected="@(ViewBag.CurrentSort == "desc")">Yeniden Eskiye</option>
                <option value="asc" selected="@(ViewBag.CurrentSort == "asc")">Eskiden Yeniye</option>
            </select>
        </div>
        <div class="flex-1 flex justify-end">
            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition-colors flex items-center gap-2 font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                </svg>
                Filtrele
            </button>
            <a href="/admin/loglar" class="ml-2 px-6 py-2 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition-colors font-medium">Sıfırla</a>
        </div>
    </form>
</div>

<!-- Logs Table -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50/50 border-b border-gray-100">
                    <th class="py-4 px-6 text-sm font-semibold text-gray-600">Tarih</th>
                    <th class="py-4 px-6 text-sm font-semibold text-gray-600">Olay Tipi</th>
                    <th class="py-4 px-6 text-sm font-semibold text-gray-600">Mesaj</th>
                    <th class="py-4 px-6 text-sm font-semibold text-gray-600">IP Adresi</th>
                    <th class="py-4 px-6 text-sm font-semibold text-gray-600">Yol (Path)</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="py-8 text-center text-gray-500">
                            Hiç güvenlik kaydı bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model)
                    {
                        var eventColor = log.EventType switch
                        {
                            "Unauthorized" => "bg-orange-50 text-orange-700 border-orange-200",
                            "Forbidden" => "bg-red-50 text-red-700 border-red-200",
                            "RateLimit" => "bg-yellow-50 text-yellow-700 border-yellow-200",
                            _ => "bg-gray-50 text-gray-700 border-gray-200"
                        };

                        <tr class="hover:bg-gray-50/50 transition-colors group">
                            <td class="py-4 px-6 text-sm text-gray-600 font-medium">
                                @TimeZoneInfo.ConvertTimeFromUtc(log.Timestamp, TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "Turkey Standard Time" : "Europe/Istanbul")).ToString("dd.MM.yyyy HH:mm:ss")
                            </td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border @eventColor">
                                    @log.EventType
                                </span>
                            </td>
                            <td class="py-4 px-6 text-sm text-gray-800">
                                @log.Message
                            </td>
                            <td class="py-4 px-6 text-sm text-gray-600 font-mono">
                                @(log.IpAddress ?? "-")
                            </td>
                            <td class="py-4 px-6 text-sm text-gray-600 truncate max-w-xs" title="@log.Path">
                                <span class="font-mono text-xs bg-gray-100 px-2 py-1 rounded">@log.Method</span> @log.Path
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
