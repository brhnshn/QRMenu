@{
    Layout = "_AdminLayout";
    ViewData["ActivePage"] = "Loglar";
    ViewData["PageTitle"] = "Log Kayıtları";
}

<div class="space-y-5">
    <style>
        .log-top { background: #ffffff; border: 1px solid rgba(214, 211, 209, .8); box-shadow: 0 1px 2px rgba(0,0,0,.04); }
        .log-input { background: #f5f5f4; border: 1px solid transparent; color: #292524; }
        .log-input::placeholder { color: #78716c; }
        .log-input:focus { outline: none; border-color: #cc5533; box-shadow: 0 0 0 2px rgba(204,85,51,.15); background: #fff; }
        .log-card { background: #ffffff; border: 1px solid rgba(214, 211, 209, .8); box-shadow: 0 1px 2px rgba(0,0,0,.04); }
        .row-hover:hover { background: #fafaf9; }
        #detailOverlay { background: rgba(28, 25, 23, .28); backdrop-filter: blur(2px); }
        #detailDrawer { transform: translateX(100%); transition: transform .25s ease; }
        #detailDrawer.open { transform: translateX(0); }
    </style>

    <section class="log-top rounded-2xl p-4">
        <div class="flex items-center justify-end mb-3">
            <div class="text-xs text-stone-500 font-bold" id="lastRefresh">Yükleniyor...</div>
        </div>
        <div class="mb-3 text-xs font-semibold text-stone-500">
            Log kayıtları güvenlik politikası gereği en fazla 1 ay saklanır, daha eski kayıtlar otomatik silinir.
        </div>
        <div class="grid grid-cols-1 md:grid-cols-6 gap-3">
            <input id="search" class="log-input md:col-span-2 px-4 py-2 rounded-xl" placeholder="Mesaj, olay, kullanıcı veya not ara..." />
            <select id="source" class="log-input px-4 py-2 rounded-xl">
                <option value="">Kaynak: Tümü</option>
                <option value="Security">Güvenlik</option>
                <option value="Audit">Sistem Kaydı</option>
            </select>
            <select id="area" class="log-input px-4 py-2 rounded-xl">
                <option value="">Alan: Tümü</option>
                <option value="Güvenlik">Güvenlik</option>
                <option value="Mutfak">Mutfak</option>
                <option value="Garson">Garson</option>
                <option value="Kasa">Kasa</option>
            </select>
            <select id="severity" class="log-input px-4 py-2 rounded-xl">
                <option value="">Seviye: Tümü</option>
                <option value="Critical">Kritik</option>
                <option value="Warning">Uyarı</option>
                <option value="Info">Bilgi</option>
            </select>
            <select id="range" class="log-input px-4 py-2 rounded-xl">
                <option value="">Tüm Zaman</option>
                <option value="24h">Son 24 Saat</option>
                <option value="1h">Son 1 Saat</option>
                <option value="15m">Son 15 Dakika</option>
                <option value="7d">Son 7 Gün</option>
            </select>
        </div>
    </section>

    <section class="log-card rounded-2xl overflow-hidden">
        <div class="px-4 py-3 border-b border-stone-200 text-xs font-black uppercase tracking-wider text-stone-500" id="summary">0 kayıt</div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-stone-800">
                <thead class="bg-stone-50 text-stone-500 uppercase text-[11px]">
                    <tr>
                        <th class="text-left px-4 py-3">Zaman</th>
                        <th class="text-left px-4 py-3">Kaynak</th>
                        <th class="text-left px-4 py-3">Alan</th>
                        <th class="text-left px-4 py-3">Olay</th>
                        <th class="text-left px-4 py-3">Mesaj</th>
                        <th class="text-left px-4 py-3">Kullanıcı</th>
                        <th class="text-left px-4 py-3">Not</th>
                    </tr>
                </thead>
                <tbody id="logBody"></tbody>
            </table>
        </div>
    </section>

    <div id="detailOverlay" class="hidden fixed inset-0 z-40" onclick="closeDetails()"></div>
    <aside id="detailDrawer" class="fixed top-0 right-0 h-full w-full max-w-xl z-50 bg-white border-l border-stone-200 text-stone-800 p-5 overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-black">Kayıt Detayı</h3>
            <button class="px-3 py-1 rounded-lg border border-stone-200 hover:border-primary" onclick="closeDetails()">Kapat</button>
        </div>
        <div id="detailContent" class="space-y-3 text-sm"></div>
    </aside>
</div>

<script>
    const filters = {
        search: document.getElementById('search'),
        source: document.getElementById('source'),
        area: document.getElementById('area'),
        severity: document.getElementById('severity'),
        range: document.getElementById('range')
    };

    const logBody = document.getElementById('logBody');
    const summary = document.getElementById('summary');
    const lastRefresh = document.getElementById('lastRefresh');
    const detailOverlay = document.getElementById('detailOverlay');
    const detailDrawer = document.getElementById('detailDrawer');
    const detailContent = document.getElementById('detailContent');

    let timer;
    let currentLogs = [];

    for (const key in filters) {
        filters[key].addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(loadLogs, 250);
        });
        filters[key].addEventListener('change', loadLogs);
    }

    function kaynakCevir(value) {
        return value === 'Security' ? 'Güvenlik' : 'Sistem Kaydı';
    }

    function seviyeCevir(value) {
        if (value === 'Critical') return 'Kritik';
        if (value === 'Warning') return 'Uyarı';
        return 'Bilgi';
    }

    function olayCevir(value) {
        if (value === 'Unauthorized') return 'Yetkisiz Erişim';
        if (value === 'Forbidden') return 'Erişim Engellendi';
        if (value === 'RateLimit') return 'Aşırı İstek';
        return value || '-';
    }

    function escapeHtml(value) {
        return String(value ?? '-').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
    }

    function openDetails(index) {
        const x = currentLogs[index];
        if (!x) return;

        const when = new Date(x.timestamp).toLocaleString('tr-TR');
        detailContent.innerHTML = `
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Zaman</div><div class="font-semibold">${escapeHtml(when)}</div></div>
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Kaynak</div><div class="font-semibold">${escapeHtml(kaynakCevir(x.sourceType))}</div></div>
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Alan</div><div class="font-semibold">${escapeHtml(x.area)}</div></div>
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Olay</div><div class="font-semibold text-primary">${escapeHtml(olayCevir(x.eventType))}</div></div>
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Seviye</div><div class="font-semibold">${escapeHtml(seviyeCevir(x.severity))}</div></div>
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Mesaj</div><div class="font-semibold">${escapeHtml(x.message)}</div></div>
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Yol</div><div class="font-mono text-xs">${escapeHtml(x.method)} ${escapeHtml(x.path)}</div></div>
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Kullanıcı</div><div class="font-semibold">${escapeHtml(x.user)}</div></div>
            <div class="p-3 rounded-xl bg-stone-50 border border-stone-200"><div class="text-stone-500 text-xs">Not</div><div class="font-semibold">${escapeHtml(x.meta)}</div></div>
        `;

        detailOverlay.classList.remove('hidden');
        detailDrawer.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeDetails() {
        detailOverlay.classList.add('hidden');
        detailDrawer.classList.remove('open');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDetails();
    });

    async function loadLogs() {
        const p = new URLSearchParams({ take: '700' });
        if (filters.search.value) p.set('search', filters.search.value);
        if (filters.source.value) p.set('source', filters.source.value);
        if (filters.area.value) p.set('area', filters.area.value);
        if (filters.severity.value) p.set('severity', filters.severity.value);
        if (filters.range.value) p.set('range', filters.range.value);

        const resp = await fetch('/admin/loglar/data?' + p.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await resp.json();

        summary.textContent = `${data.total} kayıt listeleniyor`;
        lastRefresh.textContent = `Son güncelleme: ${new Date().toLocaleString('tr-TR')}`;
        currentLogs = data.logs || [];

        if (currentLogs.length === 0) {
            logBody.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center text-stone-500">Kayıt bulunamadı.</td></tr>';
            return;
        }

        logBody.innerHTML = currentLogs.map((x, index) => {
            const when = new Date(x.timestamp).toLocaleString('tr-TR');
            const sevClass = x.severity === 'Critical' ? 'text-primary' : x.severity === 'Warning' ? 'text-amber-700' : 'text-stone-500';
            const kaynak = kaynakCevir(x.sourceType);
            const olay = olayCevir(x.eventType);
            const seviye = seviyeCevir(x.severity);

            return `
                <tr class="row-hover border-t border-stone-200 cursor-pointer" onclick="openDetails(${index})">
                    <td class="px-4 py-3 whitespace-nowrap font-semibold">${escapeHtml(when)}</td>
                    <td class="px-4 py-3">${escapeHtml(kaynak)}</td>
                    <td class="px-4 py-3">${escapeHtml(x.area)}</td>
                    <td class="px-4 py-3"><span class="font-bold ${sevClass}">${escapeHtml(olay)}</span><div class="text-[11px] text-stone-500">${escapeHtml(seviye)}</div></td>
                    <td class="px-4 py-3">${escapeHtml(x.message)} <div class="text-[11px] text-stone-500 font-mono">${escapeHtml(x.method)} ${escapeHtml(x.path)}</div></td>
                    <td class="px-4 py-3">${escapeHtml(x.user)}</td>
                    <td class="px-4 py-3 text-[12px] text-stone-500">${escapeHtml(x.meta)}</td>
                </tr>`;
        }).join('');
    }

    loadLogs();
</script>

