@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div class="header-left">
        <h1>👥 Kullanıcı Yönetimi</h1>
        <p class="subtitle">Personel hesaplarını ve rollerini yönetin</p>
    </div>
    <button class="btn-primary" onclick="modalAc('ekle')">
        <span>+</span> Yeni Kullanıcı
    </button>
</div>

<!-- Kullanıcı Tablosu -->
<div class="table-card">
    <div class="table-header">
        <div class="search-box">
            <span>🔍</span>
            <input type="text" id="searchInput" placeholder="Kullanıcı ara..." oninput="filtrele(this.value)">
        </div>
        <div class="filter-pills" id="rolFilter">
            <button class="pill active" data-rol="all">Tümü</button>
            <button class="pill" data-rol="Admin">Admin</button>
            <button class="pill" data-rol="Garson">Garson</button>
            <button class="pill" data-rol="Kasa">Kasa</button>
            <button class="pill" data-rol="Mutfak">Mutfak</button>
            <button class="pill" data-rol="Barista">Barista</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="admin-table" id="kullaniciTable">
            <thead>
                <tr>
                    <th>Kullanıcı Adı</th>
                    <th>Ad Soyad</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody id="kullaniciBody">
                <tr><td colspan="5" class="loading-row">⏳ Yükleniyor...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- KULLANICI EKLE MODALi -->
<div class="modal-overlay" id="ekleModal" onclick="modalKapat('ekle')">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2>➕ Yeni Kullanıcı</h2>
            <button class="modal-close" onclick="modalKapat('ekle')">✕</button>
        </div>
        <div class="modal-body">
            <form id="ekleForm" onsubmit="kullaniciEkle(event)">
                <div class="form-group">
                    <label>Kullanıcı Adı *</label>
                    <input type="text" id="yeni_kullaniciAdi" class="form-control" required placeholder="örn: garson2">
                </div>
                <div class="form-group">
                    <label>Ad Soyad *</label>
                    <input type="text" id="yeni_adSoyad" class="form-control" required placeholder="örn: Ahmet Yılmaz">
                </div>
                <div class="form-group">
                    <label>Şifre * (min 6 karakter)</label>
                    <div class="input-group">
                        <input type="password" id="yeni_sifre" class="form-control" required minlength="6">
                        <button type="button" class="btn-eye" onclick="toggleSifre('yeni_sifre')">👁</button>
                    </div>
                </div>
                <div class="form-group">
                    <label>Rol *</label>
                    <select id="yeni_rol" class="form-control">
                        <option value="Garson">🍽️ Garson</option>
                        <option value="Kasa">💰 Kasa</option>
                        <option value="Mutfak">👨‍🍳 Mutfak</option>
                        <option value="Barista">☕ Barista</option>
                        <option value="Admin">🛡️ Admin</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="modalKapat('ekle')">İptal</button>
                    <button type="submit" class="btn-primary">✅ Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- KULLANICI DÜZENLE MODALi -->
<div class="modal-overlay" id="duzenleModal" onclick="modalKapat('duzenle')">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2>✏️ Kullanıcı Düzenle</h2>
            <button class="modal-close" onclick="modalKapat('duzenle')">✕</button>
        </div>
        <div class="modal-body">
            <form id="duzenleForm" onsubmit="kullaniciGuncelle(event)">
                <input type="hidden" id="duz_id">
                <div class="form-group">
                    <label>Kullanıcı Adı</label>
                    <input type="text" id="duz_kullaniciAdi" class="form-control" disabled>
                </div>
                <div class="form-group">
                    <label>Ad Soyad *</label>
                    <input type="text" id="duz_adSoyad" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Rol *</label>
                    <select id="duz_rol" class="form-control">
                        <option value="Garson">🍽️ Garson</option>
                        <option value="Kasa">💰 Kasa</option>
                        <option value="Mutfak">👨‍🍳 Mutfak</option>
                        <option value="Barista">☕ Barista</option>
                        <option value="Admin">🛡️ Admin</option>
                    </select>
                </div>
                <div class="toggle-row">
                    <label>Hesap Aktif</label>
                    <label class="toggle-switch">
                        <input type="checkbox" id="duz_aktifMi">
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-warning" onclick="sifreModalAc(document.getElementById('duz_id').value)">🔑 Şifre</button>
                    <button type="button" class="btn-secondary" onclick="modalKapat('duzenle')">İptal</button>
                    <button type="submit" class="btn-primary">💾 Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ŞİFRE DEĞİŞTİR MODALi -->
<div class="modal-overlay" id="sifreModal" onclick="modalKapat('sifre')">
    <div class="modal-content modal-sm" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2>🔑 Şifre Değiştir</h2>
            <button class="modal-close" onclick="modalKapat('sifre')">✕</button>
        </div>
        <div class="modal-body">
            <form id="sifreForm" onsubmit="sifreDegistir(event)">
                <input type="hidden" id="sifre_id">
                <div class="form-group">
                    <label>Yeni Şifre (min 6 karakter)</label>
                    <div class="input-group">
                        <input type="password" id="yeni_sifre2" class="form-control" required minlength="6" placeholder="Yeni şifre girin">
                        <button type="button" class="btn-eye" onclick="toggleSifre('yeni_sifre2')">👁</button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="modalKapat('sifre')">İptal</button>
                    <button type="submit" class="btn-danger">🔑 Şifreyi Değiştir</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .admin-page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .header-left h1 { font-size: 1.8rem; font-weight: 700; margin: 0; }
    .header-left .subtitle { color: var(--text-muted); margin: 0.3rem 0 0 0; }

    .table-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .table-header { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
    .search-box { display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary, #f5f5f5); border-radius: 8px; padding: 0.5rem 1rem; flex: 1; min-width: 200px; }
    .search-box input { border: none; background: transparent; outline: none; width: 100%; }
    .filter-pills { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .pill { padding: 0.35rem 0.9rem; border-radius: 20px; border: 1px solid var(--border); background: transparent; cursor: pointer; font-size: 0.85rem; transition: all 0.2s; }
    .pill.active { background: #007bff; color: white; border-color: #007bff; }
    .pill:hover { background: rgba(0,123,255,0.1); }

    .admin-table { width: 100%; border-collapse: collapse; }
    .admin-table th { padding: 0.9rem 1.5rem; text-align: left; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); border-bottom: 1px solid var(--border); background: var(--bg-secondary, #f9f9f9); }
    .admin-table td { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); }
    .admin-table tr:hover td { background: rgba(0,123,255,0.04); }
    .loading-row { text-align: center; padding: 2rem; color: var(--text-muted); }

    .rol-badge { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600; }
    .rol-Admin { background: rgba(255,0,80,0.15); color: #cc0044; }
    .rol-Garson { background: rgba(0,123,255,0.15); color: #0056b3; }
    .rol-Kasa { background: rgba(40,167,69,0.15); color: #155724; }
    .rol-Mutfak { background: rgba(255,193,7,0.15); color: #856404; }
    .rol-Barista { background: rgba(111,66,193,0.15); color: #4b0082; }

    .status-badge { padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600; }
    .status-aktif { background: rgba(40,167,69,0.15); color: #155724; }
    .status-pasif { background: rgba(220,53,69,0.15); color: #721c24; }

    .action-btns { display: flex; gap: 0.5rem; }
    .btn-action { padding: 0.3rem 0.7rem; border-radius: 6px; border: 1px solid transparent; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
    .btn-edit { background: rgba(0,123,255,0.1); color: #007bff; border-color: rgba(0,123,255,0.3); }
    .btn-edit:hover { background: #007bff; color: white; }
    .btn-delete { background: rgba(220,53,69,0.1); color: #dc3545; border-color: rgba(220,53,69,0.3); }
    .btn-delete:hover { background: #dc3545; color: white; }

    /* Modal */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; }
    .modal-overlay.show { display: flex; }
    .modal-content { background: var(--card-bg, white); border-radius: 14px; width: 90%; max-width: 500px; box-shadow: 0 25px 50px rgba(0,0,0,0.2); animation: slideIn 0.2s ease; }
    .modal-content.modal-sm { max-width: 380px; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border); }
    .modal-header h2 { margin: 0; font-size: 1.1rem; font-weight: 700; }
    .modal-close { background: none; border: none; font-size: 1.2rem; cursor: pointer; padding: 0.2rem 0.5rem; border-radius: 6px; }
    .modal-body { padding: 1.5rem; }
    .modal-footer { display: flex; gap: 0.8rem; justify-content: flex-end; padding-top: 1rem; border-top: 1px solid var(--border); margin-top: 1rem; }

    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem; }
    .form-control { width: 100%; padding: 0.6rem 1rem; border: 1px solid var(--border); border-radius: 8px; background: var(--input-bg, #fff); box-sizing: border-box; }
    .input-group { display: flex; }
    .input-group .form-control { border-radius: 8px 0 0 8px; }
    .btn-eye { padding: 0.6rem 0.8rem; border: 1px solid var(--border); border-left: none; border-radius: 0 8px 8px 0; background: var(--bg-secondary, #f5f5f5); cursor: pointer; }
    .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 0; }
    .toggle-switch { position: relative; display: inline-block; width: 50px; height: 26px; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; inset: 0; background: #ccc; border-radius: 26px; transition: 0.4s; }
    .slider:before { content: ""; position: absolute; width: 18px; height: 18px; left: 4px; bottom: 4px; background: white; border-radius: 50%; transition: 0.4s; }
    input:checked + .slider { background: #28a745; }
    input:checked + .slider:before { transform: translateX(24px); }

    .btn-primary { padding: 0.6rem 1.2rem; background: #007bff; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; transition: all 0.2s; }
    .btn-primary:hover { background: #0056b3; }
    .btn-secondary { padding: 0.6rem 1.2rem; background: transparent; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; font-weight: 600; }
    .btn-warning { padding: 0.6rem 1.2rem; background: #ffc107; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; }
    .btn-danger { padding: 0.6rem 1.2rem; background: #dc3545; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; }
</style>

<script>
    let tumKullanicilar = [];
    let aktifRolFilter = 'all';

    const rolIkon = { Admin: '🛡️', Garson: '🍽️', Kasa: '💰', Mutfak: '👨‍🍳', Barista: '☕' };

    async function veriYukle() {
        const r = await fetch('/admin/kullanici-listesi');
        const d = await r.json();
        if (!d.success) return;
        tumKullanicilar = d.data;
        tabloGuncelle();
    }

    function tabloGuncelle() {
        const arama = document.getElementById('searchInput').value.toLowerCase();
        const filteredData = tumKullanicilar.filter(k => {
            const rolOk = aktifRolFilter === 'all' || k.rol === aktifRolFilter;
            const aramaOk = !arama || k.kullaniciAdi.toLowerCase().includes(arama) || k.adSoyad.toLowerCase().includes(arama);
            return rolOk && aramaOk;
        });

        const tbody = document.getElementById('kullaniciBody');
        if (filteredData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="loading-row">📭 Kullanıcı bulunamadı.</td></tr>';
            return;
        }

        tbody.innerHTML = filteredData.map(function(k) {
            return '<tr data-id="' + k.id + '" data-rol="' + k.rol + '">' +
                '<td><strong>' + k.kullaniciAdi + '</strong></td>' +
                '<td>' + k.adSoyad + '</td>' +
                '<td><span class="rol-badge rol-' + k.rol + '">' + (rolIkon[k.rol] || '') + ' ' + k.rol + '</span></td>' +
                '<td><span class="status-badge ' + (k.aktifMi ? 'status-aktif' : 'status-pasif') + '">' + (k.aktifMi ? '✅ Aktif' : '❌ Pasif') + '</span></td>' +
                '<td><div class="action-btns">' +
                '<button class="btn-action btn-edit" onclick=\'duzenleAc(' + JSON.stringify(k) + ')\' title="Düzenle">✏️</button>' +
                '<button class="btn-action btn-warning bg-opacity-25" style="border:1px solid #ffcc00; background:rgba(255, 193, 7, 0.1); color:#856404; transition:all 0.2s;" onmouseover="this.style.background=\'#ffc107\';this.style.color=\'#fff\'" onmouseout="this.style.background=\'rgba(255, 193, 7, 0.1)\';this.style.color=\'#856404\'" onclick="kullaniciToggle(' + k.id + ')" title="Aktif/Pasif Yap">' + (k.aktifMi ? '⏸️' : '▶️') + '</button>' +
                '<button class="btn-action btn-delete" onclick="kullaniciSil(' + k.id + ', \'' + k.kullaniciAdi + '\')" title="Kalıcı Olarak Sil">🗑️</button>' +
                '</div></td>' +
                '</tr>';
        }).join('');
    }

    function filtrele(val) { tabloGuncelle(); }

    document.querySelectorAll('.pill').forEach(p => {
        p.addEventListener('click', () => {
            document.querySelectorAll('.pill').forEach(x => x.classList.remove('active'));
            p.classList.add('active');
            aktifRolFilter = p.dataset.rol;
            tabloGuncelle();
        });
    });

    // Modaller
    function modalAc(id) { document.getElementById(id + 'Modal').classList.add('show'); }
    function modalKapat(id) { document.getElementById(id + 'Modal').classList.remove('show'); }
    function sifreModalAc(id) { document.getElementById('sifre_id').value = id; modalKapat('duzenle'); modalAc('sifre'); }

    function toggleSifre(id) {
        const el = document.getElementById(id);
        el.type = el.type === 'password' ? 'text' : 'password';
    }

    function duzenleAc(k) {
        document.getElementById('duz_id').value = k.id;
        document.getElementById('duz_kullaniciAdi').value = k.kullaniciAdi;
        document.getElementById('duz_adSoyad').value = k.adSoyad;
        document.getElementById('duz_rol').value = k.rol;
        document.getElementById('duz_aktifMi').checked = k.aktifMi;
        modalAc('duzenle');
    }

    async function kullaniciEkle(e) {
        e.preventDefault();
        const r = await fetch('/admin/kullanici-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                kullaniciAdi: document.getElementById('yeni_kullaniciAdi').value,
                adSoyad: document.getElementById('yeni_adSoyad').value,
                sifre: document.getElementById('yeni_sifre').value,
                rol: document.getElementById('yeni_rol').value
            })
        });
        const d = await r.json();
        if (d.success) { modalKapat('ekle'); veriYukle(); e.target.reset(); }
        else alert('Hata: ' + d.message);
    }

    async function kullaniciGuncelle(e) {
        e.preventDefault();
        const id = document.getElementById('duz_id').value;
        const r = await fetch(`/admin/kullanici-guncelle/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                adSoyad: document.getElementById('duz_adSoyad').value,
                rol: document.getElementById('duz_rol').value,
                aktifMi: document.getElementById('duz_aktifMi').checked
            })
        });
        const d = await r.json();
        if (d.success) { modalKapat('duzenle'); veriYukle(); }
        else alert('Hata: ' + d.message);
    }

    async function sifreDegistir(e) {
        e.preventDefault();
        const id = document.getElementById('sifre_id').value;
        const r = await fetch(`/admin/kullanici-sifre/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ yeniSifre: document.getElementById('yeni_sifre2').value })
        });
        const d = await r.json();
        if (d.success) { modalKapat('sifre'); alert('✅ Şifre başarıyla değiştirildi.'); e.target.reset(); }
        else alert('Hata: ' + d.message);
    }

    async function kullaniciSil(id, kullaniciAdi) {
        if (!confirm(`DİKKAT: "${kullaniciAdi}" kullanıcısı kalıcı olarak silinecek. Emin misiniz?`)) return;
        const r = await fetch(`/admin/kullanici-sil/${id}`, { method: 'POST' });
        const d = await r.json();
        if (d.success) veriYukle();
        else alert('Hata: ' + d.message);
    }

    async function kullaniciToggle(id) {
        const r = await fetch(`/admin/kullanici-toggle/${id}`, { method: 'POST' });
        const d = await r.json();
        if (d.success) veriYukle();
        else alert('Hata: ' + d.message);
    }

    veriYukle();
</script>
