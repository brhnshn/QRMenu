@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["ActivePage"] = "Kullanicilar";
    ViewData["PageTitle"] = "Kullanıcı Yönetimi";
}

@section Styles {
    @* Sadece bu sayfaya özel, layout ile çakışmayan stiller *@
    <style>
        .admin-content { background: #f8f6f5; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .pill-btn.active {
            background-color: #ffca57 !important;
            color: #5d4300 !important;
            box-shadow: 0 4px 12px rgba(255, 202, 87, 0.3);
        }
        .page-container { padding-top: 1.5rem; padding-bottom: 5rem; }
        
        /* Mavi focus halkalarını projenin ana rengine çekiyoruz */
        input:focus, select:focus, textarea:focus {
            --tw-ring-color: #a2371833 !important;
            border-color: #a23718 !important;
        }

        @@media (max-width: 768px) {
            .table-responsive-none { display: none; }
        }
    </style>
}

<div class="font-body text-on-surface page-container px-4 md:px-8 max-w-7xl mx-auto">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div>
            <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tight text-on-surface mb-2">Kullanıcı Yönetimi</h2>
            <p class="text-outline text-base md:text-lg">Personel hesaplarını ve rollerini yönetin</p>
        </div>
        <button onclick="modalAc('ekle')" class="bg-primary text-on-primary flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl font-headline font-bold hover:opacity-90 transition-all active:scale-95 shadow-lg shadow-primary/20 border-0 w-full md:w-auto">
            <span class="material-symbols-outlined">add</span>
            Yeni Kullanıcı
        </button>
    </div>

    <!-- Filters & Search Bento Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">
        <div class="lg:col-span-4 bg-white p-1 rounded-2xl flex items-center px-4 shadow-sm border border-stone-200">
            <span class="material-symbols-outlined text-outline">search</span>
            <input id="searchInput" oninput="filtrele(this.value)" class="w-full bg-transparent border-none focus:ring-0 py-3.5 px-3 text-on-surface placeholder:text-outline text-sm md:text-base" placeholder="Kullanıcı ara..." type="text" />
        </div>

        <div class="lg:col-span-8 flex overflow-x-auto md:flex-wrap items-center gap-3 pb-2 md:pb-0 scrollbar-hide -mx-4 px-4 md:mx-0 md:px-0" id="rolFilter">
            <button data-rol="all" class="pill-btn active px-6 py-2.5 rounded-full bg-secondary-container text-on-secondary-container font-headline font-semibold text-sm transition-colors whitespace-nowrap border-0">Tümü</button>
            <button data-rol="Admin" class="pill-btn px-6 py-2.5 rounded-full bg-stone-100 text-outline font-headline font-medium text-sm hover:bg-stone-200 transition-colors whitespace-nowrap border-0">Admin</button>
            <button data-rol="Garson" class="pill-btn px-6 py-2.5 rounded-full bg-stone-100 text-outline font-headline font-medium text-sm hover:bg-stone-200 transition-colors whitespace-nowrap border-0">Garson</button>
            <button data-rol="Kasa" class="pill-btn px-6 py-2.5 rounded-full bg-stone-100 text-outline font-headline font-medium text-sm hover:bg-stone-200 transition-colors whitespace-nowrap border-0">Kasa</button>
            <button data-rol="Mutfak" class="pill-btn px-6 py-2.5 rounded-full bg-stone-100 text-outline font-headline font-medium text-sm hover:bg-stone-200 transition-colors whitespace-nowrap border-0">Mutfak</button>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-white rounded-[2rem] overflow-hidden shadow-sm border border-stone-200">
        <div class="w-full">
            <table class="w-full text-left border-collapse table-responsive-none">
                <thead>
                    <tr class="bg-stone-50">
                        <th class="px-8 py-5 text-xs font-bold text-outline tracking-widest uppercase font-headline">Kullanıcı Adı</th>
                        <th class="px-8 py-5 text-xs font-bold text-outline tracking-widest uppercase font-headline">Ad Soyad</th>
                        <th class="px-8 py-5 text-xs font-bold text-outline tracking-widest uppercase font-headline">Rol</th>
                        <th class="px-8 py-5 text-xs font-bold text-outline tracking-widest uppercase font-headline">Durum</th>
                        <th class="px-8 py-5 text-xs font-bold text-outline tracking-widest uppercase font-headline text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="kullaniciBody" class="divide-y divide-stone-100">
                    <!-- JS ile dolacak -->
                </tbody>
            </table>

            <!-- Mobile User Cards -->
            <div id="kullaniciMobileCards" class="md:hidden divide-y divide-stone-100">
                <!-- JS ile dolacak -->
            </div>
        </div>
        <!-- Pagination UI -->
        <div class="px-8 py-6 flex items-center justify-between border-t border-stone-100 bg-stone-50/50" id="pagination">
            <span class="text-sm text-outline font-medium" id="totalCountText">Toplam - kullanıcı gösteriliyor</span>
            <div class="flex items-center gap-2" id="paginationButtons">
                <button class="p-2 rounded-lg border border-stone-200 text-outline hover:bg-stone-100 transition-colors">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <button class="w-10 h-10 rounded-lg bg-primary text-on-primary font-bold">1</button>
                <button id="btnPage2" class="hidden w-10 h-10 rounded-lg text-outline hover:bg-stone-100 transition-colors font-medium">2</button>
                <button class="p-2 rounded-lg border border-stone-200 text-outline hover:bg-stone-100 transition-colors">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Role Distribution Mini Bento Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mt-12" id="statsContainer">
        <!-- Stats will be loaded here -->
    </div>
</div>

<!-- Mobile Bottom Nav -->
<nav class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-stone-200 flex items-center justify-around h-16 z-40">
    <a href="/admin/kullanicilar" class="flex flex-col items-center gap-1 text-primary">
        <span class="material-symbols-outlined">group</span>
        <span class="text-[10px] font-bold uppercase tracking-tighter">Personel</span>
    </a>
    <a href="/admin/urunler" class="flex flex-col items-center gap-1 text-outline">
        <span class="material-symbols-outlined">restaurant</span>
        <span class="text-[10px] font-bold uppercase tracking-tighter">Menü</span>
    </a>
    <a href="/admin/siparisler" class="flex flex-col items-center gap-1 text-outline">
        <span class="material-symbols-outlined">analytics</span>
        <span class="text-[10px] font-bold uppercase tracking-tighter">Siparişler</span>
    </a>
    <a href="/admin/masalar" class="flex flex-col items-center gap-1 text-outline">
        <span class="material-symbols-outlined">grid_view</span>
        <span class="text-[10px] font-bold uppercase tracking-tighter">Masalar</span>
    </a>
</nav>

<!-- MODALS -->
<div id="ekleModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-zinc-900/40 backdrop-blur-sm p-4">
    <div class="bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden border border-stone-200">
        <div class="px-8 pt-8 pb-4 flex justify-between items-center">
            <h3 class="font-headline text-2xl font-bold">Yeni Kullanıcı Ekle</h3>
            <button onclick="modalKapat('ekle')" class="material-symbols-outlined text-outline hover:text-on-surface">close</button>
        </div>
        <form class="p-8 space-y-4" onsubmit="kullaniciEkle(event)">
            <div class="space-y-1">
                <label class="text-sm font-bold text-outline uppercase tracking-wider">Kullanıcı Adı</label>
                <input id="yeni_kullaniciAdi" required autocomplete="username" class="w-full bg-stone-50 border-stone-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary/20" type="text" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-bold text-outline uppercase tracking-wider">Ad Soyad</label>
                <input id="yeni_adSoyad" required autocomplete="name" class="w-full bg-stone-50 border-stone-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary/20" type="text" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-bold text-outline uppercase tracking-wider">Şifre</label>
                <input id="yeni_sifre" required minlength="6" autocomplete="new-password" class="w-full bg-stone-50 border-stone-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary/20" type="password" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-bold text-outline uppercase tracking-wider">Rol</label>
                <select id="yeni_rol" class="w-full bg-stone-50 border-stone-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary/20">
                    <option value="Garson">Garson</option>
                    <option value="Kasa">Kasa</option>
                    <option value="Mutfak">Mutfak</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="pt-4 flex gap-3">
                <button type="button" onclick="modalKapat('ekle')" class="flex-1 px-6 py-3 rounded-xl border border-stone-200 font-headline font-bold hover:bg-stone-50 transition-colors">Vazgeç</button>
                <button type="submit" class="flex-1 bg-primary text-on-primary px-6 py-3 rounded-xl font-headline font-bold hover:opacity-90">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<div id="duzenleModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-zinc-900/40 backdrop-blur-sm p-4">
    <div class="bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden border border-stone-200">
        <div class="px-8 pt-8 pb-4 flex justify-between items-center">
            <h3 class="font-headline text-2xl font-bold">Kullanıcı Düzenle</h3>
            <button onclick="modalKapat('duzenle')" class="material-symbols-outlined text-outline hover:text-on-surface">close</button>
        </div>
        <form class="p-8 space-y-4" onsubmit="kullaniciGuncelle(event)">
            <input type="hidden" id="duz_id" />
            <div class="space-y-1">
                <label class="text-sm font-bold text-outline uppercase tracking-wider">Kullanıcı Adı</label>
                <input id="duz_kullaniciAdi" required autocomplete="username" class="w-full bg-stone-50 border-stone-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary/20" type="text" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-bold text-outline uppercase tracking-wider">Ad Soyad</label>
                <input id="duz_adSoyad" required autocomplete="name" class="w-full bg-stone-50 border-stone-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary/20" type="text" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-bold text-outline uppercase tracking-wider">Rol</label>
                <select id="duz_rol" class="w-full bg-stone-50 border-stone-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary/20">
                    <option value="Garson">Garson</option>
                    <option value="Kasa">Kasa</option>
                    <option value="Mutfak">Mutfak</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="flex items-center justify-between py-2">
                <div class="flex flex-col">
                    <span class="font-headline font-bold text-on-surface">Hesap Aktif</span>
                    <span class="text-xs text-outline">Personel geçiş yetkisi</span>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="duz_aktifMi" class="sr-only peer">
                    <div class="w-11 h-6 bg-stone-200 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                </label>
            </div>
            <div class="pt-4 flex flex-col gap-3">
                <button type="button" onclick="sifreModalAc(document.getElementById('duz_id').value, document.getElementById('duz_kullaniciAdi').value)" class="w-full flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-orange-50 text-orange-700 font-headline font-bold border border-orange-100">Şifre Sıfırla</button>
                <div class="flex gap-3">
                    <button type="button" onclick="modalKapat('duzenle')" class="flex-1 px-6 py-3 rounded-xl border border-stone-200 font-headline font-bold">İptal</button>
                    <button type="submit" class="flex-1 bg-primary text-on-primary px-6 py-3 rounded-xl font-headline font-bold">Güncelle</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="sifreModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-zinc-900/40 backdrop-blur-sm p-4">
    <div class="bg-white w-full max-w-xs rounded-3xl shadow-2xl overflow-hidden border border-stone-200">
        <div class="px-8 pt-8 pb-4 flex justify-between items-center">
            <h3 class="font-headline text-xl font-bold">Şifre Belirle</h3>
            <button onclick="modalKapat('sifre')" class="material-symbols-outlined text-outline hover:text-on-surface">close</button>
        </div>
        <form class="p-8 space-y-4" onsubmit="sifreDegistir(event)">
            <input type="hidden" id="sifre_id" />
            <!-- Tarayıcı uyarısını önlemek için gizli kullanıcı adı alanı -->
            <input type="text" id="sifre_kullaniciAdi" autocomplete="username" style="display:none" />
            <input id="yeni_sifre2" required minlength="6" autocomplete="new-password" class="w-full bg-stone-50 border-stone-200 rounded-xl px-4 py-3" type="password" />
            <button type="submit" class="w-full bg-primary text-on-primary py-3 rounded-xl font-headline font-bold">Şifreyi Değiştir</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    let tumKullanicilar = [];
    let aktifRolFilter = 'all';

    function showToast(msg, isSuccess = false) {
        window.SavorAlert.fire({
            toast: true,
            position: 'top-end',
            icon: isSuccess ? 'success' : 'error',
            title: msg,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });
    }

    const rolRenkler = {
        Admin: 'bg-primary/10 text-primary',
        Garson: 'bg-amber-100 text-amber-700',
        Kasa: 'bg-stone-100 text-stone-600',
        Mutfak: 'bg-stone-100 text-stone-600'
    };

    async function veriYukle() {
        try {
            const r = await fetch('/admin/kullanici-listesi');
            const d = await r.json();
            if (!d.success) return;
            tumKullanicilar = d.data;
            tabloGuncelle();
            statlariYukle();
        } catch(e) { console.error("Veri yüklenemedi", e); }
    }

    function tabloGuncelle() {
        const val = document.getElementById('searchInput').value.toLowerCase();
        const filteredData = tumKullanicilar.filter(k => {
            const matchesSearch = k.kullaniciAdi.toLowerCase().includes(val) || (k.adSoyad && k.adSoyad.toLowerCase().includes(val));
            const matchesRol = aktifRolFilter === 'all' || k.rol === aktifRolFilter;
            return matchesSearch && matchesRol;
        });

        const tbody = document.getElementById('kullaniciBody');
        const mobileContainer = document.getElementById('kullaniciMobileCards');
        if (document.getElementById('totalCountText')) {
            document.getElementById('totalCountText').innerText = `Toplam ${filteredData.length} kullanıcı`;
        }

        const btn2 = document.getElementById('btnPage2');
        if(filteredData.length > 10) { btn2.classList.remove('hidden'); } else { btn2.classList.add('hidden'); }

        if (filteredData.length === 0) {
            const emptyHtml = '<tr><td colspan="5" class="px-8 py-12 text-center text-outline font-medium">📭 Kullanıcı bulunamadı.</td></tr>';
            tbody.innerHTML = emptyHtml;
            if (mobileContainer) mobileContainer.innerHTML = '<div class="p-12 text-center text-outline font-medium">📭 Kullanıcı bulunamadı.</div>';
            return;
        }

        // Table Rendering
        tbody.innerHTML = filteredData.map(function(k) {
            const init = k.adSoyad ? k.adSoyad.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() : '??';
            const rolStili = rolRenkler[k.rol] || 'bg-stone-100 text-stone-600';
            return `
                <tr class="group hover:bg-stone-50 transition-colors">
                    <td class="px-8 py-6 font-medium text-on-surface">@@${k.kullaniciAdi}</td>
                    <td class="px-8 py-6">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">${init}</div>
                            <span class="font-headline font-semibold text-on-surface">${k.adSoyad || ''}</span>
                        </div>
                    </td>
                    <td class="px-8 py-6"><span class="px-3 py-1.5 rounded-lg ${rolStili} text-xs font-bold uppercase tracking-wider">${k.rol}</span></td>
                    <td class="px-8 py-6">
                        <div class="flex items-center gap-2 ${k.aktifMi ? '' : 'opacity-50'}">
                            <span class="w-2 h-2 rounded-full ${k.aktifMi ? 'bg-emerald-500' : 'bg-stone-300'}"></span>
                            <span class="text-sm font-medium ${k.aktifMi ? 'text-emerald-700' : 'text-stone-400'}">${k.aktifMi ? 'Aktif' : 'Pasif'}</span>
                        </div>
                    </td>
                    <td class="px-8 py-6 text-right">
                        <div class="flex items-center justify-end gap-3 transition-all">
                            ${k.rol === 'Admin' 
                                ? `<button onclick="sifreModalAc('${k.id}', '${k.kullaniciAdi}')" title="Şifre Değiştir" class="material-symbols-outlined text-outline hover:text-primary p-2 text-xl">lock_reset</button>
                                   <button title="Admin kapatılamaz" disabled class="material-symbols-outlined text-stone-200 cursor-not-allowed p-2 text-xl">${k.aktifMi ? 'pause_circle' : 'play_circle'}</button>
                                   <button title="Admin kullanıcısı silinemez" disabled class="material-symbols-outlined text-stone-200 cursor-not-allowed p-2 text-xl">delete</button>`
                                : `<button onclick='duzenleAc(${JSON.stringify(k)})' class="material-symbols-outlined text-outline hover:text-primary p-2 text-xl">edit</button>
                                   <button onclick="kullaniciToggle('${k.id}')" class="material-symbols-outlined text-outline hover:text-secondary p-2 text-xl">${k.aktifMi ? 'pause_circle' : 'play_circle'}</button>
                                   <button onclick="kullaniciSil('${k.id}', '${k.kullaniciAdi}')" class="material-symbols-outlined text-outline hover:text-error p-2 text-xl">delete</button>`
                            }
                        </div>
                    </td>
                </tr>`;
        }).join('');

        // Mobile Card Rendering
        if (mobileContainer) {
            mobileContainer.innerHTML = filteredData.map(function(k) {
                const init = k.adSoyad ? k.adSoyad.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() : '??';
                const rolStili = rolRenkler[k.rol] || 'bg-stone-100 text-stone-600';
                return `
                    <div class="p-5 flex flex-col gap-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">${init}</div>
                            <div class="flex-1">
                                <div class="flex justify-between items-start">
                                    <span class="font-headline font-bold text-on-surface">${k.adSoyad || ''}</span>
                                    <span class="px-2 py-1 rounded-lg ${rolStili} text-[10px] font-bold uppercase tracking-wider">${k.rol}</span>
                                </div>
                                <span class="text-xs text-outline font-medium">@@${k.kullaniciAdi}</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between border-t border-stone-50 pt-4">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full ${k.aktifMi ? 'bg-emerald-500' : 'bg-stone-300'}"></span>
                                <span class="text-xs font-semibold ${k.aktifMi ? 'text-emerald-700' : 'text-stone-400'}">${k.aktifMi ? 'Aktif' : 'Pasif'}</span>
                            </div>
                            <div class="flex gap-1">
                                ${k.rol === 'Admin' 
                                    ? `<button onclick="sifreModalAc('${k.id}', '${k.kullaniciAdi}')" class="p-2 text-outline hover:text-primary border-0 bg-transparent"><span class="material-symbols-outlined text-xl">lock_reset</span></button>` 
                                    : `
                                    <button onclick='duzenleAc(${JSON.stringify(k)})' class="p-2 text-outline hover:text-primary border-0 bg-transparent"><span class="material-symbols-outlined text-xl">edit</span></button>
                                    <button onclick="kullaniciToggle('${k.id}')" class="p-2 text-outline hover:text-secondary border-0 bg-transparent"><span class="material-symbols-outlined text-xl">${k.aktifMi ? 'pause_circle' : 'play_circle'}</span></button>
                                    <button onclick="kullaniciSil('${k.id}', '${k.kullaniciAdi}')" class="p-2 text-outline hover:text-error border-0 bg-transparent"><span class="material-symbols-outlined text-xl">delete</span></button>
                                `}
                            </div>
                        </div>
                    </div>`;
            }).join('');
        }
    }

    function statlariYukle() {
        const stats = { Garson: 0, Mutfak: 0, Admin: 0, Kasa: 0 };
        tumKullanicilar.forEach(k => { if(stats[k.rol] !== undefined) stats[k.rol]++; });
        
        const container = document.getElementById('statsContainer');
        if(!container) return;

        container.innerHTML = Object.keys(stats).map(rol => {
            const count = stats[rol];
            const percent = tumKullanicilar.length > 0 ? (count / tumKullanicilar.length) * 100 : 0;

            return `
                <div class="bg-white p-6 rounded-2xl flex flex-col gap-1 shadow-sm border border-stone-200 hover:scale-[1.02] transition-transform">
                    <span class="text-outline text-xs font-bold uppercase tracking-wider">${rol}</span>
                    <span class="text-3xl font-headline font-extrabold text-on-surface">${count}</span>
                    <div class="w-full h-1 bg-stone-100 mt-3 rounded-full overflow-hidden">
                        <div class="h-full bg-primary rounded-full" style="width: ${percent}%"></div>
                    </div>
                </div>`;
        }).join('');
    }

    function filtrele(val) { tabloGuncelle(); }

    document.querySelectorAll('.pill-btn').forEach(p => {
        p.addEventListener('click', () => {
            document.querySelectorAll('.pill-btn').forEach(x => {
                x.classList.remove('active', 'bg-secondary-container', 'text-on-secondary-container', 'font-semibold');
                x.classList.add('bg-stone-100', 'text-outline', 'font-medium');
            });
            p.classList.remove('bg-stone-100', 'text-outline', 'font-medium');
            p.classList.add('active', 'bg-secondary-container', 'text-on-secondary-container', 'font-semibold');
            aktifRolFilter = p.dataset.rol;
            tabloGuncelle();
        });
    });

    function modalAc(id) { 
        const el = document.getElementById(id + 'Modal');
        if(el) { el.classList.remove('hidden'); el.classList.add('flex'); }
    }
    function modalKapat(id) { 
        const el = document.getElementById(id + 'Modal');
        if(el) { el.classList.add('hidden'); el.classList.remove('flex'); }
    }

    function sifreModalAc(id, username) { 
        document.getElementById('sifre_id').value = id; 
        if(document.getElementById('sifre_kullaniciAdi')) document.getElementById('sifre_kullaniciAdi').value = username;
        modalKapat('duzenle'); 
        modalAc('sifre'); 
    }

    function duzenleAc(k) {
        document.getElementById('duz_id').value = k.id;
        document.getElementById('duz_kullaniciAdi').value = k.kullaniciAdi;
        document.getElementById('duz_adSoyad').value = k.adSoyad || '';
        document.getElementById('duz_rol').value = k.rol;
        document.getElementById('duz_aktifMi').checked = k.aktifMi;
        modalAc('duzenle');
    }

    async function kullaniciEkle(e) {
        e.preventDefault();
        const r = await fetch('/admin/kullanici-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                kullaniciAdi: document.getElementById('yeni_kullaniciAdi').value,
                adSoyad: document.getElementById('yeni_adSoyad').value,
                sifre: document.getElementById('yeni_sifre').value,
                rol: document.getElementById('yeni_rol').value
            })
        });
        const d = await r.json();
        if (d.success) { 
            modalKapat('ekle'); 
            await veriYukle(); 
            e.target.reset(); 
            showToast('Kullanıcı başarıyla eklendi.', true);
        }
        else showToast(d.message);
    }

    async function kullaniciGuncelle(e) {
        e.preventDefault();
        const id = document.getElementById('duz_id').value;
        const r = await fetch(`/admin/kullanici-guncelle/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                kullaniciAdi: document.getElementById('duz_kullaniciAdi').value,
                adSoyad: document.getElementById('duz_adSoyad').value,
                rol: document.getElementById('duz_rol').value,
                aktifMi: document.getElementById('duz_aktifMi').checked
            })
        });
        const d = await r.json();
        if (d.success) { 
            modalKapat('duzenle'); 
            await veriYukle(); 
            showToast('Kullanıcı güncellendi.', true);
        }
        else showToast(d.message);
    }

    async function sifreDegistir(e) {
        e.preventDefault();
        const id = document.getElementById('sifre_id').value;
        const r = await fetch(`/admin/kullanici-sifre/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ yeniSifre: document.getElementById('yeni_sifre2').value })
        });
        const d = await r.json();
        if (d.success) { 
            modalKapat('sifre'); 
            showToast('Şifre başarıyla değiştirildi.', true); 
            e.target.reset(); 
        }
        else showToast(d.message);
    }

    async function kullaniciSil(id, kullaniciAdi) {
        window.SavorAlert.fire({
            title: 'Emin misiniz?',
            text: `"${kullaniciAdi}" kullanıcısı kalıcı olarak silinecek!`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, Sil',
            cancelButtonText: 'Vazgeç'
        }).then(async (result) => {
            if (result.isConfirmed) {
                const r = await fetch(`/admin/kullanici-sil/${id}`, { method: 'POST' });
                const d = await r.json();
                if (d.success) { await veriYukle(); showToast('Kullanıcı silindi.', true); }
                else showToast(d.message);
            }
        });
    }

    async function kullaniciToggle(id) {
        const r = await fetch(`/admin/kullanici-toggle/${id}`, { method: 'POST' });
        const d = await r.json();
        if (d.success) {
            await veriYukle();
            showToast(d.aktifMi ? 'Hesap aktifleştirildi.' : 'Hesap pasife alındı.', true);
        }
        else showToast(d.message);
    }

    veriYukle();
</script>
}
