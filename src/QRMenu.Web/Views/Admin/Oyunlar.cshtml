@model List<QRMenu.Core.Entities.OyunAyar>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Oyun & Ödül Yönetimi";
    ViewData["PageTitle"] = "Oyun Seçimi & İndirim Havuzu";
}

<div class="row">
    @foreach(var oyun in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 1rem;">
                <div class="card-header bg-white d-flex justify-content-between align-items-center" style="border-radius: 1rem 1rem 0 0;">
                    <h5 class="mb-0 fw-bold">@oyun.Ad</h5>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="toggle-@oyun.Id" 
                            @(oyun.AktifMi ? "checked" : "") onchange="toggleOyun(@oyun.Id)">
                    </div>
                </div>
                <div class="card-body bg-light">
                    <p class="text-muted small mb-2">Ödül Havuzu</p>
                    @if (oyun.Tip == "CARKIFELEK")
                    {
                        <div class="alert alert-info py-2 px-3 small mb-3">
                            Çark diliminde görünecek yazı doğrudan <strong>Tanım</strong> alanından alınır.
                        </div>
                    }
                    <ul class="list-group list-group-flush mb-3" id="odulList-@oyun.Id">
                        @foreach(var odul in oyun.Oduller)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-bottom">
                                <div>
                                    <strong>@odul.OdulTanim</strong><br>
                                    <small class="text-muted">
                                        İhtimal: %@odul.IhtimalYuzdesi
                                        @if (odul.IndirimYuzdesi > 0)
                                        {
                                            @($" / %{odul.IndirimYuzdesi} İnd.")
                                        }
                                        else if (odul.IndirimTutari > 0)
                                        {
                                            @($" / {odul.IndirimTutari} TL İnd.")
                                        }
                                        else
                                        {
                                            @(oyun.Tip == "CARKIFELEK" ? " / Boş Dilim" : " / Boş Sonuç")
                                        }
                                    </small>
                                </div>
                                <button class="btn btn-sm btn-danger rounded-circle" onclick="odulSil(@odul.Id)"><i class="bi bi-trash"></i></button>
                            </li>
                        }
                        @if(!oyun.Oduller.Any())
                        {
                            <li class="list-group-item bg-transparent text-muted small border-0">Henüz ödül yok.</li>
                        }
                    </ul>
                    <hr>
                    <h6 class="fs-6 fw-bold">Yeni Ödül Ekle</h6>
                    <form id="formOdul-@oyun.Id" onsubmit="event.preventDefault(); odulEkle(@oyun.Id)">
                        <input type="text" id="odulTanim-@oyun.Id" class="form-control form-control-sm mb-2" placeholder="@(oyun.Tip == "CARKIFELEK" ? "Çarkta görünecek yazı (Örn: %10 İndirim)" : "Tanım (Örn: %10 İndirim)")" required>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <input type="number" id="odulYuzde-@oyun.Id" class="form-control form-control-sm" placeholder="% İndirim (Ops)" min="0">
                            </div>
                            <div class="col-6">
                                <input type="number" id="odulİhtimal-@oyun.Id" class="form-control form-control-sm" placeholder="İhtimal %" min="1" max="100" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-plus"></i> Ekle</button>
                    </form>

                    @if (oyun.Tip == "CARKIFELEK")
                    {
                        <div class="mt-3 p-3 rounded border bg-white">
                            <div class="fw-semibold mb-2">Boş Dilim Ekle</div>
                            <div class="small text-muted mb-2">Bu dilim gelirse indirim uygulanmaz, kullanıcıya "boş" sonucu gösterilir.</div>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">İhtimal %</span>
                                <input type="number" id="bosIhtimal-@oyun.Id" class="form-control" min="1" max="100" value="10" />
                                <button class="btn btn-outline-secondary" type="button" onclick="bosSecenekEkle(@oyun.Id, 'CARKIFELEK')">Boş Dilim Ekle</button>
                            </div>
                        </div>
                    }

                    @if (oyun.Tip == "HAFIZA" || oyun.Tip == "KAZIKAZAN")
                    {
                        <div class="mt-3 p-3 rounded border bg-white">
                            <div class="fw-semibold mb-2">Boş Sonuç Ekle</div>
                            <div class="small text-muted mb-2">Bu sonuç gelirse indirim uygulanmaz, oyun "boş" sonucu gösterir.</div>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">İhtimal %</span>
                                <input type="number" id="bosIhtimal-@oyun.Id" class="form-control" min="1" max="100" value="10" />
                                <button class="btn btn-outline-secondary" type="button" onclick="bosSecenekEkle(@oyun.Id, '@oyun.Tip')">Boş Sonuç Ekle</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function toggleOyun(id) {
            var res = await fetch('/admin/oyun-toggle/' + id, { method: 'POST' });
            var data = await res.json();
            if(!data.success) alert('Bir hata oluştu.');
        }

        async function odulEkle(id) {
            var tanim = document.getElementById('odulTanim-' + id).value;
            var yuzde = document.getElementById('odulYuzde-' + id).value || 0;
            var ihtimal = document.getElementById('odulİhtimal-' + id).value;

            var formData = new FormData();
            formData.append('tanim', tanim);
            formData.append('indirimYuzdesi', yuzde);
            formData.append('indirimTutari', 0); // Şimdilik 0
            formData.append('ihtimal', ihtimal);

            var res = await fetch('/admin/odul-baslat/' + id, {
                method: 'POST',
                body: formData
            });
            var data = await res.json();
            if(data.success) location.reload();
        }

        async function bosSecenekEkle(id, oyunTipi) {
            var ihtimalEl = document.getElementById('bosIhtimal-' + id);
            if (!ihtimalEl) return;

            var ihtimal = parseFloat(ihtimalEl.value || '0');
            if (!(ihtimal > 0)) {
                alert('Boş seçenek için geçerli bir ihtimal girin.');
                return;
            }

            var formData = new FormData();
            formData.append('tanim', oyunTipi === 'CARKIFELEK' ? 'Boş Dilim' : 'Boş Sonuç');
            formData.append('indirimYuzdesi', 0);
            formData.append('indirimTutari', 0);
            formData.append('ihtimal', ihtimal);

            var res = await fetch('/admin/odul-baslat/' + id, {
                method: 'POST',
                body: formData
            });
            var data = await res.json();
            if (data.success) location.reload();
            else alert('Boş seçenek eklenemedi.');
        }

        async function odulSil(id) {
            if(!confirm('Silmek istediğinize emin misiniz?')) return;
            var res = await fetch('/admin/odul-sil/' + id, { method: 'POST' });
            var data = await res.json();
            if(data.success) location.reload();
        }
    </script>
}