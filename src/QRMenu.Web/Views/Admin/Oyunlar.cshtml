@model List<QRMenu.Core.Entities.OyunAyar>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Oyun & Ödül Yönetimi";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap" rel="stylesheet"/>
    <style>
        :root {
            --primary: #a23718;
            --primary-dim: #922c0c;
            --secondary: #765600;
            --tertiary: #5c5b5b;
            --on-primary: #ffefec;
            --surface: #f8f6f5;
            --on-surface: #2e2f2f;
            --surface-container-low: #f2f0f0;
            --surface-container-lowest: #ffffff;
            --outline-variant: #aeadac;
        }
        body { font-family: 'Be Vietnam Pro', sans-serif; background-color: var(--surface); }
        .font-headline { font-family: 'Plus Jakarta Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        
        .oyun-card { background: white; border-radius: 1.25rem; padding: 1.25rem; border: 1px solid rgba(174, 173, 172, 0.2); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
        .box-input { background: white; border: 1px solid #e5e7eb; border-radius: 0.5rem; display: flex; align-items: center; padding: 0 0.5rem; height: 2.25rem; }
        .box-input span { font-size: 9px; font-weight: 800; color: #9ca3af; text-transform: uppercase; margin-right: 0.25rem; flex-shrink: 0; }
        .box-input input { border: none; background: transparent; width: 100%; font-size: 13px; font-weight: 700; color: #1f2937; padding: 0; text-align: right; }
        .box-input input:focus { ring: 0; outline: none; }
        
        /* Compact Performance Style */
        .perf-compact { background: var(--primary); color: white; border-radius: 0.75rem; padding: 0.75rem; position: relative; overflow: hidden; min-width: 450px; flex-grow: 0; }
        .perf-compact h2 { font-size: 0.75rem; font-weight: 900; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.4rem; opacity: 0.9; }
        .perf-compact .stat-box { background: rgba(255,255,255,0.1); border-radius: 0.5rem; padding: 0.4rem 0.75rem; border: 1px solid rgba(255,255,255,0.05); }
        .perf-compact .stat-val { font-size: 1.1rem; font-weight: 900; }
        .perf-compact .stat-lbl { font-size: 8px; font-weight: 800; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.05em; }
    </style>
}

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div class="max-w-md ml-8">
        <h2 class="text-xl font-black text-stone-900 font-headline tracking-tight">Oyun & Ödül Yönetimi</h2>
        <p class="text-stone-500 text-xs font-medium">Müşteri bağlılığı için ödülleri yönetin. Toplam %100 olmalıdır.</p>
    </div>
    
    <!-- Relocated Performance Card -->
    <section class="perf-compact shadow-md">
        <div class="relative z-10">
            <div class="flex justify-between items-center mb-3">
                <h2>Genel Performans</h2>
                <div class="flex bg-white/10 rounded-full p-0.5">
                    <button onclick="updateStats('today')" class="px-2.5 py-1 rounded-full text-[8px] font-black uppercase tracking-widest transition-all bg-white text-primary" id="btn-today">Bugün</button>
                    <button onclick="updateStats('yesterday')" class="px-2.5 py-1 rounded-full text-[8px] font-black uppercase tracking-widest transition-all hover:bg-white/10" id="btn-yesterday">Dün</button>
                    <button onclick="updateStats('week')" class="px-2.5 py-1 rounded-full text-[8px] font-black uppercase tracking-widest transition-all hover:bg-white/10" id="btn-week">Hafta</button>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="stat-box">
                    <p class="stat-lbl">Katılım</p>
                    <p class="stat-val" id="stat-participations">--</p>
                </div>
                <div class="stat-box">
                    <p class="stat-lbl">Ödül</p>
                    <p class="stat-val" id="stat-wins">--</p>
                </div>
            </div>
        </div>
        <div class="absolute -right-2 -bottom-2 opacity-10">
            <span class="material-symbols-outlined text-5xl rotate-12">leaderboard</span>
        </div>
    </section>
</div>

<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    @foreach(var oyun in Model)
    {
        var icon = oyun.Tip == "CARKIFELEK" ? "progress_activity" : (oyun.Tip == "HAFIZA" ? "memory" : "texture");
        var colorClass = oyun.Tip == "CARKIFELEK" ? "text-primary bg-primary/10" : (oyun.Tip == "HAFIZA" ? "text-amber-600 bg-amber-50" : "text-stone-600 bg-stone-100");
        var toplamIhtimal = oyun.Oduller.Sum(x => x.IhtimalYuzdesi);

        <section class="oyun-card flex flex-col gap-4">
            <div class="flex justify-between items-start">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg @colorClass flex items-center justify-center">
                        <span class="material-symbols-outlined text-xl">@icon</span>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold font-headline text-stone-900">@oyun.Ad</h2>
                        <span class="text-[9px] font-bold text-stone-400 uppercase tracking-widest">@(oyun.Tip == "CARKIFELEK" ? "Çarkıfelek" : (oyun.Tip == "HAFIZA" ? "Hafıza Oyunu" : "Kazı Kazan"))</span>
                    </div>
                </div>
                <label class="inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="toggle-@oyun.Id" class="sr-only peer" @(oyun.AktifMi ? "checked" : "") onchange="toggleOyun(@oyun.Id)">
                    <div class="relative w-9 h-5 bg-stone-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                    <span class="ms-2 text-[9px] font-black text-stone-500 uppercase tracking-widest">@(oyun.AktifMi ? "Aktif" : "Pasif")</span>
                </label>
            </div>

            <!-- Reward List -->
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <h3 class="text-[9px] font-black text-stone-400 uppercase tracking-widest">Ödül Havuzu</h3>
                    <span class="text-[9px] font-black px-2 py-1 bg-stone-100 rounded text-stone-500 uppercase tracking-widest">@oyun.Oduller.Count Ödül</span>
                </div>
                
                <div class="bg-stone-50 rounded-xl p-3 min-h-[80px]">
                    @foreach(var odul in oyun.Oduller)
                    {
                        <div class="grid grid-cols-12 gap-2 items-center mb-3 last:mb-0">
                            <div class="col-span-5">
                                <p class="text-xs font-bold text-stone-800 font-headline truncate">@odul.OdulTanim</p>
                                <p class="text-[8px] text-stone-400 font-black uppercase tracking-widest">
                                    @if(odul.IndirimYuzdesi > 0) { <span>İndirim</span> }
                                    else if(odul.IndirimTutari > 0) { <span>Tutar</span> }
                                    else { <span>Boş</span> }
                                </p>
                            </div>
                            <div class="col-span-3">
                                <div class="box-input">
                                    <span>%</span>
                                    <input type="number" value="@(odul.IndirimYuzdesi > 0 ? odul.IndirimYuzdesi : (odul.IndirimTutari > 0 ? (int)odul.IndirimTutari : 0))" readonly />
                                </div>
                            </div>
                            <div class="col-span-3">
                                <div class="box-input">
                                    <span>İht</span>
                                    <input type="number" class="ihtimal-input-@oyun.Id" data-odul-id="@odul.Id" value="@odul.IhtimalYuzdesi" />
                                </div>
                            </div>
                            <div class="col-span-1 flex justify-end">
                                <button onclick="odulSil(@odul.Id)" class="text-stone-300 hover:text-red-500 transition-colors border-0 bg-transparent p-0">
                                    <span class="material-symbols-outlined text-base">delete</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Add Reward Form -->
            <div class="pt-3 border-t border-stone-100">
                <form id="formOdul-@oyun.Id" onsubmit="event.preventDefault(); odulEkle(@oyun.Id, 'formOdul-@oyun.Id')" class="space-y-3">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                        <input type="text" id="odulTanim-@oyun.Id" class="w-full bg-stone-100 border-none rounded-lg text-xs focus:ring-1 focus:ring-primary py-2 px-3 font-bold text-stone-700" placeholder="Tanım" required />
                        <input type="number" id="odulYuzde-@oyun.Id" class="w-full bg-stone-100 border-none rounded-lg text-xs focus:ring-1 focus:ring-primary py-2 px-3 font-bold text-stone-700" placeholder="İndirim %" required />
                        <input type="number" id="odulİhtimal-@oyun.Id" class="w-full bg-stone-100 border-none rounded-lg text-xs focus:ring-1 focus:ring-primary py-2 px-3 font-bold text-stone-700" placeholder="İhtimal %" required />
                    </div>
                    <button type="submit" class="w-full bg-primary text-on-primary py-1.5 rounded-lg font-black text-[10px] uppercase tracking-widest hover:bg-primary-dim transition-all border-0">Ekle</button>
                </form>
            </div>

            <!-- Probability Check -->
            <div class="bg-stone-50 rounded-xl p-3 flex justify-between items-center border @(toplamIhtimal == 100 ? "border-emerald-100" : "border-red-100")">
                <span class="text-[9px] font-black text-stone-400 uppercase tracking-widest">Toplam Dağılım</span>
                <div class="flex items-center gap-2">
                    <span class="text-lg font-black font-headline @(toplamIhtimal == 100 ? "text-emerald-600" : "text-red-600")">@toplamIhtimal%</span>
                    @if(toplamIhtimal == 100) {
                        <span class="material-symbols-outlined text-emerald-600 text-sm" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    } else {
                        <button onclick="topluOranKaydet(@oyun.Id)" class="bg-stone-900 text-white text-[8px] px-3 py-1 rounded-full font-black uppercase tracking-widest hover:bg-stone-700 transition-colors border-0">Kaydet</button>
                    }
                </div>
            </div>
            
            <div class="text-center">
                <button onclick="bosSecenekEkle(@oyun.Id, '@oyun.Tip')" class="text-[8px] font-black text-stone-400 hover:text-stone-600 uppercase tracking-widest border-0 bg-transparent underline">Boş Seçenek Ekle</button>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function showToast(msg, isError = false) {
            Swal.fire({
                title: msg,
                icon: isError ? 'error' : 'success',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                background: isError ? '#fee2e2' : '#ecfdf5',
                color: isError ? '#991b1b' : '#065f46'
            });
        }

        async function updateStats(period) {
            ['today', 'yesterday', 'week'].forEach(p => {
                const btn = document.getElementById('btn-' + p);
                if (p === period) {
                    btn.classList.add('bg-white', 'text-primary');
                    btn.classList.remove('hover:bg-white/10');
                } else {
                    btn.classList.remove('bg-white', 'text-primary');
                    btn.classList.add('hover:bg-white/10');
                }
            });

            try {
                const res = await fetch('/admin/oyun-istatistik?period=' + period);
                const data = await res.json();
                if (data.success) {
                    document.getElementById('stat-participations').innerText = data.participations;
                    document.getElementById('stat-wins').innerText = data.wins;
                }
            } catch (e) {
                console.error('Stats load error', e);
            }
        }

        updateStats('today');

        async function topluOranKaydet(oyunId) {
            var inputs = document.querySelectorAll('.ihtimal-input-' + oyunId);
            var oranlar = {};
            var toplam = 0;
            inputs.forEach(function(input) {
                var val = parseFloat(input.value.replace(',', '.')) || 0;
                oranlar[input.getAttribute('data-odul-id')] = val;
                toplam += val;
            });

            if (toplam > 100) {
                 showToast('Toplam ihtimal oranı %100\'ü geçemez!', true);
                 return;
            }

            var res = await fetch('/admin/odul-toplu-kaydet/' + oyunId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(oranlar)
            });

            var data = await res.json();
            if (data.success) {
                showToast('Oranlar kaydedildi!');
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(data.message, true);
            }
        }

        async function toggleOyun(id) {
            var res = await fetch('/admin/oyun-toggle/' + id, { method: 'POST' });
            var data = await res.json();
            if(!data.success) {
                showToast(data.message || 'Hata oluştu.', true);
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('Güncellendi!');
                setTimeout(() => location.reload(), 500);
            }
        }

        async function odulEkle(id, formId) {
            var tanim = document.getElementById('odulTanim-' + id).value;
            var yuzde = document.getElementById('odulYuzde-' + id).value || 0;
            var ihtimal = document.getElementById('odulİhtimal-' + id).value;

            var formData = new FormData();
            formData.append('tanim', tanim);
            formData.append('indirimYuzdesi', yuzde);
            formData.append('indirimTutari', 0);
            formData.append('ihtimal', ihtimal);

            var res = await fetch('/admin/odul-baslat/' + id, {
                method: 'POST',
                body: formData
            });
            var data = await res.json();
            if(data.success) {
                showToast('Ödül eklendi!');
                setTimeout(() => location.reload(), 500);
            } else {
                showToast(data.message || 'Hata.', true);
            }
        }

        async function odulSil(id) {
            const result = await Swal.fire({
                title: 'Silinsin mi?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sil',
                confirmButtonColor: '#d33'
            });
            
            if (result.isConfirmed) {
                var res = await fetch('/admin/odul-sil/' + id, { method: 'POST' });
                var data = await res.json();
                if(data.success) {
                    showToast('Silindi!');
                    setTimeout(() => location.reload(), 500);
                }
            }
        }

        async function bosSecenekEkle(id, oyunTipi) {
            const { value: ihtimal } = await Swal.fire({
                title: 'Boş Seçenek',
                input: 'number',
                inputValue: 10,
                showCancelButton: true,
                confirmButtonColor: '#a23718'
            });

            if (ihtimal && ihtimal > 0) {
                var formData = new FormData();
                formData.append('tanim', oyunTipi === 'CARKIFELEK' ? 'Boş Dilim' : 'Boş Sonuç');
                formData.append('indirimYuzdesi', 0);
                formData.append('indirimTutari', 0);
                formData.append('ihtimal', ihtimal);

                var res = await fetch('/admin/odul-baslat/' + id, { method: 'POST', body: formData });
                var data = await res.json();
                if (data.success) {
                    showToast('Eklendi!');
                    setTimeout(() => location.reload(), 500);
                }
            }
        }
    </script>
}