@{
    Layout = null; // Login ekranı için admin layout'u kullanılmaz.
}
<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Personel Girişi | QR Menü</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "secondary-dim": "#674b00",
                        "outline": "#777776",
                        "inverse-primary": "#fd7954",
                        "primary-dim": "#922c0c",
                        "surface-container": "#eae8e7",
                        "on-error-container": "#570008",
                        "on-primary-fixed": "#000000",
                        "secondary-fixed-dim": "#f6ba2d",
                        "secondary-container": "#ffca57",
                        "tertiary-dim": "#504f4f",
                        "primary-fixed": "#fd7954",
                        "on-secondary-fixed": "#453100",
                        "on-background": "#2e2f2f",
                        "surface-dim": "#d5d4d4",
                        "on-surface": "#2e2f2f",
                        "secondary-fixed": "#ffca57",
                        "tertiary-fixed-dim": "#f3f0f0",
                        "on-secondary": "#fff1dc",
                        "on-primary-container": "#480d00",
                        "primary-fixed-dim": "#ec6d49",
                        "tertiary-fixed": "#ffffff",
                        "surface-tint": "#a23718",
                        "outline-variant": "#aeadac",
                        "on-tertiary-container": "#636262",
                        "background": "#f8f6f5",
                        "surface-container-low": "#f2f0f0",
                        "on-primary": "#ffefec",
                        "error": "#b31b25",
                        "surface-container-highest": "#dedcdc",
                        "on-primary-fixed-variant": "#581200",
                        "inverse-on-surface": "#9e9d9c",
                        "on-error": "#ffefee",
                        "error-dim": "#9f0519",
                        "tertiary": "#5c5b5b",
                        "on-tertiary-fixed": "#505050",
                        "error-container": "#fb5151",
                        "on-surface-variant": "#5c5b5b",
                        "surface-bright": "#f8f6f5",
                        "surface": "#f8f6f5",
                        "inverse-surface": "#0e0e0e",
                        "surface-variant": "#dedcdc",
                        "surface-container-high": "#e4e2e2",
                        "on-tertiary-fixed-variant": "#6e6d6d",
                        "surface-container-lowest": "#ffffff",
                        "tertiary-container": "#ffffff",
                        "primary": "#a23718",
                        "on-secondary-fixed-variant": "#694c00",
                        "primary-container": "#fd7954",
                        "on-tertiary": "#f5f2f1",
                        "on-secondary-container": "#5d4300",
                        "secondary": "#765600"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "headline": ["Plus Jakarta Sans"],
                        "body": ["Be Vietnam Pro"],
                        "label": ["Plus Jakarta Sans"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24
        }
        .staff-bg-texture {
            background-image: url(https://lh3.googleusercontent.com/aida-public/AB6AXuBr1LXvCHHyxYiPD9a0n3z6oWbqWJ2Q0VR42kPANAdD69LG2WzpXin5EH2IunyeJlVz9zkBDxwOFYDyP2NRrOvKBWztVmg04yEvPYFVGrjD8voA2d-0Tw-1qgNQ6wQyatb-U9ffmgx2gnmTYdFqlWs2wsX6gbskcKlXxX4_c160hpsBu_Ah1djcHkeZKN-6bnVTXJZdVEauOfXzijvqzRoSepsCBgMp1xpwovbXJlJj_adXX3BvXsvon0F0XxyJtuAG3N8A-hyA28E);
            background-blend-mode: overlay
        }
        body {
            min-height: max(884px, 100dvh);
        }
    </style>
</head>
<body class="bg-background text-on-background font-body min-h-screen flex flex-col">
    <header class="bg-[#f8f6f5]/80 dark:bg-[#2e2f2f]/80 backdrop-blur-xl fixed top-0 w-full z-50 flex justify-between items-center px-6 py-4 max-w-full">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[#a23718] dark:text-[#cc5533] text-2xl" data-icon="restaurant">restaurant</span>
            <h1 class="text-2xl font-black tracking-tighter text-[#2e2f2f] dark:text-[#f8f6f5] font-headline uppercase">QR Menü</h1>
        </div>
        <div class="hidden md:flex gap-6 items-center">
            <span class="text-sm font-medium text-outline uppercase tracking-widest">Güvenli Terminal v4.2</span>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center pt-24 pb-12 px-4 relative overflow-hidden">
        <div class="absolute inset-0 bg-surface-container-high/30 pointer-events-none staff-bg-texture opacity-20"></div>

        <div class="max-w-6xl w-full grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
            <div class="lg:col-span-5 space-y-8 hidden lg:block">
                <div class="space-y-4">
                    <h2 class="text-5xl md:text-6xl font-headline font-extrabold text-on-surface leading-tight">
                        QR <span class="text-primary italic">Menü</span>
                    </h2>
                    <p class="text-xl text-on-surface-variant font-light max-w-md leading-relaxed">Hizmetin kalbine hoş geldiniz. Biriminizi seçerek istasyonunuza giriş yapın.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" id="role-buttons">
                    <button type="button" onclick="selectRole('garson', 'Garson Personel')" class="role-btn flex flex-col items-center justify-center p-6 bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/10 hover:border-primary/40 transition-all group opacity-70 hover:opacity-100">
                        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center mb-3 group-hover:bg-primary-container transition-colors">
                            <span class="material-symbols-outlined text-primary" data-icon="person_pin">person_pin</span>
                        </div>
                        <span class="font-headline text-xs font-bold uppercase tracking-wider text-on-surface-variant">GARSON</span>
                    </button>
                    <button type="button" onclick="selectRole('mutfak', 'Mutfak Personel')" class="role-btn flex flex-col items-center justify-center p-6 bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/10 hover:border-primary/40 transition-all group opacity-70 hover:opacity-100">
                        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center mb-3 group-hover:bg-primary-container transition-colors">
                            <span class="material-symbols-outlined text-primary" data-icon="cooking">cooking</span>
                        </div>
                        <span class="font-headline text-xs font-bold uppercase tracking-wider text-on-surface-variant">MUTFAK</span>
                    </button>
                    <button type="button" onclick="selectRole('kasa', 'Kasa Personel')" class="role-btn flex flex-col items-center justify-center p-6 bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/10 hover:border-primary/40 transition-all group opacity-70 hover:opacity-100">
                        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center mb-3 group-hover:bg-primary-container transition-colors">
                            <span class="material-symbols-outlined text-primary" data-icon="payments">payments</span>
                        </div>
                        <span class="font-headline text-xs font-bold uppercase tracking-wider text-on-surface-variant">KASA</span>
                    </button>
                </div>
            </div>

            <div class="lg:col-span-7 flex justify-center lg:justify-end">
                <div class="bg-surface-container-lowest p-8 md:p-12 rounded-[2rem] shadow-[0_32px_64px_-12px_rgba(46,47,47,0.12)] w-full max-w-lg border border-white relative overflow-hidden">
                    <div id="welcome-message" class="absolute inset-0 bg-surface-container-lowest z-20 flex flex-col items-center justify-center p-8 text-center transition-all duration-300">
                        <span class="material-symbols-outlined text-6xl text-primary/20 mb-4">touch_app</span>
                        <h3 class="text-2xl font-headline font-bold text-on-surface mb-2">Birim Seçimi Yapın</h3>
                        <p class="text-on-surface-variant">Giriş yapmak için lütfen sol taraftan Garson, Mutfak veya Kasa kutusuna tıklayın.</p>
                        
                        <div class="mt-8 flex justify-center w-full lg:hidden gap-3">
                             <button onclick="selectRole('garson', 'Garson Personel')" class="px-4 py-3 bg-surface-container rounded-xl text-xs font-bold">GARSON</button>
                             <button onclick="selectRole('mutfak', 'Mutfak Personel')" class="px-4 py-3 bg-surface-container rounded-xl text-xs font-bold">MUTFAK</button>
                             <button onclick="selectRole('kasa', 'Kasa Personel')" class="px-4 py-3 bg-surface-container rounded-xl text-xs font-bold">KASA</button>
                        </div>
                    </div>

                    <div class="mb-10 text-center lg:text-left">
                        <h3 id="form-title" class="text-3xl font-headline font-bold text-on-surface mb-2">Personel Girişi</h3>
                        <p class="text-on-surface-variant">Erişim şifrenizi giriniz.</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="bg-error-container text-on-error-container p-4 rounded-xl mb-6 text-sm font-medium flex items-center gap-3">
                            <span class="material-symbols-outlined text-error">error</span>
                            @ViewBag.Error
                        </div>
                        <script>
                            // Hata varsa ilgili rolü seçili tut
                            document.addEventListener('DOMContentLoaded', () => {
                                const storedRole = localStorage.getItem('lastRole') || 'garson';
                                const storedRoleName = localStorage.getItem('lastRoleName') || 'Personel';
                                selectRole(storedRole, storedRoleName);
                            });
                        </script>
                    }

                    <form class="space-y-6" action="/Auth/Login" method="post">
                        <div class="space-y-2">
                            <label class="block text-xs font-bold uppercase tracking-widest text-outline ml-1">Kullanıcı Adı</label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors" data-icon="badge">badge</span>
                                <input name="username" id="usernameInput" class="w-full pl-12 pr-4 py-4 bg-surface-container-low border-none rounded-xl focus:ring-2 focus:ring-primary/20 text-on-surface font-headline font-medium transition-all" placeholder="Kullanıcı adınız" type="text" autofocus required />
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="block text-xs font-bold uppercase tracking-widest text-outline ml-1">Pin / Şifre</label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors" data-icon="lock">lock</span>
                                <input name="password" id="passwordInput" class="w-full pl-12 pr-4 py-4 bg-surface-container-low border-none rounded-xl focus:ring-2 focus:ring-primary/20 text-on-surface tracking-[0.5em] font-headline transition-all" placeholder="••••" type="password" required />
                            </div>
                        </div>

                        <button class="w-full mt-4 py-5 bg-primary text-on-primary font-headline font-bold text-lg rounded-2xl shadow-xl shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-3" type="submit">
                            <span>Oturumu Başlat</span>
                            <span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
                        </button>
                    </form>

                    <div class="mt-8 pt-6 border-t border-surface-container-high flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="flex items-center gap-2 text-on-surface-variant">
                            <span class="material-symbols-outlined text-sm" data-icon="admin_panel_settings">admin_panel_settings</span>
                            <span class="text-xs font-medium">Yönetim erişimi</span>
                        </div>
                        <a href="/Auth/AdminLogin" class="px-4 py-2 bg-surface-container text-on-surface-variant rounded-full text-[10px] font-bold uppercase tracking-wider hover:bg-surface-container-highest transition-colors flex items-center gap-2 text-primary">ADMİN GİRİŞİ</a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="mt-auto py-8 px-6 text-center lg:text-left">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <p class="text-xs text-outline font-medium">© 2026 QR Menü Sistemi. Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <script>
        function selectRole(username, roleName) {
            // Unhide form, hide welcome
            document.getElementById('welcome-message').style.opacity = '0';
            setTimeout(() => {
                document.getElementById('welcome-message').style.display = 'none';
            }, 300);

            // Update title
            document.getElementById('form-title').innerText = roleName + ' Girişi';
            
            // Set hidden input (removed)
            // Focus username
            setTimeout(() => document.getElementById('usernameInput').focus(), 100);
            document.querySelectorAll('.role-btn').forEach(btn => {
                btn.classList.replace('opacity-100', 'opacity-70');
                btn.classList.replace('border-primary', 'border-outline-variant/10');
            });

            // Need to match the button with `onclick` containing username
            const activeBtn = Array.from(document.querySelectorAll('.role-btn')).find(b => b.getAttribute('onclick').includes(username));
            if(activeBtn) {
                activeBtn.classList.replace('opacity-70', 'opacity-100');
                activeBtn.classList.replace('border-outline-variant/10', 'border-primary');
            }



            // Store in LocalStorage to preserve state on error
            localStorage.setItem('lastRole', username);
            localStorage.setItem('lastRoleName', roleName);
        }
    </script>
</body>
</html>
