@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistem Yöneticisi Girişi | QR Menü</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="~/js/tailwind-config.js" asp-append-version="true"></script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24
        }
        .admin-bg-texture {
            background-image: url(https://lh3.googleusercontent.com/aida-public/AB6AXuBr1LXvCHHyxYiPD9a0n3z6oWbqWJ2Q0VR42kPANAdD69LG2WzpXin5EH2IunyeJlVz9zkBDxwOFYDyP2NRrOvKBWztVmg04yEvPYFVGrjD8voA2d-0Tw-1qgNQ6wQyatb-U9ffmgx2gnmTYdFqlWs2wsX6gbskcKlXxX4_c160hpsBu_Ah1djcHkeZKN-6bnVTXJZdVEauOfXzijvqzRoSepsCBgMp1xpwovbXJlJj_adXX3BvXsvon0F0XxyJtuAG3N8A-hyA28E);
            background-blend-mode: overlay
        }
        body {
            min-height: max(600px, 100dvh);
        }
    </style>
</head>
<body class="bg-background text-on-background font-body min-h-screen flex flex-col">
    <header class="bg-[#f8f6f5]/80 dark:bg-[#2e2f2f]/80 backdrop-blur-xl fixed top-0 w-full z-50 flex justify-between items-center px-6 py-4 max-w-full">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[#a23718] dark:text-[#cc5533] text-2xl" data-icon="restaurant">restaurant</span>
            <h1 class="text-2xl font-black tracking-tighter text-[#2e2f2f] dark:text-[#f8f6f5] font-headline uppercase">QR Menü</h1>
        </div>
        <div class="hidden md:flex gap-6 items-center">
            <span class="text-sm font-medium text-outline uppercase tracking-widest">Sistem Yöneticisi</span>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center pt-24 pb-12 px-4 relative overflow-hidden">
        <div class="absolute inset-0 bg-surface-container-high/30 pointer-events-none admin-bg-texture opacity-20"></div>

        <div class="w-full flex justify-center relative z-10">
            <div class="bg-surface-container-lowest p-8 md:p-12 rounded-[2rem] shadow-[0_32px_64px_-12px_rgba(46,47,47,0.12)] w-full max-w-lg border border-white">
                <div class="mb-10 text-center">
                    <span class="material-symbols-outlined text-6xl text-primary/80 mb-4 inline-block" data-icon="admin_panel_settings">admin_panel_settings</span>
                    <h3 class="text-3xl font-headline font-bold text-on-surface mb-2">Yönetici Girişi</h3>
                    <p class="text-on-surface-variant">Sistemi yönetmek için kimlik bilgilerinizi doğrulayın.</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-error-container text-on-error-container p-4 rounded-xl mb-6 text-sm font-medium flex items-center gap-3">
                        <span class="material-symbols-outlined text-error">error</span>
                        @ViewBag.Error
                    </div>
                }

                <form class="space-y-6" action="/Auth/AdminLogin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="space-y-2">
                        <label class="block text-xs font-bold uppercase tracking-widest text-outline ml-1">Kullanıcı Adı</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors" data-icon="badge">badge</span>
                            <input name="username" class="w-full pl-12 pr-4 py-4 bg-surface-container-low border-none rounded-xl focus:ring-2 focus:ring-primary/20 text-on-surface font-headline font-medium transition-all" placeholder="admin" type="text" autocomplete="username" autofocus required />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-xs font-bold uppercase tracking-widest text-outline ml-1">Şifre</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors" data-icon="lock">lock</span>
                            <input name="password" class="w-full pl-12 pr-4 py-4 bg-surface-container-low border-none rounded-xl focus:ring-2 focus:ring-primary/20 text-on-surface tracking-[0.5em] font-headline transition-all" placeholder="••••" type="password" autocomplete="current-password" required />
                        </div>
                    </div>

                    <button class="w-full mt-4 py-5 bg-primary text-on-primary font-headline font-bold text-lg rounded-2xl shadow-xl shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-3" type="submit">
                        <span>Oturumu Başlat</span>
                        <span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
                    </button>
                    
                    <div class="pt-4 text-center">
                        <a href="/Auth/Login" class="text-sm font-semibold text-primary hover:underline underline-offset-4">Personel Ekranına Dön</a>
                    </div>
                </form>

            </div>
        </div>
    </main>

    <footer class="mt-auto py-8 px-6 text-center">
        <div class="max-w-6xl mx-auto flex flex-col items-center gap-2">
            <p class="text-xs text-outline font-medium">© 2026 QR Menü Sistemi. Tüm hakları saklıdır.</p>
        </div>
    </footer>
</body>
</html>
