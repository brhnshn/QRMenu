@{
    Layout = "~/Views/Shared/_KasaLayout.cshtml";
    ViewData["Title"] = "Kasa Ayarları";
    ViewData["ActivePage"] = "KasaAyarlar";
    ViewData["PageTitle"] = "Kasa Ayarları";
}

@section Styles {
    <style>
        .kasa-settings-root {
            height: 100%;
            min-height: 0;
            overflow-y: auto;
            padding: 1.25rem;
            background: #f8f6f5;
        }

        .kasa-settings-wrap {
            max-width: 1160px;
            margin: 0 auto;
            display: grid;
            gap: 1rem;
        }

        .kasa-settings-head {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: .8rem;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid #ece7e4;
            border-radius: 1rem;
            padding: 1rem 1.1rem;
        }

        .kasa-settings-sub {
            margin: 0 0 .2rem;
            font-size: .72rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: #765600;
            font-weight: 800;
        }

        .kasa-settings-title {
            margin: 0;
            color: #2e2f2f;
            font-size: clamp(1.5rem, 2.4vw, 2rem);
            font-weight: 900;
            letter-spacing: -.02em;
        }

        .kasa-save-btn {
            border: 0;
            border-radius: .8rem;
            background: #a23718;
            color: #ffefec;
            padding: .72rem 1rem;
            font-size: .88rem;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

        .kasa-save-btn:hover {
            opacity: .92;
        }

        .settings-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .settings-card {
            border-radius: 1rem;
            border: 1px solid #ece7e4;
            background: #fff;
            padding: 1rem;
            box-shadow: 0 8px 20px rgba(46, 47, 47, 0.04);
        }

        .settings-card h3 {
            margin: 0 0 .8rem;
            color: #2e2f2f;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: -.01em;
        }

        .settings-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            border-top: 1px solid #f0ece9;
            padding: .72rem 0;
        }

        .settings-row:first-of-type {
            border-top: 0;
            padding-top: 0;
        }

        .settings-row:last-of-type {
            padding-bottom: 0;
        }

        .settings-label {
            margin: 0;
            color: #2e2f2f;
            font-size: .9rem;
            font-weight: 700;
        }

        .settings-help {
            margin: .18rem 0 0;
            color: #777776;
            font-size: .76rem;
            font-weight: 500;
        }

        .switch {
            position: relative;
            width: 44px;
            height: 26px;
            display: inline-block;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background: #ddd8d4;
            transition: .2s;
            border-radius: 999px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 3px;
            top: 3px;
            background: white;
            transition: .2s;
            border-radius: 999px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, .15);
        }

        input:checked + .slider {
            background: #a23718;
        }

        input:checked + .slider:before {
            transform: translateX(18px);
        }

        .settings-select {
            min-width: 170px;
            border-radius: .7rem;
            border: 1px solid #ddd8d4;
            background: #fff;
            padding: .45rem .6rem;
            color: #2e2f2f;
            font-size: .86rem;
            font-weight: 700;
        }

        .settings-note {
            border-radius: .9rem;
            border: 1px dashed #d7d2cf;
            background: #f7f4f2;
            padding: .8rem;
            color: #6f6d6c;
            font-size: .8rem;
            font-weight: 600;
        }

        @@media (max-width: 980px) {
            .settings-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .kasa-settings-root {
                padding: .8rem;
            }

            .kasa-settings-head {
                padding: .85rem;
            }

            .settings-card {
                padding: .85rem;
            }

            .settings-select {
                min-width: 135px;
            }
        }
    </style>
}

<section class="kasa-settings-root">
    <div class="kasa-settings-wrap">
        <header class="kasa-settings-head">
            <div>
                <p class="kasa-settings-sub">Kasa Yönetimi</p>
                <h1 class="kasa-settings-title">Ayarlar</h1>
            </div>
            <button type="button" class="kasa-save-btn" onclick="kaydetKasaAyar()">
                <span class="material-symbols-outlined text-[18px]">save</span>
                <span>Ayarları Kaydet</span>
            </button>
        </header>

        <div class="settings-grid">
            <article class="settings-card">
                <h3>Tahsilat ve Bildirim</h3>

                <div class="settings-row">
                    <div>
                        <p class="settings-label">Otomatik yenileme</p>
                        <p class="settings-help">Kasa ekranı sipariş değişiminde güncellensin.</p>
                    </div>
                    <label class="switch">
                        <input id="kasaAutoRefresh" type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="settings-row">
                    <div>
                        <p class="settings-label">Bildirim sesi</p>
                        <p class="settings-help">Ödeme alındığında zil sesi çalsın.</p>
                    </div>
                    <label class="switch">
                        <input id="kasaPaymentSound" type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="settings-row">
                    <div>
                        <p class="settings-label">Varsayılan ödeme tipi</p>
                        <p class="settings-help">Tahsilat ekranında seçili gelsin.</p>
                    </div>
                    <select id="kasaDefaultPayment" class="settings-select">
                        <option value="Nakit">Nakit</option>
                        <option value="Kart">Kart</option>
                    </select>
                </div>
            </article>

            <article class="settings-card">
                <h3>Arayüz</h3>

                <div class="settings-row">
                    <div>
                        <p class="settings-label">Sidebar kapalı başlat</p>
                        <p class="settings-help">Kasa paneli dar görünümde açılsın.</p>
                    </div>
                    <label class="switch">
                        <input id="kasaStartCollapsed" type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="settings-row">
                    <div>
                        <p class="settings-label">Masa kartı sıralama</p>
                        <p class="settings-help">Masalar ekranında varsayılan sıralama.</p>
                    </div>
                    <select id="kasaSortDefault" class="settings-select">
                        <option value="wait-desc">Bekleme Süresi</option>
                        <option value="amount-desc">Tutar</option>
                        <option value="table-asc">Masa No</option>
                    </select>
                </div>

                <div class="settings-row">
                    <div>
                        <p class="settings-label">Kompakt kart görünümü</p>
                        <p class="settings-help">Masalar ekranında daha sıkı kart ölçüsü.</p>
                    </div>
                    <label class="switch">
                        <input id="kasaCompactCards" type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </article>
        </div>

        <div class="settings-note" id="kasaAyarNote">
            Değişiklikler bu cihaz için saklanır ve bir sonraki girişte otomatik uygulanır.
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function yukleKasaAyar() {
            const boolSettings = [
                ['kasaAutoRefresh', true],
                ['kasaPaymentSound', true],
                ['kasaStartCollapsed', false],
                ['kasaCompactCards', false]
            ];

            boolSettings.forEach(([key, fallback]) => {
                const el = document.getElementById(key);
                if (!el) {
                    return;
                }

                const stored = localStorage.getItem(key);
                if (stored === null) {
                    el.checked = fallback;
                    return;
                }

                el.checked = stored === '1';
            });

            const paymentEl = document.getElementById('kasaDefaultPayment');
            if (paymentEl) {
                paymentEl.value = localStorage.getItem('kasaDefaultPayment') || 'Nakit';
            }

            const sortEl = document.getElementById('kasaSortDefault');
            if (sortEl) {
                sortEl.value = localStorage.getItem('kasaSortDefault') || 'wait-desc';
            }
        }

        function kaydetKasaAyar() {
            const boolKeys = ['kasaAutoRefresh', 'kasaPaymentSound', 'kasaStartCollapsed', 'kasaCompactCards'];
            boolKeys.forEach((key) => {
                const el = document.getElementById(key);
                if (!el) {
                    return;
                }
                localStorage.setItem(key, el.checked ? '1' : '0');
            });

            const paymentEl = document.getElementById('kasaDefaultPayment');
            if (paymentEl) {
                localStorage.setItem('kasaDefaultPayment', paymentEl.value);
            }

            const sortEl = document.getElementById('kasaSortDefault');
            if (sortEl) {
                localStorage.setItem('kasaSortDefault', sortEl.value);
            }

            if (document.getElementById('kasaStartCollapsed')?.checked) {
                localStorage.setItem('kasaSidebarCollapsed', '1');
            }

            const note = document.getElementById('kasaAyarNote');
            if (note) {
                note.textContent = 'Ayarlar kaydedildi.';
            }
        }

        document.addEventListener('DOMContentLoaded', yukleKasaAyar);
    </script>
}
