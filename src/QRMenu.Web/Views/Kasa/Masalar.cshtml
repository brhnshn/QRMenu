@using QRMenu.Core.Enums
@model List<QRMenu.Core.Entities.Masa>
@{
    Layout = "~/Views/Shared/_KasaLayout.cshtml";
    ViewData["Title"] = "Kasa Yönetimi";
    ViewData["ActivePage"] = "KasaMasalar";
    ViewData["PageTitle"] = "Kasa Yönetimi";

    var mutfakZamanEsigi = DateTime.UtcNow.AddHours(-24);
    var nowUtc = DateTime.UtcNow;

    var masaKartlari = Model
        .OrderBy(m => m.MasaNo)
        .Select(masa =>
        {
            var siparisler = masa.Siparisler
                .Where(s => s.Durum != SiparisDurum.TamOdendi && s.Durum != SiparisDurum.Iptal && s.Durum != SiparisDurum.Iade)
                .ToList();

            var aktifDetayVarmi = siparisler.Any(s => s.SiparisDetaylar.Any(sd =>
                sd.Durum != SiparisDurum.TamOdendi &&
                sd.Durum != SiparisDurum.Iptal &&
                sd.Durum != SiparisDurum.Iade));

            var mutfaktaVarMi = siparisler.Any(s =>
                s.OlusturmaTarihi >= mutfakZamanEsigi &&
                (s.Durum == SiparisDurum.Onaylandi || s.Durum == SiparisDurum.Hazirlaniyor));

            var garsondaVarMi = siparisler.Any(s => s.Durum == SiparisDurum.Hazir);

            var odemeBekliyorMu = siparisler.Any(s =>
                s.Durum == SiparisDurum.TeslimEdildi ||
                s.Durum == SiparisDurum.KismiOdendi);

            var kalanBakiye = siparisler.Sum(s =>
            {
                var bazToplam = s.SiparisDetaylar
                    .Where(sd => sd.Durum != SiparisDurum.Iptal && sd.Durum != SiparisDurum.Iade)
                    .Sum(sd => sd.Adet * sd.BirimFiyat);

                var oran = bazToplam > 0 ? (s.ToplamTutar / bazToplam) : 1m;

                return s.SiparisDetaylar
                    .Where(sd => sd.Durum != SiparisDurum.TamOdendi &&
                                 sd.Durum != SiparisDurum.Iptal &&
                                 sd.Durum != SiparisDurum.Iade)
                    .Sum(sd => (sd.Adet * sd.BirimFiyat) * oran);
            });

            var doluMu = aktifDetayVarmi && kalanBakiye > 0;

            var enEskiSiparis = siparisler
                .Select(s => (DateTime?)s.OlusturmaTarihi)
                .OrderBy(t => t)
                .FirstOrDefault();

            var beklemeDakika = enEskiSiparis.HasValue
                ? (int)Math.Max(0, (nowUtc - enEskiSiparis.Value).TotalMinutes)
                : 0;

            var bolgeAd = string.IsNullOrWhiteSpace(masa.Bolge?.Ad) ? "Salon" : masa.Bolge!.Ad;

            var durumMetni = "Hazır";
            if (doluMu)
            {
                if (odemeBekliyorMu)
                {
                    durumMetni = "Ödeme Bekliyor";
                }
                else if (garsondaVarMi)
                {
                    durumMetni = "Garsonda";
                }
                else if (mutfaktaVarMi)
                {
                    durumMetni = "Mutfakta";
                }
                else
                {
                    durumMetni = "Sipariş Var";
                }
            }

            var acilMi = doluMu && beklemeDakika >= 40;

            return new
            {
                MasaId = masa.Id,
                MasaNo = masa.MasaNo,
                BolgeAd = bolgeAd,
                DoluMu = doluMu,
                DurumMetni = durumMetni,
                KalanBakiye = kalanBakiye,
                BeklemeDakika = beklemeDakika,
                AcilMi = acilMi,
                OdemedeMi = odemeBekliyorMu,
                MutfaktaMi = mutfaktaVarMi,
                GarsondaMi = garsondaVarMi
            };
        })
        .ToList();

    var toplamOdemeBekleyen = masaKartlari.Count(x => x.DoluMu);
    var bolgeChipleri = masaKartlari
        .GroupBy(x => x.BolgeAd)
        .Select(g => new
        {
            Bolge = g.Key,
            Bekleyen = g.Count(x => x.DoluMu)
        })
        .OrderByDescending(x => x.Bekleyen)
        .ThenBy(x => x.Bolge)
        .ToList();
}

@section Styles {
    <style>
        .kasa-masalar-root {
            height: 100%;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #f8f6f5;
        }

        .kasa-main-scroll {
            min-height: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            overflow: hidden;
            padding: 1rem 1.25rem;
        }

        .kasa-main-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .kasa-main-scroll::-webkit-scrollbar-thumb {
            background: #d5d4d4;
            border-radius: 999px;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .table-bento-grid {
            display: grid;
            grid-template-columns: repeat(1, minmax(0, 1fr));
            gap: .85rem;
            min-height: 0;
            flex: 1;
            align-content: start;
            overflow: visible;
        }

        @@media (min-width: 768px) {
            .table-bento-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (min-width: 1024px) {
            .table-bento-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (min-width: 1280px) {
            .table-bento-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        .table-card {
            height: 13.5rem;
        }

        .table-card.is-clickable {
            cursor: pointer;
        }

        .table-card.is-clickable:focus-visible {
            outline: 2px solid rgba(162, 55, 24, 0.4);
            outline-offset: 2px;
        }

        @@media (max-width: 767px) {
            .kasa-main-scroll {
                padding: .75rem;
            }

            .table-card {
                height: 12.5rem;
            }
        }

        .kasa-main-footer {
            margin-top: .25rem;
            padding-top: .65rem;
            padding-bottom: .2rem;
        }

        .kasa-pager-btn {
            width: 2.6rem;
            height: 2.6rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: .65rem;
            background: #eae8e7;
            color: #2e2f2f;
            font-weight: 800;
            border: 0;
            transition: background-color .2s ease, color .2s ease, opacity .2s ease;
        }

        .kasa-pager-btn:hover {
            background: #dedcdc;
        }

        .kasa-pager-btn.is-active {
            background: #765600;
            color: #fff;
        }

        .kasa-pager-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }
    </style>
}

<audio id="kasaBellSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

<section class="kasa-masalar-root">
    <div id="kasaTabContent" class="kasa-main-scroll">
        @if (ViewBag.ConnectionWarning != null)
        {
            <div class="mb-4 border border-amber-200 bg-amber-50 text-amber-800 rounded-xl px-4 py-3 flex items-center gap-2 text-sm">
                <i class="bi bi-wifi-off"></i>
                <span>@ViewBag.ConnectionWarning</span>
            </div>
        }

        <header class="mb-2">
            <div class="flex items-end justify-between mb-3 gap-3 flex-wrap">
                <div>
                    <span class="text-secondary font-bold tracking-widest text-xs uppercase mb-2 block">Operasyon Paneli</span>
                    <h1 class="text-3xl font-extrabold text-on-surface tracking-tight">Bekleyen Masalar</h1>
                </div>
                <div class="bg-primary/5 px-5 py-3 rounded-xl flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary flex items-center justify-center rounded-full text-white">
                        <span class="material-symbols-outlined">receipt_long</span>
                    </div>
                    <div>
                        <p class="text-xs text-on-surface-variant font-semibold">Toplam Ödeme Bekleyen</p>
                        <p class="text-xl font-black text-primary">@toplamOdemeBekleyen Masa</p>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2 flex-wrap pb-1">
                <button type="button" class="px-6 py-2 bg-secondary-container text-on-secondary-container rounded-full text-sm font-bold shadow-sm whitespace-nowrap kasa-filter-chip active" data-area-chip="all">Tüm Masalar (@masaKartlari.Count)</button>
                @foreach (var chip in bolgeChipleri)
                {
                    <button type="button" class="px-6 py-2 bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high rounded-full text-sm font-semibold transition-colors whitespace-nowrap kasa-filter-chip" data-area-chip="@chip.Bolge">@chip.Bolge (@chip.Bekleyen)</button>
                }

                <div class="ml-auto flex items-center gap-2">
                    <span class="text-sm font-semibold text-on-surface-variant">Sırala:</span>
                    <div class="relative">
                        <select id="kasaSortSelect" class="appearance-none pl-3 pr-8 py-2 rounded-full bg-surface-container-low hover:bg-surface-container-high text-sm font-bold border-0 focus:ring-2 focus:ring-primary/20">
                            <option value="wait-desc">Bekleme Süresi</option>
                            <option value="amount-desc">Tutar</option>
                            <option value="table-asc">Masa No</option>
                        </select>
                        <span class="material-symbols-outlined text-lg absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">arrow_drop_down</span>
                    </div>
                </div>
            </div>
        </header>

        <div id="kasaTableGrid" class="table-bento-grid">
            @foreach (var kart in masaKartlari)
            {
                var badgeText = kart.DoluMu
                    ? (kart.AcilMi ? $"Acil - {kart.BeklemeDakika} dk." : $"{kart.BolgeAd} - {kart.BeklemeDakika} dk.")
                    : $"{kart.BolgeAd} - Boş";

                var borderClass = "border-outline-variant";
                var badgeClass = "bg-surface-container-high text-on-surface-variant";

                if (kart.AcilMi)
                {
                    borderClass = "border-error";
                    badgeClass = "bg-error/10 text-error";
                }
                else if (kart.DoluMu && kart.OdemedeMi)
                {
                    borderClass = "border-secondary";
                    badgeClass = "bg-secondary/10 text-secondary";
                }
                else if (kart.DoluMu && kart.MutfaktaMi)
                {
                    borderClass = "border-blue-500";
                    badgeClass = "bg-blue-100 text-blue-700";
                }
                else if (kart.DoluMu && kart.GarsondaMi)
                {
                    borderClass = "border-emerald-500";
                    badgeClass = "bg-emerald-100 text-emerald-700";
                }

                var displayAmount = kart.DoluMu ? kart.KalanBakiye : 0m;
                var searchText = $"masa {kart.MasaNo} {kart.BolgeAd} {kart.DurumMetni}";

                <article class="group bg-surface-container-lowest rounded-xl p-5 border-l-4 @borderClass shadow-sm hover:shadow-md transition-all scale-95 hover:scale-100 flex flex-col justify-between table-card is-clickable"
                         data-area="@kart.BolgeAd"
                         data-wait="@kart.BeklemeDakika"
                         data-amount="@displayAmount"
                         data-table="@kart.MasaNo"
                         data-search="@searchText.ToLowerInvariant()"
                         data-detail-url="/Kasa/Odeme/@kart.MasaId"
                         role="button"
                         tabindex="0"
                         aria-label="Masa @kart.MasaNo detayını aç">
                    <div>
                        <div class="flex justify-between items-start mb-4 gap-2">
                            <span class="text-3xl font-black text-on-surface opacity-30">#@kart.MasaNo</span>
                            <div class="@badgeClass px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider">@badgeText</div>
                        </div>
                        <h3 class="text-xl font-bold text-on-surface mb-1">Masa @kart.MasaNo</h3>
                        <p class="text-sm text-on-surface-variant">Durum: @kart.DurumMetni</p>
                    </div>
                    <div class="flex items-center justify-between border-t border-surface-container-high pt-4 gap-2">
                        <div>
                            <p class="text-[10px] text-on-surface-variant font-bold uppercase">Tutar</p>
                            <p class="text-lg font-black text-on-surface">@displayAmount.ToString("N2") TL</p>
                        </div>

                        @if (kart.DoluMu)
                        {
                            <a href="/Kasa/Odeme/@kart.MasaId" class="bg-primary text-on-primary px-4 py-2 rounded-lg text-sm font-bold hover:bg-primary-dim transition-colors flex items-center gap-2 whitespace-nowrap">
                                Ödeme Al
                            </a>
                        }
                        else
                        {
                            <span class="bg-surface-container-high text-on-surface-variant px-4 py-2 rounded-lg text-sm font-bold whitespace-nowrap">Hazır</span>
                        }
                    </div>
                </article>
            }

            <div id="kasaGridEmpty" class="border-2 border-dashed border-outline-variant rounded-xl p-5 flex flex-col items-center justify-center text-center table-card opacity-60" style="display:none;">
                <span class="material-symbols-outlined text-4xl mb-2">search</span>
                <p class="text-sm font-bold">Filtreye uygun masa bulunamadı</p>
                <p class="text-xs text-on-surface-variant">Arama veya filtreyi değiştir</p>
            </div>
        </div>

        <footer class="kasa-main-footer flex items-center justify-between border-t border-surface-container-high gap-3 flex-wrap">
            <p id="kasaFooterInfo" class="text-sm text-on-surface-variant font-medium">Toplam @masaKartlari.Count masadan @toplamOdemeBekleyen bekleyen masa gösteriliyor</p>
            <div class="flex gap-2 items-center" id="kasaPagerControls">
                <button id="kasaPrevPageBtn" type="button" class="kasa-pager-btn" aria-label="Önceki sayfa" disabled>
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <div id="kasaPageNumberGroup" class="flex gap-2"></div>
                <button id="kasaNextPageBtn" type="button" class="kasa-pager-btn" aria-label="Sonraki sayfa" disabled>
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        </footer>
    </div>
</section>

@section Scripts {
    <script>
        let refreshTimer = null;
        let lastRefreshAt = 0;
        let refreshInFlight = false;
        const kasaUiState = {
            area: 'all',
            query: '',
            sort: 'wait-desc',
            currentPage: 1,
            totalPages: 1,
            pageSize: 1
        };

        function normalizeText(value) {
            return String(value || '').toLocaleLowerCase('tr-TR');
        }

        function sortCards(cards) {
            const sortType = kasaUiState.sort;
            cards.sort((a, b) => {
                const waitA = Number(a.dataset.wait || 0);
                const waitB = Number(b.dataset.wait || 0);
                const amountA = Number(a.dataset.amount || 0);
                const amountB = Number(b.dataset.amount || 0);
                const tableA = Number(a.dataset.table || 0);
                const tableB = Number(b.dataset.table || 0);

                if (sortType === 'amount-desc') return amountB - amountA;
                if (sortType === 'table-asc') return tableA - tableB;
                return waitB - waitA;
            });
        }

        function getGridColumnCount(grid) {
            if (!grid) {
                return 1;
            }

            const template = window.getComputedStyle(grid).gridTemplateColumns || '';
            const parts = template.split(' ').filter(Boolean);
            return Math.max(1, parts.length);
        }

        function calculatePageSize(grid, visibleCards) {
            const cols = getGridColumnCount(grid);
            if (!visibleCards.length) {
                return cols;
            }

            const cardRect = visibleCards[0].getBoundingClientRect();
            const cardHeight = cardRect.height || 0;
            const gridStyle = window.getComputedStyle(grid);
            const rowGap = Number.parseFloat(gridStyle.rowGap || '0') || 0;
            const availableHeight = grid.clientHeight || 0;

            if (cardHeight <= 0 || availableHeight <= 0) {
                return cols;
            }

            const rows = Math.max(1, Math.floor((availableHeight + rowGap) / (cardHeight + rowGap)));
            return Math.max(1, cols * rows);
        }

        function renderPager(totalItems) {
            const prevBtn = document.getElementById('kasaPrevPageBtn');
            const nextBtn = document.getElementById('kasaNextPageBtn');
            const numberGroup = document.getElementById('kasaPageNumberGroup');
            const footerInfo = document.getElementById('kasaFooterInfo');
            const totalAll = document.querySelectorAll('#kasaTableGrid .table-card[data-search]').length;

            if (footerInfo) {
                footerInfo.textContent = `Toplam ${totalAll} masadan ${totalItems} masa gösteriliyor`;
            }

            if (!prevBtn || !nextBtn || !numberGroup) {
                return;
            }

            numberGroup.innerHTML = '';

            const totalPages = kasaUiState.totalPages;
            const currentPage = kasaUiState.currentPage;

            prevBtn.disabled = currentPage <= 1;
            nextBtn.disabled = currentPage >= totalPages;

            if (totalPages <= 1) {
                return;
            }

            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `kasa-pager-btn${i === currentPage ? ' is-active' : ''}`;
                btn.textContent = String(i);
                btn.addEventListener('click', () => {
                    if (kasaUiState.currentPage === i) {
                        return;
                    }
                    kasaUiState.currentPage = i;
                    applyBekleyenFilters();
                });
                numberGroup.appendChild(btn);
            }
        }

        function initTableCardNavigation() {
            document.querySelectorAll('#kasaTableGrid .table-card[data-detail-url]').forEach(card => {
                const goToDetail = () => {
                    const detailUrl = card.dataset.detailUrl;
                    if (detailUrl) {
                        window.location.href = detailUrl;
                    }
                };

                card.onclick = (evt) => {
                    const target = evt.target;
                    if (target instanceof Element && target.closest('a, button, input, select, textarea, label')) {
                        return;
                    }
                    goToDetail();
                };

                card.onkeydown = (evt) => {
                    if (evt.key === 'Enter' || evt.key === ' ') {
                        evt.preventDefault();
                        goToDetail();
                    }
                };
            });
        }

        function applyBekleyenFilters() {
            const grid = document.getElementById('kasaTableGrid');
            if (!grid) return;

            const empty = document.getElementById('kasaGridEmpty');
            const cards = Array.from(grid.querySelectorAll('.table-card[data-search]'));

            const visibleCards = cards.filter(card => {
                const areaMatch = kasaUiState.area === 'all' || card.dataset.area === kasaUiState.area;
                const text = normalizeText(card.dataset.search || '');
                const queryMatch = !kasaUiState.query || text.includes(kasaUiState.query);
                return areaMatch && queryMatch;
            });

            sortCards(visibleCards);
            visibleCards.forEach(card => grid.appendChild(card));

            const pageSize = calculatePageSize(grid, visibleCards);
            kasaUiState.pageSize = pageSize;
            kasaUiState.totalPages = Math.max(1, Math.ceil(visibleCards.length / pageSize));
            kasaUiState.currentPage = Math.min(kasaUiState.currentPage, kasaUiState.totalPages);
            kasaUiState.currentPage = Math.max(1, kasaUiState.currentPage);

            const startIndex = (kasaUiState.currentPage - 1) * kasaUiState.pageSize;
            const endIndex = startIndex + kasaUiState.pageSize;

            cards.forEach(card => {
                card.style.display = 'none';
            });

            visibleCards.forEach((card, index) => {
                card.style.display = index >= startIndex && index < endIndex ? '' : 'none';
            });

            if (empty) {
                empty.style.display = visibleCards.length ? 'none' : 'flex';
            }

            renderPager(visibleCards.length);
        }

        function initBekleyenMasalarUI() {
            const searchInput = document.getElementById('kasaSearchInput');
            const sortSelect = document.getElementById('kasaSortSelect');
            const prevBtn = document.getElementById('kasaPrevPageBtn');
            const nextBtn = document.getElementById('kasaNextPageBtn');

            document.querySelectorAll('[data-area-chip]').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.areaChip === kasaUiState.area);
                btn.onclick = () => {
                    kasaUiState.area = btn.dataset.areaChip || 'all';
                    kasaUiState.currentPage = 1;
                    document.querySelectorAll('[data-area-chip]').forEach(x => x.classList.toggle('active', x === btn));
                    applyBekleyenFilters();
                };
            });

            if (searchInput) {
                searchInput.value = kasaUiState.query;
                searchInput.oninput = () => {
                    kasaUiState.query = normalizeText(searchInput.value).trim();
                    kasaUiState.currentPage = 1;
                    applyBekleyenFilters();
                };
            }

            if (sortSelect) {
                sortSelect.value = kasaUiState.sort;
                sortSelect.onchange = () => {
                    kasaUiState.sort = sortSelect.value;
                    kasaUiState.currentPage = 1;
                    applyBekleyenFilters();
                };
            }

            if (prevBtn) {
                prevBtn.onclick = () => {
                    if (kasaUiState.currentPage <= 1) {
                        return;
                    }
                    kasaUiState.currentPage -= 1;
                    applyBekleyenFilters();
                };
            }

            if (nextBtn) {
                nextBtn.onclick = () => {
                    if (kasaUiState.currentPage >= kasaUiState.totalPages) {
                        return;
                    }
                    kasaUiState.currentPage += 1;
                    applyBekleyenFilters();
                };
            }

            initTableCardNavigation();
            applyBekleyenFilters();
        }

        async function softRefreshKasaPanels() {
            if (refreshInFlight) return;
            refreshInFlight = true;

            try {
                const searchInput = document.getElementById('kasaSearchInput');
                if (searchInput) {
                    kasaUiState.query = normalizeText(searchInput.value).trim();
                }

                const sortSelect = document.getElementById('kasaSortSelect');
                if (sortSelect) {
                    kasaUiState.sort = sortSelect.value;
                }

                const activeChip = document.querySelector('[data-area-chip].active');
                if (activeChip) {
                    kasaUiState.area = activeChip.dataset.areaChip || 'all';
                }

                const res = await fetch(window.location.pathname, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Sayfa yenileme verisi alınamadı.');

                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');

                const yeniIcerik = doc.getElementById('kasaTabContent');
                const mevcutIcerik = document.getElementById('kasaTabContent');
                if (yeniIcerik && mevcutIcerik) {
                    mevcutIcerik.innerHTML = yeniIcerik.innerHTML;
                    initBekleyenMasalarUI();
                }
            } catch (err) {
                console.error(err);
                location.reload();
            } finally {
                refreshInFlight = false;
            }
        }

        function scheduleSoftRefresh(delayMs = 500) {
            const minIntervalMs = 3000;
            const elapsed = Date.now() - lastRefreshAt;
            const waitMs = Math.max(delayMs, minIntervalMs - elapsed);

            if (refreshTimer) return;

            refreshTimer = setTimeout(async () => {
                refreshTimer = null;
                lastRefreshAt = Date.now();
                await softRefreshKasaPanels();
            }, Math.max(0, waitMs));
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/order')
            .withAutomaticReconnect()
            .build();

        connection.on('SiparisGeldi', function () {
            scheduleSoftRefresh(800);
        });

        connection.on('SiparisEklendi', function () {
            scheduleSoftRefresh(800);
        });

        connection.on('SiparisGuncellendi', function () {
            scheduleSoftRefresh(500);
        });

        connection.on('OdemeYapildi', function () {
            const bell = document.getElementById('kasaBellSound');
            if (bell) {
                bell.play().catch(() => {});
            }
            scheduleSoftRefresh(300);
        });

        connection.start().then(() => {
            console.log('Kasa Paneli SignalR bağlantısı başarılı.');
        }).catch(err => console.error('SignalR Hatası:', err));

        let kasaResizeTimer = null;
        window.addEventListener('resize', function () {
            if (kasaResizeTimer) {
                clearTimeout(kasaResizeTimer);
            }

            kasaResizeTimer = setTimeout(() => {
                applyBekleyenFilters();
            }, 120);
        });

        initBekleyenMasalarUI();
    </script>
}