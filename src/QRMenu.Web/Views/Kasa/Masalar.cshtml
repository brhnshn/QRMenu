@model QRMenu.Web.ViewModels.KasaMasalarPageViewModel

@{
    Layout = "~/Views/Shared/_KasaLayout.cshtml";
    ViewData["Title"] = "Kasa Yönetimi";
    ViewData["ActivePage"] = "KasaMasalar";
    ViewData["PageTitle"] = "Kasa Yönetimi";
}

@section Styles {
    <style>
        .kasa-masalar-root {
            height: 100%;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #f8f6f5;
        }

        .kasa-main-scroll {
            min-height: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            overflow: hidden;
            padding: 0.75rem 1rem;
        }

        .table-bento-grid {
            display: grid;
            grid-template-columns: repeat(1, minmax(0, 1fr));
            gap: .85rem;
            min-height: 0;
            flex: 1;
            align-content: start;
            overflow: visible;
        }

        @@media (min-width: 768px) { .table-bento-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @@media (min-width: 1024px) { .table-bento-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
        @@media (min-width: 1280px) { .table-bento-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

        .kasa-compact-mode .table-card { height: 11.15rem; }
        .table-card { height: 11.5rem; }
        .table-card.is-clickable { cursor: pointer; }

        .kasa-main-footer {
            margin-top: .25rem;
            padding-top: .65rem;
            padding-bottom: .2rem;
        }

        .kasa-pager-btn {
            width: 2.6rem;
            height: 2.6rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: .65rem;
            background: #eae8e7;
            color: #2e2f2f;
            font-weight: 800;
            border: 0;
        }

        .kasa-pager-btn.is-active {
            background: #765600;
            color: #fff;
        }

        .kasa-pager-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }
    </style>
}

<audio id="kasaBellSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

<section class="kasa-masalar-root">
    @await Html.PartialAsync("_KasaMasalarContent", Model)
</section>

@section Scripts {
    <script>
        function readBoolSetting(key, fallback) {
            try {
                const raw = localStorage.getItem(key);
                return raw === null ? fallback : raw === '1';
            } catch {
                return fallback;
            }
        }

        function readTextSetting(key, fallback) {
            try {
                return localStorage.getItem(key) || fallback;
            } catch {
                return fallback;
            }
        }

        function applyKasaViewSettings() {
            const compactMode = readBoolSetting('kasaCompactCards', false);
            document.body.classList.toggle('kasa-compact-mode', compactMode);
            document.documentElement.classList.toggle('kasa-compact-mode', compactMode);
        }

        let refreshTimer = null;
        let lastRefreshAt = 0;
        let refreshInFlight = false;
        const kasaUiState = {
            area: 'all',
            query: '',
            sort: readTextSetting('kasaSortDefault', 'wait-desc'),
            currentPage: 1,
            totalPages: 1,
            pageSize: 1
        };

        function normalizeText(value) {
            return String(value || '').toLocaleLowerCase('tr-TR');
        }

        function sortCards(cards) {
            const sortType = kasaUiState.sort;
            cards.sort((a, b) => {
                const waitA = Number(a.dataset.wait || 0);
                const waitB = Number(b.dataset.wait || 0);
                const amountA = Number(a.dataset.amount || 0);
                const amountB = Number(b.dataset.amount || 0);
                const tableA = Number(a.dataset.table || 0);
                const tableB = Number(b.dataset.table || 0);

                if (sortType === 'amount-desc') return amountB - amountA;
                if (sortType === 'table-asc') return tableA - tableB;
                return waitB - waitA;
            });
        }

        function getGridColumnCount(grid) {
            const template = window.getComputedStyle(grid).gridTemplateColumns || '';
            return Math.max(1, template.split(' ').filter(Boolean).length);
        }

        function calculatePageSize(grid, visibleCards) {
            const cols = getGridColumnCount(grid);
            if (!visibleCards.length) return cols;

            const cardRect = visibleCards[0].getBoundingClientRect();
            const gridStyle = window.getComputedStyle(grid);
            const rowGap = Number.parseFloat(gridStyle.rowGap || '0') || 0;
            const availableHeight = grid.clientHeight || 0;

            if (!cardRect.height || !availableHeight) return cols;

            const rows = Math.max(1, Math.floor((availableHeight + rowGap) / (cardRect.height + rowGap)));
            return Math.max(1, cols * rows);
        }

        function renderPager(totalItems) {
            const prevBtn = document.getElementById('kasaPrevPageBtn');
            const nextBtn = document.getElementById('kasaNextPageBtn');
            const numberGroup = document.getElementById('kasaPageNumberGroup');
            const footerInfo = document.getElementById('kasaFooterInfo');
            const totalAll = document.querySelectorAll('#kasaTableGrid .table-card[data-search]').length;

            if (footerInfo) {
                footerInfo.textContent = `Toplam ${totalAll} masadan ${totalItems} masa gösteriliyor`;
            }

            if (!prevBtn || !nextBtn || !numberGroup) return;

            numberGroup.innerHTML = '';
            prevBtn.disabled = kasaUiState.currentPage <= 1;
            nextBtn.disabled = kasaUiState.currentPage >= kasaUiState.totalPages;

            if (kasaUiState.totalPages <= 1) return;

            for (let i = 1; i <= kasaUiState.totalPages; i++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `kasa-pager-btn${i === kasaUiState.currentPage ? ' is-active' : ''}`;
                btn.textContent = String(i);
                btn.addEventListener('click', () => {
                    if (kasaUiState.currentPage === i) return;
                    kasaUiState.currentPage = i;
                    applyBekleyenFilters();
                });
                numberGroup.appendChild(btn);
            }
        }

        function initTableCardNavigation() {
            document.querySelectorAll('#kasaTableGrid .table-card[data-detail-url]').forEach(card => {
                const goToDetail = () => {
                    const detailUrl = card.dataset.detailUrl;
                    if (detailUrl) window.location.href = detailUrl;
                };

                card.onclick = (evt) => {
                    const target = evt.target;
                    if (target instanceof Element && target.closest('a, button, input, select, textarea, label')) return;
                    goToDetail();
                };

                card.onkeydown = (evt) => {
                    if (evt.key === 'Enter' || evt.key === ' ') {
                        evt.preventDefault();
                        goToDetail();
                    }
                };
            });
        }

        function applyBekleyenFilters() {
            const grid = document.getElementById('kasaTableGrid');
            if (!grid) return;

            const empty = document.getElementById('kasaGridEmpty');
            const cards = Array.from(grid.querySelectorAll('.table-card[data-search]'));
            const visibleCards = cards.filter(card => {
                const areaMatch = kasaUiState.area === 'all' || card.dataset.area === kasaUiState.area;
                const text = normalizeText(card.dataset.search || '');
                return areaMatch && (!kasaUiState.query || text.includes(kasaUiState.query));
            });

            sortCards(visibleCards);
            visibleCards.forEach(card => grid.appendChild(card));

            kasaUiState.pageSize = calculatePageSize(grid, visibleCards);
            kasaUiState.totalPages = Math.max(1, Math.ceil(visibleCards.length / kasaUiState.pageSize));
            kasaUiState.currentPage = Math.max(1, Math.min(kasaUiState.currentPage, kasaUiState.totalPages));

            const startIndex = (kasaUiState.currentPage - 1) * kasaUiState.pageSize;
            const endIndex = startIndex + kasaUiState.pageSize;

            cards.forEach(card => card.style.display = 'none');
            visibleCards.forEach((card, index) => {
                card.style.display = index >= startIndex && index < endIndex ? '' : 'none';
            });

            if (empty) {
                empty.style.display = visibleCards.length ? 'none' : 'flex';
            }

            renderPager(visibleCards.length);
        }

        function initBekleyenMasalarUI() {
            const searchInput = document.getElementById('kasaSearchInput');
            const sortSelect = document.getElementById('kasaSortSelect');
            const prevBtn = document.getElementById('kasaPrevPageBtn');
            const nextBtn = document.getElementById('kasaNextPageBtn');

            document.querySelectorAll('[data-area-chip]').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.areaChip === kasaUiState.area);
                btn.onclick = () => {
                    kasaUiState.area = btn.dataset.areaChip || 'all';
                    kasaUiState.currentPage = 1;
                    document.querySelectorAll('[data-area-chip]').forEach(x => x.classList.toggle('active', x === btn));
                    applyBekleyenFilters();
                };
            });

            if (searchInput) {
                searchInput.value = kasaUiState.query;
                searchInput.oninput = () => {
                    kasaUiState.query = normalizeText(searchInput.value).trim();
                    kasaUiState.currentPage = 1;
                    applyBekleyenFilters();
                };
            }

            if (sortSelect) {
                sortSelect.value = kasaUiState.sort;
                sortSelect.onchange = () => {
                    kasaUiState.sort = sortSelect.value;
                    kasaUiState.currentPage = 1;
                    applyBekleyenFilters();
                };
            }

            if (prevBtn) prevBtn.onclick = () => { if (kasaUiState.currentPage > 1) { kasaUiState.currentPage -= 1; applyBekleyenFilters(); } };
            if (nextBtn) nextBtn.onclick = () => { if (kasaUiState.currentPage < kasaUiState.totalPages) { kasaUiState.currentPage += 1; applyBekleyenFilters(); } };

            initTableCardNavigation();
            applyBekleyenFilters();
        }

        async function softRefreshKasaPanels() {
            if (refreshInFlight) return;
            refreshInFlight = true;

            try {
                const searchInput = document.getElementById('kasaSearchInput');
                if (searchInput) kasaUiState.query = normalizeText(searchInput.value).trim();

                const sortSelect = document.getElementById('kasaSortSelect');
                if (sortSelect) kasaUiState.sort = sortSelect.value;

                const activeChip = document.querySelector('[data-area-chip].active');
                if (activeChip) kasaUiState.area = activeChip.dataset.areaChip || 'all';

                const res = await fetch(window.location.pathname, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Sayfa yenileme verisi alınamadı.');

                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const incoming = doc.getElementById('kasaTabContent');
                const current = document.getElementById('kasaTabContent');
                if (incoming && current) {
                    current.outerHTML = incoming.outerHTML;
                    initBekleyenMasalarUI();
                }
            } catch (err) {
                console.error(err);
                console.warn('Kasa paneli güncellenemedi, mevcut içerik korunuyor.');
            } finally {
                refreshInFlight = false;
            }
        }

        function scheduleSoftRefresh(delayMs = 90) {
            const minIntervalMs = 200;
            const elapsed = Date.now() - lastRefreshAt;
            const waitMs = Math.max(delayMs, minIntervalMs - elapsed);

            if (refreshTimer) return;

            refreshTimer = setTimeout(async () => {
                refreshTimer = null;
                lastRefreshAt = Date.now();
                await softRefreshKasaPanels();
            }, Math.max(0, waitMs));
        }

        function buildConnection(useFallbackTransports) {
            const options = useFallbackTransports
                ? { transport: signalR.HttpTransportType.ServerSentEvents | signalR.HttpTransportType.LongPolling }
                : undefined;

            return new signalR.HubConnectionBuilder()
                .withUrl('/hubs/order', options)
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Error)
                .build();
        }

        function registerConnectionHandlers(conn) {
            conn.on('SiparisGeldi', () => scheduleSoftRefresh(100));
            conn.on('SiparisEklendi', () => scheduleSoftRefresh(100));
            conn.on('SiparisGuncellendi', () => scheduleSoftRefresh(80));
            conn.on('OdemeYapildi', () => {
                if (readBoolSetting('kasaPaymentSound', true)) {
                    const bell = document.getElementById('kasaBellSound');
                    if (bell) bell.play().catch(() => {});
                }
                scheduleSoftRefresh(60);
            });
        }

        let connection = buildConnection(false);
        registerConnectionHandlers(connection);

        async function startConnection(conn, allowFallback) {
            try {
                await conn.start();
            } catch (err) {
                console.error('SignalR Hatası:', err);
                if (!allowFallback) return;

                try { await conn.stop(); } catch {}

                connection = buildConnection(true);
                registerConnectionHandlers(connection);
                await startConnection(connection, false);
            }
        }

        startConnection(connection, true);

        let kasaResizeTimer = null;
        window.addEventListener('resize', function () {
            if (kasaResizeTimer) clearTimeout(kasaResizeTimer);
            kasaResizeTimer = setTimeout(applyBekleyenFilters, 120);
        });

        applyKasaViewSettings();
        initBekleyenMasalarUI();
    </script>
}

