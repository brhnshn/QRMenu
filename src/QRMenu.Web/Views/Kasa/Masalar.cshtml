@model List<QRMenu.Core.Entities.Masa>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Kasa Paneli";
    ViewData["ActivePage"] = "KasaMasalar";
    ViewData["PageTitle"] = "Kasa İşlemleri";
    
    var sonOdemeler = ViewBag.SonOdemeler as List<QRMenu.Core.Entities.Siparis>;
    var mutfakZamanEsigi = DateTime.UtcNow.AddHours(-24);
}

@section Styles {
    <link href="~/css/admin-siparisler.css" rel="stylesheet" />
    <style>
        :root {
            --cash-bg-1: #f8fafc;
            --cash-bg-2: #eef7ff;
            --cash-border: #d7e5f6;
            --cash-text: #0f172a;
            --cash-muted: #64748b;
        }

        .admin-content {
            background:
                radial-gradient(circle at 15% 15%, rgba(56, 189, 248, 0.12), transparent 30%),
                radial-gradient(circle at 85% 85%, rgba(14, 165, 233, 0.12), transparent 36%),
                linear-gradient(155deg, var(--cash-bg-1), var(--cash-bg-2));
        }

        .kasa-tabs {
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid var(--cash-border);
            backdrop-filter: blur(8px);
            padding: 10px 20px 0;
            border-radius: 16px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
            margin-bottom: 24px;
        }
        .nav-tabs { border-bottom: none; }
        .nav-link { 
            border: none !important; 
            font-weight: 700; 
            color: #64748b; 
            padding: 14px 24px; 
            position: relative;
            transition: all 0.2s;
        }
        .nav-link:hover { color: #0f172a; }
        .nav-link.active { color: #3b82f6 !important; background: transparent !important; }
        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 20%;
            right: 20%;
            height: 3px;
            background: #3b82f6;
            border-radius: 3px;
        }

        .kare-masa {
            background: rgba(255, 255, 255, 0.94);
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            color: var(--cash-text);
            display: block;
            border: 1px solid var(--cash-border);
            position: relative;
        }
        .kare-masa:hover {
            transform: translateY(-8px) scale(1.01);
            box-shadow: 0 18px 34px rgba(15, 23, 42, 0.12);
        }
        .masa-dolu {
            border-color: #f59e0b;
            background: linear-gradient(180deg, #fff9ef, #fff5e6);
        }
        .masa-mutfak {
            border-color: #3b82f6;
            background: linear-gradient(180deg, #f5faff, #edf5ff);
        }
        .masa-garson {
            border-color: #22c55e;
            background: linear-gradient(180deg, #f4fff7, #e9fcef);
        }
        .masa-odeme {
            border-color: #f59e0b;
            background: linear-gradient(180deg, #fff9ef, #fff5e6);
        }
        .masa-bos {
            border-color: #cbd5e1;
            background: linear-gradient(180deg, #ffffff, #f8fafc);
            opacity: 0.82;
        }
        
        .masa-no { font-size: 1.5rem; font-weight: 900; color: var(--cash-text); margin-bottom: 8px; }
        .masa-info { font-size: 0.9rem; font-weight: 700; color: var(--cash-muted); }
        .masa-tutar { font-size: 1.1rem; font-weight: 800; color: #b45309; margin-top: 15px; }

        .siparis-table-wrap {
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--cash-border);
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        }

        .siparis-table thead th {
            background: #eff6ff;
            color: var(--cash-text);
            border-bottom: 1px solid var(--cash-border);
        }

        .siparis-table tbody tr {
            background: rgba(255, 255, 255, 0.96);
        }

        .siparis-table tbody tr:hover {
            background: #f8fbff;
        }

        @@media (max-width: 576px) {
            .kare-masa {
                padding: 20px 12px;
            }
            .masa-no {
                font-size: 1.2rem;
            }
        }
    </style>
}

<div class="kasa-tabs">
    <ul class="nav nav-tabs" id="kasaTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="bekleyen-tab" data-bs-toggle="tab" data-bs-target="#bekleyen" type="button" role="tab">
                <i class="bi bi-hourglass-split"></i> Bekleyen Masalar
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="odenen-tab" data-bs-toggle="tab" data-bs-target="#odenen" type="button" role="tab">
                <i class="bi bi-check-all"></i> Ödenen Siparişler
            </button>
        </li>
    </ul>
</div>

@if (ViewBag.ConnectionWarning != null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert" style="border-radius: 12px;">
        <i class="bi bi-wifi-off me-2"></i>
        <span>@ViewBag.ConnectionWarning</span>
    </div>
}

<audio id="kasaBellSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

<div class="tab-content" id="kasaTabContent">
    <!-- BEKLEYEN MASALAR TAB -->
    <div class="tab-pane fade show active" id="bekleyen" role="tabpanel">
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach(var masa in Model.OrderBy(m => m.MasaNo))
            {
                var siparisler = masa.Siparisler.Where(s => s.Durum != QRMenu.Core.Enums.SiparisDurum.TamOdendi && s.Durum != QRMenu.Core.Enums.SiparisDurum.Iptal && s.Durum != QRMenu.Core.Enums.SiparisDurum.Iade).ToList();
                var aktifDetayVarmi = siparisler.Any(s => s.SiparisDetaylar.Any(sd =>
                    sd.Durum != QRMenu.Core.Enums.SiparisDurum.TamOdendi &&
                    sd.Durum != QRMenu.Core.Enums.SiparisDurum.Iptal &&
                    sd.Durum != QRMenu.Core.Enums.SiparisDurum.Iade));

                var doluMu = aktifDetayVarmi;

                // Kasa etiketleri sipariş ana durumundan hesaplanır.
                // Sadece Mutfakta etiketi için Mutfak paneliyle aynı 24 saat kuralını uygularız.
                var mutfaktaVarMi = siparisler.Any(s =>
                    s.OlusturmaTarihi >= mutfakZamanEsigi &&
                    (s.Durum == QRMenu.Core.Enums.SiparisDurum.Onaylandi ||
                     s.Durum == QRMenu.Core.Enums.SiparisDurum.Hazirlaniyor));

                var garsondaVarMi = siparisler.Any(s =>
                    s.Durum == QRMenu.Core.Enums.SiparisDurum.Hazir);

                var odemeBekliyorMu = siparisler.Any(s =>
                    s.Durum == QRMenu.Core.Enums.SiparisDurum.TeslimEdildi ||
                    s.Durum == QRMenu.Core.Enums.SiparisDurum.KismiOdendi);
                
                // Siparişe uygulanan indirimleri kalan bakiyeye oransal yansıtıyoruz.
                var kalanBakiye = siparisler.Sum(s =>
                {
                    var bazToplam = s.SiparisDetaylar
                        .Where(sd => sd.Durum != QRMenu.Core.Enums.SiparisDurum.Iptal && sd.Durum != QRMenu.Core.Enums.SiparisDurum.Iade)
                        .Sum(sd => sd.Adet * sd.BirimFiyat);

                    var oran = bazToplam > 0 ? (s.ToplamTutar / bazToplam) : 1m;

                    return s.SiparisDetaylar
                        .Where(sd => sd.Durum != QRMenu.Core.Enums.SiparisDurum.TamOdendi && 
                                     sd.Durum != QRMenu.Core.Enums.SiparisDurum.Iptal && 
                                     sd.Durum != QRMenu.Core.Enums.SiparisDurum.Iade)
                        .Sum(sd => (sd.Adet * sd.BirimFiyat) * oran);
                });
                
                // Eğer bakiye 0 ise masayı boş kabul et.
                if (kalanBakiye <= 0) doluMu = false;

                var masaDurumSinifi = "masa-bos";
                var durumMetni = "Hazır";
                var durumRenkSinifi = "text-muted";
                var durumIkonu = "bi-check-circle";

                if (doluMu)
                {
                    if (odemeBekliyorMu)
                    {
                        masaDurumSinifi = "masa-odeme";
                        durumMetni = "Ödeme Bekliyor";
                        durumRenkSinifi = "text-warning";
                        durumIkonu = "bi-credit-card";
                    }
                    else if (garsondaVarMi)
                    {
                        masaDurumSinifi = "masa-garson";
                        durumMetni = "Garsonda";
                        durumRenkSinifi = "text-success";
                        durumIkonu = "bi-bag-check";
                    }
                    else if (mutfaktaVarMi)
                    {
                        masaDurumSinifi = "masa-mutfak";
                        durumMetni = "Mutfakta";
                        durumRenkSinifi = "text-primary";
                        durumIkonu = "bi-fire";
                    }
                    else
                    {
                        masaDurumSinifi = "masa-dolu";
                        durumMetni = "Sipariş Var";
                        durumRenkSinifi = "text-secondary";
                        durumIkonu = "bi-receipt";
                    }
                }
                
                <div class="col">
                    <a href="@(doluMu ? $"/Kasa/Odeme/{masa.Id}" : "#")" class="kare-masa @masaDurumSinifi">
                        <div class="masa-no">Masa @masa.MasaNo</div>
                        <div class="masa-info">
                            @if(doluMu) {
                                <span class="@durumRenkSinifi"><i class="bi @durumIkonu"></i> @durumMetni</span>
                            } else {
                                <span class="text-muted"><i class="bi bi-check-circle"></i> Hazır</span>
                            }
                        </div>
                        @if(doluMu) {
                            <div class="masa-tutar">@kalanBakiye.ToString("N2") TL</div>
                        } else {
                            <div class="masa-tutar text-muted" style="opacity: 0.3;">0,00 TL</div>
                        }
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- ÖDENEN SİPARİŞLER TAB -->
    <div class="tab-pane fade" id="odenen" role="tabpanel">
        <div class="siparis-table-wrap">
            <table class="siparis-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Masa</th>
                        <th>Ürünler</th>
                        <th>Tutar</th>
                        <th>Ödeme Tarihi</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @if (sonOdemeler == null || !sonOdemeler.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">Henüz ödenmiş sipariş yok.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach(var s in sonOdemeler)
                        {
                            var detayOzet = string.Join(", ", s.SiparisDetaylar.Select(sd => $"{sd.Adet}x {sd.Urun.Ad}"));
                            <tr>
                                <td><strong>#@s.Id</strong></td>
                                <td><span class="badge bg-dark rounded-pill px-3">Masa @s.Masa?.MasaNo</span></td>
                                <td class="text-truncate" style="max-width:300px;">@detayOzet</td>
                                <td><strong>@s.ToplamTutar.ToString("N2") TL</strong></td>
                                <td>@(s.GuncellemeTarihi?.ToString("HH:mm") ?? "-")</td>
                                <td><span class="durum-badge durum-@s.Durum">@s.Durum</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let refreshTimer = null;
        let lastRefreshAt = 0;
        let refreshInFlight = false;

        async function softRefreshKasaPanels() {
            if (refreshInFlight) return;
            refreshInFlight = true;

            try {
                const activeTabTarget = document.querySelector('#kasaTab .nav-link.active')?.getAttribute('data-bs-target') || '#bekleyen';

                const res = await fetch(window.location.pathname, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Sayfa yenileme verisi alınamadı.');

                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');

                const yeniIcerik = doc.getElementById('kasaTabContent');
                const mevcutIcerik = document.getElementById('kasaTabContent');
                if (yeniIcerik && mevcutIcerik) {
                    mevcutIcerik.innerHTML = yeniIcerik.innerHTML;

                    // Aktif sekmeyi koru
                    mevcutIcerik.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('show', 'active'));
                    const activePane = mevcutIcerik.querySelector(activeTabTarget);
                    if (activePane) {
                        activePane.classList.add('show', 'active');
                    } else {
                        const firstPane = mevcutIcerik.querySelector('.tab-pane');
                        if (firstPane) firstPane.classList.add('show', 'active');
                    }
                }
            } catch (err) {
                console.error(err);
                location.reload();
            } finally {
                refreshInFlight = false;
            }
        }

        function scheduleSoftRefresh(delayMs = 500) {
            const minIntervalMs = 3000;
            const elapsed = Date.now() - lastRefreshAt;
            const waitMs = Math.max(delayMs, minIntervalMs - elapsed);

            if (refreshTimer) return;

            refreshTimer = setTimeout(async () => {
                refreshTimer = null;
                lastRefreshAt = Date.now();
                await softRefreshKasaPanels();
            }, Math.max(0, waitMs));
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/order")
            .withAutomaticReconnect()
            .build();

        connection.on("SiparisGeldi", function () {
            scheduleSoftRefresh(800);
        });

        connection.on("SiparisEklendi", function () {
            scheduleSoftRefresh(800);
        });

        connection.on("SiparisGuncellendi", function () {
            scheduleSoftRefresh(500);
        });

        connection.on("OdemeYapildi", function () {
            document.getElementById('kasaBellSound').play().catch(() => {});
            scheduleSoftRefresh(300);
        });

        connection.start().then(() => {
            console.log("Kasa Paneli SignalR Bağlantısı başarılı.");
        }).catch(err => console.error("SignalR Hatası:", err));
    </script>
}
